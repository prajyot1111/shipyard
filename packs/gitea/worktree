#!/usr/bin/env python3
"""`worktree <id>`: the card's worktrees, primary first, cut when needed (the kit's `verbs.py`)."""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), os.environ.get("KEEL_HOME") or str(HERE.parent.parent), str(HERE.parent.parent)]

from keel.packkit import verbs  # noqa: E402

sys.exit(verbs.run("worktree", sys.argv[1:], pack=HERE, layer="gt_layer"))
