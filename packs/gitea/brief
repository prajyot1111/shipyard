#!/usr/bin/env python3
"""`brief <id>`: the pack's half of a house's brief (the kit's `verbs.py`)."""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), os.environ.get("KEEL_HOME") or str(HERE.parent.parent), str(HERE.parent.parent)]

from keel.packkit import verbs  # noqa: E402

sys.exit(verbs.run("brief", sys.argv[1:], pack=HERE, layer="gt_layer"))
