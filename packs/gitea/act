#!/usr/bin/env python3
"""`act verbs | act links <id>...`: the card verbs (none) and the links the deck draws
(the kit's `verbs.py`)."""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), os.environ.get("KEEL_HOME") or str(HERE.parent.parent), str(HERE.parent.parent)]

from keel.packkit import verbs  # noqa: E402

sys.exit(verbs.run("act", sys.argv[1:], pack=HERE, layer="gt_layer"))
