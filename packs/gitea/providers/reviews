#!/usr/bin/env python3
"""`providers/reviews`: the Reviews page's gear, the space's two review settings (c-730,
the kit's `verbs.py`)."""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
sys.path[:0] = [str(HERE), os.environ.get("KEEL_HOME") or str(HERE.parent.parent), str(HERE.parent.parent)]

from keel.packkit import verbs  # noqa: E402

sys.exit(verbs.run("providers/reviews", sys.argv[1:], pack=HERE, layer="gt_layer"))
