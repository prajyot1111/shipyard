#!/usr/bin/env python3
"""`ship <id> poll|diff|method|down|reap` and `ship mine`: a shipping card's pull requests
as GitHub shows them (the kit's `verbs.py`)."""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), os.environ.get("KEEL_HOME") or str(HERE.parent.parent), str(HERE.parent.parent)]

from keel.packkit import verbs  # noqa: E402

sys.exit(verbs.run("ship", sys.argv[1:], pack=HERE, layer="gh_layer"))
