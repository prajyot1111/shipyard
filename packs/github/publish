#!/usr/bin/env python3
"""`publish <id> [--answer]`: Approve outcome marks the card's drafts ready; with `--answer`,
Ship pushes the card's own branch and posts the kept replies (the kit's `verbs.py`)."""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), os.environ.get("KEEL_HOME") or str(HERE.parent.parent), str(HERE.parent.parent)]

from keel.packkit import verbs  # noqa: E402

sys.exit(verbs.run("publish", sys.argv[1:], pack=HERE, layer="gh_layer"))
