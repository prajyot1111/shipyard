#!/usr/bin/env python3
"""`logins check`: gh's sign-in as a row of Keel's Logins list (the kit's `verbs.py`, gh_ready.py)."""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), os.environ.get("KEEL_HOME") or str(HERE.parent.parent), str(HERE.parent.parent)]

from keel.packkit import verbs  # noqa: E402

sys.exit(verbs.run("logins", sys.argv[1:], pack=HERE, layer="gh_layer"))
