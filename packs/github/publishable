#!/usr/bin/env python3
"""`publishable <id>`: whether Approve outcome could publish this card, as JSON (the kit's `verbs.py`)."""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), os.environ.get("KEEL_HOME") or str(HERE.parent.parent), str(HERE.parent.parent)]

from keel.packkit import verbs  # noqa: E402

sys.exit(verbs.run("publishable", sys.argv[1:], pack=HERE, layer="gh_layer"))
