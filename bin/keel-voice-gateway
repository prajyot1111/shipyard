#!/usr/bin/env python3
"""keel-voice-gateway - the voice service, in the foreground (what launchd runs).

    keel-voice-gateway [--port N]

Everything a person does to it is a `keel voice` verb (keel/voice.py): `venv` builds
`.venv-voice` from etc/voice-requirements.txt on the newest interpreter the speech
stack allows, `install [--load]` writes dev.keel.voice.plist into the services directory
(the install's services/, a bare checkout's etc/) and bootstraps it,
`uninstall` takes it out, `status` says whether it is loaded and answering. This file
only runs the gateway, and it is the one script in bin/ that imports the package.

IT RUNS UNDER ITS OWN INTERPRETER, and that is not fussiness. `keel/` is Python 3.14 and
the standard library; the speech model pulls MLX, numpy, librosa and forty-odd more, and
kokoro pins Python below 3.13. So voice gets `.venv-voice`, this script re-execs into it
when it exists, and deleting that directory un-installs the speech stack and nothing else.

WHAT IT DOES WHEN THE SPEECH MODEL IS NOT INSTALLED: starts, serves, and says so on
/voice/health. A gateway that refuses to boot because a model is missing is a gateway
that cannot tell you the model is missing.
"""
from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent                      # the Keel checkout
PACKAGE_DIR = ROOT / "voice"            # holds the harbor_voice package
VENV = ROOT / ".venv-voice"
VENV_PY = VENV / "bin" / "python"


def reexec_into_venv() -> None:
    """Run under .venv-voice if it exists and we are not already there.

    Guarded by an environment variable rather than by comparing paths, because the two
    interpreters may be the same file through different symlinks and an exec loop in a
    launchd agent is a fork bomb with a restart policy.
    """
    if os.environ.get("HARBOR_VOICE_REEXEC") or not VENV_PY.exists():
        return
    # `sys.prefix`, NOT a comparison of interpreter paths. A venv's `bin/python` is a
    # SYMLINK to the base interpreter, so resolving both sides makes them equal and the
    # re-exec never happens: the gateway then runs under an interpreter with no speech
    # model and reports the model as missing, which is a truthful report of a fault
    # caused by this function. sys.prefix is the venv directory and nothing else is.
    if Path(sys.prefix).resolve() == VENV.resolve():
        return
    os.execve(str(VENV_PY), [str(VENV_PY), str(Path(__file__).resolve()), *sys.argv[1:]],
              {**os.environ, "HARBOR_VOICE_REEXEC": "1"})


def main() -> int:
    ap = argparse.ArgumentParser(prog="keel-voice-gateway", description=__doc__.splitlines()[0])
    ap.add_argument("--port", type=int, default=None)
    a = ap.parse_args()
    reexec_into_venv()
    sys.path.insert(0, str(PACKAGE_DIR))
    from harbor_voice.server import serve                               # noqa: PLC0415
    return serve(a.port)


if __name__ == "__main__":
    sys.exit(main())
