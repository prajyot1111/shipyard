#!/usr/bin/env bash
# keel-backup - the runtime data that exists nowhere else.
#
# Moved into Keel by cutover step 8 from ~/harbor/bin/harbor-backup, which is now
# read-only history. `keel backup` (keel/backup.py) is the verb that installs the two
# launchd agents and calls this; everything below is unchanged in design.
#
# The design puts generated output outside git on purpose (segments/README.md says why: a
# tracked file that a fetcher rewrites leaves the checkout dirty on a schedule). That is
# correct, and it leaves the board, every card directory, every fathom ask, every daybook
# item and every decision journal living on exactly one disk, with no Time Machine
# destination and no other copy. The design that keeps the repo clean is the same design
# that loses the data with the laptop.
#
# So: an encrypted copy, hourly, in a store off this machine (Google Drive through rclone
# today; the store is one line of the config, see STORE below).
#
#   keel-backup snapshot [--force] [--set N] [--take-over]   take one now (the hourly job)
#   keel-backup restore --into DIR [--set N] [--local]        pull a snapshot back out, REMOTE by default
#   keel-backup verify [--set N] [--local]                    decrypt the newest snapshot and unpack it
#   keel-backup pull                                          copy the store's recent end here (the nightly job)
#   keel-backup status [--json]                               freshness, size, what is retained
#   keel-backup init                                          prove the store and make the keys, once
#   keel-backup migrate-from-git [--clone DIR]                the one-off move off the old GitHub repo
#   keel-backup notice add|close ...                          the board notice verbs every alarm speaks
#   keel-backup slim --dry-run | --approved | --restore ID | --purge [--id ID | --unproven ID]
#                    [--set N] [--limit N] [--json]           rewrite old snapshots without what the scan now leaves out
#
# FIVE THINGS THIS FILE IS BUILT AROUND, each because the obvious version is wrong:
#
# 1. NOTHING IT WRITES LANDS INSIDE A CHECKOUT. The working files, the state
#    file, the passphrases, the rclone token and the logs all live under ~/.keel-backup. A
#    single untracked file inside a checkout dirties the tree, and on 2026-08-01 that exact
#    failure meant an approved queue entry silently did not run and self-extension was
#    disabled for a day. A backup job writing hourly would have reproduced that permanently.
#    There is no exception: the passphrase may not move into ~/keel because state/ is IN
#    the keel set.
#
# 2. THE CHANGE TEST IS ON PLAINTEXT, NOT CIPHERTEXT. gpg output is nondeterministic
#    (fresh session key, fresh salt), so hashing the encrypted blob reports a change every
#    single hour, which is how a repo of "identical" 1.4MB blobs grows to a gigabyte of
#    nothing. The manifest below hashes each file's CONTENT, sorted by path, and the
#    snapshot is skipped entirely when that digest matches the last one. Each SET has its
#    own manifest, so a quiet set costs nothing when a noisy one changes.
#
# 3. THE STORE HOLDS BLOBS, AND EVERY SET HAS ONE WRITER. Until c-285 this was a git repo
#    on GitHub with exactly one orphan commit, force-pushed hourly, because encrypted blobs
#    do not delta-compress and history would have kept every snapshot forever. That was a
#    lot of git machinery to make git behave like a blob store, it could take only one
#    writer (two machines force-pushing one root erase each other), and the repo was
#    heading past what GitHub advises. So the store is now what the data always was: one
#    object per snapshot, `sets/<set>/snapshots/YYYY/MM/<id>.tar.gz.gpg`, with the set's
#    `latest.json` written LAST as the commit point, and a blob proven present by the
#    store's own md5 of it rather than by an upload's exit code. Retention deletes the
#    objects it drops, into Drive's trash for 30 days. Which machine writes which set is
#    the config's `backup_sets`, and `latest.json` names the host that wrote it: a machine
#    refuses to write a set another machine wrote in the last day unless told --take-over,
#    so the phase-1 overlap (the Mac writing, the box coming up) cannot fork the keel set.
#
# 4. THE KEY HAS TO LEAVE THE MACHINE. A passphrase stored only on the disk being backed
#    up is a decoration, not a key. Generating one therefore also stages it on the queue
#    for a password manager, and losing that card means every snapshot is unrecoverable.
#    The corollary is enforced below: if the keyfile is missing but snapshots already
#    exist, this refuses to run rather than generating a new key, because a new key turns
#    the entire history into noise while looking like a successful backup.
#
# 5. FAILURE IS LOUD. Silent failure is the only failure mode backup systems really have.
#    A failed run, or a stale one, stages a `backup-stale` notice that retires itself on
#    the next success, so the board carries it until it clears. A failed VERIFY uses different keys, for the reason
#    written above announce_unreadable: those alarms mean different things and sharing a
#    key let the hourly job retire the weekly one. A refused token (`backup-auth`) is raised
#    on the FIRST refusal: a Drive refresh token that has died stops every later run too,
#    and waiting six hours for staleness to say so is six hours of nothing reaching the store.
#
# THREE SETS, AND WHY THEY ARE NOT ONE ARCHIVE
#
# Keel's `state/` and its segment data are the live set and the reason this runs at all.
# The other two are older and are kept for the same reason they were added: the old
# engine's ledger is the only record of what that system did, and the retired PR tools'
# findings and context notes are history that old cards still link into.
#
# Harbor's runtime data was the first thing here. Helm's is the second, and it has exactly
# the same exposure for exactly the same reason: ~/.claude/pr-reviews and ~/.claude/pr-watch
# are gitignored by the allowlist at the top of ~/.claude/.gitignore, and so they live on
# one disk with no other copy. The review scanner and PR watch that wrote them are retired
# (Keel lane RETIRE, 2026-09-24), and what is kept is their HISTORY, read-only: every
# review finding and orientation, every PR context note, the archived ones and their
# screenshots. None of it can be regenerated, and older cards link into it.
#
# They are independent sets sharing one store and one lock, rather than one archive
# holding all of it. keel and harbor share a passphrase; helm has its OWN, held on the Mac
# only, because the box can read every object in the store (one Drive app, one user, no
# per-prefix keys) and must not be able to decrypt employer review notes. Three reasons, in the order they should be weighed:
#
#   RESTORE IS THE TEST, and one archive fails it. The trees are rooted at different
#   places on disk (~/keel, ~/harbor and ~/.claude), so a single tarball would need synthetic
#   prefixes, and `restore --into DIR` would then unpack BOTH trees whichever one you came
#   for. Putting Helm's state back would mean copying the right subtree out of a directory
#   that also holds a full copy of Harbor's, by hand, under exactly the pressure that makes
#   people copy the wrong one. Two sets means `restore --set helm --into DIR` produces
#   ~/.claude's tree and nothing else, so the recovery of one can never clobber the other.
#
#   THE CHANGE TEST IS PER SET, and merging them would break point 2 for both. Harbor's
#   ledger moves on its own schedule and Helm's set on another; one shared manifest
#   makes any change anywhere re-encrypt and re-push everything, which doubles the cost of
#   every snapshot to record a change in one half of it.
#
#   THE ALARMS ARE PER SET. A set that cannot be read back needs a card that names it, and
#   the lesson already learned the hard way here (see announce_unreadable) is that two
#   alarms sharing a key erase each other. So the sets get separate keys.
#
# Every set lives under sets/<name>/ in the store. On GitHub Harbor's sat at the repo root
# to avoid re-uploading its history for symmetry; the move off GitHub re-uploaded all of it
# once anyway, so the special case went with it.
#
# WHAT IS IN HERE, AND WHY IT IS ENCRYPTED BEFORE IT LEAVES
#
# The scope is his, chosen deliberately, and it includes the board and the ledger.
# Both mention work: a work card's brief names what a session was sent to do, dispatch
# prompts did the same, and ledger/reviews quotes the code a review was reading. None of that is employer property, and none of it goes to an
# employer surface, which is the crossing the space rules actually forbid. It is going the
# other way, onto a personal account.
#
# The Helm set goes further and that deserves saying plainly rather than being left implicit
# in a path glob: pr-reviews/findings and pr-watch/context hold internal employer material,
# quoted diffs and review notes on real pull requests. It is backed up here knowingly, under
# the same two conditions, which are what make it acceptable and are not negotiable: the
# archive is AES256 encrypted BEFORE it leaves the machine (under a passphrase only the Mac
# holds), so the store holds ciphertext and nothing else, and no object in it is shared
# with anyone, which `verify` re-checks weekly rather than trusting how it was created. It must never reach a public host. If the day comes that any
# of this should not leave at all, the fix is one line in the matching file list.
#
# CREDENTIALS STILL NEVER LEAVE, encrypted or not, which is the same rule that keeps
# ~/harbor/secrets out of the harbor set and state/human.token and state/artifact.key out
# of the keel one. ~/.claude/pr-reviews/.env holds four live Slack
# webhook URLs, so the Helm list excludes .env outright rather than relying on it being
# small or on nobody noticing. Logs, pid, port and lock files are excluded too, for reasons
# written where the exclusion is.

set -euo pipefail

KEEL_HOME="${KEEL_HOME:-$HOME/keel}"
# The old checkout, kept as a set because its ledger and its frozen segment data are still
# the only copy of what the system before this one did. An override for the same reason
# the other homes have one: the selftest points every root at a fabricated tree.
HARBOR_HOME="${KEEL_HARBOR_HOME:-$HOME/harbor}"
# The third set's root. An override rather than a constant so the selftest can point it
# at a fabricated tree; nothing else should set it.
HELM_HOME="${KEEL_HELM_HOME:-$HOME/.claude}"
# Deliberately not under any of the roots above. See point 1 above; this is the whole
# reason the path is an absolute default rather than something tidy like $KEEL_HOME/backup.
BACKUP_HOME="${KEEL_BACKUP_HOME:-$HOME/.keel-backup}"
STATE="$BACKUP_HOME/state.json"
LOGDIR="$BACKUP_HOME/logs"
LOCK="$BACKUP_HOME/.lock"
# What this machine knows about each set it writes: the last latest.json it saw in the
# store, the store's listing as of the last run (what `status` reads, offline), and
# pending/, a blob encrypted and proven locally that has not yet been proven in the store.
WORK="$BACKUP_HOME/work"
# The nightly pull's copy of the recent end of the store, the second copy that never
# deletes because the store did (see cmd_pull).
MIRROR="$BACKUP_HOME/mirror"
MIRROR_DAYS="${KEEL_BACKUP_MIRROR_DAYS:-3}"

# THE CONFIG IS the install's config.toml, asked for once. `keel backup` passes these in; a bare
# `bin/keel-backup` (a restore by hand) asks `keel backup env` for them, so
# which store and which sets are decided in exactly one place.
#
# A FAILED ASK IS NOT AN EMPTY ANSWER. The scheduled jobs get only PATH, HOME and KEEL_HOME,
# so if `keel backup env` breaks (a config typo, a python3 that cannot import keel), an
# eval that shrugged would leave no store and no sets, and the hourly job would say
# "nothing to do", exit 0, and never raise an alarm again. ENV_ERROR makes every verb that
# needs the config die instead, which the snapshot's exit trap turns into backup-stale.
ENV_ERROR=""
if [ -z "${KEEL_BACKUP_STORE:-}" ] && [ -x "$KEEL_HOME/bin/keel" ]; then
  if _env="$("$KEEL_HOME/bin/keel" backup env 2>&1)"; then eval "$_env"
  else ENV_ERROR="$(printf '%s' "$_env" | tail -1)"; fi
  unset _env
fi
# `rclone:<remote>:<path>` or `file:<dir>`. Empty means the store was never set up, and
# every verb that needs it says so rather than guessing.
STORE="${KEEL_BACKUP_STORE:-}"
RCLONE_CONF="${KEEL_BACKUP_RCLONE_CONFIG:-$BACKUP_HOME/rclone.conf}"
# The sets THIS machine writes and verifies (`[backup] sets`). Empty is a real answer: a
# machine that writes none.
MY_SETS="${KEEL_BACKUP_SETS:-}"
# THE KEEL SET IS THE INSTALL'S LIVE DATA, not the checkout's (c-622). An install's board is
# its `[machine] state_dir` (`keel backup env` says which), which need not be under
# $KEEL_HOME: the scheduled jobs run from the checkout at ~/keel while the board is
# ~/shipyard/state. The set's root is the state dir's parent, the install's home, holding
# state/, config.toml and segments/*/data, so the archive's paths stay `state/...`; a state
# dir not named `state` would not restore to one, so it is refused rather than guessed.
KEEL_STATE="${KEEL_BACKUP_STATE_DIR:-$KEEL_HOME/state}"
KEEL_DATA="$(dirname "$KEEL_STATE")"
case " $MY_SETS " in
  *" keel "*) [ "$(basename "$KEEL_STATE")" = state ] || [ -n "$ENV_ERROR" ] \
    || ENV_ERROR="the keel set backs up a state dir named state, and the config's is $KEEL_STATE" ;;
esac
HOST="${KEEL_BACKUP_HOST:-$(hostname -s 2>/dev/null || echo unknown)}"
PULL="${KEEL_BACKUP_PULL:-0}"
# `[backup] legacy_repo`: the code-host repo (owner/name) this pushed to before the store,
# named only by the one-off `migrate` below. Empty: the migration names no repo.
LEGACY_REPO="${KEEL_BACKUP_LEGACY_REPO:-}"
# BESIDE THE WORK FILES, NOT INSIDE A CHECKOUT. It used to live at ~/harbor/secrets/backup.key,
# which was right while that tree was the live one and is wrong now that it is read-only
# history. It may not move into ~/keel either: state/ is IN the keel set, so the key would
# ride inside the archive it unlocks and, worse, sit in a tree a restore writes over.
# Credentials never leave this machine, so it stays outside every set.
KEYFILE="${KEEL_BACKUP_KEYFILE:-$BACKUP_HOME/backup.key}"
# The helm set's own passphrase, on the Mac only. See the note above the sets: the box
# can fetch every object in the store, so it is the key, not the store, that keeps
# employer review notes out of its reach.
HELM_KEYFILE="${KEEL_BACKUP_HELM_KEYFILE:-$BACKUP_HOME/backup-helm.key}"
# THE LOUD PART GOES ON THE BOARD. This used to stage notices on Harbor's queue through
# bin/harbor-queue. Harbor is retired and the queue with it, so `queue()` below speaks the
# same two verbs to Keel's board through bin/kb, and the board is the only store either way.
KB="$KEEL_HOME/bin/kb"
NOTICE_TOPIC="notice"
NOTICE_SPACE="personal"

# Older than this without a SUCCESSFUL run and something is wrong enough to say so.
STALE_HOURS="${KEEL_BACKUP_STALE_HOURS:-6}"
# The nightly pull's own staleness: two missed nights, not one, because a laptop asleep
# at 03:00 runs it on wake and one late night is not news.
PULL_STALE_HOURS="${KEEL_BACKUP_PULL_STALE_HOURS:-48}"
# How long a set belongs to the host that last wrote it: inside this, another host refuses
# to write it without --take-over.
OWNER_HOURS=24
# The store is a 100 GB Drive plan, so the bound is not a ceiling the store enforces but
# a promise about retention that nothing else measures. Crossing it does not stop the
# backup, it says so on the board.
# KEEL_BACKUP_SIZE_WARN_MB is a plain override, read by every run with no gate, so it is
# taken only when it is a number (c-724 r3.F8): anything else once made the comparison
# an error, which is no warning at all.
SIZE_WARN_MB="${KEEL_BACKUP_SIZE_WARN_MB:-8192}"
case "$SIZE_WARN_MB" in ''|*[!0-9]*) SIZE_WARN_MB=8192 ;; esac

PY=python3

say() { printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"; }
# What `die` last said, its first line: the reason a failed snapshot leaves in the state file
# (on_exit). Empty for a run that stopped without one (an abort under set -e).
DIED=""
die() { DIED="$*"; DIED="${DIED%%$'\n'*}"; say "ERROR: $*" >&2; exit 1; }
need_config() {
  [ -z "$ENV_ERROR" ] || die "could not read the backup settings (keel backup env): $ENV_ERROR"
}

# PORTABLE, because this runs on macOS and on Ubuntu. BSD `stat -f %m` is GNU's
# `stat -c %Y`, and GNU coreutils has sha256sum where macOS has shasum; both print the
# same `<hash>  <path>` lines, which is all the manifest reads.
mtime_of() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || date +%s; }
if command -v shasum >/dev/null 2>&1; then SHA256=(shasum -a 256); else SHA256=(sha256sum); fi
# md5: begin (tests/test_backupmd5.py reads from here to "md5: end")
# THE MD5 OF A FILE IS THE PROOF OF EVERY OBJECT THIS TOOL WRITES, so three things hold.
#
# The system's own tool is used where there is one (c-724: a run asks for a few dozen of
# these, and a Python started for each was a quarter of a slim's time), BUT ONLY ONE THAT
# PROVES ITSELF: it must give the md5 of no bytes for /dev/null, exactly. The choice is
# made once, when the tool starts (md5_of runs inside $(...), where a choice made at first
# use would be forgotten each time), and anything that fails the test leaves Python.
#
# A DIGEST IS 32 LOWER-CASE HEX CHARACTERS OR IT IS NOTHING. Whatever ran, md5_of prints
# only that; anything else prints nothing and returns 1. The file is read from stdin, so no
# tool prints or escapes its name, and one that cannot be read fails (measured on macOS
# 27, /sbin/md5: `md5 -q < file` on a file it may not read prints nothing and exits 1).
#
# TWO DIGESTS ARE THE SAME ONLY WHEN BOTH ARE DIGESTS: same_md5. An empty string equals an
# empty string, and a comparison written with = would call that proven.
MD5_EMPTY=d41d8cd98f00b204e9800998ecf8427e
is_md5() { [[ "$1" =~ ^[0-9a-f]{32}$ ]]; }
same_md5() { is_md5 "$1" && is_md5 "$2" && [ "$1" = "$2" ]; }
md5_python() { "$PY" -c 'import hashlib,sys
h = hashlib.md5()
with open(sys.argv[1], "rb") as f:
    for chunk in iter(lambda: f.read(1 << 20), b""): h.update(chunk)
print(h.hexdigest())' "$1"; }
md5_choose() {          # sets MD5_TOOL: the first system tool that proves itself, else python
  local tool sum
  for tool in "md5sum" "md5 -q" "/sbin/md5 -q"; do
    # shellcheck disable=SC2086  # the tool and its flag are two words on purpose
    sum="$( { $tool < /dev/null; } 2>/dev/null )" || continue
    if [ "${sum%% *}" = "$MD5_EMPTY" ]; then MD5_TOOL="$tool"; return 0; fi
  done
  MD5_TOOL=python
}
md5_of() {              # $1 = file; prints its md5, or nothing and returns 1
  local sum
  if [ "$MD5_TOOL" = python ]; then sum="$(md5_python "$1" 2>/dev/null)" || return 1
  else
    # shellcheck disable=SC2086
    sum="$( { $MD5_TOOL < "$1"; } 2>/dev/null )" || return 1
    sum="${sum%% *}"
  fi
  is_md5 "$sum" || return 1
  printf '%s\n' "$sum"
}
md5_choose
# md5: end

# ---------------------------------------------------------------------------
# Locking. The hourly agent, the drain's own start of an overdue run (c-750) and a hand-run
# snapshot can collide, and two runs sharing one work directory would have one of them
# publishing a set the other is mid-way through pruning.
#
# THE LOCK IS A SYMLINK WHOSE TARGET IS THE HOLDER'S PID: `ln -s <pid> <lock>`. One system
# call makes it and signs it, and it fails when anything is at the name, so there is no
# moment in which a lock exists and says nothing about whose it is. It was a directory
# with a pid file written a step later, and every hard case of the lock lived in that step
# (a lock read as nobody's while its run was a millisecond from signing it). The link
# points at nothing; it is only ever read with readlink.
#
# A DIRECTORY AT THE NAME is that older lock, left by a run of the tool as it was (across a
# deploy, live or dead). It is read as it always was, by the pid file inside it, under the
# same rules, and a stale one is broken the same way. Nothing here makes one.
#
# ONE lock for every set, not one each, because a run walks all of them. The nightly pull
# takes a second lock of its own (cmd_pull points LOCK at it and calls the same lock_take):
# it writes only the mirror, and an hourly snapshot waiting on a two-gigabyte first pull
# would be a stale backup for no reason.
# ---------------------------------------------------------------------------
pid_live() { [ "$1" -gt 0 ] 2>/dev/null && kill -0 "$1" 2>/dev/null; }
lock_there() { [ -L "$1" ] || [ -e "$1" ]; }    # a link to a pid points at nothing: -e alone says no
# Whom a lock names: its link's target, or the pid file of the older directory form.
# Anything that is not a number is 0, which names no run.
lock_owner() {
  local pid
  if [ -L "$1" ]; then pid="$(readlink "$1" 2>/dev/null || true)"
  else pid="$(cat "$1/pid" 2>/dev/null || true)"; fi
  case "$pid" in ''|*[!0-9]*) echo 0 ;; *) echo "$pid" ;; esac
}
# Make the lock name $1 (this run, or a run whose lock is being put back). 0: made, and it
# is that run's. 1: something is at the name. Any other failure leaves the name free (a full
# disk, a home that cannot be written), and that is a failed run like any other, said
# loudly: a backup that cannot lock must not pass for one that lost a race.
#
# `-n` so a link already there is never followed. It does not help when a DIRECTORY is
# there (the older lock): `ln` then succeeds by making the link INSIDE it. So a success is
# checked, and a link made inside a directory is taken back out. That touches the directory
# and so makes it look new, which matters (its age is what lets a stale one be broken), so a
# directory seen at the name is not tried at all; the check is for one that appears between.
#
# TWICE BEFORE IT IS A FAILURE. `ln` failing with the name then found free is also what a
# lock released in between looks like: a run held the name when `ln` ran and had finished
# by the time this looked. So it is tried once more, and only a second failure that again
# leaves the name free is the disk's.
lock_make() {
  local try
  for try in 1 2; do
    if [ -d "$LOCK" ] && [ ! -L "$LOCK" ]; then return 1; fi
    if ln -sn "$1" "$LOCK" 2>/dev/null; then
      if [ -L "$LOCK" ]; then return 0; fi
      rm -f "$LOCK/$1" 2>/dev/null || true
      return 1
    fi
    if lock_there "$LOCK"; then return 1; fi
  done
  die "could not make the lock $LOCK (a full disk, or $BACKUP_HOME cannot be written)"
}
# WHAT A BREAKER KILLED HALF WAY LEFT: `<lock>.stale.<its pid>`, between its rename and its
# next step. Nothing reads those, so without this they stay for good. One is removed when
# the pid in its name is no longer running and it has been there over a minute.
lock_sweep() {
  local left now=""
  for left in "$LOCK".stale.*; do
    lock_there "$left" || continue
    case "${left##*.}" in ''|*[!0-9]*) continue ;; esac
    pid_live "${left##*.}" && continue
    [ -n "$now" ] || now="$(date +%s)"
    [ $(( now - $(mtime_of "$left") )) -ge 60 ] || continue
    rm -rf "$left"
  done
  return 0
}
lock_take() {
  mkdir -p "$BACKUP_HOME"
  lock_sweep
  local try owner made age stale named
  for try in 1 2 3; do
    if lock_make "$$"; then return 0; fi
    owner="$(lock_owner "$LOCK")"; made="$(mtime_of "$LOCK")"
    # This run's own: a breaker renamed it away by mistake and has just put it back.
    if [ "$owner" = "$$" ]; then return 0; fi
    if pid_live "$owner"; then
      say "another run holds $LOCK (pid $owner); nothing to do"
      exit 0
    fi
    # Gone since the attempt (released, or renamed away by a breaker): the name is free.
    lock_there "$LOCK" || continue
    # A run killed mid-snapshot (a laptop closing, a launchd stop) leaves its lock behind,
    # and a lock nothing can break is a backup that never runs again. Two tests, and both
    # have to agree before breaking it: the owner is gone, and the lock is older than any
    # real run could be.
    age=$(( $(date +%s) - made ))
    if [ "$age" -lt 1800 ]; then
      say "lock held by a dead pid but only ${age}s old; leaving it for now"
      exit 0
    fi
    # THE BREAK IS A RENAME, because two runs can both get here: of two that judged the
    # same lock stale, only one rename finds it. `rm; make` let both take the lock.
    #
    # THE INTERLEAVINGS, walked. A and B both judged the dead run's lock X stale.
    #   A renames X; B's rename finds nothing: B stands down. One run.
    #   A renames X and makes its own lock; B, which judged X, then renames A's. The renamed
    #     lock names A, not the dead pid B judged, so B makes it again for A and stands
    #     down. In between the name is free, for milliseconds (a readlink and an ln, each a
    #     process of its own). A is unaffected: it holds
    #     its lock by having made it, and at the end removes it only if it still names A.
    #   The same, and a third run C takes the name in that gap: C holds it, B's put-back
    #     fails and B leaves it at that. A and C then both run, A with no lock at the name.
    #     THIS IS WHAT REMAINS: three runs within milliseconds of each other, two of them
    #     breaking the same stale lock. Nothing shorter than one more atomic step (a rename
    #     that tests what it renames) closes it, and the shell has none.
    #   B is killed between its rename and its put-back: the same exposure for whoever
    #     comes next while A still runs, and what B left is swept (lock_sweep).
    stale="$LOCK.stale.$$"
    rm -rf "$stale"     # a dead run's leftover under this pid; `mv` would move INTO a directory
    if ! mv "$LOCK" "$stale" 2>/dev/null; then
      say "another run broke the stale lock first; nothing to do"
      exit 0
    fi
    named="$(lock_owner "$stale")"
    if [ "$named" != "$owner" ]; then
      # Made again for the run it names, FIRST, before the renamed copy is cleared away, so
      # the name is free for as short a time as this can make it. If the name is taken by
      # now, that run has it; a lock that named nobody (0) is not made again, so it cannot
      # hold the next run. In a subshell: a put-back that cannot be made is not this run's
      # failure, and must not end it before the renamed copy is removed.
      if [ "$named" -gt 0 ]; then ( lock_make "$named" ) || true; fi
      rm -rf "$stale"
      say "another run took the lock as this one went to break it; nothing to do"
      exit 0
    fi
    rm -rf "$stale"
    say "broke a stale lock (${age}s old, pid $owner is gone)"
    if lock_make "$$"; then return 0; fi
    say "another run took the lock first; nothing to do"
    exit 0
  done
  say "the lock changed hands three times while this run tried for it; nothing to do"
  exit 0
}
# A LOCK THAT NAMES THIS RUN, AND ONLY THAT. The lock itself says whose it is, so that is
# all release asks: no flag of this run's own beside it. A flag set on the line after the
# `ln` left a TERM between the two with a lock nothing removed, a dead run's, good for
# half an hour of nothing. And a run that held the lock can find, by the time it ends,
# that the name is another run's (its own was broken while it sat frozen past the half
# hour): removing whatever is at the name then removed a live run's lock from under it.
# A directory there is the older tool's and names its own run, never this one.
lock_release() {
  if [ "$(lock_owner "$LOCK")" = "$$" ]; then rm -rf "$LOCK"; fi
  return 0
}

# Every exit path releases, including the signal ones. A handler that does not re-raise
# swallows the signal and costs launchd the ability to stop this job at all, which is the
# same rule harbor-segments-fetch documents.
TMPDIR_RUN=""
ANNOUNCE_ON_FAIL=0
RECORD_ON_FAIL=0
RECORD_VERIFY_ON_FAIL=0
# A slim holds a second lock for the whole run (see cmd_slim): the same lock, by the same
# functions, at another name, as the pull's is. It unpacks old snapshots with the modes they
# carry, and a directory one of them made read-only would outlive a bare rm, so a slim's
# work is made removable first.
#
# THIS RUN IS A SLIM when both say so: the verb was slim, and .slim-lock names this pid
# (r2.F5, r3.F6). The lock without the verb is not enough: a dead slim's stale lock names a
# pid the system hands out again, and an hourly run given that pid would have released a
# lock that was never its own. The record beside the lock is not asked: a slim that ends before its line is
# written still holds the lock, and left behind it would refuse the next slim for half an
# hour. The record decides only whether a line is taken out of it (slim_run_release).
SLIM_LOCK="$BACKUP_HOME/.slim-lock"
SLIM_MODE=0
cleanup() {
  local slim=0
  if [ "$SLIM_MODE" = 1 ] && [ "$(lock_owner "$SLIM_LOCK")" = "$$" ]; then slim=1; fi
  if [ -n "$TMPDIR_RUN" ]; then
    if [ "$slim" = 1 ]; then chmod -R u+rwX "$TMPDIR_RUN" 2>/dev/null || true; fi
    rm -rf "$TMPDIR_RUN"
  fi
  if [ "$slim" = 1 ]; then slim_run_release; fi
  lock_release
}

# THE ANNOUNCE LIVES IN THE TRAP, and it has to. `die` is an exit, so a wrapper of the
# form `cmd_snapshot || announce` never runs: the process is already gone. Every way this
# can fail (gpg missing, a full disk, a round trip that did not match, an unexpected abort
# under set -e) lands here instead, which is the difference between a backup that stops
# working loudly and one that stops working the way they usually do.
#
# THE REASON IS LEFT IN THE STATE FILE TOO (c-757), for the same reason and in the same
# place: `last_error`, with `last_error_at`. It was written on one path only, a publish
# that failed, so a run that died anywhere earlier (no gpg, a lock that could not be made,
# a store that would not list) left the setup page nothing to show, and the page showed a
# spinner. The next run that succeeds empties `last_error`.
#
# WHEN IT IS ARMED (r1.F8). RECORD_ON_FAIL is set by cmd_snapshot itself, AFTER its
# arguments are checked and BEFORE it reads the config and takes the lock: a mistyped flag
# by hand failed no backup and records nothing, while a run that cannot make its lock, or
# cannot read its settings, did fail and says why. It is unset on the line after
# `last_success` is written and its notice retired: whatever goes wrong in the sums and the status after that, the
# copy was made, and "the run stopped" must not be written over it. A signal disarms it.
# A narrowed run (`--set`) that fails still records, and one that succeeds clears nothing,
# which is the file's own rule for a narrowed run (see cmd_snapshot).
#
# THE WEEKLY PROOF HAS THE SAME RECORD (r1.F2): RECORD_VERIFY_ON_FAIL, armed by cmd_verify
# after its arguments are checked, writes `last_verify_error` and `last_verify_error_at`.
# Only two of its deaths stamped one, so a proof that died anywhere else was later shown as
# one that "did not run". Those two disarm it first: their own words are the better ones.
on_exit() {
  local rc=$?
  if [ "$rc" -ne 0 ] && [ "$RECORD_ON_FAIL" = 1 ]; then
    state_set last_error "${DIED:-the run stopped with exit $rc; its last lines are in $LOGDIR/backup.out}" \
      last_error_at "$(now_iso)" 2>/dev/null || true
  fi
  if [ "$rc" -ne 0 ] && [ "$RECORD_VERIFY_ON_FAIL" = 1 ]; then
    state_set last_verify_error "${DIED:-the proof stopped with exit $rc; its last lines are in $LOGDIR/verify.out}" \
      last_verify_error_at "$(now_iso)" 2>/dev/null || true
  fi
  if [ "$rc" -ne 0 ] && [ "$ANNOUNCE_ON_FAIL" = 1 ]; then
    announce_broken "Keel backup failed" \
      "keel backup run exited $rc on $HOST, so nothing new reached the store and anything written since the last success exists only on this machine.${DIED:+ It said: $DIED} The reason is the last lines of $LOGDIR/backup.out. This card retires itself on the next successful run."
  fi
  cleanup
}
trap 'on_exit' EXIT
# ANNOUNCE_ON_FAIL=0 first, because a signal is not a failure worth a card. Re-raising
# still runs the EXIT trap on the way out, so without this a `launchctl unload` or a
# `launchctl kickstart -k` landing mid-snapshot would stage "Keel backup failed" at the
# exact moment somebody was deliberately stopping the job. A backup alarm that fires when
# you touch the agent is one nobody reads by the second week, and the real staleness check
# still catches it if the job never comes back.
trap 'ANNOUNCE_ON_FAIL=0; RECORD_ON_FAIL=0; RECORD_VERIFY_ON_FAIL=0; cleanup; trap - INT; kill -INT $$' INT
trap 'ANNOUNCE_ON_FAIL=0; RECORD_ON_FAIL=0; RECORD_VERIFY_ON_FAIL=0; cleanup; trap - TERM; kill -TERM $$' TERM

# Idempotent on purpose. verify calls restore, and a second mktemp there would leave the
# first directory behind while the cleanup trap removed only the newest, so a weekly job
# would litter /tmp with restored copies of the very data this is trying to protect.
mktmp() {
  [ -n "$TMPDIR_RUN" ] && return 0
  TMPDIR_RUN="$(mktemp -d "${TMPDIR:-/tmp}/keel-backup.XXXXXX")"
}

# ---------------------------------------------------------------------------
# THE SETS.
#
# A set is: a root on disk, a place in the repo, a file list, a retention policy, a minimum
# interval, a canary that proves a restore unpacked the right tree, and its own alarm key.
# Everything below dispatches on the name, and every per-set fact lives in exactly one of
# these functions, because a backup whose scope is described in two places eventually backs
# up something different from what it checks.
# ---------------------------------------------------------------------------
# Keel's own two, then the install's own (`[backup] extra`, c-722, which `keel backup env`
# hands in as KEEL_BACKUP_EXTRA), and any other set this machine writes, so a config from
# before `extra` backs up, restores and pulls exactly as it did. Their per-set facts below are
# kept by name until a set can be described by the config alone.
SETS="keel code"
for _s in ${KEEL_BACKUP_EXTRA:-} $MY_SETS; do
  case " $SETS " in *" $_s "*) ;; *) SETS="$SETS $_s" ;; esac
done
unset _s

set_valid() { case " $SETS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

set_root() {            # where the live data is
  case "$1" in
    keel)   printf '%s' "$KEEL_DATA" ;;
    code)   printf '%s' "$KEEL_HOME" ;;
    harbor) printf '%s' "$HARBOR_HOME" ;;
    helm)   printf '%s' "$HELM_HOME" ;;
    *) die "unknown set: $1" ;;
  esac
}

# WHERE A SET LIVES IN THE STORE, and on this machine. Every set under sets/<name>/ in the
# store; this machine's knowledge of it under work/<name>/; the pull's copy of it under
# mirror/sets/<name>/, the store's own layout, so a mirror is a store someone could point
# `file:` at.
set_prefix() { set_valid "$1" || die "unknown set: $1"; printf 'sets/%s' "$1"; }
set_work()   { printf '%s/%s' "$WORK" "$1"; }
blob_key() {            # $1 = set, $2 = id
  printf '%s/snapshots/%s/%s/%s.tar.gz.gpg' "$(set_prefix "$1")" "${2:0:4}" "${2:4:2}" "$2"
}
writes_set() { case " $MY_SETS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

set_label() {
  case "$1" in
    keel)   printf '%s' "Keel state and segment data" ;;
    # The checkout's own history, as one git bundle. The repo has no remote, so without
    # this the snapshots restore a board that nothing can run (c-288).
    code)   printf '%s' "Keel's code (a git bundle of every branch)" ;;
    # The old engine's tree. It stopped changing at cutover, so this set costs one more
    # snapshot and then nothing, and it stays because its ledger is the only record of
    # what that system did.
    harbor) printf '%s' "Harbor runtime data (frozen at cutover)" ;;
    # The set is still called "helm" (the identifier is also the destination directory
    # name in the backup clone, sets/helm/, and renaming it would mean migrating real
    # snapshot history rather than a label) but the label stopped being about Helm's own
    # code the moment Helm retired (c-169), and about a running tool when the review
    # scanner and PR watch retired (lane RETIRE): it keeps their history, read-only.
    helm)   printf '%s' "retired PR tools' history" ;;
  esac
}

# RETENTION IS PER SET because the recovery objective is. Losing an hour of Harbor's ledger
# loses a dispatch record that nothing can rebuild, so its hourly tier is worth a week.
# Helm's set is history now: the documents in it (findings, context notes) no longer change
# at all, so hourly granularity there buys nothing and is charged for at full price: see
# set_min_interval for the arithmetic.
#
# NOT A LEVER FOR PUSH SIZE. Card c-092's size fault (99 snapshots taken 2026-09-04 through
# 2026-09-10 reaching 2.5GB) was a scope bug, not a retention bug: segments/*/data/
# filler-audio, a regenerable TTS cache, was in the harbor set and got re-archived at full
# size on every real change anywhere. Excluding it (see harbor_roots) is the fix. Tightening
# this window to force old retained snapshots out was tried and reverted: existing
# snapshots are a promise, not a knob to turn when a push is too big, and turning it costs
# real, unrecoverable history (this repo keeps exactly one commit, so a snapshot pruned
# locally and then pushed is gone from the remote too, not merely old). If the retained set
# is ever too large again for a reason retention actually addresses (real growth, not a
# scope bug), that is a decision for a human to make deliberately, not a side effect of
# chasing a push error.
# code keeps 1 day hourly and 30 daily: a bundle is 17MB against keel's 8MB, and a restore
# wants the newest one, while an older one is only ever wanted to recover a branch that
# was deleted, which a month of dailies and the monthlies cover.
#
# keel keeps 1 day hourly and 30 daily too (c-752, the owner's decision of 2026-10-12; it
# was 7 and 90, as harbor still is). This is the deliberate decision the paragraph above
# asks for, made on real growth and not on a push error. Measured on 2026-10-11: the
# store held 13.2GB and almost all of it was the last week's hourly snapshots of this
# set, 94 of them from 5 to 9 October at 10.9GB, each a full copy of about 115 to 130MB;
# everything older was 1.1GB together. At 7 and 90 the store settles at 20 to 30GB
# whatever else is done, at 1 and 30 near 7GB. A day of hourly copies keeps same-day
# recovery, which is what the hourly tier is for; past that a day's last state is the one
# a restore wants. Nothing new deletes: the next publishing run prunes by the rule it
# already has (retained_deletions), and what it drops sits in the store's trash for 30
# days where the store has one (Drive does, a directory does not).
set_hourly_days() { case "$1" in keel) echo 1 ;; code) echo 1 ;; harbor) echo 7 ;;  helm) echo 2 ;;  esac; }
set_daily_days()  { case "$1" in keel) echo 30 ;; code) echo 30 ;; harbor) echo 90 ;; helm) echo 30 ;; esac; }

# A FLOOR ON HOW OFTEN A SET IS SNAPSHOTTED, and Helm's is the reason it exists.
#
# Every one of the watcher's status files carried a `checked_at` it rewrote every few
# minutes, so the content test in point 2 could NEVER skip a Helm snapshot. The status
# cache is out of the set since the watcher retired (lane RETIRE), so the content test now
# skips an unchanged set by itself; the floor stays as the second guard. The set costs
# 1.9MB compressed per snapshot, 1.7MB of which is pr-watch/context/_assets, PR screenshots
# that never change but which gpg re-randomises on every run so git cannot dedupe them
# across snapshots, so a set that did start changing hourly would spend about 46MB a day.
#
# Harbor's floor is 0: it is small, its changes are all meaningful, and the content test
# alone is the right rule there. --force bypasses the floor, for the same reason it
# bypasses the content test.
# Keel's floor is 0 for the reason Harbor's was: the set is small, every change in it is
# a card moving or a fetcher folding something in, and losing an hour of that loses a
# record nothing rebuilds. The content test alone is the right rule here.
# Code's floor is 6 hours, like Helm's, for a different reason: every commit on any branch
# changes the bundle, and a building day commits every few minutes. Six hours of commits
# lost is six hours of work that is also still in the worktrees the commits came from.
set_min_interval() { case "$1" in keel) echo 0 ;; code) echo 21600 ;; harbor) echo 0 ;; helm) echo 21600 ;; esac; }

# A canary with a real dependency on it, so an archive that unpacks but holds the wrong
# tree still fails. Checked as parseable JSON rather than mere existence, because a
# truncated file is present too.
set_canary() {
  case "$1" in
    keel)   printf '%s' "state/board.db" ;;                    # the only state Keel has
    code)   printf '%s' "code/keel.bundle" ;;                  # the code that runs it
    harbor) printf '%s' "segments/fathom/data/index.json" ;;   # what the fathom app read first
    helm)   printf '%s' "pr-reviews/state.json" ;;             # the review history's index
  esac
}

# PARSED, NOT MERELY PRESENT, and how it is parsed depends on the set: a truncated file
# exists too, and "the archive unpacked" is not the same claim as "the archive holds the
# right tree". The board is opened and asked for its cards, which is a stronger canary
# than any file test, because a board that opens with no cards in it is exactly the
# empty-snapshot-over-a-good-one failure the rest of this file guards against.
canary_ok() {           # $1 = set, $2 = the restored canary file
  [ -f "$2" ] || return 1
  case "$1" in
    keel) "$PY" -c 'import sqlite3,sys
db = sqlite3.connect(sys.argv[1])
try: count = db.execute("select count(*) from cards").fetchone()[0]
finally: db.close()
raise SystemExit(0 if count > 0 else 1)' "$2" 2>/dev/null ;;
    # A bundle git can read, with main in it: the branch a restored host checks out.
    code) git bundle list-heads "$2" 2>/dev/null | grep -q ' refs/heads/main$' ;;
    *)    "$PY" -c 'import json,sys; json.load(open(sys.argv[1]))' "$2" 2>/dev/null ;;
  esac
}

# ---------------------------------------------------------------------------
# Scope, per set. One definition each, used by snapshot AND by verify.
#
# harbor. In: segments/*/data (all three segments), ledger/*.jsonl, ledger/reviews,
# ledger/returns, ledger/briefs.
# Out: secrets/ (credentials never leave, encrypted or not), .claude/projects (session
# transcripts, which are large, regenerated and not state), segments/*/data/coach (a live
# session's own working directory: scratch code it wrote to test a hypothesis, which is
# the same class as a transcript and grows with nothing pruning it), segments/*/data/
# filler-audio (see below), ledger/settings (see below), and the build and lock residue
# that would otherwise make every run look changed.
#
# The CONVERSATION is still in, and the distinction is the point: it is kept as
# data/coach-<item>.txt, a file rather than that directory, and it is real state because
# the note is written from it.
#
# FILLER-AUDIO IS A CACHE, NOT STATE, and it is the reason this went from a ~1MB set to a
# ~30MB one: harbor_voice.corpus.AudioCache writes pre-synthesized filler-line clips there,
# keyed by a hash of the text, and by 2026-09-10 that was 355 WAV files (32MB) that had not
# changed since 2026-09-04. Every run's manifest is one hash over every file this set
# includes, so any real change anywhere (a ledger line, a daybook thread) made the whole
# tree look changed and re-archived that 32MB of unchanged audio into a fresh, non-delta
# blob, every time. Retention keeps up to 7 days of hourly copies, so that one cache was
# multiplying itself into gigabytes: it, not the real ~17MB of state, is what pushed
# the old GitHub backup repo past the size GitHub's send-pack would accept (card c-092, queue
# notice 1108). The same regenerability test that excludes data/coach excludes this: losing
# it costs re-synthesizing a filler line the next time it is picked, once, and nothing else
# reads it.
#
# RETURNS AND BRIEFS WERE FALLING THROUGH THE GAP BETWEEN THE TWO SYSTEMS. This file was
# built on the assumption that anything git tracks is protected by git, so it covers only
# what git does not track. ledger/returns (what each dispatch said on its way out) and
# ledger/briefs (the prompt each dispatch was given) are gitignored as runtime state AND
# sat outside every root here, so they were protected by neither: sixteen return records
# and every brief lived on exactly one disk. They are not regenerable by any means. A
# return is a session's own account of what came of it, written once and never again, and
# a brief is the only record of what a dispatch was actually asked to do, which is what
# anybody re-running or explaining a piece of work reads first.
#
# ledger/settings IS DELIBERATELY LEFT OUT, and it is the one of the three that looked
# like it belonged. It is named after a real dispatch like the other two, but it holds no
# account of anything: it is a hooks file generated deterministically by `harbor-return
# settings` from the dispatch id, and it is useful only while that dispatch is alive.
# Worse, it names absolute paths on THIS machine, so restoring it onto another one is
# actively wrong in the same way restoring Helm's *.pid and *.port would be: it would
# wire hooks pointing at a home that is not there. Same test as everything else here, and
# it fails it: losing it costs nothing, because nothing reads it after the session ends.
#
# ledger/panes is out on the same test. It is a frame of a pane a failed spawn was last
# showing, kept so the failure can say what tripped it: diagnostic residue with a lifetime
# of hours, the same class as a log, and the logs are excluded everywhere in this file.
#
# ADDING A ROOT CHANGES THE MANIFEST, so the next snapshot after this legitimately
# re-encrypts and re-uploads once. That is the skip-unchanged rule in point 2 working, not
# failing.
# ---------------------------------------------------------------------------
# keel. IN: state/ (the board, every card directory, every blackboard under state/boards,
# the voice data), segments/*/data, the install's config.toml when there is one, and the
# install's own things that left the code in c-722: memory/ (Bosun's and the talker's memory,
# the talker's rulebook), identity/ (the user's profile), packs/ (the install's own packs,
# the work pack among them) and history/ (the design notes and old Atlas pages the move
# carried). Until c-722 the code set's bundle held them, because the checkout tracked them;
# once they left the tree nothing else holds a copy, so they ride here. Their `.git`
# directories stay pruned as every other, and each install repo's history rides instead as
# a git bundle, `repos/<name>.bundle` (c-725 r1.F8, keel_stage), so a restore keeps its
# commits. Also IN (r1.F6): spaces/ (a space contract of the user's own, which move-personal
# writes there) and the install's Claude memory, claude/projects/*/memory. state/boards/.trash/ is IN too: a board he deleted is
# restorable for 30 days, so it is carried until the drain purges it (keel/boardtrash.py),
# and a restore from this archive brings the trash back with it. That tree is the one irreplaceable thing on this machine: the board is
# the only store, a card directory holds the plan and the output a session wrote once, and
# the segment data is every daybook thread, every fathom note and every bill already read.
#
# OUT, each on the same test the other sets are scoped by, which is "what does losing it
# actually cost":
#   state/logs/            A log is not state, it is a record of how the state got here,
#                          and the state itself is in this archive. They also grow on
#                          every poll, so including them would make the manifest change
#                          every run and push a fresh blob each time.
#   state/worktrees/       Git worktrees of this repo. Every byte is reachable from the
#                          repo's own history, and restoring one onto another machine
#                          would plant a worktree whose gitdir pointer names a home that
#                          is not there.
#   state/drafts/          Scratch work: demo films, audio stems, prototypes. On 2026-09-28
#                          a demo-video pass put about 1.2GB of mp4 and wav here and every
#                          hourly snapshot went from 26MB to 173MB, about 4GB a day held
#                          for the 7-day hourly tier. Nothing in it is board state, and a
#                          draft worth keeping is promoted into a card or a repo.
#   a card's scratch/      state/cards/<id>/scratch, the folder and everything under it
#                          (c-752, the owner's decision of 2026-10-12). Scratch is by name
#                          the place for throwaway copies; what a card must keep belongs
#                          in its folder proper. The rule
#                          before this one dropped only a first-level directory of it
#                          that held .git, and kept the rest (r1.F7). Measured on
#                          2026-10-11, a done card (c-512) had three plain copies of a
#                          product repo's source there, with no .git, so that rule
#                          archived them every hour: 104MB of a 302MB snapshot. Only the
#                          card's own scratch/ is named: the second -path keeps a deeper
#                          directory of that name (out/scratch), since -path's * matches
#                          '/' as well.
#   node_modules/          Anywhere under the roots. A card's scratch checkout of webapp-react
#                          (c-512) carried 93k files and 418MB of it into every snapshot;
#                          `npm install` rebuilds it from the lockfile beside it.
#   *.mp4 *.mov *.webm     Video and audio, anywhere, a card's out/ included. A demo film
#   *.wav *.m4a            (c-568, 138MB) kept every box snapshot at 176MB after drafts
#                          were dropped. A recording worth keeping lives on Drive or in a
#                          repo; the hourly tier is for the board and the text around it.
#   state/fetch-locks/     Held only while a fetcher is running. A restored lock is a lock
#                          nothing will ever release.
#   state/boards/.attached/ A board file waiting between the attach that carried it and the
#                          push that names it (keel/boardfiles.py). It is pruned after an
#                          hour, and a restored one is a file nothing is ever going to push:
#                          the same class as a fetch lock. A board's own copies, under
#                          board-files/ and files/, ARE archived; they are the record.
#   human.token,           Credentials. They never leave this machine, encrypted or not,
#   artifact.key           which is the same rule that keeps ~/harbor/secrets and the
#                          scanner's .env out of the other two sets.
#   talker.pid             Names a process on THIS machine. Restoring it is worse than
#                          not restoring it.
#   merged-tests.log       Anywhere in the set, as node_modules is. A landing's whole test
#                          output, written into the card's directory (keel/merging.py,
#                          SUITE_LOG), about 0.9MB a card. A log is not state,
#                          by the rule that keeps state/logs/ out, and the card's
#                          record already says what the run decided. Measured 2026-10-06
#                          (c-594): 67MB of the 264MB a snapshot holds, re-archived every
#                          hour (c-671). Named exactly rather than as *.log: another log
#                          in a card directory may be the card's evidence, and stays IN.
#   voice/pcm/             HIS VOICE. The opt-in corpus the end-of-utterance hangover is
#                          measured on (voice/harbor_voice/record.py, c-311): recordings
#                          of him talking, kept for days and then deleted. Unlike
#                          everything else here it is excluded because of WHAT IT IS
#                          rather than what it costs. An archive is the one copy nobody
#                          goes back and deletes, so the recordings never enter one.
#   voice/cache/           The TTS clip cache, keyed by a hash of the text. Regenerable by
#                          saying the line again, and it is 32MB against about 600KB of
#                          real state, so including it would re-archive the cache in full
#                          on every real change anywhere. That is exactly the scope bug
#                          that took the old repo to 2.5GB (see the note above
#                          harbor_roots); it is not being repeated one tree along.
#   board.db, -wal, -shm   NOT because they are unwanted: the board is the most important
#                          file here. They are excluded from the SCAN because a live WAL
#                          database copied file by file is a torn read, and keel_stage
#                          below appends a consistent online-backup copy at the same path
#                          instead. A restored -wal beside a snapshot taken through the
#                          backup API would be a stale journal against a newer file.
keel_roots() {          # prints the roots that exist, one per line
  cd "$KEEL_DATA"
  local d
  if [ -d state ]; then printf '%s\n' state; fi
  # The install's own config (c-610 S1): untracked, so the code set never carries it, and a
  # restore without it would come back on the shipped defaults.
  if [ -f config.toml ]; then printf '%s\n' config.toml; fi
  for d in segments/*/data; do if [ -d "$d" ]; then printf '%s\n' "$d"; fi; done
  # The install's own things (c-722): the code no longer carries a copy of any of them.
  for d in memory identity packs history spaces claude/projects/*/memory; do
    if [ -d "$d" ] && [ ! -L "$d" ]; then printf '%s\n' "$d"; fi
  done
}

keel_find() {           # $1 = f or d, the argument to find's -type
  cd "$KEEL_DATA"
  local roots=() d
  while IFS= read -r d; do [ -n "$d" ] && roots+=("$d"); done < <(keel_roots)
  if [ ${#roots[@]} -eq 0 ]; then return 0; fi
  # The prunes name whole trees; the ! -name tests drop the individual files that are
  # secret, machine-local, superseded, or a log that is not state. `-path` rather than
  # `-name` for the pruned trees,
  # for the reason written above harbor_file_list: a basename prune would drop any
  # directory that ever shares the name, anywhere, silently.
  find "${roots[@]}" \
    \( -path 'state/logs' -o -path 'state/worktrees' -o -path 'state/fetch-locks' \
       -o -path 'state/drafts' -o -name 'node_modules' \
       -o \( -path 'state/cards/*/scratch' ! -path 'state/cards/*/*/scratch' -type d \) \
       -o -iname '*.mp4' -o -iname '*.mov' -o -iname '*.webm' -o -iname '*.wav' -o -iname '*.m4a' \
       -o -path 'state/boards/.attached' \
       -o -path 'state/voice/cache' -o -path 'state/voice/pcm' \
       -o -name '__pycache__' -o -name '.venv' \
       -o -name '*.lock' -o -name '.*.lock' -o -name '.git' \) -prune -o \
    -type "$1" ! -name '.DS_Store' ! -name '.tmp-*' \
         ! -name 'human.token' ! -name 'artifact.key' ! -name 'talker.pid' \
         ! -name 'merged-tests.log' \
         ! -name 'board.db' ! -name 'board.db-wal' ! -name 'board.db-shm' -print0
}
keel_file_list() { keel_find f; }
keel_dir_list()  { keel_find d; }

# WHAT CANNOT SIMPLY BE READ OFF THE LIVE TREE. The board is a WAL SQLite file that the
# drain, the deck and the talker all write to, so copying it file by file mid-run is a
# torn read and the one file here that must never be one. sqlite3's own online backup API
# gives a consistent copy of a database being written to, so the snapshot is taken through
# it and appended to the archive at the path the live file has. Appending to an
# uncompressed tar is why the archive is gzipped as a second step in snapshot_set.
keel_stage() {          # $1 = the tar being built
  local db="$KEEL_STATE/board.db" stage="$TMPDIR_RUN/keel-stage"
  # NO BOARD IS NOT A QUIET HOUR once the set has history: a snapshot without it published
  # over good ones is the empty-snapshot failure again, one file wide (c-622). A config
  # whose state dir holds no board yet, on a set the store already has, is refused.
  if [ ! -f "$db" ]; then
    [ "$(set_count keel)" -eq 0 ] || return 1
    return 0
  fi
  rm -rf "$stage"; mkdir -p "$stage/state"
  "$PY" - "$db" "$stage/state/board.db" <<'PY' || return 1
import sqlite3, sys
source = sqlite3.connect("file:%s?mode=ro" % sys.argv[1], uri=True)
target = sqlite3.connect(sys.argv[2])
try:
    with target:
        source.backup(target)
finally:
    target.close()
    source.close()
PY
  # The board's own append fails the stage (c-725 r3.F1): repos_stage after it always
  # returns 0, so without the `|| return 1` a snapshot missing its board would be published.
  tar -rf "$1" -C "$stage" state/board.db || return 1
  repos_stage "$1"
}

# THE INSTALL'S OWN REPOS' HISTORY (c-725 r1.F8). memory/ and packs/ are git repos the builder
# builds on, and their .git is pruned from the file list like every other, so each rides as
# a bundle of its branches beside its files: repos/<name>.bundle. Rebuilt only when a ref
# moved, cached under work/keel/ as the code set's is, so a quiet hour stages the same
# bytes. A repo with no commit yet has nothing to bundle. A restore keeps the history
# (docs/atlas/86-restore.md: clone the bundle aside, move its .git in, then git status).
#
# A BUNDLE THAT FAILS NEVER STOPS THE BOARD (c-725 r2.F6). The board is the set's one
# irreplaceable file; a git problem in a memory repo says so in one line and the snapshot
# carries on, its files archived and that repo's history not, this hour.
KEEL_REPOS="memory packs"       # read by repos_stage, and by set_staged for the paths they ride at
repos_stage() {         # $1 = the tar being built
  local name stage="$TMPDIR_RUN/keel-repos"
  rm -rf "$stage"; mkdir -p "$stage/repos"
  for name in $KEEL_REPOS; do
    [ -d "$KEEL_DATA/$name/.git" ] || continue
    git -C "$KEEL_DATA/$name" rev-parse --verify --quiet HEAD >/dev/null || continue
    repo_bundle "$1" "$name" "$stage" ||
      say "[keel] could not bundle the history of $name/; its files are archived, its history is not in this snapshot" >&2
  done
  return 0
}

repo_bundle() {         # $1 = the tar, $2 = the repo's name, $3 = the stage
  local repo="$KEEL_DATA/$2" cache refs digest
  cache="$(set_work keel)/bundles"; mkdir -p "$cache" || return 1
  refs="$(git -C "$repo" for-each-ref --format='%(objectname) %(refname)' refs/heads refs/tags)" || return 1
  digest="$(printf '%s\n' "$refs" | "${SHA256[@]}" | cut -d' ' -f1)"
  if [ ! -s "$cache/$2.bundle" ] || [ "$(cat "$cache/$2.sha256" 2>/dev/null)" != "$digest" ]; then
    rm -f "$cache/$2.bundle.part" || return 1
    git -C "$repo" bundle create -q "$cache/$2.bundle.part" --branches --tags || return 1
    mv -f "$cache/$2.bundle.part" "$cache/$2.bundle" || return 1
    printf '%s\n' "$digest" > "$cache/$2.sha256"
  fi
  cp "$cache/$2.bundle" "$3/repos/$2.bundle" && tar -rf "$1" -C "$3" "repos/$2.bundle"
}

# code. IN: one file, code/keel.bundle, a `git bundle` of every local branch and tag of the
# checkout at $KEEL_HOME. Nothing is read off the tree itself: the working tree is what
# the bundle's main checks out to, and anything uncommitted is not code yet.
#
# BUILT ONLY WHEN A REF MOVED. The bundle is rebuilt when the list of refs and the commits
# they name changes, and reused byte for byte otherwise, so the plaintext change test in
# point 2 sees an unchanged file on a quiet hour rather than trusting git to write the same
# pack twice. The copy lives under work/code/, outside every checkout (point 1).
#
# A home that is not a git checkout has no code to back up (the selftest's fabricated
# trees, a box before `ship`), and the empty-manifest rule in snapshot_set decides what
# that means: nothing yet, or loud if the store already holds code.
code_stage() {          # $1 = the tar being built
  [ -e "$KEEL_HOME/.git" ] || return 0
  local cache stage refs digest
  cache="$(set_work code)/bundle"; stage="$TMPDIR_RUN/code-stage"
  mkdir -p "$cache"
  refs="$(git -C "$KEEL_HOME" for-each-ref --format='%(objectname) %(refname)' refs/heads refs/tags)" || return 1
  digest="$(printf '%s\n' "$refs" | "${SHA256[@]}" | cut -d' ' -f1)"
  if [ ! -s "$cache/keel.bundle" ] || [ "$(cat "$cache/refs.sha256" 2>/dev/null)" != "$digest" ]; then
    rm -f "$cache/keel.bundle.part"
    git -C "$KEEL_HOME" bundle create -q "$cache/keel.bundle.part" --branches --tags || return 1
    mv -f "$cache/keel.bundle.part" "$cache/keel.bundle"
    printf '%s\n' "$digest" > "$cache/refs.sha256"
  fi
  rm -rf "$stage"; mkdir -p "$stage/code"
  cp "$cache/keel.bundle" "$stage/code/keel.bundle"
  tar -rf "$1" -C "$stage" code/keel.bundle
}

# The hook for what cannot be read off a tree file by file: keel's board, code's bundle.
set_stage() {           # $1 = set, $2 = the tar being built
  case "$1" in
    keel) keel_stage "$2" ;;
    code) code_stage "$2" ;;
    *) return 0 ;;
  esac
}

# What a set stages, by the path each has in the archive, one per line. `slim` keeps these
# by name (c-724 r2.F12): the scan does not list them, so a staged path under a root the
# scan walks would otherwise read as something a rule had dropped. A path added to a stage
# above is added here.
set_staged() {          # $1 = set
  local name
  case "$1" in
    keel) printf '%s\n' state/board.db; for name in $KEEL_REPOS; do printf 'repos/%s.bundle\n' "$name"; done ;;
    code) printf '%s\n' code/keel.bundle ;;
    *) : ;;
  esac
}

harbor_roots() {        # prints the roots that exist, one per line
  cd "$HARBOR_HOME"
  local d
  for d in segments/*/data; do if [ -d "$d" ]; then printf '%s\n' "$d"; fi; done
  # Each guarded by -d, so a fresh clone with no dispatch history behind it backs up what
  # exists rather than failing on a directory nothing has created yet.
  for d in ledger/reviews ledger/returns ledger/briefs; do
    if [ -d "$d" ]; then printf '%s\n' "$d"; fi
  done
}

harbor_file_list() {    # NUL-separated, relative to $HARBOR_HOME, stable order
  cd "$HARBOR_HOME"
  local roots=() d
  while IFS= read -r d; do [ -n "$d" ] && roots+=("$d"); done < <(harbor_roots)
  # ledger/*.jsonl are files rather than a tree, so they are listed directly. The glob
  # cannot match the queue's lock or its atomic-rename temp: those are queue.jsonl.lock
  # and queue.jsonl.<pid>, and neither ends in .jsonl.
  local f
  for f in ledger/*.jsonl; do if [ -f "$f" ]; then printf '%s\0' "$f"; fi; done
  if [ ${#roots[@]} -eq 0 ]; then return 0; fi
  # `-path */data/coach`, not `-name coach`, and the difference is worth the extra
  # characters: a basename prune drops any directory called coach at any depth under any
  # segment, so a segment that one day keeps something legitimate under that name loses it
  # from every backup silently. This names the one directory meant. Raised in review.
  # `-path */data/filler-audio` is the same argument for the same reason: a cache, named
  # once, not a basename that could collide. See the note above harbor_roots.
  #
  # `! -name '.tmp-*'` (below, alongside .DS_Store) matters now that a tar read error is
  # fatal (card c-092 review round 2): harbor-live-status and harbor_voice/bus.py both
  # write into segments/*/data via `tempfile.mkstemp(prefix=".tmp-")` then `os.replace()`,
  # which is correctly atomic for THEM but means a `.tmp-*` file this scan lists can be
  # renamed away before tar gets to read it. Without this exclusion that race would turn
  # an ordinary atomic write into a hard snapshot failure, which is the exact flaky-hourly
  # symptom this card exists to remove, just relocated rather than fixed.
  find "${roots[@]}" \
    \( -name '__pycache__' -o -name '.venv' -o -name '.node' -o -path '*/data/coach' \
       -o -path '*/data/filler-audio' \
       -o -name '*.lock' -o -name '.*.lock' -o -name '.git' \) -prune -o \
    -type f ! -name '.DS_Store' ! -name '.tmp-*' -print0
}

# THE DIRECTORIES TOO, and only for the archive. A tar built from a list of files alone
# records no empty directory, so the first restore of the live data came back missing
# data/asks/ and data/inbox/ in three segments. Nothing was lost (they were empty) but
# they are not decoration: segments/README.md makes data/asks/ where a fetcher writes an
# ask and data/inbox/ the ONE door model output comes back through, so restoring onto a
# clean machine would leave the worker with nowhere to put an answer.
#
# Deliberately absent from the manifest, which stays content-only: creating an empty
# directory is then not by itself a reason to spend a snapshot, and the next real change
# carries it. The alternative, a manifest that changes when a lock directory blinks in
# and out, would defeat the whole skip-unchanged rule in point 2.
harbor_dir_list() {
  cd "$HARBOR_HOME"
  local roots=() d
  while IFS= read -r d; do [ -n "$d" ] && roots+=("$d"); done < <(harbor_roots)
  if [ ${#roots[@]} -eq 0 ]; then return 0; fi
  # Same prune list as the file list above, the coach and filler-audio trees included:
  # the two have to agree, or the archive would carry an empty directory for a tree whose
  # contents are deliberately not backed up.
  find "${roots[@]}" \
    \( -name '__pycache__' -o -name '.venv' -o -name '.node' -o -path '*/data/coach' \
       -o -path '*/data/filler-audio' \
       -o -name '*.lock' -o -name '.*.lock' -o -name '.git' \) -prune -o \
    -type d -print0
}

# helm (the set keeps its name; see set_label()'s comment for why). In: pr-reviews entire
# (the retired review scanner's state file, every finding, every orientation note) and
# pr-watch/context entire (every PR context note, _archived/ and the _assets/ screenshots
# the notes embed). Those are the parts of the two directories ~/.claude/.gitignore
# excludes from the claude-config repo that are worth keeping: HISTORY, read-only, which
# older cards link into (the config's artifact_roots serves them). Out since lane RETIRE:
# the rest of pr-watch (its watchlist, its status cache, its model choice), the retired
# watcher's own state, which nothing reads any more.
#
# Out, and each for its own reason:
#   .env, *.env   Four live Slack webhook URLs. Credentials never leave this machine,
#                 encrypted or not. This is the same rule that keeps ~/harbor/secrets out
#                 of the other set, and it is the one exclusion here that is a hard rule
#                 rather than a judgement about cost.
#   *.log         helm.log alone is 2MB and is appended to on every scan, so including
#                 logs would make the manifest change on essentially every run and push a
#                 fresh multi-megabyte blob every time. A log is also not state: it is a
#                 record of how the state got to where it is, and the state itself is here.
#   *.pid, *.port These name a process and a port on THIS machine. Restoring them onto
#                 another one is worse than not restoring them, because Helm would read a
#                 pid and a port that belong to nothing.
#   *.lock        Held only while something is running. A restored lock is a lock nothing
#                 will ever release.
#   the usual residue (__pycache__, .venv, node_modules, .git, .DS_Store), same as above.
HELM_ROOTS="pr-reviews pr-watch/context"

helm_find() {           # $1 = f or d, the argument to find's -type
  cd "$HELM_HOME"
  local roots=() d
  for d in $HELM_ROOTS; do if [ -d "$d" ]; then roots+=("$d"); fi; done
  if [ ${#roots[@]} -eq 0 ]; then return 0; fi
  # The prunes come first so a lock DIRECTORY is not descended into; the ! -name tests
  # then drop the individual files that are secret, noisy or machine-local.
  #
  # helm-sessions is pruned too now (c-169): it held the old inbox command's tmux bridge's
  # session-state files, and that capability was dropped when Helm's dashboard retired
  # rather than ported, so nothing writes there anymore. The rest of pr-reviews/ is kept
  # whole as the retired scanner's history, its overlay and dismiss files included.
  find "${roots[@]}" \
    \( -name '__pycache__' -o -name '.venv' -o -name 'node_modules' \
       -o -name 'helm-sessions' \
       -o -name '*.lock' -o -name '.*.lock' -o -name '.git' \) -prune -o \
    -type "$1" ! -name '.DS_Store' ! -name '.env' ! -name '*.env' \
         ! -name '*.log' ! -name '*.pid' ! -name '*.port' -print0
}
helm_file_list() { helm_find f; }
helm_dir_list()  { helm_find d; }

# code lists nothing off the tree: its one file is staged (code_stage).
set_file_list() { case "$1" in keel) keel_file_list ;; harbor) harbor_file_list ;; helm) helm_file_list ;; code) : ;; esac; }
set_dir_list()  { case "$1" in keel) keel_dir_list  ;; harbor) harbor_dir_list  ;; helm) helm_dir_list  ;; code) : ;; esac; }
# The roots a set's lists walk, one per line, and the text of the find that leaves things
# out under them. Both are for `slim`, which runs the lists above over an unpacked snapshot
# and names what they left out by the rule as it is written here: a path under none of
# the roots is named by no rule, and a set with no find leaves nothing out.
set_roots() {
  local d
  case "$1" in
    keel) keel_roots ;;
    harbor) harbor_roots ;;
    helm) cd "$HELM_HOME"; for d in $HELM_ROOTS; do if [ -d "$d" ]; then printf '%s\n' "$d"; fi; done ;;
    code) : ;;
  esac
}
set_rules() { case "$1" in keel) declare -f keel_find ;; harbor) declare -f harbor_file_list ;; helm) declare -f helm_find ;; code) : ;; esac; }
# EVERYTHING THAT DECIDES WHAT A SLIM DROPS, as text, for the digest an approval is held to
# (c-724 r2.F2): the find, and also the functions that say where it walks and what it
# lists, the staged paths kept by name, and the canary. A change to any of them between
# the dry run and the rewrite is a change of rules.
# AS THE FILE WRITES THEM, NOT AS A BASH PRINTS THEM BACK (r3.F7). `declare -f` is one
# bash's own rendering of a function, so the digest would follow whichever bash PATH
# finds, and a different one would turn every slimmed snapshot into one "slimmed under
# older rules", fetched and read again. fn_source reads each function out of this file:
# from the line that opens it to the line that is its closing brace.
fn_source() {           # $1.. = function names; a name the file does not define fails
  local name
  for name in "$@"; do
    awk -v n="$name" '
      function opens() { return index($0, n "()") == 1 && substr($0, length(n) + 3) ~ /^[ \t]*\{/ }
      !on && opens() { on = 1; found = 1 }
      on { print }
      on && ($0 == "}" || (opens() && $0 ~ /}[ \t]*$/)) { on = 0 }
      END { exit !found }' "$SELF_FILE" || return 1
  done
}
set_decides() {         # $1 = set
  case "$1" in
    keel) fn_source keel_find keel_roots keel_file_list keel_dir_list || return 1 ;;
    harbor) fn_source harbor_file_list harbor_roots harbor_dir_list || return 1 ;;
    helm) fn_source helm_find helm_file_list helm_dir_list || return 1; printf 'HELM_ROOTS=%s\n' "$HELM_ROOTS" ;;
    *) : ;;
  esac
  fn_source set_roots set_file_list set_dir_list set_staged || return 1
  printf 'staged=%s\n' "$(set_staged "$1" | tr '\n' ' ')"
  printf 'canary=%s\n' "$(set_canary "$1")"
}

# The manifest is `<sha256>  <path>` per file, sorted by path under LC_ALL=C. Its own
# digest is the change test from point 2 in the header. Deliberately content only: a
# chmod with no edit does not trigger a snapshot, which is the right trade for data that
# is entirely JSON and markdown written by fetchers.
#
# RETURNS rather than dies on an empty result, and the caller decides. The old version was
# always fatal, which was right when there was one set that always had data; with a second
# set it would mean a machine that has never run Helm cannot back up Harbor either. The
# dangerous case (a set that HAD data and now has none) is still fatal, in snapshot_set,
# where the prior snapshots are visible.
# TAKEN FROM THE ARCHIVE, NOT FROM A SECOND READ OF THE LIVE TREE. An earlier version
# hashed $root directly here, once before the tar was built and once (as the round-trip
# check) after it, and those were two separate reads of a live, actively-written tree
# with real time between them. Anything the ledger or a fetcher wrote in that window
# (a queue entry, a dispatch record) made the archive disagree with a manifest that was
# already stale by the time snapshot_set compared them, and refusing to commit on that
# disagreement was the guard working correctly against a false signal. That race, not
# corruption, was what had been failing roughly hourly: the fix is to hash the exact
# bytes that went into the archive, by extracting it, rather than to hash $root a second
# time. See snapshot_set for where this is called.
manifest() {            # $1 = raw archive (.tar.gz), $2 = output path, $3 = set (for the die message). 1 if it has no files.
  local raw="$1" out="$2" s="${3:-?}" extract list
  extract="$TMPDIR_RUN/manifest-extract"
  rm -rf "$extract"; mkdir -p "$extract"
  # CHECKED, NOT TRUSTED. The round trip now compares against a manifest taken from THIS
  # extraction rather than from an independent read of the live tree (see the note above
  # this function), so this extraction succeeding is the only thing standing between a
  # truncated archive and a manifest that quietly describes the truncation as correct.
  # errexit does not cover it: manifest is always called as `if ! manifest ...`, and bash
  # suspends -e for the whole body of a function invoked as an if/while condition. Flagged
  # in review round 1 on card c-092, against exactly this failure mode: tar hits a read
  # error on one real file (EIO, a permission change mid-run), exits non-zero, and without
  # this check would leave a short-but-valid gzip stream that this function would have
  # happily hashed and called complete.
  gzip -dc "$raw" | tar -xf - -C "$extract" \
    || die "[$s] the archive does not decompress and extract cleanly; refusing to treat a possibly truncated tree as the source of truth"
  list="$out.list"
  ( cd "$extract" && LC_ALL=C find . -type f -print0 ) > "$list"
  : > "$out"
  # The list goes to a file first so its emptiness can be tested BEFORE xargs sees it.
  # BSD xargs runs the utility once even with no input, so an empty list would have run
  # `shasum -a 256` with no arguments, which reads stdin, finds the drained pipe at EOF and
  # writes the hash of nothing as `<sha>  -`. That is a one-line manifest of a file that
  # does not exist, and it would have looked like a set with data in it.
  [ -s "$list" ] || { rm -rf "$extract"; return 1; }
  ( cd "$extract" && LC_ALL=C sort -z < "$list" | xargs -0 "${SHA256[@]}" ) \
    | sed 's|  \./|  |' | LC_ALL=C sort -k2 > "$out"
  rm -rf "$extract"
  [ -s "$out" ]
}

# THE DIAGNOSTIC KEPT REGARDLESS OF CAUSE. A round-trip mismatch used to say only that
# the two manifests differed, which is why a day of hourly failures went by with nobody
# able to act on it: the fix above removes the race that was causing them, but it does
# not remove the value of saying what actually differs the next time this fires for a
# real reason (disk corruption, a gpg problem). Classifies by path: present in one
# manifest but not the other, or present in both with a different hash.
report_manifest_diff() {  # $1 = expected (source) manifest, $2 = actual (round-trip) manifest
  "$PY" - "$1" "$2" <<'PY'
import sys

def load(path):
    d = {}
    for line in open(path):
        line = line.rstrip("\n")
        if not line:
            continue
        h, p = line.split("  ", 1)
        d[p] = h
    return d

expected, actual = load(sys.argv[1]), load(sys.argv[2])
missing = sorted(set(expected) - set(actual))
extra = sorted(set(actual) - set(expected))
changed = sorted(p for p in (set(expected) & set(actual)) if expected[p] != actual[p])

def show(label, paths):
    print("  %s: %d file(s)" % (label, len(paths)))
    for p in paths[:25]:
        print("    %s" % p)
    if len(paths) > 25:
        print("    ... and %d more" % (len(paths) - 25))

if missing:
    show("in the source but missing from the round trip", missing)
if extra:
    show("in the round trip but not in the source", extra)
if changed:
    show("present in both but with different content", changed)
if not (missing or extra or changed):
    print("  the manifests differ but no path-level difference was found (a formatting or ordering issue in the manifests themselves)")
PY
}
digest_of() { "${SHA256[@]}" < "$1" | cut -d' ' -f1; }

# ---------------------------------------------------------------------------
# The keys. keel and harbor share one passphrase; helm has its own, which exists on the
# Mac only (see the note above the sets for why the key and not the store is the boundary).
# ---------------------------------------------------------------------------
set_keyfile() { case "$1" in helm) printf '%s' "$HELM_KEYFILE" ;; *) printf '%s' "$KEYFILE" ;; esac; }
key_card()    { case "$1" in helm) printf 'backup-passphrase-helm' ;; *) printf 'backup-passphrase' ;; esac; }
# What a NEW key is saved as in the password manager (c-729: named for the product, as the
# install's units are). A key saved before that is under its old name, which `key_was`
# says too wherever the user is asked to find one.
key_name()    { case "$1" in helm) printf 'Keel backup passphrase (helm set)' ;; *) printf 'Shipyard backup passphrase' ;; esac; }
key_was()     { case "$1" in helm) printf '"%s"' "$(key_name helm)" ;; *) printf '"%s", or "Keel backup passphrase" for a key saved before c-729' "$(key_name "$1")" ;; esac; }

# $1 = set, $2 = "yes" when the store already holds snapshots of it (the caller listed it).
ensure_key() {
  local s="$1" history="$2" kf
  kf="$(set_keyfile "$s")"
  if [ -s "$kf" ]; then chmod 600 "$kf"; return 0; fi

  # THE DANGEROUS CASE, and the reason this is not just a file test. A missing keyfile
  # beside an existing history means the key was LOST, not that this is a fresh install.
  # Generating a new one there would succeed, upload happily, and leave every earlier
  # snapshot permanently unreadable while the dashboard said the backup was healthy.
  if [ "$history" = yes ]; then
    die "$kf is missing but the store already holds $s snapshots.
  Refusing to generate a new passphrase: the existing snapshots would become unreadable.
  Put the passphrase from your password manager ($(key_was "$s")) back at $kf
  (mode 600), or if it is genuinely gone, delete that set from the store and start over knowingly."
  fi

  mkdir -p "$(dirname "$kf")"
  ( umask 077; openssl rand -base64 48 | tr -d '\n' > "$kf" )
  chmod 600 "$kf"
  say "generated a new AES256 passphrase at $kf"

  # Point 4 in the header. This is the single most important side effect in the file, so
  # a failure here is fatal rather than a warning: a key that never reached a human is
  # the same as no backup at all, and finding that out during a restore is finding out
  # too late. It is staged, not printed, because prose in a service log reaches nobody.
  #
  # WHERE THE PASSPHRASE ENDS UP, so nobody discovers it later and assumes it was an
  # accident. Staging it puts the string in the card's brief on the board, and the deck
  # and the talker both read briefs: while this card is pending, the passphrase is in
  # Keel's context. That is the cost of the card, and the card is still right, because a
  # key that exists only on the disk being backed up protects nothing.
  queue add "Put the $(key_name "$s") in your password manager" \
    --kind notice --key "$(key_card "$s")" --replace \
    --why "$(cat "$kf")

That string is the AES256 passphrase for the $s set's snapshots$([ "$s" = helm ] || printf ' (and every set but helm)'). It exists in exactly
two places right now: this card, and $kf on this machine. If this machine dies before you
copy it, those snapshots are unrecoverable, permanently. There is no recovery path and no
reset. Copy it into your password manager as \"$(key_name "$s")\" now, then tick this off." \
    || die "could not stage the passphrase on the board, and a key nobody has is not a
  key. The passphrase is at $kf; get it off this machine before trusting any of this."
}

gpg_enc() {             # $1 = keyfile; stdin -> $2
  # --pinentry-mode loopback is required, not stylistic: under launchd or systemd there
  # is no tty and no agent to prompt, and without it gpg fails with "Inappropriate ioctl
  # for device" on every scheduled run while working perfectly by hand. --compress-algo
  # none because the input is already gzipped, and compressing twice costs time for nothing.
  gpg --batch --yes --quiet --no-tty --pinentry-mode loopback \
      --symmetric --cipher-algo AES256 \
      --s2k-mode 3 --s2k-digest-algo SHA512 --s2k-count 65011712 \
      --compress-algo none --passphrase-file "$1" -o "$2"
}
gpg_dec() {             # $1 = keyfile, $2 -> stdout
  gpg --batch --quiet --no-tty --pinentry-mode loopback \
      --passphrase-file "$1" --decrypt "$2"
}

# ---------------------------------------------------------------------------
# State. Timing lives here; the CONTENT digest lives in each set's latest.json in the repo
# instead, so that losing this file costs a duplicate snapshot rather than the ability to
# tell whether anything changed.
# ---------------------------------------------------------------------------
state_get() {           # $1 = key, prints value or empty
  [ -f "$STATE" ] || { echo ""; return 0; }
  "$PY" -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get(sys.argv[2],"") or "")
except Exception: print("")' "$STATE" "$1"
}
# ONE WRITER AT A TIME (c-757 r1.F8). This reads the file, changes it and writes it back,
# and its callers do not share a lock: a snapshot holds .lock, a pull .pull-lock, the weekly
# verify none, and a run that dies before its lock writes its reason from the exit trap. Two
# of them at once each read the old file and the later write lost the other's key. So the
# whole read-change-write holds an flock on a file beside the state file. Never the state
# file itself: it is replaced by rename, and a lock on a replaced file locks nothing.
state_set() {           # key value [key value ...]
  mkdir -p "$BACKUP_HOME"
  "$PY" - "$STATE" "$@" <<'PY'
import fcntl, json, os, sys
path, args = sys.argv[1], sys.argv[2:]
held = open(path + ".lock", "w")
try:
    fcntl.flock(held, fcntl.LOCK_EX)    # released when this process ends
except OSError:
    # A filesystem that refuses flock (some network homes). The record is worth more than
    # the lock: it is written unlocked, as every record was before c-757 (fc.D4).
    pass
try:
    d = json.load(open(path))
except Exception:
    d = {}
for i in range(0, len(args), 2):
    d[args[i]] = args[i + 1]
tmp = path + ".tmp"
open(tmp, "w").write(json.dumps(d, indent=2, sort_keys=True) + "\n")
os.replace(tmp, path)     # atomic: a run killed here leaves the old state, never half of one
PY
}
now_iso() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
age_seconds() {         # $1 = iso8601 Z, prints seconds or empty
  [ -n "$1" ] || { echo ""; return 0; }
  "$PY" -c 'import sys,datetime
try:
    t=datetime.datetime.strptime(sys.argv[1],"%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    print(int((datetime.datetime.now(datetime.timezone.utc)-t).total_seconds()))
except Exception: print("")' "$1"
}
# Snapshot ids are the same instant in a denser spelling (20260812T035733Z), so they go
# through the same parser rather than a second one that could disagree with it.
id_to_iso() {           # $1 = snapshot id
  local i="$1"
  [ ${#i} -eq 16 ] || { echo ""; return 0; }
  printf '%s-%s-%sT%s:%s:%sZ' "${i:0:4}" "${i:4:2}" "${i:6:2}" "${i:9:2}" "${i:11:2}" "${i:13:2}"
}
human_age() {           # $1 = seconds
  [ -n "$1" ] || { echo "never"; return 0; }
  "$PY" -c 'import sys
s=int(sys.argv[1])
print("%dm ago"%(s//60) if s<5400 else "%dh ago"%(s//3600) if s<172800 else "%dd ago"%(s//86400))' "$1"
}

# ---------------------------------------------------------------------------
# The loud part. One key, always replaced, so eight failed runs overnight leave one card
# rather than eight identical ones. Nothing here is an approval: there is no decision to
# make, only something to know, which is exactly what `--kind notice` is for.
#
# STALENESS IS ONE ALARM FOR THE WHOLE RUN, not one per set, and that is not the same
# oversight as the one below. Every set is snapshotted by one process and reaches the
# remote in one push, so the run is atomic: if it fails, no set is fresh. A per-set
# staleness card would be two cards saying the same sentence about the same failure.
# ---------------------------------------------------------------------------
# A NOTICE IS A CARD. `queue add <what> --key K --replace --why W` upserts the open card
# carrying options.notice_key=K; `queue close K` stages it done. "Open" is any stage but
# done, so a notice already tapped away stays away and a re-raise makes a new card rather
# than resurrecting the answered one. The verbs and the exit codes are the retired queue's,
# because every call site below reads them: 0 did it, 5 nothing open under that key, which
# is the ordinary answer and not a failure.
queue() {
  local verb="${1:-}"; shift || true
  [ -x "$KB" ] || return 0
  local what="" key="" why="" replace=0
  case "$verb" in
    add)   what="${1:-}"; shift || true ;;
    close) key="${1:-}"; shift || true ;;
    *) return 1 ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --key) key="${2:-}"; shift 2 ;;
      --why) why="${2:-}"; shift 2 ;;
      --replace) replace=1; shift ;;
      --kind|--summary|--by-hand) shift 2 ;;
      *) shift ;;
    esac
  done
  local existing
  existing="$("$KB" list --topic "$NOTICE_TOPIC" --json 2>/dev/null \
    | "$PY" -c 'import json,sys
try: cards = json.load(sys.stdin)
except Exception: cards = []
key = sys.argv[1]
for card in cards:
    if card.get("stage") != "done" and (card.get("options") or {}).get("notice_key") == key:
        print(card.get("id") or ""); break' "$key")" || existing=""
  if [ "$verb" = close ]; then
    [ -n "$existing" ] || return 5
    # What the board said goes to stderr, the log: a close refused here was swallowed for
    # as long as the board allowed done only from review, and no notice ever retired (J-1).
    local said code=0
    said="$("$KB" stage "$existing" done 2>&1 >/dev/null)" || code=$?
    [ "$code" = 0 ] || printf '%s\n' "$said" >&2
    return "$code"
  fi
  if [ -n "$existing" ]; then
    [ "$replace" = 1 ] || return 0
    "$KB" set "$existing" "title=$what" "brief=$why" >/dev/null 2>&1
    return $?
  fi
  "$KB" create --space "$NOTICE_SPACE" --title "$what" --brief "$why" \
        --autonomy attended --topic "$NOTICE_TOPIC" --option "notice_key=$key" >/dev/null 2>&1
}

# Retire the notice under $1. 5 (nothing open under the key) is the ordinary answer; any
# other failure is said, never swallowed, so a notice that will not retire is in the log.
close_notice() {        # $1 = key
  [ -x "$KB" ] || return 0
  local code=0
  queue close "$1" || code=$?
  [ "$code" = 0 ] || [ "$code" = 5 ] || say "could not close the $1 notice (board exit $code)"
  return 0
}

announce_broken() {     # $1 = one-line what, $2 = the detail
  [ -x "$KB" ] || return 0
  queue add "$1" --kind notice --key backup-stale --replace --why "$2" \
    || say "could not stage the backup-stale notice (board exit $?)"
}
clear_broken() {
  close_notice backup-stale
}

# SEPARATE KEYS, AND THEY HAVE TO BE SEPARATE.
#
# These say completely different things. backup-stale means new data is not reaching the
# remote. backup-unreadable means what is already there cannot be read back, which is
# strictly worse and is not fixed by anything the hourly job does.
#
# They shared a key in the first version of this file, and that was a bug of exactly the
# kind the header claims to guard against: a weekly verify failing at 04:30 on Sunday
# staged the card, and the 05:00 snapshot succeeded (it would, nothing is wrong with
# taking snapshots) and closed it. The one alarm that says the backups are unreadable
# would have retired itself within the hour, every time, and the more reliably the hourly
# job worked the faster it would have erased it. Only a passing verify clears it.
#
# THE SAME ARGUMENT APPLIES BETWEEN THE SETS, which is why the key carries the set name.
# Harbor's set being readable says nothing whatsoever about Helm's, so a single
# backup-unreadable key would have a passing Harbor restore retire the card that says
# Helm's review history cannot be decrypted. Harbor keeps the bare key it has always had
# so that a card staged by the older version is still the card this version retires.
unreadable_key() { case "$1" in harbor) printf 'backup-unreadable' ;; *) printf 'backup-unreadable-%s' "$1" ;; esac; }
announce_unreadable() { # $1 = set, $2 = one-line what, $3 = the detail
  [ -x "$KB" ] || return 0
  queue add "$2" --kind notice --key "$(unreadable_key "$1")" --replace --why "$3" \
    || say "could not stage the $(unreadable_key "$1") notice (board exit $?)"
}
clear_unreadable() {    # $1 = set
  close_notice "$(unreadable_key "$1")"
}

# A THIRD KEY, for the third thing that can be wrong. "The repo is public" is not "a set
# cannot be read": it is about the whole remote, it is true or false independently of any
# set, and it is fixed by a different action. It shared the unreadable key while there was
# only one set, which was harmless because only one of them could be raised per run. With
# two sets both can now be raised in the same run, and the two cards would overwrite each
# other under one key, losing whichever was staged first. Same lesson, one step along.
announce_public() {     # $1 = one-line what, $2 = the detail
  [ -x "$KB" ] || return 0
  queue add "$1" --kind notice --key backup-public --replace --why "$2" \
    || say "could not stage the backup-public notice (board exit $?)"
}
clear_public() {
  close_notice backup-public
}

# A FOURTH KEY, raised on the first refusal. A Drive refresh token that has died (the OAuth
# app left in "testing", which expires tokens after 7 days; a revoked grant; a changed
# password) fails every later run the same way, and nothing the hourly job does will fix
# it. backup-stale would say so after STALE_HOURS; this says what to do about it now.
# Retired by the next run that reached the store, which is exactly the proof it needs.
# The same refusal marks the `drive` row of the Logins list at once, and a run that reached
# the store marks it working (c-558, keel/logins.py). Nothing here waits on it or fails for it.
mark_login() {          # $@ = `keel logins mark drive` arguments
  [ -x "$KEEL_HOME/bin/keel" ] || return 0
  "$KEEL_HOME/bin/keel" logins mark drive "$@" >/dev/null 2>&1 || true
}
announce_auth() {       # $1 = what the store said
  mark_login --why "the store refused the login: $1"
  [ -x "$KB" ] || return 0
  queue add "Keel backup: the store refused the login" --kind notice --key backup-auth --replace \
    --why "rclone could not authenticate to $STORE from $HOST: $1

Nothing reaches the store until this is fixed. Most likely the Google refresh token has
died. Mint a new one: bin/keel-backup-setup (it skips what is already done). The deck's
Logins list has the one-liner on its drive row. This card retires itself on
the next run that reaches the store." \
    || say "could not stage the backup-auth notice (board exit $?)"
}
clear_auth() {
  mark_login --ok
  close_notice backup-auth
}

# The pull's own key. It is not backup-stale: the store may be perfectly current while the
# second copy on this machine is not, and the two are fixed by different actions.
# THE SAME WORDS EVERY HOUR. The hourly job re-states an open notice with --replace, so a
# brief carrying a relative age ("49h ago", then "50h ago") changed on every run and put a
# `set` event on the card each hour. Absolute times only, and the error is quoted from the
# state file, which only a pull writes. It names pull.err: the failure is written there,
# and pull.out ends with the last success.
pull_brief() {
  local last err
  last="$(state_get last_pull)"; err="$(state_get last_pull_error)"
  printf '%s' "The last good keel backup pull on $HOST was ${last:-never}. The store may be fine; what is missing is the second copy on this machine.${err:+ The last pull said: $err.} The error is in $LOGDIR/pull.err. Run: bin/keel backup pull (the Mac's drain runs it by itself when it is due and the Mac is awake). This card retires itself on the next good pull."
}
announce_pull() {       # $1 = one-line what, $2 = the detail
  [ -x "$KB" ] || return 0
  queue add "$1" --kind notice --key backup-pull-stale --replace --why "$2" \
    || say "could not stage the backup-pull-stale notice (board exit $?)"
}
clear_pull() {
  close_notice backup-pull-stale
}

# ---------------------------------------------------------------------------
# THE STORE. Four verbs and a privacy question, and two backends behind them:
#
#   rclone:<remote>:<path>   the real one. Drive through rclone, so OAuth refresh, resumable
#                            uploads and Drive's duplicate-name quirk are rclone's problems,
#                            solved there, rather than a hand-written Drive client's.
#   file:<dir>               a directory. What the selftest runs against, offline, and a
#                            store in its own right (a mounted disk, the pull's mirror).
#
# Keys are paths relative to the store root. Every verb returns non-zero on failure and
# never dies, so the caller decides what a failure means: a snapshot dies, a verify raises
# the set's alarm and carries on to the next set.
# ---------------------------------------------------------------------------
store_kind() { printf '%s' "${STORE%%:*}"; }
store_base() { printf '%s' "${STORE#*:}"; }

# rclone with the config this machine keeps outside every set, and its stderr kept: an
# authentication refusal is recognised by what rclone says, so it can be raised on the
# first run it happens rather than after hours of staleness.
rcl() {
  # Per process: the nightly pull and an hourly snapshot can overlap, and one's stderr
  # must not be read as the other's.
  local err="$BACKUP_HOME/.rclone.err.$$" rc=0
  rclone --config "$RCLONE_CONF" --retries 3 --low-level-retries 10 --log-level ERROR \
         "$@" 2> "$err" || rc=$?
  if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ]; then
    sed 's/^/  rclone: /' "$err" >&2
    if grep -qiE 'invalid_grant|cannot fetch token|couldn.t fetch token|unauthorized_client|invalid_client|token (has been )?(expired|revoked)|401 Unauthorized' "$err"; then
      announce_auth "$(grep -iE 'invalid_grant|token|unauthori|invalid_client' "$err" | head -1 | cut -c1-300)"
    fi
  fi
  rm -f "$err"
  return "$rc"
}

# Everything under a prefix, as `<key>\t<bytes>\t<md5>` lines sorted by key. A prefix the
# store does not have is an empty listing, not a failure: a set nobody has written yet.
store_list() {          # $1 = prefix
  local base; base="$(store_base)"
  case "$(store_kind)" in
    file)
      "$PY" - "$base" "$1" <<'PY'
import hashlib, os, sys
base, prefix = sys.argv[1], sys.argv[2]
top = os.path.join(base, prefix)
rows = []
for dirpath, _dirs, files in os.walk(top):
    for name in files:
        if name.startswith(".put-"):
            continue                    # an interrupted put, not an object
        path = os.path.join(dirpath, name)
        h = hashlib.md5()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        rows.append((os.path.relpath(path, base), os.path.getsize(path), h.hexdigest()))
for key, size, md5 in sorted(rows):
    print(f"{key}\t{size}\t{md5}")
PY
      ;;
    rclone)
      local out rc=0
      # --fast-list: Drive lists a whole tree in a few calls rather than one per folder.
      out="$(rcl lsjson -R --fast-list --files-only --hash --hash-type md5 "$base/$1")" || rc=$?
      # 3 is rclone's "directory not found": the prefix does not exist yet.
      if [ "$rc" -eq 3 ]; then return 0; fi
      [ "$rc" -eq 0 ] || return "$rc"
      printf '%s' "$out" | "$PY" -c 'import json,sys
prefix = sys.argv[1]
rows = sorted((prefix + "/" + e["Path"], e["Size"], (e.get("Hashes") or {}).get("md5", ""))
              for e in json.load(sys.stdin))
for key, size, md5 in rows:
    print(f"{key}\t{size}\t{md5}")' "$1"
      ;;
    *) say "no store is configured (KEEL_BACKUP_STORE is '${STORE}')" >&2; return 2 ;;
  esac
}

store_put() {           # $1 = local file, $2 = key
  local base; base="$(store_base)"
  case "$(store_kind)" in
    file)
      # Atomic and private: written beside its final name, then renamed, so a reader never
      # sees half an object; 0600, because world-readable is exactly what the privacy check
      # below looks for.
      local dest="$base/$2" tmp
      ( umask 077; mkdir -p "$(dirname "$dest")" ) || return 1
      tmp="$(dirname "$dest")/.put-$$-$(basename "$dest")"
      ( umask 077; cp "$1" "$tmp" ) && chmod 600 "$tmp" && mv -f "$tmp" "$dest" \
        || { rm -f "$tmp"; return 1; }
      ;;
    # --checksum: an object already there with the same md5 is not sent again, which is what
    # makes publishing a pending blob after a crash idempotent.
    rclone) rcl copyto --checksum "$1" "$base/$2" ;;
    *) return 2 ;;
  esac
}

store_get() {           # $1 = key, $2 = local file
  local base; base="$(store_base)"
  mkdir -p "$(dirname "$2")"
  case "$(store_kind)" in
    file)   [ -f "$base/$1" ] && cp "$base/$1" "$2" ;;
    rclone) rcl copyto "$base/$1" "$2" ;;
    *) return 2 ;;
  esac
}

# ONE KEY'S MD5 AS THE STORE HOLDS IT NOW; nothing when the key is not there, and non-zero
# when the store did not answer (c-724 r2.F15). For proving one write: on a folder that is
# a hash of the one object, where a listing of its prefix hashes every object under it. On
# rclone it is a listing of the key's own folder, which is one call, and two objects that
# share the name print two lines, which match no single md5.
store_md5() {           # $1 = key
  local base rows; base="$(store_base)"
  case "$(store_kind)" in
    file)   if [ -f "$base/$1" ]; then md5_of "$base/$1"; fi ;;
    rclone) rows="$(store_list "$(dirname "$1")")" || return 1
            printf '%s\n' "$rows" | awk -F'\t' -v k="$1" '$1 == k {print $3}' | sort -u ;;
    *) return 2 ;;
  esac
}

# Deletes go to Drive's trash (rclone's default for drive, kept 30 days), so a buggy or
# hostile writer cannot erase history in one run; the pull that never deletes is the
# real second copy.
store_delete() {        # $1 = key
  local base; base="$(store_base)"
  case "$(store_kind)" in
    file)   rm -f "$base/$1" ;;
    rclone) rcl deletefile "$base/$1" ;;
    *) return 2 ;;
  esac
}

# IS ANY OF IT SHARED? Prints `private`, `public <what>`, or `unknown <why>`, and only a
# literal `private` may retire the backup-public alarm. For Drive: no object and not the
# root folder may carry an `anyone` or `domain` permission. For a directory: nothing in it
# may be readable by other users, the same question asked of a filesystem.
store_public() {
  local base; base="$(store_base)"
  case "$(store_kind)" in
    file)
      "$PY" - "$base" <<'PY'
import os, stat, sys
base = sys.argv[1]
shared = []
for dirpath, dirs, files in os.walk(base):
    for name in dirs + files:
        path = os.path.join(dirpath, name)
        mode = os.stat(path).st_mode
        if stat.S_ISREG(mode) and mode & stat.S_IROTH:
            shared.append(os.path.relpath(path, base))
print("public " + ", ".join(shared[:5]) if shared else "private")
PY
      ;;
    rclone)
      mktmp
      local items="$TMPDIR_RUN/perms-items.json" root="$TMPDIR_RUN/perms-root.json"
      rcl lsjson -R -M --drive-metadata-permissions read "$base" > "$items" \
        || { echo "unknown could not list the store's permissions"; return 0; }
      rcl lsjson --stat -M --drive-metadata-permissions read "$base" > "$root" || echo '{}' > "$root"
      "$PY" - "$root" "$items" <<'PY'
import json, sys
try:
    root = json.load(open(sys.argv[1]))
except ValueError:
    root = {}
entries = json.load(open(sys.argv[2])) + [dict(root, Path="(the store folder)")]
seen, shared = 0, []
for e in entries:
    perms = (e.get("Metadata") or {}).get("permissions")
    if perms is None:
        continue
    seen += 1
    for p in json.loads(perms) if isinstance(perms, str) else perms:
        if p.get("type") in ("anyone", "domain"):
            shared.append(e.get("Path", "?"))
if shared:
    print("public " + ", ".join(sorted(set(shared))[:5]))
elif seen:
    print("private")
else:
    print("unknown the store reports no permissions (not Google Drive, or rclone too old)")
PY
      ;;
    *) echo "unknown no store configured" ;;
  esac
}

# The attended check every verb that touches the store makes first. An hourly job on a
# machine where nobody ran the setup wizard fails HERE, with the command that fixes it,
# rather than with an rclone error about a remote it has never heard of.
ensure_store() {
  case "$(store_kind)" in
    file)   [ -n "$(store_base)" ] || die "KEEL_BACKUP_STORE is 'file:' with no directory" ;;
    rclone)
      command -v rclone >/dev/null 2>&1 \
        || die "rclone is not installed (brew install rclone)"
      local remote; remote="$(store_base)"; remote="${remote%%:*}"
      [ -s "$RCLONE_CONF" ] && rclone --config "$RCLONE_CONF" listremotes 2>/dev/null | grep -qx "$remote:" \
        || die "the store $STORE is not set up on this machine: $RCLONE_CONF has no remote '$remote'.
  Run bin/keel-backup-setup."
      ;;
    "") die "no store is configured: config.toml [backup] store, or KEEL_BACKUP_STORE" ;;
    *)  die "unknown store '$STORE': it is rclone:<remote>:<path> or file:<dir>" ;;
  esac
  mkdir -p "$WORK" "$LOGDIR"
}

# ---------------------------------------------------------------------------
# What this machine knows about a set: the store's listing, refreshed by every run that
# touches the set and kept so `status` can answer without the network.
# ---------------------------------------------------------------------------
refresh_listing() {     # $1 = set; returns non-zero if the store cannot be listed
  local w tmp; w="$(set_work "$1")"; mkdir -p "$w"
  tmp="$w/listing.tsv.tmp"
  store_list "$(set_prefix "$1")" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$w/listing.tsv"
}
listing()      { cat "$(set_work "$1")/listing.tsv" 2>/dev/null || true; }
listing_blobs(){ listing "$1" | awk -F'\t' '$1 ~ /\.tar\.gz\.gpg$/'; }
set_count()    { listing_blobs "$1" | wc -l | tr -d ' '; }
set_mb()       { listing_blobs "$1" | awk -F'\t' '{b += $2} END {printf "%d", b / 1048576}'; }
newest_id() {           # $1 = set, prints the newest snapshot id in the store or empty
  local k; k="$(listing_blobs "$1" | cut -f1 | LC_ALL=C sort | tail -1)"
  if [ -n "$k" ]; then basename "$k" .tar.gz.gpg; fi
}
listed_md5() {          # $1 = set, $2 = key; prints its md5 in the listing, or empty
  # Drive lets two objects share a name (an upload retried after a timeout that had in
  # fact succeeded). Identical copies are one md5 and still match; different ones print two
  # lines, never match, and the caller says what to run.
  listing "$1" | awk -F'\t' -v k="$2" '$1 == k {print $3}' | sort -u
}
has_history() { [ "$(set_count "$1")" -gt 0 ] && echo yes || echo no; }
store_mb() {
  local s total=0
  for s in $MY_SETS; do total=$((total + $(set_mb "$s"))); done
  printf '%s' "$total"
}
# What a slim keeps of the archives it rewrote (slim-old/<set>/, c-724), as last listed.
# Beside the sets, never in them, so store_mb does not see it; the size warning adds it,
# since until a purge the store holds each rewritten snapshot twice (r2.F13).
slim_old_total_mb() {
  local s total=0
  for s in $MY_SETS; do total=$((total + $(slim_old_mb "$s"))); done
  printf '%s' "$total"
}
snapshot_count() {
  local s total=0
  for s in $MY_SETS; do total=$((total + $(set_count "$s"))); done
  printf '%s' "$total"
}

# The set's latest.json as the store has it, fetched only when the store's copy differs
# from the one this machine last saw (by md5 in the listing). Prints its path, or nothing
# for a set with no latest.json yet.
sync_latest() {         # $1 = set
  local s="$1" w key want have
  w="$(set_work "$s")"; key="$(set_prefix "$s")/latest.json"
  want="$(listed_md5 "$s" "$key")"
  if [ -z "$want" ]; then rm -f "$w/latest.json"; return 0; fi
  have=""; [ -f "$w/latest.json" ] && have="$(md5_of "$w/latest.json")"
  if [ "$want" != "$have" ]; then
    store_get "$key" "$w/latest.json.tmp" || { rm -f "$w/latest.json.tmp"; return 1; }
    mv -f "$w/latest.json.tmp" "$w/latest.json"
  fi
  printf '%s' "$w/latest.json"
}
latest_field() {        # $1 = latest.json path (may be empty), $2 = field
  [ -n "$1" ] && [ -f "$1" ] || { echo ""; return 0; }
  "$PY" -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get(sys.argv[2], "") or "")
except Exception: print("")' "$1" "$2"
}

# ---------------------------------------------------------------------------
# Retention. Decided on the ids the STORE holds, not on anything local: a machine taking
# a set over has none of its history on disk, and pruning by a local view would delete the
# other machine's snapshots as "not retained".
# ---------------------------------------------------------------------------
retained_deletions() {  # $1 = set; stdin: keys; prints the keys to delete, newest-kept guaranteed
  # -c, not a heredoc: a heredoc IS the script's stdin, and the keys arrive on stdin.
  "$PY" -c '
import os, sys, datetime
hourly_days, daily_days = int(sys.argv[1]), int(sys.argv[2])
now = datetime.datetime.now(datetime.timezone.utc)
ids = []
for line in sys.stdin:
    key = line.strip()
    if key.endswith(".tar.gz.gpg"):
        ids.append((os.path.basename(key)[: -len(".tar.gz.gpg")], key))
if not ids:
    raise SystemExit(0)
ids.sort()
keep, by_day, by_month = set(), {}, {}
for sid, _key in ids:
    try:
        ts = datetime.datetime.strptime(sid, "%Y%m%dT%H%M%SZ").replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        keep.add(sid)          # an id we cannot parse is never something we delete
        continue
    age = (now - ts).total_seconds() / 86400.0
    if age <= hourly_days:
        keep.add(sid)
    elif age <= daily_days:
        by_day.setdefault(sid[:8], []).append(sid)
    else:
        by_month.setdefault(sid[:6], []).append(sid)
# The LAST of each period, not the first: the newest state of that day is the one worth
# having, and ids sort lexicographically in time order because they are UTC and padded.
for group in (by_day, by_month):
    for v in group.values():
        keep.add(max(v))
keep.add(ids[-1][0])           # the newest overall, unconditionally
for sid, key in ids:
    if sid not in keep:
        print(key)
' "$(set_hourly_days "$1")" "$(set_daily_days "$1")"
}

# The mirror's rule (see cmd_pull): per set, the newest snapshot of each of the MIRROR_DAYS
# most recent days present in the keys given. Prints the snapshot keys to KEEP.
mirror_keep() {         # stdin: snapshot keys (sets/<set>/snapshots/...); stdout: keys kept
  "$PY" -c '
import os, sys
days = int(sys.argv[1])
newest = {}                    # (set, day) -> key
for line in sys.stdin:
    key = line.strip()
    if not key.endswith(".tar.gz.gpg"):
        continue
    parts = key.split("/")
    if len(parts) < 3 or parts[0] != "sets":
        continue
    sid = os.path.basename(key)[: -len(".tar.gz.gpg")]
    slot = (parts[1], sid[:8])
    if slot not in newest or os.path.basename(newest[slot]) < os.path.basename(key):
        newest[slot] = key
by_set = {}
for (s, day), key in newest.items():
    by_set.setdefault(s, []).append((day, key))
for rows in by_set.values():
    for _day, key in sorted(rows)[-days:]:
        print(key)
' "$MIRROR_DAYS"
}

# ---------------------------------------------------------------------------
# Publishing. A blob is encrypted and proven into work/<set>/pending/ first, then put,
# then PROVEN IN THE STORE by the store's own md5 of it, and only then is latest.json
# written: latest.json is the commit point, and a latest.json naming a blob the store
# does not hold is the one lie this must never tell.
#
# A run that dies anywhere in here leaves the blob in pending/, and the next run publishes
# it before doing anything else. That replaces the git version's "unpushed head" test: a
# snapshot that never reached the store cannot be mistaken for a quiet night, because it
# is still sitting in pending/ saying so.
# ---------------------------------------------------------------------------
publish_pending() {     # $1 = set; 0 when pending/ is empty afterwards
  local s="$1" w blob id key md5 newest="" meta
  w="$(set_work "$s")"
  [ -d "$w/pending" ] || return 0
  local blobs=()
  while IFS= read -r blob; do [ -n "$blob" ] && blobs+=("$blob"); done \
    < <(find "$w/pending" -name '*.tar.gz.gpg' 2>/dev/null | LC_ALL=C sort)
  # ONLY A BLOB WITH ITS latest.json BESIDE IT WAS PROVEN: snapshot_set writes the json after
  # the round trip and names the blob last. Anything else here is residue, never a snapshot.
  local proven=()
  for blob in ${blobs[@]+"${blobs[@]}"}; do
    if [ -s "${blob%.tar.gz.gpg}.json" ]; then proven+=("$blob")
    else say "[$s] discarding $(basename "$blob"): it has no proof beside it" >&2; rm -f "$blob"; fi
  done
  blobs=(${proven[@]+"${proven[@]}"})
  [ ${#blobs[@]} -gt 0 ] || return 0

  for blob in "${blobs[@]}"; do
    id="$(basename "$blob" .tar.gz.gpg)"
    store_put "$blob" "$(blob_key "$s" "$id")" || { say "[$s] could not put $id in the store" >&2; return 1; }
  done
  refresh_listing "$s" || { say "[$s] could not list the store after putting" >&2; return 1; }
  for blob in "${blobs[@]}"; do
    id="$(basename "$blob" .tar.gz.gpg)"; key="$(blob_key "$s" "$id")"
    md5="$(md5_of "$blob")"
    if ! same_md5 "$(listed_md5 "$s" "$key")" "$md5"; then
      say "[$s] the store does not hold $id as written (md5 '$(listed_md5 "$s" "$key" | tr '\n' ' ')', expected $md5). Two different md5s mean two objects share the name: rclone --config $RCLONE_CONF dedupe --dedupe-mode newest $(store_base)/$(set_prefix "$s")" >&2
      return 1
    fi
    newest="$id"
  done

  # The commit point, for the newest pending blob, and only if it is newer than what the
  # store already names: an older pending blob republished after a crash must not wind
  # latest.json backwards.
  meta="$w/pending/$newest.json"
  local current; current="$(latest_field "$(sync_latest "$s")" snapshot)"
  if [ -f "$meta" ] && { [ -z "$current" ] || [ "$newest" \> "$current" ] || [ "$newest" = "$current" ]; }; then
    store_put "$meta" "$(set_prefix "$s")/latest.json" || { say "[$s] could not write latest.json" >&2; return 1; }
    refresh_listing "$s" || return 1
    same_md5 "$(listed_md5 "$s" "$(set_prefix "$s")/latest.json")" "$(md5_of "$meta")" \
      || { say "[$s] the store's latest.json is not the one just written" >&2; return 1; }
    cp "$meta" "$w/latest.json"
  fi
  rm -rf "$w/pending"
  say "[$s] published ${#blobs[@]} snapshot(s), newest $newest, proven by md5"
}

# ---------------------------------------------------------------------------
# snapshot
# ---------------------------------------------------------------------------
# One set, published on its own: per-set publishing means a failure in one set leaves the
# others' snapshots safely in the store rather than holding them hostage to one push.
#
# Prints its verdict and returns 0 when it published a new snapshot, 1 when it deliberately
# skipped. It dies only for the cases where carrying on would damage what is already there.
snapshot_set() {        # $1 = set, $2 = force (0|1), $3 = take over (0|1)
  local s="$1" force="$2" takeover="$3"
  local root w mf dg prev id enc raw last_id last_iso last_age floor latest owner owner_age kf

  root="$(set_root "$s")"; w="$(set_work "$s")"; mkdir -p "$w"; kf="$(set_keyfile "$s")"

  refresh_listing "$s" || die "[$s] could not list the store ($STORE)"
  if [ ! -d "$root" ]; then
    # Nothing ever written: a set this machine has never had, skipped. Written before: the
    # data this machine promised to back up is gone, which is not a quiet hour.
    if [ "$(set_count "$s")" -gt 0 ]; then
      die "[$s] $root is gone, but the store holds $(set_count "$s") snapshots of it. If the set
  really moved off this machine, take it out of config.toml [backup] sets."
    fi
    say "[$s] $root is not on this machine; nothing to back up"
    return 1
  fi

  ensure_key "$s" "$(has_history "$s")"
  # Whatever an earlier run left half-published goes first, so the change test below reads
  # a latest.json that includes it.
  publish_pending "$s" || die "[$s] an earlier snapshot is still waiting to reach the store and could not be published"
  # What a run killed mid-encryption leaves: never proven, so never published, only removed.
  rm -f "$w"/pending/*.part 2>/dev/null || true
  latest="$(sync_latest "$s")" || die "[$s] could not read latest.json from the store"

  # THE ARCHIVE IS BUILT FIRST, from one read of $root, and the manifest used for both the
  # skip decision below and the round-trip proof further down is derived from ITS bytes
  # (see manifest()) rather than from a second, later scan of $root. Building it always,
  # even on a quiet hour, costs a little (a few megabytes of tar+gzip) against the
  # alternative of hashing a live tree twice with real time in between: see manifest() for
  # why that second read was the actual bug. The expensive part, gpg's deliberately slow
  # KDF, still only runs below once a real change is confirmed.
  raw="$TMPDIR_RUN/$s.tar.gz"
  local plain="$TMPDIR_RUN/$s.tar"
  # CHECKED, NOT TRUSTED, for the same reason as the extraction in manifest(): this
  # function is called as `if snapshot_set ...`, so bash suspends -e for its whole body
  # and a failing pipeline would otherwise be swallowed. `set -o pipefail` (inherited into
  # the subshell) makes the pipeline's exit status the rightmost non-zero one, so a tar
  # error on one unreadable file is not masked by a later stage succeeding on whatever tar
  # managed to emit before it gave up.
  #
  # TAR TO A FILE, THEN GZIP, rather than one pipeline into gzip. set_stage below appends
  # to the archive (today: the board, taken through sqlite's online backup rather than read
  # off the live tree), and a gzip stream cannot be appended to. Everything downstream still
  # sees one $raw built from one read of $root.
  ( cd "$root" && { set_dir_list "$s"; set_file_list "$s"; } | LC_ALL=C sort -z \
      | tar -cf "$plain" --null --no-recursion -T - ) \
    || die "[$s] failed to build the archive (tar exited non-zero); refusing to snapshot a possibly incomplete tree"
  set_stage "$s" "$plain" \
    || die "[$s] could not stage $(set_canary "$s") into the archive; refusing to snapshot a tree missing the one file the canary checks"
  # -n drops gzip's embedded timestamp, which keeps the compressed bytes a function of the
  # content alone: a stable blob makes two identical trees look identical when someone is
  # comparing by hand during a recovery.
  gzip -9nc "$plain" > "$raw" \
    || die "[$s] failed to compress the archive; refusing to snapshot a possibly incomplete tree"

  mf="$TMPDIR_RUN/manifest-$s.txt"
  if ! manifest "$raw" "$mf" "$s"; then
    # An empty manifest means either this set has never had anything (fine, skip) or its
    # data has disappeared (not fine). The difference is whether snapshots already exist,
    # and publishing an empty tree as the newest is how a backup system deletes your data.
    if [ "$(set_count "$s")" -gt 0 ]; then
      die "[$s] $root produced an empty file list but $(set_count "$s") snapshots of it already
  exist. Refusing: an empty snapshot published over a good one is how a backup system deletes
  your data. Check that $root still holds what it should."
    fi
    say "[$s] nothing to back up in $root yet"
    return 1
  fi

  dg="$(digest_of "$mf")"
  prev="$(latest_field "$latest" manifest)"

  if [ "$dg" = "$prev" ] && [ -n "$prev" ] && [ "$force" = 0 ]; then
    # Point 2. Skipping is not "nothing happened": the store's copy is provably current,
    # so this counts as a successful run and the freshness clock is reset. Treating a skip
    # as staleness would cry wolf every quiet night, and a backup alarm nobody believes is
    # worse than none.
    say "[$s] unchanged since $(latest_field "$latest" snapshot) (manifest ${dg:0:12}); nothing to publish"
    return 1
  fi

  # ONE WRITER PER SET. latest.json names the host that wrote it; another host that wrote
  # it within OWNER_HOURS still owns it. Two writers would each prune by retention and
  # each publish a latest.json the other's change test then disagrees with, forever.
  # Cutover moves a set by config, and the new owner's first run says --take-over.
  owner="$(latest_field "$latest" host)"
  if [ -n "$owner" ] && [ "$owner" != "$HOST" ] && [ "$takeover" = 0 ]; then
    owner_age="$(age_seconds "$(id_to_iso "$(latest_field "$latest" snapshot)")")"
    if [ -n "$owner_age" ] && [ "$owner_age" -lt $((OWNER_HOURS * 3600)) ]; then
      die "[$s] $owner wrote this set $(human_age "$owner_age"); this host is $HOST.
  One set has one writer. If the set has really moved here (cutover), run once with
  --take-over: bin/keel backup run --take-over --set $s. Otherwise take $s out of
  [backup] sets in config.toml."
    fi
  fi

  # The floor from set_min_interval. Checked against the newest snapshot IN THE STORE
  # rather than against state.json, so losing the state file costs at most one extra
  # snapshot instead of restarting the clock.
  floor="$(set_min_interval "$s")"
  if [ "$floor" -gt 0 ] && [ "$force" = 0 ]; then
    last_id="$(newest_id "$s")"
    if [ -n "$last_id" ]; then
      last_iso="$(id_to_iso "$last_id")"
      last_age="$(age_seconds "$last_iso")"
      if [ -n "$last_age" ] && [ "$last_age" -lt "$floor" ]; then
        say "[$s] changed, but the last snapshot is only $((last_age / 60))m old and the floor is $((floor / 60))m; nothing to publish"
        return 1
      fi
    fi
  fi

  id="$(date -u '+%Y%m%dT%H%M%SZ')"
  mkdir -p "$w/pending"
  # Written under a name publish_pending does not pick up, and renamed to it only once the
  # round trip below has proven it and its latest.json is beside it: a run killed mid-gpg
  # must not leave half a blob that the next run would publish as the newest snapshot.
  enc="$w/pending/$id.tar.gz.gpg.part"

  gpg_enc "$kf" "$enc" < "$raw" || { rm -f "$enc"; die "[$s] gpg refused to encrypt; nothing was published"; }

  # PROVE IT BEFORE PUBLISHING IT. Decrypt what was just written, rebuild the manifest
  # from the unpacked tree and require it to equal $mf, which was taken from the same raw
  # archive just encrypted (see manifest()). A mismatch here is no longer a live-tree
  # race: it means the gpg round trip itself altered the bytes, which is worth refusing to
  # publish over. At a couple of megabytes it costs about a second, so there is no reason to
  # run any hour without it.
  local check="$TMPDIR_RUN/check-$s"; rm -rf "$check"; mkdir -p "$check"
  # -z is said out loud. bsdtar (macOS) sniffs gzip on a pipe; GNU tar (the box) does not,
  # and refuses with "Archive is compressed. Use -z option". Both accept -z.
  gpg_dec "$kf" "$enc" | tar -xzf - -C "$check" || { rm -f "$enc"; die "[$s] the blob just written does not decrypt"; }
  ( cd "$check" && LC_ALL=C find . -type f -print0 | LC_ALL=C sort -z \
      | xargs -0 "${SHA256[@]}" | sed 's|  \./|  |' | LC_ALL=C sort -k2 ) \
    > "$TMPDIR_RUN/roundtrip-$s.txt"
  if ! diff -q "$mf" "$TMPDIR_RUN/roundtrip-$s.txt" >/dev/null; then
    rm -f "$enc"
    say "[$s] round trip of $id does not match the source manifest; here is what differs:"
    report_manifest_diff "$mf" "$TMPDIR_RUN/roundtrip-$s.txt"
    die "[$s] the round trip of $id does not match the source manifest; refusing to publish it"
  fi

  "$PY" - "$w/pending/$id.json" "$id" "$dg" "$(wc -l < "$mf" | tr -d ' ')" \
        "$(wc -c < "$raw" | tr -d ' ')" "$(wc -c < "$enc" | tr -d ' ')" "$s" "$HOST" "$(now_iso)" <<'PY'
import json, sys
path, sid, manifest, files, archive, enc, name, host, at = sys.argv[1:10]
# Plaintext on purpose, and carrying no file names: this is what lets a machine with no
# local state tell whether anything changed, which host owns the set, and what a human
# landing in the store reads first. A digest and some counts leak nothing about the contents.
# archive_bytes is the gzipped tar, not the raw tree: it is what the blob costs, which is
# the number the retention arithmetic is done in.
open(path, "w").write(json.dumps({
    "set": name, "snapshot": sid, "manifest": manifest, "files": int(files),
    "archive_bytes": int(archive), "encrypted_bytes": int(enc),
    "host": host, "written_at": at,
}, indent=2, sort_keys=True) + "\n")
PY
  [ -s "$w/pending/$id.json" ] || { rm -f "$enc"; die "[$s] could not write the snapshot's latest.json; nothing was published"; }
  mv -f "$enc" "$w/pending/$id.tar.gz.gpg"

  publish_pending "$s" || {
    state_set last_error "[$s] publish failed at $(now_iso)"
    announce_broken "Keel backup could not reach the store" \
      "A new snapshot of $s was taken and verified on $HOST but could not be proven in $STORE, so it is still only on this machine (in $w/pending, published first by the next run). Check the network and run: bin/keel backup run. This card retires itself on the next successful run."
    # Disarm the generic announce in the exit trap: both use --replace on one key, and the
    # vague one landing a moment later would overwrite this specific diagnosis.
    ANNOUNCE_ON_FAIL=0
    die "[$s] publish to $STORE failed; the snapshot is waiting in $w/pending"
  }

  # Retention runs only on a publishing run, which is correct rather than a shortcut: a
  # skipped run adds nothing, so the set it would prune can only shrink. A quiet week
  # leaves a few snapshots past their tier, and the next real change tidies them.
  local deleted=0 key
  while IFS= read -r key; do
    if [ -n "$key" ]; then
      store_delete "$key" || die "[$s] could not delete $key from the store"
      deleted=$((deleted+1))
    fi
  done < <(listing_blobs "$s" | cut -f1 | retained_deletions "$s")
  refresh_listing "$s" || die "[$s] could not list the store after pruning"
  [ "$(set_count "$s")" -ge 1 ] || die "[$s] no snapshots left in the store after pruning; this should be impossible, look now"

  state_set "last_snapshot_$s" "$id" "last_manifest_$s" "$dg"
  say "[$s] snapshot $id published ($deleted pruned, $(set_count "$s") kept, $(set_mb "$s")MB)"
  return 0
}

cmd_snapshot() {
  # --force exists for one situation, and it is not "I want a snapshot now". The skip in
  # point 2 compares CONTENT, so a change to the archive itself (a new exclusion, empty
  # directories starting to be recorded) leaves every manifest identical and the fix
  # never reaches the store: the backup keeps confirming it is up to date while storing
  # the old shape. This is the door out of that, and it is why the flag is here rather
  # than in a comment telling someone to delete latest.json by hand. It bypasses the
  # minimum interval too, for the same reason.
  local force=0 only="" takeover=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      --take-over) takeover=1; shift ;;
      --set) only="${2:?--set needs a set name}"; set_valid "$only" || die "unknown set '$only'; known: $SETS"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  if [ -n "$only" ] && ! writes_set "$only"; then
    die "$HOST does not write the $only set (config.toml [backup] sets is '${MY_SETS}')"
  fi

  RECORD_ON_FAIL=1      # from here a death is a backup that failed (on_exit, c-757 r1.F8)
  need_config
  lock_take; mktmp
  rotate_log
  if [ -z "$MY_SETS" ]; then
    # Not a failure and not a success worth a clock: a host that writes nothing (the box
    # before cutover) has no freshness to measure, and status --announce knows it.
    say "$HOST writes no backup sets (config.toml [backup] sets); nothing to do"
    return 0
  fi
  # ASKED FIRST, BY NAME (c-757). Every copy is encrypted, so a run on a machine with no gpg
  # can only fail, and it used to fail at the encryption with "gpg refused to encrypt",
  # after the archive was built, which names the step and not the cause. `init` needs only
  # openssl, so a backup can be set up and turned on with no gpg at all.
  gpg --version >/dev/null 2>&1 \
    || die "gpg did not run (it is not installed, or not on this run's PATH), and every copy is encrypted with it. Install it (on a Mac: brew install gnupg). The next run then writes the copy."
  ensure_store

  local s took="" any=0
  for s in $MY_SETS; do
    if [ -n "$only" ] && [ "$s" != "$only" ]; then continue; fi
    if snapshot_set "$s" "$force" "$takeover"; then any=1; took="${took:+$took+}$s"; fi
  done
  # Every set reached the store (listed, and published when changed), so a refused token
  # is provably fixed.
  clear_auth

  if [ "$any" = 1 ]; then
    write_store_readme
    state_set last_commit "$(now_iso)"
  fi

  # A NARROWED RUN MAY NOT MOVE THE RUN-WIDE CLOCK. `snapshot --set helm` examined one set,
  # so it has no standing to say the other ones are safe, and last_success is what
  # `keel backup status` prints and what the staleness alarm is measured against. Letting a
  # hand-run `--set helm` reset that clock and retire a backup-stale card raised because
  # KEEL's data is not reaching the store is the same self-erasing alarm this file has
  # already been refused for twice: an alarm may only be retired by something that proved
  # as much as the thing that raised it.
  if [ -n "$only" ]; then
    say "[$only] done. The other sets were not examined, so the freshness figure is unchanged and nothing is retired on this run's account."
  else
    state_set last_success "$(now_iso)" last_error ""
    clear_broken
    # The copy is made: nothing after this writes a failure over it (c-757 r1.F8). After
    # clear_broken and not before it, so the success is still followed at once by the retire
    # (tests/test_backupdue.py holds those two lines together); clear_broken never fails.
    RECORD_ON_FAIL=0
    say "run complete: ${took:-nothing changed} ($(snapshot_count) kept, $(store_mb)MB across $MY_SETS)"
  fi

  local size old also=""; size="$(store_mb)"; old="$(slim_old_total_mb)"
  if [ "${old:-0}" -gt 0 ]; then
    also=" It holds ${old}MB more under slim-old/, the archives a slim rewrote, kept as the way back until bin/keel backup slim --purge removes them."
  fi
  if [ $(( ${size:-0} + ${old:-0} )) -gt "$SIZE_WARN_MB" ]; then
    # A promise about size that nothing measures is how the unbounded version gets
    # discovered a year later by the store rather than by us.
    queue add "The Keel backup store has passed ${SIZE_WARN_MB}MB" --kind notice \
      --key backup-size --replace \
      --why "$STORE holds ${size}MB for $HOST's sets ($MY_SETS).$also The per-set retention tiers in bin/keel-backup may need tightening, or the data being backed up has grown." >/dev/null 2>&1 || true
  fi
}

write_store_readme() {
  # RECOVERY MUST NOT DEPEND ON THIS SCRIPT. If the machine is gone, so is bin/keel-backup,
  # and whoever is standing in front of this store has a passphrase and a pile of .gpg
  # files. So the commands that get the data back live in the store itself, one per set,
  # including which directory each one restores relative to. Put only when it changed.
  local readme="$WORK/README.md"
  cat > "$readme.new" <<'MD'
# keel-backup

Encrypted snapshots of runtime data that exists on exactly one machine. Everything here is
useless without the passphrases, which are in your password manager and nowhere in
this store: "Shipyard backup passphrase" (the keel and harbor sets; "Keel backup
passphrase" for a key saved before c-729) and "Keel backup passphrase (helm set)", which
exists on the Mac only.

There are four independent SETS. They share this store and nothing else: each has its own
snapshots, its own retention, its own root on disk and one machine that writes it (named
in its latest.json), so restoring one can never overwrite the others.

| set | in the store | restores relative to | what it is |
|---|---|---|---|
| keel | `sets/keel/` | `~/keel` | the board, every card directory, the voice data, every segment's data |
| code | `sets/code/` | anywhere (it is one file) | `code/keel.bundle`: Keel's code, every branch, as a git bundle |
| harbor | `sets/harbor/` | `~/harbor` | the old engine's segment data and ledgers, frozen at cutover |
| helm | `sets/helm/` | `~/.claude` | the retired PR tools' history, read-only: the review scanner's state, findings and orientation notes, and PR watch's context notes with their screenshots |

Each `snapshots/YYYY/MM/<id>.tar.gz.gpg` is a complete, standalone copy of that set at that
moment, not a delta. The `latest.json` beside `snapshots/` names the newest one, the host
that wrote it, and the SHA-256 of its plaintext manifest.

## Getting the data back without any tooling

    gpg --decrypt sets/keel/snapshots/2026/09/20260918T013000Z.tar.gz.gpg > keel.tar.gz
    tar -xzf keel.tar.gz -C somewhere/

The same two lines for `sets/harbor/` and `sets/helm/` (the helm set asks for its own
passphrase). gpg prompts for it. Paths inside each archive are relative to that set's
root, so `state/board.db` restores to exactly where it belongs under the install's home
(the keel set's root is the parent of the board's state dir).
`state/board.db` in the keel archive is a consistent copy taken through sqlite's own
backup API, not a file-by-file read of a live database, so it opens.

Unpack into a scratch directory first and look at it, then move what you want into place.
No archive is a merge and none knows what is already on the disk.

Not in a keel snapshot: a card's `scratch/` folder (`state/cards/<id>/scratch`), which is
for throwaway work. Everything else in a card's directory is.

## Starting from nothing: a new machine with no Keel on it

Clone Keel from the newest `code` snapshot's bundle (`git clone keel.bundle ~/keel`), put
the two things only you hold in place (the passphrase at `~/.keel-backup/backup.key` and
the store's login at `~/.keel-backup/rclone.conf`, both in the password manager), then
`~/keel/bin/keel-backup restore --set keel --into DIR` and move what you want into place.
The whole procedure is in Keel's Atlas, `docs/atlas/86-restore.md`, which the code bundle
carries.

Retention, per set. keel and code: hourly for 1 day, one per day to 30 days, one per
month beyond. harbor: hourly for 7 days, one per day to 90 days, one per month beyond.
helm: hourly for 2 days, one per day to 30 days, one per month beyond. code and helm take
no more than one snapshot every 6 hours in the first place. A pruned snapshot sits in the
store's trash for 30 days, where the store has one.
MD
  if [ -f "$readme" ] && cmp -s "$readme" "$readme.new"; then rm -f "$readme.new"
  elif store_put "$readme.new" "README.md"; then mv -f "$readme.new" "$readme"
  else rm -f "$readme.new"; say "could not put README.md in the store (the snapshots are fine)"; fi
}

rotate_log() {          # $1 = log name, backup.out by default
  # The service manager appends to its log forever. Truncating IN PLACE rather than
  # replacing the file matters: launchd holds an open fd on that inode, so `mv` would leave
  # every later line going to a file nobody can find.
  local f="$LOGDIR/${1:-backup.out}"
  mkdir -p "$LOGDIR"
  [ -f "$f" ] || return 0
  local bytes; bytes="$(wc -c < "$f" | tr -d ' ')"
  if [ "$bytes" -gt 2000000 ]; then
    tail -n 500 "$f" > "$f.trim" && cat "$f.trim" > "$f" && rm -f "$f.trim"
  fi
}

# ---------------------------------------------------------------------------
# restore
# ---------------------------------------------------------------------------
# The core RETURNS rather than dying, and that is not a style choice: cmd_verify has to
# survive a failed restore for long enough to stage the notice that says so. A `die` here
# would exit the whole process, and the one run that most needs to be loud would be the
# one that said nothing.
#
# FROM THE STORE by default, and that default is the point: the question a backup has to
# answer is whether the copy that survives this machine is readable. `local` reads the
# pull's mirror instead, which is the copy that survives the store.
fetch_blob() {          # $1 = set, $2 = remote|local, $3 = id|latest; prints a local path
  local s="$1" source="$2" which="$3" key
  if [ "$source" = local ]; then
    local d="$MIRROR/$(set_prefix "$s")/snapshots" f
    if [ "$which" = latest ]; then
      f="$(find "$d" -name '*.tar.gz.gpg' 2>/dev/null | LC_ALL=C sort | tail -1)"
    else
      f="$(find "$d" -name "$which.tar.gz.gpg" 2>/dev/null | head -1)"
    fi
    [ -n "$f" ] || { say "[$s] no snapshot matching '$which' in the mirror at $d" >&2; return 1; }
    printf '%s' "$f"; return 0
  fi
  local rows
  rows="$(store_list "$(set_prefix "$s")/snapshots")" || { say "[$s] could not list $STORE" >&2; return 1; }
  if [ "$which" = latest ]; then
    key="$(printf '%s\n' "$rows" | cut -f1 | grep '\.tar\.gz\.gpg$' | LC_ALL=C sort | tail -1)"
  else
    key="$(printf '%s\n' "$rows" | cut -f1 | grep "/$which\.tar\.gz\.gpg$" | head -1)"
  fi
  [ -n "$key" ] || { say "[$s] no snapshot matching '$which' in $STORE" >&2; return 1; }
  mktmp
  local dest="$TMPDIR_RUN/fetched/$(basename "$key")"
  store_get "$key" "$dest" || { say "[$s] could not fetch $key" >&2; return 1; }
  # Proven like a put is: the bytes on disk are the bytes the store says it holds.
  if ! same_md5 "$(md5_of "$dest")" "$(printf '%s\n' "$rows" | awk -F'\t' -v k="$key" '$1 == k {print $3}')"; then
    # ONCE MORE, ON THE STORE'S WORD AS IT IS NOW (c-724 r1.F13). This takes no lock, and a
    # slim puts a rewritten archive over a snapshot's own name: a fetch a moment after the
    # listing then has the new bytes and the old md5. That is a changed object, not an
    # unreadable set, and the card this would raise must never cry wolf. One fresh listing
    # and one more fetch; a mismatch against the fresh listing is the real thing.
    rows="$(store_list "$(set_prefix "$s")/snapshots")" || { say "[$s] could not list $STORE" >&2; return 1; }
    store_get "$key" "$dest" || { say "[$s] could not fetch $key" >&2; return 1; }
    same_md5 "$(md5_of "$dest")" "$(printf '%s\n' "$rows" | awk -F'\t' -v k="$key" '$1 == k {print $3}')" \
      || { say "[$s] $key arrived with a different md5 than the store lists" >&2; return 1; }
  fi
  printf '%s' "$dest"
}

do_restore() {          # $1 = set, $2 = remote|local, $3 = id|latest, $4 = destination
  local s="$1" source="$2" which="$3" into="$4" kf
  kf="$(set_keyfile "$s")"
  if [ ! -s "$kf" ]; then
    say "no passphrase for the $s set at $kf, so nothing of it can be decrypted" >&2; return 1
  fi

  # Point 1, enforced rather than trusted. A restore into the live checkout would scatter
  # untracked files through it, and "just be careful" is not a guard. It applies to every
  # set and every checkout, not only the one the set came from. Resolved with pwd -P so a
  # symlink cannot walk around it.
  mkdir -p "$into"
  local abs home_abs home
  abs="$(cd "$into" && pwd -P)"
  # EVERY checkout, not only the one this set came from: restoring Keel's tree into
  # ~/harbor dirties that one just as thoroughly, and a restore into ~/keel would scatter
  # untracked files through the live engine's own repo while it is running.
  for home in "$KEEL_HOME" "$KEEL_DATA" "$HARBOR_HOME"; do
    [ -d "$home" ] || continue
    home_abs="$(cd "$home" && pwd -P)"
    case "$abs/" in
      "$home_abs"/*)
        say "refusing to restore into $abs: it is inside the checkout at $home_abs, and untracked files there dirty a live tree. Unpack into a scratch directory and move what you want into place." >&2
        return 1 ;;
    esac
  done

  local blob
  blob="$(fetch_blob "$s" "$source" "$which")" || return 1
  say "[$s] restoring $(basename "$blob" .tar.gz.gpg) into $abs"
  # -z, because GNU tar will not sniff gzip on a pipe: without it the first restore on the
  # box failed on a good blob (bootstrap, 2026-09-19).
  gpg_dec "$kf" "$blob" | tar -xzf - -C "$abs" || { say "[$s] decrypt or unpack failed" >&2; return 1; }
  say "[$s] restored $(find "$abs" -type f | wc -l | tr -d ' ') files from $(basename "$blob" .tar.gz.gpg)"
}

cmd_restore() {
  local into="" which="latest" source="remote" s="keel"
  while [ $# -gt 0 ]; do
    case "$1" in
      --into) into="${2:?--into needs a directory}"; shift 2 ;;
      --set) s="${2:?--set needs a set name}"; set_valid "$s" || die "unknown set '$s'; known: $SETS"; shift 2 ;;
      --snapshot) which="${2:?--snapshot needs an id or 'latest'}"; shift 2 ;;
      --local) source="local"; shift ;;
      --remote) source="remote"; shift ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  # keel by default, because it is the live set and the one a bring-up restores; the
  # others by name. `--set helm` puts nothing of Harbor's or Keel's into the destination.
  [ -n "$into" ] || die "usage: keel-backup restore --into DIR [--set $(echo "$SETS" | tr ' ' '|')] [--snapshot ID] [--local]"
  mktmp
  [ "$source" = local ] || ensure_store
  do_restore "$s" "$source" "$which" "$into" || die "restore failed"
}

# ---------------------------------------------------------------------------
# verify
# ---------------------------------------------------------------------------
cmd_verify() {
  local source="remote" only=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --local) source="local"; shift ;;
      --remote) source="remote"; shift ;;
      --set) only="${2:?--set needs a set name}"; set_valid "$only" || die "unknown set '$only'; known: $SETS"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  RECORD_VERIFY_ON_FAIL=1   # from here a death is a proof that failed (on_exit, c-757 r1.F2)
  need_config
  mktmp
  rotate_log verify.out

  # WHICH SETS: the ones this host writes, because that is the promise it keeps. A named
  # set is checked whoever writes it (the Mac can prove the box's keel set is readable).
  local sets="${only:-$MY_SETS}"
  if [ -z "$sets" ]; then
    say "$HOST writes no backup sets and none was named; nothing to verify"
    RECORD_VERIFY_ON_FAIL=0
    return 0
  fi
  [ "$source" = local ] || ensure_store

  # The weekly job runs exactly this. A backup that has never been restored is not a
  # backup, and one that was restored once at build time is a backup that WAS working.
  # The card has to name what was actually read, because the two failures want different
  # next moves. A store failure means the copy that survives this machine is unreadable; a
  # local one means the pull's mirror is, which the next pull may well repair on its own.
  local whence="from $STORE" when="its weekly restore check"
  if [ "$source" != "remote" ]; then whence="from the mirror at $MIRROR"; when="a local restore check"; fi

  # EVERY SET IS ATTEMPTED BEFORE ANYTHING GIVES UP. Dying on the first failure would mean
  # a broken keel set hides a broken helm set for a week, and the card for the second one
  # would only appear after somebody fixed the first. Each failure raises its own alarm as
  # it happens, and the process exits non-zero at the end.
  local s failed="" checked="" n total=0 target canary
  for s in $sets; do
    # A SET WITH NO SNAPSHOTS YET IS NOT AN UNREADABLE SET. Without this, the first weekly
    # verify after a new set is added stages "the set cannot be read back" about a set
    # nothing has ever written, which is a false alarm on the one card that must never cry
    # wolf. Asked of the source being verified, not of a cache.
    if [ "$source" = remote ]; then
      # Asked of the store directly, never through work/: the weekly verify takes no lock,
      # and the listing cache is the hourly snapshot's to write.
      local rows
      if rows="$(store_list "$(set_prefix "$s")/snapshots")" && [ -z "$rows" ]; then
        say "[$s] no snapshots in the store yet; nothing to verify"; continue
      fi
    elif [ -z "$(find "$MIRROR/$(set_prefix "$s")/snapshots" -name '*.tar.gz.gpg' -print -quit 2>/dev/null)" ]; then
      say "[$s] no snapshots in the mirror yet; nothing to verify"; continue
    fi
    target="$TMPDIR_RUN/restored-$s"; rm -rf "$target"; mkdir -p "$target"

    if ! do_restore "$s" "$source" latest "$target"; then
      failed="${failed:+$failed, }$s"
      announce_unreadable "$s" "Keel backup: the $s set failed $when" \
        "keel backup verify on $HOST could not restore the newest $s snapshot ($(set_label "$s")) $whence. The hourly snapshots may still be running, so this is not necessarily stale data: it is data that cannot be read back, which is worse. Run: bin/keel backup verify --set $s"
      continue
    fi

    canary="$target/$(set_canary "$s")"
    if ! canary_ok "$s" "$canary"; then
      failed="${failed:+$failed, }$s"
      announce_unreadable "$s" "Keel backup: the $s set restored but its contents are wrong" \
        "The newest $s snapshot $whence unpacked, but $(set_canary "$s") is missing or does not read back. Something is backing up the wrong tree. Run: bin/keel backup verify --set $s"
      continue
    fi

    n="$(find "$target" -type f | wc -l | tr -d ' ')"
    total=$((total + n))
    checked="${checked:+$checked, }$s ($n files)"
    rm -rf "$target"
  done

  # STILL PRIVATE? Asserted at creation and then never again is how a store ends up
  # shared for months. Nobody shares it by accident, but "the data is encrypted" is the
  # only thing standing between a shared link and a stranger with a copy of the whole
  # board, and that is a thin enough margin to be worth one listing a week.
  # Only when the store is what was actually checked: a `verify --local` is a question about
  # the mirror, and asking the store about it would be answering a question nobody asked.
  local vis="skipped"
  [ "$source" = "remote" ] && vis="$(store_public)"
  case "$vis" in
    public*)
      # Recorded as well as announced, like the failures above it. `status` prints
      # last_verify_error, so leaving it unset here would give the one failure with a
      # security shape the quietest status line of the three.
      state_set last_verify_error "the store is shared (${vis#public }), seen at $(now_iso)" \
        last_verify_error_at "$(now_iso)"
      RECORD_VERIFY_ON_FAIL=0
      announce_public "The Keel backup store is SHARED" \
        "Something in $STORE is shared beyond your own account: ${vis#public }. Every snapshot is still AES256 encrypted, so this is not an immediate disclosure, but anyone with the link can now download them and only the passphrase is holding. Remove the sharing in Google Drive (the item's Share dialog, General access: Restricted)."
      die "verify: the store is shared: ${vis#public }" ;;
  esac

  if [ -n "$failed" ]; then
    state_set last_verify_error "$failed unreadable at $(now_iso)" last_verify_error_at "$(now_iso)"
    RECORD_VERIFY_ON_FAIL=0
    die "verify: could not read back: $failed"
  fi

  # FROM HERE NOTHING FAILED THE PROOF, so the record is disarmed before each way out, as a
  # snapshot disarms its own after `last_success`. Left armed, any non-zero exit after it
  # (the closing lines, or `migrate`, which carries on after calling this) wrote "the proof
  # stopped" over a proof that passed (c-757 fc.D2).
  [ -n "$checked" ] || { say "verify: no set had snapshots to check"; RECORD_VERIFY_ON_FAIL=0; return 0; }

  # WHAT A LOCAL VERIFY IS NOT ALLOWED TO DO. It proves the mirror is readable, which is a
  # weaker claim than the weekly job makes, so it may raise alarms but it may not retire
  # them and it may not touch the freshness clock. Otherwise a hand-run `verify --local`
  # would close a "the store is SHARED" card raised by the weekly run and reset the figure
  # `keel backup status` prints. Raising stays ungated on purpose: believing an alarm too
  # readily is cheap, dismissing one is not.
  if [ "$source" != "remote" ]; then
    RECORD_VERIFY_ON_FAIL=0
    say "verify ok LOCALLY: $checked, canaries parse. The store was not read, so nothing is cleared and the freshness figure is unchanged."
    return 0
  fi

  # AN ALARM MAY ONLY BE RETIRED BY SOMETHING THAT PROVED AS MUCH AS THE THING THAT RAISED
  # IT. A restore that unpacked and whose canary parsed is proof about READABILITY, so each
  # verified set clears its own readability card here. It is not proof about sharing, so
  # backup-public retires only on a literal "private", never on an unanswered question.
  #
  # EXCEPT WHEN THE RUN WAS NARROWED, the same way a narrowed snapshot may not move the
  # snapshot clock. `verify --set helm` proved one set, so it clears that set's card and
  # nothing else.
  if [ -z "$only" ]; then
    state_set last_verify "$(now_iso)" last_verify_error "" last_verify_files "$total"
  else
    say "[$only] only this set was verified, so the freshness figure keel backup status prints is unchanged."
  fi
  RECORD_VERIFY_ON_FAIL=0     # the proof passed and is on file: nothing after this is its failure
  for s in $sets; do clear_unreadable "$s"; done
  clear_auth
  if [ "$vis" = "private" ]; then
    clear_public
    say "verify ok: newest snapshot restored from $STORE for $checked, canaries parse, nothing shared"
  else
    say "verify ok: newest snapshot restored from $STORE for $checked, canaries parse."
    say "WARNING: could not confirm nothing in the store is shared (${vis}), so any pending backup-public card is LEFT STANDING rather than retired on an unanswered question."
  fi
}

# ---------------------------------------------------------------------------
# pull: the second copy
# ---------------------------------------------------------------------------
# The nightly job on the Mac. It copies every object the store holds that the mirror lacks,
# for every set whoever writes it, and then proves the newest snapshot of each set it can
# decrypt by restoring it. So the box vanishing costs nothing the store did not already
# hold, and the store vanishing (a lost Google account, a writer gone wrong) costs at most
# a night.
#
# IT NEVER DELETES BECAUSE THE STORE DID. A copy that mirrors deletions is a copy a bad
# writer empties in one night, which is the failure it exists for.
#
# IT HOLDS ONLY THE RECENT END. The store carries the full hourly and daily history; the
# mirror is the copy for the store vanishing, and for that the newest state is what
# matters. So it keeps the newest snapshot of each of the MIRROR_DAYS most recent days a
# set has, decided on the union of its own ids and the store's (mirror_keep), fetches only
# those and drops the rest. A night of bad snapshots still leaves the days before it.
# Holding every hourly copy here cost 15GB of a 228GB disk by 2026-10-01.
cmd_pull() {
  [ $# -eq 0 ] || die "unknown argument: $1"
  need_config
  LOCK="$BACKUP_HOME/.pull-lock"
  lock_take; mktmp
  rotate_log pull.out
  ensure_store

  local rows s key
  if ! rows="$(store_list sets)"; then
    pull_failed "could not list $STORE"
  fi
  mkdir -p "$MIRROR"
  PULL_GOT=0; PULL_FAILED=""
  pull_objects "$rows"
  [ -z "$PULL_FAILED" ] || pull_failed "could not copy $PULL_FAILED"
  # THE COMMIT POINTS LAST, ONE PER SET, after every blob they could name is here.
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    s="${key#sets/}"; s="${s%%/*}"
    pull_latest "$s" || PULL_FAILED="${PULL_FAILED:+$PULL_FAILED, }$key"
  done < <(printf '%s\n' "$rows" | cut -f1 | grep '/latest\.json$' || true)
  [ -z "$PULL_FAILED" ] || pull_failed "could not copy $PULL_FAILED"
  rows="$PULL_ROWS_SEEN$rows"
  local got="$PULL_GOT"

  local proved="" unreadable="" kf target blob id
  for s in $SETS; do
    [ -d "$MIRROR/sets/$s/snapshots" ] || continue
    # Pruned after the copy to the recent end (see above). The keep set is computed on the
    # same union pull_objects fetched by, so nothing dropped here is fetched again tomorrow.
    local keep
    keep="$(mirror_union "$rows" | mirror_keep)"
    while IFS= read -r key; do
      [ -n "$key" ] || continue
      printf '%s\n' "$keep" | grep -qxF "$key" && continue
      rm -f "$MIRROR/$key"
    done < <(cd "$MIRROR" && find "sets/$s/snapshots" -name '*.tar.gz.gpg')
    find "$MIRROR/sets/$s/snapshots" -type d -empty -delete 2>/dev/null || true

    kf="$(set_keyfile "$s")"
    if [ ! -s "$kf" ]; then say "[$s] no passphrase here ($kf); copied but not proven"; continue; fi
    blob="$(find "$MIRROR/sets/$s/snapshots" -name '*.tar.gz.gpg' | LC_ALL=C sort | tail -1)"
    [ -n "$blob" ] || continue
    id="$(basename "$blob" .tar.gz.gpg)"
    target="$TMPDIR_RUN/pulled-$s"; rm -rf "$target"; mkdir -p "$target"
    if gpg_dec "$kf" "$blob" | tar -xzf - -C "$target" && canary_ok "$s" "$target/$(set_canary "$s")"; then
      proved="${proved:+$proved, }$s $id"
    else
      unreadable="${unreadable:+$unreadable, }$s $id"
    fi
    rm -rf "$target"
  done

  if [ -n "$unreadable" ]; then
    # Not staleness and not a network blip: the copy is here and does not read back.
    # Raised on the first night, whatever the clock says.
    state_set last_pull_error "unreadable: $unreadable at $(now_iso)"
    announce_pull "Keel backup: the nightly copy does not read back" \
      "keel backup pull on $HOST copied the store into $MIRROR, but the newest snapshot of $unreadable does not decrypt or its canary does not parse. The store's own copy may be just as bad: run bin/keel backup verify now."
    die "pull: unreadable: $unreadable"
  fi

  state_set last_pull "$(now_iso)" last_pull_error "" last_pull_files "$got"
  clear_pull
  clear_auth
  say "pull ok: $got new object(s) into $MIRROR, $(du -sm "$MIRROR" 2>/dev/null | cut -f1)MB held; proven: ${proved:-nothing to prove}"
}

# Every object in a listing the mirror lacks, each checked against the listing's md5. The
# latest.json files are skipped here: pull_latest does them, last. Counts into PULL_GOT and
# names what failed in PULL_FAILED.
pull_objects() {        # $1 = listing rows
  local key size md5 dest keep
  keep="$(mirror_union "$1" | mirror_keep)"
  while IFS=$'\t' read -r key size md5; do
    [ -n "$key" ] || continue
    case "$key" in */latest.json) continue ;; esac
    case "$key" in
      *.tar.gz.gpg) printf '%s\n' "$keep" | grep -qxF "$key" || continue ;;
    esac
    dest="$MIRROR/$key"
    [ -f "$dest" ] && same_md5 "$(md5_of "$dest")" "$md5" && continue
    if store_get "$key" "$dest.part" && same_md5 "$(md5_of "$dest.part")" "$md5"; then
      mv -f "$dest.part" "$dest"; PULL_GOT=$((PULL_GOT+1))
    elif pull_again "$key" "$md5" "$dest"; then
      PULL_GOT=$((PULL_GOT+1))
    else
      rm -f "$dest.part"; PULL_FAILED="${PULL_FAILED:+$PULL_FAILED, }$key"
    fi
  done <<< "$1"
}

# ONE MORE FETCH, when the store lists the object differently now (c-724 r1.F13). The pull
# lists the store once and copies for as long as that takes, and a slim puts a rewritten
# archive over a snapshot's own name: the bytes then arrive whole and match no md5 the old
# listing has. The object's folder is listed again, and when its md5 has changed the fetch
# is made once more against that. Anything else is the failure it was.
pull_again() {          # $1 = key, $2 = the md5 the first listing had, $3 = where it goes
  local fresh
  fresh="$(store_list "$(dirname "$1")" | awk -F'\t' -v k="$1" '$1 == k {print $3}' | sort -u)" || return 1
  if [ -z "$fresh" ] || [ "$fresh" = "$2" ]; then return 1; fi
  store_get "$1" "$3.part" && same_md5 "$(md5_of "$3.part")" "$fresh" && mv -f "$3.part" "$3"
}

# The snapshot keys the mirror could hold: the store's listing and its own, one per line.
mirror_union() {        # $1 = listing rows
  { printf '%s\n' "$1" | cut -f1
    [ -d "$MIRROR/sets" ] && (cd "$MIRROR" && find sets -name '*.tar.gz.gpg')
  } | grep '\.tar\.gz\.gpg$' | LC_ALL=C sort -u || true
}

# ONE SET'S COMMIT POINT, and the rule is the store's own: a latest.json is good when it
# parses and the snapshot it names is here. Not "its md5 matches the listing": the box
# rewrites latest.json every hour, and a pull that dozes through DarkWakes on a laptop
# fetches it hours after the listing, so the listing's md5 is stale by then (c-440, two
# nights running). When the snapshot it names is not here (the box published a new one
# mid-pull) the set is listed once more and what is new is copied, then it is tried once
# more. A latest.json that still names nothing here is never written into the mirror,
# which keeps the commit point it had.
pull_latest() {         # $1 = set
  local s="$1" key dest attempt more
  key="sets/$s/latest.json"; dest="$MIRROR/$key"   # any set the store holds, known here or not
  for attempt in 1 2; do
    if store_get "$key" "$dest.part" && latest_held "$s" "$dest.part"; then
      mv -f "$dest.part" "$dest"; return 0
    fi
    rm -f "$dest.part"
    [ "$attempt" = 1 ] || break
    say "[$s] latest.json names a snapshot the mirror does not hold; listing the set again"
    more="$(store_list "sets/$s")" || return 1
    pull_objects "$more"
    PULL_ROWS_SEEN="$PULL_ROWS_SEEN$more"$'\n'
  done
  return 1
}
latest_held() {         # $1 = set, $2 = a latest.json; 0 when it parses and names a held blob
  local id; id="$(latest_field "$2" snapshot)"
  [ -n "$id" ] && [ -f "$MIRROR/sets/$1/snapshots/${id:0:4}/${id:4:2}/$id.tar.gz.gpg" ]
}
PULL_ROWS_SEEN=""

# A failed pull says so on the board only once the second copy is really behind: one bad
# night on a laptop that slept through 03:00 is not news, two is. Always exits non-zero.
pull_failed() {         # $1 = what went wrong
  local last age
  last="$(state_get last_pull)"; age="$(age_seconds "$last")"
  state_set last_pull_error "$1 at $(now_iso)"
  if [ -z "$age" ] || [ "$age" -gt $((PULL_STALE_HOURS * 3600)) ]; then
    announce_pull "Keel backup: no nightly copy for over ${PULL_STALE_HOURS}h" "$(pull_brief)"
  fi
  die "pull: $1"
}

# ---------------------------------------------------------------------------
# init and the move off GitHub
# ---------------------------------------------------------------------------
cmd_init() {
  [ $# -eq 0 ] || die "unknown argument: $1"
  mktmp
  ensure_store
  local s
  for s in $MY_SETS; do
    refresh_listing "$s" || die "[$s] could not list $STORE"
    ensure_key "$s" "$(has_history "$s")"
  done
  write_store_readme
  say "ready: $STORE reachable from $HOST, writing: ${MY_SETS:-nothing}"
}

# THE ONE-OFF MOVE from the GitHub repo (`[backup] legacy_repo`) this used to push to. It
# reads the local working clone of that repo, which after the last successful push held
# exactly what GitHub held, puts every retained snapshot into the store under the new
# layout, and then runs the ordinary weekly verify against the store for every set. It is
# idempotent: an object the store already holds is not sent again, so a run cut short is
# finished by running it again.
#
# THE HELM SET IS RE-ENCRYPTED on the way. On GitHub it shared the keel passphrase; here
# it gets its own (see the note above the sets), and a helm blob still readable under the
# shared passphrase would undo the whole point of that. Each one is decrypted, encrypted
# under the helm key, and proven by comparing the two plaintexts.
cmd_migrate() {
  local clone="$BACKUP_HOME/harbor-data"
  while [ $# -gt 0 ]; do
    case "$1" in
      --clone) clone="${2:?--clone needs a directory}"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  lock_take; mktmp
  ensure_store
  [ -d "$clone/.git" ] || die "no git clone at $clone"
  [ -z "$(git --no-optional-locks -C "$clone" status --porcelain 2>/dev/null)" ] \
    || die "$clone has uncommitted changes: a snapshot that never reached GitHub. Let the old job push it first."
  [ -s "$KEYFILE" ] || die "no passphrase at $KEYFILE: the GitHub snapshots cannot be read without it"

  local s old blob id key helm_tmp a b n meta
  for s in $SETS; do
    case "$s" in harbor) old="$clone" ;; *) old="$clone/sets/$s" ;; esac
    [ -d "$old/snapshots" ] || { say "[$s] nothing in the clone"; continue; }
    refresh_listing "$s" || die "[$s] could not list $STORE"
    [ "$s" != helm ] || ensure_key helm "$(has_history helm)"
    n=0
    while IFS= read -r blob; do
      id="$(basename "$blob" .tar.gz.gpg)"; key="$(blob_key "$s" "$id")"
      if [ -n "$(listed_md5 "$s" "$key")" ]; then continue; fi
      if [ "$s" = helm ]; then
        helm_tmp="$TMPDIR_RUN/helm-$id.tar.gz.gpg"
        gpg_dec "$KEYFILE" "$blob" | gpg_enc "$HELM_KEYFILE" "$helm_tmp" || die "[helm] could not re-encrypt $id"
        a="$(gpg_dec "$KEYFILE" "$blob" | "${SHA256[@]}" | cut -d' ' -f1)"
        b="$(gpg_dec "$HELM_KEYFILE" "$helm_tmp" | "${SHA256[@]}" | cut -d' ' -f1)"
        [ "$a" = "$b" ] || die "[helm] $id re-encrypted to different plaintext"
        store_put "$helm_tmp" "$key" || die "[helm] could not put $id"
        rm -f "$helm_tmp"
      else
        store_put "$blob" "$key" || die "[$s] could not put $id"
      fi
      n=$((n+1))
    done < <(find "$old/snapshots" -name '*.tar.gz.gpg' | LC_ALL=C sort)

    refresh_listing "$s" || die "[$s] could not list $STORE after the copy"
    # Every GitHub snapshot is in the store, and the ones copied as they were are byte for
    # byte the same (the helm ones were proven by plaintext above).
    while IFS= read -r blob; do
      id="$(basename "$blob" .tar.gz.gpg)"; key="$(blob_key "$s" "$id")"
      [ -n "$(listed_md5 "$s" "$key")" ] || die "[$s] $id is missing from the store after the copy"
      [ "$s" = helm ] || same_md5 "$(listed_md5 "$s" "$key")" "$(md5_of "$blob")" \
        || die "[$s] $id differs in the store from the clone"
    done < <(find "$old/snapshots" -name '*.tar.gz.gpg')

    # latest.json last, as always, now naming the host that owns the set.
    meta="$TMPDIR_RUN/latest-$s.json"
    "$PY" - "$old/latest.json" "$meta" "$HOST" "$(now_iso)" "$LEGACY_REPO" <<'PY' || die "[$s] the clone's latest.json does not read"
import json, sys
src, dst, host, at, repo = sys.argv[1:6]
d = json.load(open(src))
d.update(host=host, written_at=at, migrated_from=f"github:{repo}" if repo else "github")
open(dst, "w").write(json.dumps(d, indent=2, sort_keys=True) + "\n")
PY
    # NEVER BACKWARDS. A rerun after the store has moved on (new snapshots, another owner)
    # leaves the store's latest.json alone rather than rewinding it to GitHub's.
    local current; current="$(latest_field "$(sync_latest "$s")" snapshot)"
    if [ -n "$current" ] && [ "$current" \> "$(latest_field "$meta" snapshot)" ]; then
      say "[$s] the store has moved on to $current; its latest.json is left as it is"
    else
      store_put "$meta" "$(set_prefix "$s")/latest.json" || die "[$s] could not write latest.json"
      refresh_listing "$s" || die "[$s] could not list $STORE"
      cp "$meta" "$(set_work "$s")/latest.json"
    fi
    say "[$s] $n snapshot(s) copied, $(set_count "$s") in the store, $(set_mb "$s")MB"
  done
  write_store_readme
  lock_release
  say "copied. Now the proof: the ordinary weekly verify, against the store, for every set."
  MY_SETS="$SETS" cmd_verify
  state_set migrated_at "$(now_iso)"
  say "migration done. The GitHub repo can be archived (gh repo archive ${LEGACY_REPO:-<owner>/<repo>}) and deleted after 90 days."
}

# ---------------------------------------------------------------------------
# slim (c-724): the retained snapshots, rewritten without what the scan now leaves out
# ---------------------------------------------------------------------------
# A scope fix only slims the snapshots taken after it. The ones already in the store keep
# what the scan dropped later (drafts, node_modules, films, a landing's test log, a card's
# scratch folder), each a complete copy, for as long as retention holds them: about 15GB
# on 2026-10-10, nearly all of it things the backup had already stopped carrying.
#
#   slim --dry-run                reads every snapshot not yet slim and says what the rules
#                                 would drop, by rule, with the total and a rough time.
#                                 Writes nothing to the store; writes what it showed to
#                                 $BACKUP_HOME/slim-approved.json.
#   slim --approved               rewrites exactly what that file covers, one snapshot at
#                                 a time, oldest first. There is no bare rewrite.
#   slim --restore ID             the kept old archive back over its name
#   slim --purge                  remove EVERY kept old archive of the set; only then is
#                                 space freed
#   slim --purge --id ID          remove one snapshot's kept old archive, by the same rules
#   slim --purge --unproven ID    remove one object under slim-old/ that no journal entry
#                                 vouches for; the snapshot itself is not touched
#   --set N                       one set (every set this host writes otherwise)
#   --limit N                     examine only N snapshots, to try one first
#   --json                        the report as one JSON document on stdout
#
# WHAT IS DROPPED IS DECIDED BY THE SCAN ITSELF. The snapshot is unpacked, and the set's own
# set_dir_list and set_file_list run over the unpacked tree exactly as a snapshot runs them
# over the live one. What they list is kept; so is every path the set stages rather than
# scans (set_staged: the board, each repo's bundle), and so is anything under none of
# today's roots, which no rule names. The rest is dropped. There is no second list here to drift from the
# first. The arithmetic (the subtraction, the rule names read out of the find's own text,
# the proof) is keel/backupslim.py.
#
# THE REWRITE DOES WHAT THE DRY RUN SHOWED, AND NOTHING ELSE (r1.F2, r2.F2). The dry run
# records, per snapshot, the md5 of the object it read, a digest of everything that decides
# a drop (set_decides: the find, the roots and list functions, the staged paths, the
# canary), a digest of the dropped paths and of the roots found, and the totals by rule.
# --approved refuses a snapshot that file does not cover exactly: another
# object, other rules, or a plan that drops anything more, less or different. It says to
# run the dry run again (keel/backupslimapproval.py).
#
# AN ARCHIVE ANSWERS EVERY RULE BY ITSELF (c-752). .git never entered an archive, and for
# three days (c-724, 2026-10-09 to 2026-10-12) one rule asked whether a directory of a
# card's scratch/ held it, which only the live tree could say: a dry run told --live-git
# asked it and the rewrite marked the directories that dry run named. The scan now leaves a
# card's scratch/ out whole, no rule asks about .git, and that flag and its marking are
# gone. An approval entry from then that names such directories is refused (run the dry
# run again), as is any written under the old rule, since the rules' digest changed.
#
# ONE SNAPSHOT AT A TIME:
#   1. fetched (proven by md5), decrypted, unpacked; the unpacked tree must be the
#      archive's own member list, path for path (r1.F3); scanned. Nothing to drop: the
#      journal says so and the object is not touched.
#   2. packed again from the unpacked tree, encrypted under the same key, decrypted and
#      unpacked once more, and PROVEN: the same files with the same content, mode and
#      time, the same directories with the same mode and time, minus exactly what was
#      dropped, and the canary still reads.
#   3. under the backup's own lock: the store still lists the snapshot as it was fetched
#      (a snapshot retention pruned meanwhile is never put back) and no publish of it is
#      pending; the old archive is copied to slim-old/ and proven; the new one is put under
#      a temporary name in slim-tmp/ and proven; the journal records the replace; the new
#      archive is put over the old one's name and proven by md5; a latest.json that names
#      it is made to describe it; the temporary object is removed and the journal says done.
# A run that dies anywhere leaves both archives whole in the store, each proven, whatever
# the name itself holds: see slim_recover, which the next run starts with.
#
# THE JOURNAL IS sets/<set>/slim.json IN THE STORE, so a resume skips what is done from
# any machine: a snapshot is slim when the journal names the object the store holds now
# (its md5) and records that it was slimmed under today's rules (their digest). It also
# holds what each one lost, by rule; the trees themselves are in $LOGDIR/slim.jsonl. No
# snapshot is deleted and no id changes, so retention and status count what they counted;
# the sizes are the listing's, refreshed once when the run ends.
#
# TWO LOCKS, AND THE BACKUP'S OWN IS HELD NARROWLY ON PURPOSE (r1.F1, a decision: the plan
# said the slim takes the backup's lock so the two never run together). .slim-lock is held
# for the whole run: one slim at a time, since each rewrites the journal. The backup's own
# lock is held only around step 3, and waited for rather than given up on. A whole run
# takes hours, and holding the lock across it would skip every hourly snapshot until the
# staleness alarm fired. Step 3 is seconds on Drive, where a listing is one call; on a
# folder store a listing hashes every object in the set, so it is as long as that takes.
# What the hourly job can do in the gaps is covered where it matters: a snapshot it pruned
# is found gone under the lock and never put back, and a snapshot it has a publish pending
# for (work/<set>/pending) is skipped for the run, so a pending blob is never put back
# over a rewrite. The dry run takes only the first lock and writes nothing to the store.
SELF_HOME="$(cd "$(dirname "$0")/.." && pwd -P)"
SELF_FILE="$SELF_HOME/bin/${0##*/}"      # this file, by a path no later cd moves (fn_source reads it)
SLIM_JSON=0
# Free disk wanted before a snapshot is fetched: its size in the store this many times
# over (the blob, its unpacked tree twice, the new blob), and a floor to spare.
SLIM_DISK_FACTOR="${KEEL_BACKUP_SLIM_DISK_FACTOR:-12}"
SLIM_DISK_FLOOR_MB="${KEEL_BACKUP_SLIM_DISK_FLOOR_MB:-1024}"
# How long step 3 waits for the backup's lock before the run stops, to be run again.
SLIM_LOCK_WAIT="${KEEL_BACKUP_SLIM_LOCK_WAIT:-1800}"
# What the dry run showed, per snapshot: all a rewrite may do (keel/backupslimapproval.py).
# Local, beside the keys, never in the store.
SLIM_APPROVAL="$BACKUP_HOME/slim-approved.json"

# -P: `python -m` puts the current directory first on its path, so a slim run from another
# checkout's root would do its sums with that checkout's modules. The tool's own, always.
slim_py() { PYTHONPATH="$SELF_HOME${PYTHONPATH:+:$PYTHONPATH}" "$PY" -P -m keel.backupslim "$@"; }
slim_say() { if [ "$SLIM_JSON" = 1 ]; then say "$@" >&2; else say "$@"; fi; }
slim_clean() { if [ -e "$1" ]; then chmod -R u+rwX "$1" 2>/dev/null || true; rm -rf "$1"; fi; }
free_mb() { df -Pk "$1" 2>/dev/null | awk 'NR == 2 {printf "%d", $4 / 1024}'; }
slim_tmp_key() { printf 'slim-tmp/%s/%s.new' "$1" "$2"; }
# THE OLD ARCHIVE IS KEPT (r1.F7), under slim-old/<set>/, outside sets/: retention, status
# and the nightly pull list sets/ and never see it. It is the way back from a rewrite
# (slim --restore <id>) until slim --purge removes it, and only then is the space freed.
slim_old_key() { printf 'slim-old/%s/%s.tar.gz.gpg' "$1" "$2"; }
# One object copied to another key by the store itself: on rclone a copy inside the remote
# (server side where the remote can, so a 250MB archive is not sent a second time), on a
# folder the same atomic put every object gets. The caller proves the copy by md5.
slim_copy() {           # $1 = from key, $2 = to key
  local base; base="$(store_base)"
  case "$(store_kind)" in
    file)   [ -f "$base/$1" ] && store_put "$base/$1" "$2" ;;
    rclone) rcl copyto --checksum "$base/$1" "$base/$2" ;;
    *) return 2 ;;
  esac
}
# What status reads, offline like the rest of it: the kept old archives as last listed.
slim_old_cache() {      # $1 = set
  local w; w="$(set_work "$1")"; mkdir -p "$w"
  slim_side "slim-old/$1" "$w/slim-old.tsv.tmp" && mv -f "$w/slim-old.tsv.tmp" "$w/slim-old.tsv"
}
slim_old_count() { if [ -f "$(set_work "$1")/slim-old.tsv" ]; then awk 'NF {n++} END {printf "%d", n}' "$(set_work "$1")/slim-old.tsv"; else printf 0; fi; }
slim_old_mb() { if [ -f "$(set_work "$1")/slim-old.tsv" ]; then awk -F'\t' '{b += $2} END {printf "%d", b / 1048576}' "$(set_work "$1")/slim-old.tsv"; else printf 0; fi; }
# A listing of one of the slim's own prefixes into a file. A
# LISTING THAT FAILED IS NOT AN EMPTY ONE (r1.F4): slim_side returns the store's own
# status, and every caller stops on it. Read inside a command substitution, as this once
# was, a failed listing was an empty string, "no copy is held", and the copy was removed.
slim_side() { store_list "$1" > "$2"; }                 # $1 = prefix, $2 = file
# THE TESTS' SEAM (tests/test_backupslim*.py), honoured only when BOTH hold: the store is a
# folder (never Drive, never any rclone remote) and KEEL_BACKUP_SLIM_TEST=1 says a test is
# asking. A stray variable in somebody's shell does nothing to a real run (r1.F12).
#   KEEL_BACKUP_SLIM_DIE_AT=<step>    stop dead at that step, as a kill or a lost machine would
#   KEEL_BACKUP_SLIM_HOLD_AT=<step>   say "holding at <step>" and wait there for $BACKUP_HOME/.slim-go
slim_test_at() {
  if [ "${KEEL_BACKUP_SLIM_TEST:-}" != 1 ] || [ "$(store_kind)" != file ]; then return 0; fi
  if [ "${KEEL_BACKUP_SLIM_DIE_AT:-}" = "$1" ]; then kill -KILL $$; fi
  if [ "${KEEL_BACKUP_SLIM_HOLD_AT:-}" = "$1" ]; then
    slim_say "holding at $1"
    until [ -e "$BACKUP_HOME/.slim-go" ]; do sleep 0.1; done
  fi
}

# THE SLIM'S TWO LOCKS ARE THE TOOL'S ONE LOCK (lock_take, lock_release, above), at two
# names. Nothing here makes, reads or breaks a lock by a rule of its own: a stale one is
# judged and broken by lock_take alone (r1.F16 is c-750's rename there), so what the hourly
# job would do to a lock is exactly what a slim does.
#
# lock_take ends the run when it cannot have the lock, which is right for the hourly job
# and wrong twice here: a slim wants to say so and stop with a failure, and around a replace
# it wants to wait. So it is called in a subshell, where its `exit` ends only the subshell,
# and whether the lock was had is then read off the lock itself: it names this run or it
# does not. ($$ in a subshell is still this run's pid, so the lock made there is this run's.)
slim_take() {           # $1 = the lock's name; 0 when it now names this run. What lock_take said: SLIM_SAID
  local LOCK="$1"
  SLIM_SAID="$( ( lock_take ) 2>&1 | tail -1 | cut -d' ' -f2- )" || true
  [ "$(lock_owner "$LOCK")" = "$$" ]
}

# .slim-lock, for the whole run. THE RUN'S TEMPORARY DIRECTORY IS RECORDED BESIDE IT (r1.F8),
# in <lock>.work, one line a run: its pid, the temp root it ran under, and the directory.
# A kill or a power loss skips the exit trap and leaves a whole decrypted snapshot (the
# board, the memory, the config) under the temp root, up to twice, and no later run would
# find it. The line is written once the lock is held and taken out at release. The next
# run to hold the lock reads the lines a dead run left and removes each directory, but
# only one that is this tool's own: named as mktmp names them, directly under the temp
# root ITS RECORD names (not this run's, which may differ), a real directory and not a link.
#
# A RECORD GOES ONLY WHEN ITS DIRECTORY IS GONE (r2.F5): removed here, or found already
# gone. One that is not removed (its pid is running, the name or the place is wrong, it is
# a link) keeps its line and the run says why, so a later run, or a person, still knows
# where a decrypted snapshot may lie.
slim_run_lock() {
  local root="${TMPDIR:-/tmp}"
  if ! slim_take "$SLIM_LOCK"; then die "slim could not have its lock: ${SLIM_SAID:-$SLIM_LOCK is held}"; fi
  # THIS RUN'S LINE FIRST, THEN THE SWEEP (r3.F6): the sweep removes whole unpacked trees
  # and can be slow, and a run stopped in it must already be on record.
  printf '%s\t%s\t%s\n' "$$" "${root%/}" "$TMPDIR_RUN" >> "$SLIM_LOCK.work"
  slim_sweep
}
slim_run_release() {
  local LOCK="$SLIM_LOCK"
  if [ "$(lock_owner "$LOCK")" = "$$" ] && [ ! -e "$TMPDIR_RUN" ]; then slim_unrecord "$$" "$TMPDIR_RUN"; fi
  lock_release
}
slim_unrecord() {       # $1 = pid, $2 = directory: that line out of the record, and the record gone with its last
  [ -f "$SLIM_LOCK.work" ] || return 0
  awk -F'\t' -v p="$1" -v d="$2" '!($1 == p && $3 == d)' "$SLIM_LOCK.work" > "$SLIM_LOCK.work.$$" || true
  if [ -s "$SLIM_LOCK.work.$$" ]; then mv -f "$SLIM_LOCK.work.$$" "$SLIM_LOCK.work"
  else rm -f "$SLIM_LOCK.work.$$" "$SLIM_LOCK.work"; fi
}
slim_sweep() {          # the slim lock is held: what the record says dead runs left
  local pid root dir said
  [ -f "$SLIM_LOCK.work" ] || return 0
  while IFS=$'\t' read -r pid root dir <&4; do
    [ -n "$pid" ] || continue
    # This run's own line, written a moment ago. A dead run that had this pid named
    # another directory, and is judged like any other.
    if [ "$pid" = "$$" ] && [ "$dir" = "$TMPDIR_RUN" ]; then continue; fi
    if said="$(slim_sweep_one "$pid" "$root" "$dir")"; then
      slim_unrecord "$pid" "$dir"
      if [ -n "$said" ]; then slim_say "$said"; fi
    else
      slim_say "left $dir, recorded by a slim (pid $pid) as its unpacked work: $said. Its record stays in $SLIM_LOCK.work."
    fi
  done 4< <(cat "$SLIM_LOCK.work")
}
# 0 when the directory is gone now (prints what was removed, if anything); 1 and why not.
# Another line under this run's own pid is a dead run's (a pid handed out again).
slim_sweep_one() {      # $1 = pid, $2 = the temp root it ran under, $3 = its directory
  local parent="${3%/*}"
  if [ "$1" != "$$" ] && pid_live "$1"; then echo "that pid is running"; return 1; fi
  if [ ! -e "$3" ] && [ ! -L "$3" ]; then return 0; fi
  case "${3##*/}" in keel-backup.??????) ;; *) echo "it is not named as this tool names its own"; return 1 ;; esac
  if [ "${parent%/}" != "$2" ]; then echo "it is not directly under the temp root its record names ($2)"; return 1; fi
  if [ -L "$3" ] || [ ! -d "$3" ]; then echo "it is a link, or not a directory"; return 1; fi
  chmod -R u+rwX "$3" 2>/dev/null || true
  rm -rf "$3"
  if [ -e "$3" ]; then echo "it could not be removed"; return 1; fi
  echo "removed $3, the unpacked work a killed slim left"
}

# The backup's own lock, around a replace. WAITED FOR, by taking it again: the hourly job
# holds it for a minute, and a snapshot already fetched, scanned and proven is worth that
# minute. 1 when it could not be had in SLIM_LOCK_WAIT seconds. It is released by
# lock_release, which removes it only while it names this run.
slim_lock() {
  local waited=0 told=0
  until slim_take "$LOCK"; do
    [ "$waited" -lt "$SLIM_LOCK_WAIT" ] || return 1
    if [ "$told" = 0 ]; then slim_say "waiting for the backup's lock: ${SLIM_SAID:-it is held}"; told=1; fi
    sleep 2; waited=$((waited + 2))
  done
}

# The set's own lists, or its roots, read off an unpacked snapshot instead of the live
# tree. In a subshell: every list changes directory, and the roots are globals.
slim_scan() {           # $1 = set, $2 = the unpacked snapshot, $3 = lists|roots
  ( KEEL_DATA="$2"; HARBOR_HOME="$2"; HELM_HOME="$2"
    case "$3" in
      roots) set_roots "$1" ;;
      # && and not ; (r1.F11): a directory pass that failed must fail the scan, or its
      # short list would read as empty directories the rules had dropped.
      *) set_dir_list "$1" && set_file_list "$1" ;;
    esac )
}

# The set's journal, fetched when the store holds one. NON-ZERO WHEN THE STORE DID NOT
# ANSWER: an unanswered question is not "there is none" (r1.F4).
slim_journal_fetch() {  # $1 = set, $2 = where the journal goes
  local key have; key="$(set_prefix "$1")/slim.json"
  rm -f "$2"
  have="$(store_md5 "$key")" || return 1
  rm -f "$2.stood"
  if [ -n "$have" ]; then store_get "$key" "$2" && cp "$2" "$2.stood" || return 1; fi
}
# THE JOURNAL HAS A SECOND COPY (r3.F1). slim.json is put over its own name, and a put over
# a name is not assumed to be all or nothing; it is also the only thing that says which
# object under slim-old/ is which snapshot's original. So before each put, the journal AS
# IT STOOD in the store (<file>.stood: what was fetched, or last put and seen there) is put
# beside it as slim.json.prev and proven, and copied to work/<set>/ on this machine. The
# previous copy lacks at most the last change, and for a snapshot just rewritten it still
# names the replace, with the md5 of the archive it replaced. Only slim --restore reads it.
slim_journal_put() {    # $1 = set, $2 = the journal
  local key stood="$2.stood" w
  key="$(set_prefix "$1")/slim.json"
  if [ -f "$stood" ]; then
    store_put "$stood" "$key.prev" && same_md5 "$(store_md5 "$key.prev")" "$(md5_of "$stood")" || return 1
    w="$(set_work "$1")"
    mkdir -p "$w" && cp "$stood" "$w/slim.json.prev" || return 1
  fi
  store_put "$2" "$key" || return 1
  if same_md5 "$(store_md5 "$key")" "$(md5_of "$2")"; then cp "$2" "$stood"; fi
}
# 0 when the journal file is one a run can go by: there, and it reads.
slim_journal_reads() {  # $1 = set, $2 = the fetched journal
  [ -f "$2" ] && slim_py journal show "$2" --set "$1" >/dev/null 2>&1
}

slim_record() {         # $1 set, $2 id, $3 state, $4 bytes in the store, $5 bytes after or '', $6 since, $7 plan.json or '', $8 note
  local args=(--run "$SLIM_RUN" --log "$LOGDIR/slim.jsonl" --set "$1" --id "$2" --state "$3"
              --was-bytes "$4" --seconds "$(( $(date +%s) - $6 ))" --at "$(now_iso)")
  if [ -n "$5" ]; then args+=(--now-bytes "$5"); fi
  if [ -n "$7" ] && [ -f "$7" ]; then args+=(--plan "$7"); fi
  if [ -n "$8" ]; then args+=(--note "$8"); fi
  slim_say "$(slim_py record "${args[@]}")"
}

# A PUBLISH OF THIS SNAPSHOT IS PENDING (r1.F1). The hourly job encrypts a snapshot into
# work/<set>/pending/ and publishes from there; one it could not prove in the store stays
# there, and the next hourly run puts it again, first thing. The backup's lock is not held
# while a slim reads a snapshot, so without this a pending blob would be put back over a
# snapshot the slim had just rewritten. A snapshot that pending/ names is skipped for the
# run, and the commit asks again under the lock, where no hourly run can be mid-publish.
slim_pending() {        # $1 = set, $2 = id; 0 when a publish of it is pending
  [ -n "$(find "$(set_work "$1")/pending" -name "$2.*" -print 2>/dev/null | head -1)" ]
}

# EVERY WRITE IS PROVEN BY ONE KEY'S MD5, ASKED OF THE STORE AFTERWARDS (store_md5), and
# asked again for the next write: no listing is kept across two writes (r2.F15). On a
# folder store that hashes the one object written; a listing of the prefix hashed every
# object in the set, three times a snapshot, under the backup's lock. The set's whole
# listing, which status reads, is refreshed once, when the run ends (slim_set).

# A latest.json that names the snapshot being replaced is made to describe what the name
# now holds, so the hourly change test still skips an unchanged tree. The lock is held.
slim_latest() {         # $1 = set, $2 = journal
  local key was="$TMPDIR_RUN/slim-latest-was-$1.json" out="$TMPDIR_RUN/slim-latest-$1.json" have rc=0
  key="$(set_prefix "$1")/latest.json"
  have="$(store_md5 "$key")" || return 1
  [ -n "$have" ] || return 0
  store_get "$key" "$was" || return 1
  slim_py latest --file "$was" --journal "$2" --out "$out" || rc=$?
  if [ "$rc" = 3 ]; then return 0; fi
  [ "$rc" = 0 ] || return 1
  store_put "$out" "$key" || return 1
  mkdir -p "$(set_work "$1")"; cp "$out" "$(set_work "$1")/latest.json"
}

# What step 3 leaves to do once the name holds the new archive, read from the journal's
# own entry so a later run can do it with nothing on disk: the commit point when it names
# this snapshot, the temporary object, and the journal's own word. The lock is held.
slim_finish() {         # $1 = set, $2 = journal
  local s="$1" journal="$2" row id key rest tmp have
  row="$(slim_py journal show "$journal" --set "$s")" || return 1
  [ -n "$row" ] || return 0
  IFS=$'\t' read -r id key rest <<< "$row"
  slim_latest "$s" "$journal" || return 1
  slim_test_at latest
  tmp="$(slim_tmp_key "$s" "$id")"
  have="$(store_md5 "$tmp")" || return 1
  if [ -n "$have" ]; then store_delete "$tmp" || return 1; fi
  slim_test_at cleaned
  slim_py journal done "$journal" --set "$s" || return 1
  slim_journal_put "$s" "$journal" || return 1
  same_md5 "$(store_md5 "$(set_prefix "$s")/slim.json")" "$(md5_of "$journal")"
}

# A snapshot's own name filled from a copy the store holds: fetched, checked against the
# md5 it must have, put over the name, and proven there. The lock is held.
slim_put_over() {       # $1 = the name, $2 = the copy's key, $3 = the md5 it must have
  local back="$TMPDIR_RUN/slim-back.gpg" rc=0
  { store_get "$2" "$back" && same_md5 "$(md5_of "$back")" "$3" && store_put "$back" "$1" \
      && same_md5 "$(store_md5 "$1")" "$3"; } || rc=1
  rm -f "$back"
  return "$rc"
}

# What an interrupted run left: a replace the journal names, and any temporary object.
# EVERYTHING HERE IS JUDGED ON A STORE THAT ANSWERED AND A JOURNAL THAT READ (r1.F4). A
# question the store did not answer, or an unreadable journal, stops the run with nothing
# changed.
#
# THE PUT OVER A NAME IS NOT ASSUMED TO BE ALL OR NOTHING (r1.F5). On a folder store it is a
# rename. On rclone it is whatever the remote does with an upload over a name, which this
# file has checked on no remote but rclone's own local one. So the two copies are in the
# store before that put (the old archive under slim-old/, the new one under slim-tmp/, each
# proven by md5), and what the name is found holding decides:
#   the new archive        the replace happened: it is finished
#   the old archive        it did not: the entry is forgotten and the snapshot done again
#   nothing, and           RETENTION REMOVED IT (r2.F4): a run killed mid-replace leaves a
#   retention's own rule   lock the hourly job breaks half an hour on, and its prune can
#   says the snapshot      then take the snapshot. It is not put back: the journal entry
#   goes                   and both copies kept for the replace are removed, and said.
#   anything else, or      the new archive goes over the name from slim-tmp/, when that copy
#   nothing while          is the one the journal recorded. (An empty name that retention
#   retention would        would have kept was not emptied by retention; dropping its
#   keep it                copies would lose the snapshot, so it is filled.) When the copy
#                          is not the journal's, the run stops, changes nothing, removes
#                          nothing, and names the copy that is good (slim --restore puts
#                          the old archive back). Only a name that is empty with no copy
#                          held anywhere is simply forgotten.
slim_recover() {        # $1 = set, $2 = journal
  local row
  row="$(slim_py journal show "$2" --set "$1")" || return 1
  if [ -n "$row" ]; then slim_recover_one "$1" "$2" "$row" || return 1; fi
  slim_strays "$1" "$2"
}

# The steps below read slim_recover_one's locals (s, journal, id, key, was, md5, have, tmd5,
# omd5, tmp, old, held), as slim_one's steps read its own.
slim_recover_one() {    # $1 = set, $2 = journal, $3 = the journal's replace: id, key, old md5, new md5
  local s="$1" journal="$2" id key was md5 have tmd5 omd5 tmp old held rc=0
  IFS=$'\t' read -r id key was md5 <<< "$3"
  tmp="$(slim_tmp_key "$s" "$id")"; old="$(slim_old_key "$s" "$id")"
  if ! slim_lock; then SLIM_STOP="[$s] another backup run kept the lock for over ${SLIM_LOCK_WAIT}s; run slim again"; return 1; fi
  if ! have="$(store_md5 "$key")" || ! tmd5="$(store_md5 "$tmp")" || ! omd5="$(store_md5 "$old")"; then
    lock_release
    SLIM_STOP="[$s] the store did not answer, so what an interrupted run left at $id was not judged, and nothing was changed"
    return 1
  fi
  held="$(printf '%s' "${have:-nothing}" | tr '\n' ' ')"
  local retired=1
  if [ -z "$have" ]; then
    retired=0; slim_retention_drops "$s" "$key" "$journal" || retired=$?
    if [ "$retired" = 2 ]; then
      lock_release
      SLIM_STOP="[$s] the store did not answer, so what an interrupted run left at $id was not judged, and nothing was changed"
      return 1
    fi
  fi
  if [ "$retired" = 0 ]; then
    slim_retired || rc=1
  elif same_md5 "$have" "$md5"; then
    slim_finish "$s" "$journal" && slim_say "[$s] $id: an interrupted run had replaced it; finished" || rc=1
  elif same_md5 "$have" "$was"; then
    slim_forget "an interrupted run had not replaced it; it is done again from the start" || rc=1
  elif same_md5 "$tmd5" "$md5"; then
    slim_refill || rc=1
  elif [ -z "$have" ] && [ -z "$tmd5" ] && [ -z "$omd5" ]; then
    slim_forget "it is no longer in the store and no copy of it is held; its journal entry is dropped" || rc=1
  else
    slim_stuck; rc=1
  fi
  lock_release
  return "$rc"
}
# Would retention, given the set as the store lists it now with this snapshot put back
# among them, remove this snapshot? Asked of retained_deletions, the one rule there is.
# 0 yes, 1 no, 2 the store did not answer.
slim_retention_drops() {    # $1 = set, $2 = the snapshot's key, $3 = the journal
  local rows="$TMPDIR_RUN/slim-ret-$1.tsv" side="$TMPDIR_RUN/slim-ret-old-$1.tsv" gone
  store_list "$(set_prefix "$1")/snapshots" > "$rows" || return 2
  slim_side "slim-old/$1" "$side" || return 2
  gone="$(slim_retention_list "$1" "$rows" "$side" "$3" "$2")" || return 2
  printf '%s\n' "$gone" | awk -v k="$2" '$0 == k {found = 1} END {exit !found}'
}
# THE ONE QUESTION, ASKED ONE WAY by recovery, restore and purge, so all three give the
# same answer for one snapshot. Retention's rule is run over the set as the store lists
# it, with the snapshots counted back in that are known to have been there: each one the
# journal vouches a kept old archive for (a done rewrite whose recorded old md5 is the
# object under slim-old/; any other object there is nobody's snapshot), and the one being
# asked about. Prints the keys retention would remove.
slim_retention_list() { # $1 = set, $2 = the set's listing, $3 = the listing of slim-old/<set>, $4 = journal, $5 = one more key or ''
  local vouched
  vouched="$(slim_py vouched --old "$3" --journal "$4" --set "$1")" || return 1
  { cut -f1 "$2"; printf '%s\n' "$vouched" "${5:-}"; } | LC_ALL=C sort -u | retained_deletions "$1"
}
slim_retired() {        # the snapshot is retention's to remove: nothing of the replace is kept
  if [ -n "$tmd5" ] && ! store_delete "$tmp"; then return 1; fi
  if [ -n "$omd5" ] && ! store_delete "$old"; then return 1; fi
  slim_forget "retention has removed it since an interrupted run began to replace it. It is not put back: its journal entry and the copies kept for the replace are removed"
}
slim_forget() {         # $1 = why: the journal's replace is dropped, in the store too
  slim_py journal drop "$journal" --set "$s" && slim_journal_put "$s" "$journal" || return 1
  slim_say "[$s] $id: $1"
}
slim_refill() {         # the proven new archive over a name that holds neither, then the finish
  if ! slim_put_over "$key" "$tmp" "$md5" || ! slim_finish "$s" "$journal"; then
    SLIM_STOP="[$s] $id holds neither archive under its own name ($held), and the new one could not be put over it from $tmp, which holds it whole (md5 $md5). This run removed nothing; run slim again."
    return 1
  fi
  slim_say "[$s] $id: its own name held $held, neither archive; the new one was put over it from the copy an interrupted run had proven at $tmp"
}
slim_stuck() {          # no proven new copy: stop, and name what is good
  SLIM_STOP="[$s] $id holds neither archive under its own name ($held; the old one is $was, the new one $md5), and $tmp is not the new one (md5 '$(printf '%s' "$tmd5" | tr '\n' ' ')')."
  if same_md5 "$omd5" "$was"; then
    SLIM_STOP="$SLIM_STOP The old archive is whole at $old: bin/keel backup slim --restore $id --set $s puts it back over the name."
  else
    SLIM_STOP="$SLIM_STOP The store holds no copy of either archive that the journal recorded ($old: md5 '$(printf '%s' "$omd5" | tr '\n' ' ')')."
  fi
  SLIM_STOP="$SLIM_STOP This run changed nothing and removed nothing."
}
# A STRAY IS A TEMPORARY OBJECT NO JOURNAL ENTRY NAMES, in a listing that answered, after a
# journal that read: an upload whose run died before it journalled the replace.
slim_strays() {         # $1 = set, $2 = journal
  local row keep="" stray side="$TMPDIR_RUN/slim-side-$1.tsv"
  row="$(slim_py journal show "$2" --set "$1")" || return 1
  if [ -n "$row" ]; then keep="$(slim_tmp_key "$1" "${row%%$'\t'*}")"; fi
  slim_side "slim-tmp/$1" "$side" || return 1
  while IFS= read -r stray; do
    if [ -z "$stray" ] || [ "$stray" = "$keep" ]; then continue; fi
    store_delete "$stray" || return 1
    slim_say "[$1] removed $stray, a temporary object an interrupted run left"
  done < <(cut -f1 "$side")
}

# Step 3. 0: replaced, proven and journalled (SLIM_NOW is its new size). 3: the store no
# longer holds the snapshot as it was fetched, so it is left alone. 4: slim-old already
# holds a different archive under this id, which is never written over (7 when it is the
# one an earlier rewrite of this snapshot kept). 6: a publish of it became pending while it
# was read. 2: stop the run. Its steps read its locals.
slim_commit() {         # $1 set, $2 id, $3 key, $4 the fetched md5, $5 bytes, $6 work dir, $7 journal
  local s="$1" id="$2" key="$3" was="$4" bytes="$5" d="$6" journal="$7" md5 size tmp old rc=0
  md5="$(md5_of "$d/new.gpg")"; size="$(wc -c < "$d/new.gpg" | tr -d ' ')"
  tmp="$(slim_tmp_key "$s" "$id")"; old="$(slim_old_key "$s" "$id")"
  if ! slim_lock; then
    SLIM_STOP="[$s] stopped at $id: another backup run kept the lock for over ${SLIM_LOCK_WAIT}s. Nothing of $id was written; run slim again to carry on."
    return 2
  fi
  slim_commit_locked || rc=$?
  lock_release
  if [ "$rc" = 0 ]; then SLIM_NOW="$size"; fi
  return "$rc"
}
slim_commit_locked() {
  local have
  if ! have="$(store_md5 "$key")"; then SLIM_STOP="[$s] stopped at $id: the store did not answer"; return 2; fi
  same_md5 "$have" "$was" || return 3
  if slim_pending "$s" "$id"; then return 6; fi
  slim_journal_first || return 2
  slim_keep_old || return $?
  slim_test_at kept
  slim_stage_new || return 2
  slim_test_at uploaded
  slim_journal_replacing || return 2
  slim_test_at journaled
  slim_replace || return 2
  slim_test_at replaced
  if ! slim_finish "$s" "$journal"; then
    SLIM_STOP="[$s] stopped at $id: it is rewritten and proven, but what follows (latest.json, the temporary object, the journal) could not be finished; run slim again and it is."
    return 2
  fi
}
slim_keep_old() {       # 3a: THE OLD ARCHIVE FIRST, kept and proven before anything is put over its name
  local omd5
  if ! omd5="$(store_md5 "$old")"; then SLIM_STOP="[$s] stopped at $id: the store did not answer"; return 2; fi
  if [ -n "$omd5" ] && [ "$omd5" != "$was" ]; then
    # The archive an EARLIER rewrite of this snapshot replaced (r2.F6: slimmed once, and
    # rules added since drop more). The journal vouches for it, and it is not written over.
    if [ "$(slim_py journal was "$journal" --set "$s" --id "$id")" = "$omd5" ]; then return 7; fi
    return 4
  fi
  [ -z "$omd5" ] || return 0
  if ! { slim_copy "$key" "$old" || store_put "$d/old.gpg" "$old"; } || ! same_md5 "$(store_md5 "$old")" "$was"; then
    SLIM_STOP="[$s] stopped at $id: its old archive could not be kept at $old and proven there, so it was not rewritten. $id itself was not written."
    slim_unkeep
    return 2
  fi
}
# A COPY THAT COULD NOT BE PROVEN IS NOT LEFT WHERE THE OLD ARCHIVE BELONGS (r2.F1). It
# would be found there by the next run, or by somebody following a message, as if it were
# the way back. It is removed while the snapshot's own name still holds the archive that
# was fetched (the name is the good copy); if it cannot be, the stop says so and how.
slim_unkeep() {
  local left
  left="$(store_md5 "$old")" || left="?"
  [ -n "$left" ] || return 0
  if same_md5 "$(store_md5 "$key")" "$was" && store_delete "$old"; then return 0; fi
  SLIM_STOP="$SLIM_STOP An object that is not its old archive was left at $old and could not be removed: bin/keel backup slim --purge --unproven $id --set $s removes it."
}
slim_stage_new() {      # 3b: the new archive under its temporary name, proven there
  if ! store_put "$d/new.gpg" "$tmp" || ! same_md5 "$(store_md5 "$tmp")" "$md5"; then
    SLIM_STOP="[$s] stopped at $id: the rewritten archive could not be proven in the store under its temporary name ($tmp, which the next run removes). $id itself was not written."
    return 2
  fi
}
slim_journal_replacing() {  # 3c: the journal names the replace before the name is written
  if ! slim_py journal replacing "$journal" --set "$s" --id "$id" --key "$key" --was-md5 "$was" --md5 "$md5" \
         --was-bytes "$bytes" --bytes "$size" --at "$(now_iso)" --manifest "$(digest_of "$d/manifest.txt")" \
         --files "$(wc -l < "$d/manifest.txt" | tr -d ' ')" --archive-bytes "$(wc -c < "$d/new.tar.gz" | tr -d ' ')" \
         --plan "$d/plan/plan.json" --old-key "$old" --rules "$SLIM_RULES" \
     || ! slim_journal_put "$s" "$journal" \
     || ! same_md5 "$(store_md5 "$(set_prefix "$s")/slim.json")" "$(md5_of "$journal")"; then
    # PROVEN LIKE EVERY OTHER WRITE (r2.F11), before the name is touched: the journal is
    # what tells the next run which copy is which, so a put the store does not show is no
    # journal at all.
    slim_py journal drop "$journal" --set "$s" || true
    SLIM_STOP="[$s] stopped at $id: the journal could not be written to the store and read back there. $id itself was not written."
    return 2
  fi
}
slim_replace() {        # 3d: the new archive over the snapshot's own name, proven there
  local have=""
  if ! store_put "$d/new.gpg" "$key" || ! have="$(store_md5 "$key")" || ! same_md5 "$have" "$md5"; then
    SLIM_STOP="[$s] stopped at $id: the store does not hold it as rewritten (md5 '$(printf '%s' "$have" | tr '\n' ' ')', wanted $md5). The new archive is whole at $tmp and the old one at $old, both proven; run slim again, and it finishes the replace, forgets it, or puts the new archive over the name from that copy. Two md5s mean two objects share the name: rclone --config $RCLONE_CONF dedupe --dedupe-mode newest $(store_base)/$(set_prefix "$s"), then slim again."
    return 2
  fi
}

# A snapshot that is left as it is, with why: one line in the run file, and its work gone.
slim_left() {           # $1 set, $2 id, $3 state, $4 bytes, $5 since, $6 work dir, $7 why
  slim_record "$1" "$2" "$3" "$4" "" "$5" "" "$7"; slim_clean "$6"
}

# ONE SNAPSHOT, IN STEPS. slim_one holds the snapshot's facts as locals (s, id, key, bytes,
# md5, d, kf, canary, root, t0, had, n) and the steps below read and set them: bash scopes a
# local to the function and everything it calls. Each step returns 1 once it has said why
# the snapshot is left as it is (slim_left), and slim_one moves on to the next.
slim_fetch() {          # step 1a: the old archive, fetched as listed, decrypted and unpacked
  if ! store_get "$key" "$d/old.gpg" || ! same_md5 "$(md5_of "$d/old.gpg")" "$md5"; then
    slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "it could not be fetched as the store lists it"; return 1
  fi
  # Decrypted to a file, not a pipe: the archive is read twice, once to unpack it and once
  # for its own list of members.
  if ! gpg_dec "$kf" "$d/old.gpg" > "$d/old.tar.gz" || ! tar -xpzf "$d/old.tar.gz" -C "$d/old"; then
    slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "it does not decrypt and unpack, so it is left as it is"; return 1
  fi
  # THE UNPACKED TREE IS THE ARCHIVE, PATH FOR PATH, OR NOTHING IS PLANNED FROM IT (r1.F3).
  # Everything after this compares unpacked trees, so a path lost in unpacking (two names
  # a volume folds into one, a directory that cannot be listed) would be lost from the
  # rewritten snapshot with every proof passing. tar exits 0 on the first of those.
  if ! slim_py members --archive "$d/old.tar.gz" --tree "$d/old" 2> "$d/plan/why"; then
    cat "$d/plan/why" >&2
    slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "what it unpacked to is not what it names ($(head -1 "$d/plan/why" | sed 's/^ *//')), so it is left as it is"; return 1
  fi
  # old.gpg stays until the commit: proven by md5, it is what the kept old archive is put
  # from when the store cannot copy it by itself.
  rm -f "$d/old.tar.gz"
}

slim_plan() {           # step 1b: the set's own scan over the unpacked tree; n = paths to drop
  if ! slim_scan "$s" "$d/old" lists > "$d/plan/kept" || ! slim_scan "$s" "$d/old" roots > "$d/plan/roots"; then
    slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "it could not be scanned"; return 1
  fi
  set_rules "$s" > "$d/plan/rules"
  set_staged "$s" > "$d/plan/staged"
  if ! n="$(slim_py plan --tree "$d/old" --plan "$d/plan" 2> "$d/plan/why")"; then
    slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "it $(tr '\n' ' ' < "$d/plan/why")so it is left as it is"; return 1
  fi
  # THE PLAN IS THE ONE THE DRY RUN SHOWED, OR NOTHING IS PACKED (r1.F2, r2.F2): the same
  # dropped paths and the same roots (a digest of each), and the same totals by the same rules.
  if [ "$dry" = 0 ] && ! slim_py check --file "$SLIM_APPROVAL" --set "$s" --id "$id" --plan "$d/plan/plan.json" \
       --dropped "$d/plan/dropped.json" --roots "$d/plan/roots" 2> "$d/plan/why"; then
    slim_left "$s" "$id" refused "$bytes" "$t0" "$d" "$(tr '\n' ' ' < "$d/plan/why")"; return 1
  fi
}

# The dry run's record of what it showed for this snapshot, which is all a rewrite may do.
slim_approve() {
  slim_py approve --file "$SLIM_APPROVAL" --set "$s" --id "$id" --md5 "$md5" --bytes "$bytes" \
    --rules "$SLIM_RULES" --plan "$d/plan/plan.json" --dropped "$d/plan/dropped.json" \
    --roots "$d/plan/roots" --at "$(now_iso)"
}

# BEFORE A REWRITE FETCHES ANYTHING (r1.F2): the approval file must cover the object the
# store holds now, under the rules as they are now. 0 to go on; 1 when the snapshot is dealt
# with here (the dry run found nothing to drop, so the journal says so with no fetch; or it
# is refused, and says to run the dry run again); 5 when the dry run has not shown it at
# all, which is not counted against --limit; 2 to stop the run (an approval file that is
# there and does not parse: damage is not an empty file, r2.F8).
slim_gate() {
  local verdict arc=0
  verdict="$(slim_py approved --file "$SLIM_APPROVAL" --set "$s" --id "$id" --md5 "$md5" \
               --rules "$SLIM_RULES")" || arc=$?
  case "$arc:$verdict" in
    0:nothing) slim_nothing || return 2; return 1 ;;
    0:*) return 0 ;;
    3:"the dry run has not shown it"*) slim_left "$s" "$id" unapproved "$bytes" "$t0" "$d" "$verdict"; return 5 ;;
    3:*) slim_left "$s" "$id" refused "$bytes" "$t0" "$d" "$verdict"; return 1 ;;
    4:*) SLIM_STOP="[$s] the approval file $SLIM_APPROVAL does not read ($verdict), so nothing was judged on it and nothing was rewritten. bin/keel backup slim --dry-run --set $s writes it afresh."
         slim_clean "$d"; return 2 ;;
    *) slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "the approval file could not be read"; return 1 ;;
  esac
}

slim_pack() {           # step 2a: the kept members, packed again from the unpacked tree
  if ! ( cd "$d/old" && tar -cf - --null --no-recursion -T "$d/plan/members" ) | gzip -9nc > "$d/new.tar.gz"; then
    slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "it could not be packed again"; return 1
  fi
  # The old canary is read only now, after the pack: opening a board can write beside it,
  # which moves its directory's time, and the proof compares directories' times (r1.F10).
  if canary_ok "$s" "$d/old/$canary"; then had=1; fi
}

slim_prove() {          # step 2b: encrypted, read back, and proven against the old tree
  if ! gpg_enc "$kf" "$d/new.gpg" < "$d/new.tar.gz"; then
    slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "gpg refused to encrypt the rewritten archive, so the old one is left as it is"; return 1
  fi
  if ! gpg_dec "$kf" "$d/new.gpg" | tar -xpzf - -C "$d/new"; then
    slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "the rewritten archive does not decrypt and unpack, so the old one is left as it is"; return 1
  fi
  # Times to the nanosecond where tar carries them (bsdtar's archives do); whole seconds
  # where its format does not (GNU tar's default), which is the format's loss and no fault.
  local times=()
  case "$(tar --version 2>/dev/null)" in *bsdtar*) ;; *) times=(--whole-seconds) ;; esac
  if ! slim_py prove --old "$d/old" --new "$d/new" --plan "$d/plan" --manifest "$d/manifest.txt" \
         ${times[@]+"${times[@]}"} 2> "$d/plan/why"; then
    slim_say "[$s] the rewritten $id is not the old one minus what the rules drop:"
    cat "$d/plan/why" >&2
    slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "the rewritten archive is not the old one minus what the rules drop, so the old one is left as it is"; return 1
  fi
  if [ "$had" = 1 ] && ! canary_ok "$s" "$d/new/$canary"; then
    slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "$canary does not read back from the rewritten archive, so the old one is left as it is"; return 1
  fi
}

slim_nothing() {        # nothing to drop: the journal says it was looked at, the object is not written
  if [ "$dry" = 1 ] && ! slim_approve; then
    slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "the approval file could not be written"; return 0
  fi
  if [ "$dry" = 0 ]; then
    if ! slim_py journal nothing "$journal" --set "$s" --id "$id" --md5 "$md5" --bytes "$bytes" --at "$(now_iso)" \
         --rules "$SLIM_RULES" \
       || ! slim_journal_put "$s" "$journal"; then
      SLIM_STOP="[$s] stopped at $id: the journal could not be written to the store"; slim_clean "$d"; return 2
    fi
  fi
  slim_record "$s" "$id" nothing "$bytes" "" "$t0" "$d/plan/plan.json" ""
  slim_clean "$d"
}

# 0 whatever became of the snapshot (the run file says what), 2 to stop the run with SLIM_STOP.
slim_one() {            # $1 set, $2 id, $3 key, $4 bytes, $5 md5, $6 dry, $7 journal
  local s="$1" id="$2" key="$3" bytes="$4" md5="$5" dry="$6" journal="$7"
  local d="$TMPDIR_RUN/slim-$s-$id" kf canary t0 free need had=0 n rc=0
  kf="$(set_keyfile "$s")"; canary="$(set_canary "$s")"; t0="$(date +%s)"
  slim_clean "$d"; mkdir -p "$d/old" "$d/new" "$d/plan"
  if slim_pending "$s" "$id"; then
    slim_left "$s" "$id" left "$bytes" "$t0" "$d" "a publish of it is pending in $(set_work "$s")/pending, which the next hourly run finishes; it is left for a later slim"
    return 0
  fi
  if [ "$dry" = 0 ]; then
    slim_gate || rc=$?
    case "$rc" in 0) ;; 1) return 0 ;; *) return "$rc" ;; esac
  else
    # Whatever an earlier dry run said of this snapshot is gone until this one has read it.
    slim_py approve --forget --file "$SLIM_APPROVAL" --set "$s" --id "$id" || true
  fi
  free="$(free_mb "$TMPDIR_RUN")"; need=$(( bytes * SLIM_DISK_FACTOR / 1048576 + SLIM_DISK_FLOOR_MB ))
  if [ "${free:-0}" -lt "$need" ]; then
    SLIM_STOP="[$s] stopped before $id: ${free:-0}MB free under $TMPDIR_RUN, and unpacking it wants ${need}MB (its size in the store $SLIM_DISK_FACTOR times over, and ${SLIM_DISK_FLOOR_MB}MB to spare)"
    slim_clean "$d"; return 2
  fi
  slim_fetch || return 0
  slim_plan || return 0
  if [ "$n" = 0 ]; then slim_nothing; return $?; fi
  slim_pack || return 0
  if [ "$dry" = 1 ]; then
    if ! slim_approve; then
      slim_left "$s" "$id" failed "$bytes" "$t0" "$d" "the approval file could not be written"; return 0
    fi
    slim_record "$s" "$id" would-slim "$bytes" "$(wc -c < "$d/new.tar.gz" | tr -d ' ')" "$t0" "$d/plan/plan.json" ""
    slim_clean "$d"; return 0
  fi
  slim_prove || return 0
  slim_test_at prepared
  slim_commit "$s" "$id" "$key" "$md5" "$bytes" "$d" "$journal" || rc=$?
  case "$rc" in
    0) slim_record "$s" "$id" slimmed "$bytes" "$SLIM_NOW" "$t0" "$d/plan/plan.json" ""
       slim_py approve --forget --file "$SLIM_APPROVAL" --set "$s" --id "$id" || true ;;
    3) slim_record "$s" "$id" left "$bytes" "" "$t0" "" "it changed or was pruned while it was being read, so it is left as the store has it" ;;
    4) slim_record "$s" "$id" left "$bytes" "" "$t0" "" "the object at $(slim_old_key "$s" "$id") is not this snapshot's old archive, and is never written over. The snapshot itself is untouched. Remove that object, and nothing else, with: bin/keel backup slim --purge --unproven $id --set $s" ;;
    7) slim_record "$s" "$id" left "$bytes" "" "$t0" "" "it was slimmed before under older rules, and the archive that rewrite replaced is still kept at $(slim_old_key "$s" "$id"), which is never written over. Once that way back is no longer wanted, bin/keel backup slim --purge --id $id --set $s removes that one archive (without --id the purge removes every kept archive of the set), and the next slim rewrites this snapshot" ;;
    6) slim_record "$s" "$id" left "$bytes" "" "$t0" "" "a publish of it is pending in $(set_work "$s")/pending, which the next hourly run finishes; it is left for a later slim" ;;
    *) slim_clean "$d"; return 2 ;;
  esac
  slim_clean "$d"
}

slim_set() {            # $1 = set, $2 = dry; 2 to stop the run
  local s="$1" dry="$2" rows journal stats id key bytes md5 rc
  if [ -z "$(set_rules "$s")" ]; then
    slim_say "[$s] its scan leaves nothing out, so there is nothing to slim"; return 0
  fi
  if [ ! -s "$(set_keyfile "$s")" ]; then
    slim_say "[$s] no passphrase here ($(set_keyfile "$s")), so nothing of it can be read; skipped"; return 0
  fi
  rows="$TMPDIR_RUN/slim-$s.tsv"; journal="$TMPDIR_RUN/slim-$s.json"; stats="$TMPDIR_RUN/slim-$s.stats"
  if ! slim_journal_fetch "$s" "$journal"; then
    SLIM_STOP="[$s] the store ($STORE) did not answer, or its slim.json could not be fetched"; return 2
  fi
  if ! slim_journal_there "$s" "$journal"; then
    SLIM_STOP="${SLIM_STOP:-[$s] the store ($STORE) did not answer}"; return 2
  fi
  if [ "$dry" = 0 ] && ! slim_recover "$s" "$journal"; then
    SLIM_STOP="${SLIM_STOP:-[$s] could not finish what an interrupted run left in the store}"; return 2
  fi
  if ! store_list "$(set_prefix "$s")" > "$rows"; then
    SLIM_STOP="[$s] could not list the store ($STORE)"; return 2
  fi
  # A snapshot is slim under TODAY'S rules or it is looked at again (r2.F6): the journal
  # keeps, with each rewrite, the digest of what decided its drops.
  SLIM_RULES="$TMPDIR_RUN/slim-rules-$s"
  if ! set_decides "$s" > "$SLIM_RULES"; then
    SLIM_STOP="[$s] the text of what decides a drop could not be read out of $SELF_FILE, so nothing is judged"; return 2
  fi
  if ! slim_py candidates --rows "$rows" --journal "$journal" --set "$s" --stats "$stats" --rules "$SLIM_RULES" > "$rows.todo"; then
    SLIM_STOP="[$s] could not read the store's listing"; return 2
  fi
  SLIM_STATS+=(--stats "$s=$stats")
  while IFS=$'\t' read -r id key bytes md5 <&3; do
    [ -n "$id" ] || continue
    if [ "$SLIM_LIMIT" -gt 0 ] && [ "$SLIM_DONE" -ge "$SLIM_LIMIT" ]; then break; fi
    SLIM_DONE=$((SLIM_DONE + 1))
    rc=0; slim_one "$s" "$id" "$key" "$bytes" "$md5" "$dry" "$journal" || rc=$?
    if [ "$rc" = 5 ]; then SLIM_DONE=$((SLIM_DONE - 1)); fi
    if [ "$rc" = 2 ]; then slim_listed "$s" "$dry" || true; return 2; fi
  done 3< "$rows.todo"
  if ! slim_listed "$s" "$dry"; then SLIM_STOP="[$s] could not list the store when the run ended"; return 2; fi
}
# NO JOURNAL IS NOT AN EMPTY JOURNAL when the store holds a slim's copies (r2.F11). A
# rewrite puts an empty journal in the store, and proves it, before it makes its first
# copy, so objects under slim-tmp/<set> or slim-old/<set> with no slim.json mean the
# journal was lost. Read as empty it would say no replace was under way, and the proven
# new copy of one that was would be swept as a stray. So that stops, and removes nothing.
slim_journal_there() {  # $1 = set, $2 = the fetched journal (absent when the store has none)
  local side="$TMPDIR_RUN/slim-side-$1.tsv" n=0 m=0
  [ ! -f "$2" ] || return 0
  if ! slim_side "slim-tmp/$1" "$side"; then return 1; fi
  n="$(awk 'NF {n++} END {printf "%d", n}' "$side")"
  if ! slim_side "slim-old/$1" "$side"; then return 1; fi
  m="$(awk 'NF {n++} END {printf "%d", n}' "$side")"
  if [ "$n" -gt 0 ] || [ "$m" -gt 0 ]; then
    SLIM_STOP="[$1] the store holds a slim's copies ($n under slim-tmp/$1, $m under slim-old/$1) and no $(set_prefix "$1")/slim.json to say what they are. Nothing was changed or removed. Each object under slim-old/$1 is some snapshot's archive from before a rewrite, and may be the only copy of it. bin/keel backup slim --restore <id> --set $1 puts one back under its name, going by the journal's previous copy ($(set_prefix "$1")/slim.json.prev, or the one in $(set_work "$1")), and writes the journal again."
    return 1
  fi
}
slim_journal_first() {  # 3a0: the set's first journal, in the store and proven, before the first copy
  [ ! -f "$journal" ] || return 0
  if ! slim_py journal init "$journal" --set "$s" || ! slim_journal_put "$s" "$journal" \
     || ! same_md5 "$(store_md5 "$(set_prefix "$s")/slim.json")" "$(md5_of "$journal")"; then
    rm -f "$journal"
    SLIM_STOP="[$s] stopped at $id: the journal could not be written to the store and read back there. $id itself was not written."
    return 2
  fi
}
# What status reads, refreshed once when a run ends: the set's listing after a rewrite
# (never by a dry run: that cache is the hourly job's and a rewrite's), and the kept old
# archives either way.
slim_listed() {         # $1 = set, $2 = dry
  if [ "$2" = 0 ]; then refresh_listing "$1" || return 1; fi
  slim_old_cache "$1"
}

# slim --purge: the kept old archives go, and with them the way back. Only the ones
# keel/backupslimjournal.py's purgeable() names: a rewrite the journal marks done (while
# the store holds the slimmed snapshot it recorded, or no snapshot of that id any more
# AND retention's own rule says that snapshot goes, which is how the old archive of a
# snapshot retention removed goes), and a second copy of what a snapshot's own name still
# holds. An unfinished replace keeps its old archive, and so does a snapshot whose name is
# empty while retention would keep it: that archive is its only copy (slim --restore).
slim_purge() {          # $1 = the one set named, or ''; $2 = one snapshot's id, or ''
  local s rows journal side key why n=0 one="${2:-}"
  for s in ${1:-$MY_SETS}; do
    # ONE SET HAS ONE WRITER, and the kept old archives are the only way back from its
    # rewrites: only the host that writes the set removes them (r2.F3), as only it restores.
    writes_set "$s" || die "$HOST does not write the $s set (config.toml [backup] sets is '${MY_SETS}'), and only its writer purges what is kept for it"
    rows="$TMPDIR_RUN/slim-$s.tsv"; journal="$TMPDIR_RUN/slim-$s.json"; side="$TMPDIR_RUN/slim-oside-$s.tsv"
    if ! store_list "$(set_prefix "$s")" > "$rows" || ! slim_journal_fetch "$s" "$journal" \
       || ! slim_side "slim-old/$s" "$side" || ! slim_retention_list "$s" "$rows" "$side" "$journal" > "$side.retired" \
       || ! slim_py purge --old "$side" --rows "$rows" --journal "$journal" --set "$s" --retired "$side.retired" > "$side.go"; then
      die "[$s] could not list the store ($STORE) or read its slim.json; nothing was removed"
    fi
    while IFS=$'\t' read -r key why; do
      [ -n "$key" ] || continue
      # ONE ID (r3.F5): the same rules, for that one kept archive and no other.
      if [ -n "$one" ] && [ "$key" != "$(slim_old_key "$s" "$one")" ]; then continue; fi
      store_delete "$key" || die "[$s] could not remove $key"
      slim_say "[$s] removed $key: $why"; n=$((n + 1))
    done < "$side.go"
    slim_old_cache "$s" || true
  done
  if [ -n "$one" ] && [ "$n" = 0 ]; then
    die "[${1:-$MY_SETS}] nothing was removed for $one: no old archive is kept for it, or it is one a purge keeps (said above, with why)"
  fi
  slim_say "purge: $n old archive(s) removed; what is left is listed by keel backup status"
}

# slim --purge --unproven <id>: one object at slim-old/<set>/<id> that no journal entry
# vouches for (the journal records no rewrite of the snapshot, or records another md5 as
# its old archive), removed while the snapshot's own name holds an object. It is what a
# keep that could not be proven, or a stray upload, leaves; the snapshot is not touched.
slim_purge_unproven() { # $1 = id, $2 = set
  local id="$1" s="$2" journal old key omd5 have recorded=""
  writes_set "$s" || die "$HOST does not write the $s set (config.toml [backup] sets is '${MY_SETS}'), and only its writer removes what is kept for it"
  journal="$TMPDIR_RUN/slim-$s.json"; old="$(slim_old_key "$s" "$id")"; key="$(blob_key "$s" "$id")"
  if ! slim_journal_fetch "$s" "$journal" || ! omd5="$(store_md5 "$old")" || ! have="$(store_md5 "$key")"; then
    die "[$s] the store did not answer; nothing was removed"
  fi
  [ -n "$omd5" ] || die "[$s] there is no object at $old"
  # WITH NO JOURNAL TO ASK, ONLY A SECOND COPY GOES (r3.F1). An absent slim.json reads as
  # "no rewrite recorded" for every object, and one that does not read says nothing, so
  # neither vouches for a removal: the object may be the only copy of the original. The one
  # thing that needs no journal is that it is, byte for byte, what the name holds.
  if ! slim_journal_reads "$s" "$journal"; then
    same_md5 "$have" "$omd5" || die "[$s] the store holds no slim.json that reads, so nothing says what $old is, and it is not what $id's own name holds (md5 '$(printf '%s' "$have" | tr '\n' ' ')'): it may be the only copy of that snapshot's original. It is not removed. bin/keel backup slim --restore $id --set $s puts it back, going by the journal's previous copy."
  else
    recorded="$(slim_py journal was "$journal" --set "$s" --id "$id")" || die "[$s] its slim.json does not read; nothing was removed"
    [ "$omd5" != "$recorded" ] || die "[$s] the journal vouches for it: $old is $id's old archive. slim --purge removes it once its rewrite is done; slim --restore $id puts it back."
    [ -n "$have" ] || die "[$s] the store holds no snapshot $id under its own name, so the object at $old may be all there is of it; it is not removed"
  fi
  store_delete "$old" || die "[$s] could not remove $old"
  slim_old_cache "$s" || true
  slim_say "[$s] removed $old (md5 $(printf '%s' "$omd5" | tr '\n' ' ')): no journal entry records it as $id's old archive. The snapshot itself was not touched."
}

# slim --restore <id>: the kept old archive back over the snapshot's own name, proven by
# md5, the journal's entry for it forgotten, and only then the kept copy removed (the name
# holds it). Under the backup's lock, like the replace it undoes. Its steps read its locals.
slim_restore() {        # $1 = id, $2 = set
  local id="$1" s="$2" journal old key mid=0 have omd5
  writes_set "$s" || die "$HOST does not write the $s set (config.toml [backup] sets is '${MY_SETS}'), and only its writer rewrites it"
  journal="$TMPDIR_RUN/slim-$s.json"; old="$(slim_old_key "$s" "$id")"; key="$(blob_key "$s" "$id")"
  slim_lock || die "another backup run kept the lock for over ${SLIM_LOCK_WAIT}s; nothing was restored"
  slim_restore_read
  slim_restore_put
  slim_restore_latest
  slim_restore_forget
  refresh_listing "$s" || true
  slim_old_cache "$s" || true
  lock_release
  slim_say "[$s] $id is the old archive again (md5 $omd5). Its rewrite is forgotten, so a later slim looks at it afresh."
}
# ONLY THE ARCHIVE THE JOURNAL RECORDED GOES BACK OVER A NAME (r2.F1). The object at
# slim-old/<set>/<id> is put over the snapshot's own name, and that name may hold the only
# good copy, so being there is not enough: the journal must name a rewrite of this
# snapshot (done, or unfinished), and the object's md5 must be the one the journal
# recorded for the archive that rewrite replaced. Anything else stops, having changed
# nothing, and says what it found.
# THE RESTORE, AND ONLY THE RESTORE, GOES BY THE JOURNAL'S PREVIOUS COPY when slim.json is
# absent or does not read (r3.F1): the store's slim.json.prev, or this machine's copy when
# the store has lost that too. What it vouches for is held to the same test: the object
# under slim-old/ must have the md5 that copy recorded for the archive the rewrite
# replaced. The run says which journal it went by, and the journal it then writes is that
# copy without the restored snapshot.
slim_restore_journal() {
  local prev here from="" there=0
  slim_journal_fetch "$s" "$journal" || die "[$s] the store did not answer; nothing was restored"
  if slim_journal_reads "$s" "$journal"; then return 0; fi
  if [ -f "$journal" ]; then there=1; fi
  prev="$(set_prefix "$s")/slim.json.prev"; here="$(set_work "$s")/slim.json.prev"
  rm -f "$journal" "$journal.stood"
  if store_get "$prev" "$journal" 2>/dev/null && slim_journal_reads "$s" "$journal"; then from="$prev in the store"
  elif [ -f "$here" ] && cp "$here" "$journal" && slim_journal_reads "$s" "$journal"; then
    from="$here"
    slim_local_covers
  else
    rm -f "$journal"
    # No journal and no copy of one: a set no slim has written to. It reads as empty.
    if [ "$there" = 0 ]; then return 0; fi
    die "[$s] the store's slim.json does not read, and no previous copy of it does either ($prev, $here), so nothing says what the archive at $old is. Nothing was changed."
  fi
  slim_say "[$s] slim.json is absent or does not read; this restore goes by the journal's previous copy, $from"
  if [ "$from" = "$here" ]; then
    # Said here only as what will happen: the restore has checks still to pass, and the
    # write is announced where it is made (slim_restore_forget).
    SLIM_LOCAL_JOURNAL=1
    slim_say "[$s] the store holds no copy of the journal, so the restore is going by this machine's copy; if it goes through, that copy, without $id, becomes the store's journal"
  fi
}
# THIS MACHINE'S COPY IS ONLY AS NEW AS ITS OWN LAST SLIM. The restore ends by writing the
# journal it went by back to the store, and a local copy with no entry for an archive the
# store keeps would make that archive one nobody recorded. So every object under
# slim-old/<set> must have an entry in the copy (a rewrite done, or the one under way), or
# the restore stops before it changes anything and names the ones that have none.
slim_local_covers() {
  local side="$TMPDIR_RUN/slim-cover-$s.tsv" k sid unknown=""
  slim_side "slim-old/$s" "$side" || die "[$s] the store did not answer; nothing was restored"
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    sid="${k##*/}"; sid="${sid%.tar.gz.gpg}"
    if [ -z "$(slim_py journal was "$journal" --set "$s" --id "$sid")" ]; then unknown="$unknown $sid"; fi
  done < <(cut -f1 "$side")
  [ -z "$unknown" ] || die "[$s] the store holds no copy of the journal, and this machine's copy ($here) is older than the store's kept archives: it has no entry for$unknown, kept under slim-old/$s. Written back as the store's journal it would leave those unrecorded, so nothing was changed. Each is some snapshot's original and may be its only copy; do not remove them."
}
slim_restore_read() {   # what the store and the journal hold, or the restore stops having changed nothing
  local row recorded
  slim_restore_journal
  if ! row="$(slim_py journal show "$journal" --set "$s")" \
     || ! recorded="$(slim_py journal was "$journal" --set "$s" --id "$id")" \
     || ! omd5="$(store_md5 "$old")" || ! have="$(store_md5 "$key")"; then
    die "[$s] the store did not answer or its slim.json does not read; nothing was restored"
  fi
  [ -n "$omd5" ] || die "[$s] no old archive is kept for $id (it was purged, or never rewritten)"
  [ -n "$recorded" ] || die "[$s] the journal has no rewrite of $id, so nothing says what its old archive was (at $old: md5 '$(printf '%s' "$omd5" | tr '\n' ' ')'). Nothing was changed."
  [ -z "$omd5" ] || same_md5 "$omd5" "$recorded" || die "[$s] the object at $old is not the archive the journal recorded as $id's old one (md5 '$(printf '%s' "$omd5" | tr '\n' ' ')' there, $recorded recorded). The snapshot's own name was not written. Nothing was changed; bin/keel backup slim --purge --unproven $id --set $s removes that object."
  # An unfinished replace of this very snapshot is what a restore is the way out of: the
  # old archive goes back over the name whatever it holds, and the replace is forgotten.
  if [ "${row%%$'\t'*}" = "$id" ]; then mid=1; fi
  case "$omd5" in *$'\n'*) die "[$s] two objects share the name $old; look before restoring" ;; esac
  if [ -z "$have" ] && [ "$mid" != 1 ]; then slim_restore_gone; fi
}
# AN EMPTY NAME IS NOT PROOF THAT RETENTION EMPTIED IT (r3.F2). Retention's own rule is
# asked, as recovery asks it: a snapshot it says goes is not put back, and its kept
# archive is the purge's; one it would keep was lost some other way, the kept archive is
# the only copy of it, and it goes back under its name.
slim_restore_gone() {
  local gone=0
  slim_retention_drops "$s" "$key" "$journal" || gone=$?
  case "$gone" in
    0) die "[$s] the store no longer lists $id, and retention's rule says it goes, so it is not put back. Its old archive is still at $old; slim --purge removes it." ;;
    1) slim_say "[$s] the store no longer lists $id, and retention would keep it: the old archive at $old goes back under its name" ;;
    *) die "[$s] the store did not answer, so whether retention removed $id is not known; nothing was restored" ;;
  esac
}
slim_restore_put() {    # the old archive over the name, proven there
  local now=""
  ! same_md5 "$have" "$omd5" || return 0
  if ! slim_copy "$old" "$key" && ! slim_put_over "$key" "$old" "$omd5"; then
    die "[$s] $id could not be put back from $old, which still holds the old archive"
  fi
  now="$(store_md5 "$key")" || die "[$s] the store did not answer after the restore; $old still holds the old archive"
  same_md5 "$now" "$omd5" \
    || die "[$s] $id is not held as the old archive after the restore (md5 '$(printf '%s' "$now" | tr '\n' ' ')', wanted $omd5); $old still holds it"
}
slim_restore_latest() { # a latest.json that names the snapshot says again what it said before
  local key2 was="$TMPDIR_RUN/slim-latest-was-$s.json" out="$TMPDIR_RUN/slim-latest-$s.json" held rc=0
  key2="$(set_prefix "$s")/latest.json"
  held="$(store_md5 "$key2")" || die "[$s] could not read latest.json"
  [ -n "$held" ] || return 0
  store_get "$key2" "$was" || die "[$s] could not read latest.json"
  slim_py unlatest --file "$was" --journal "$journal" --id "$id" --out "$out" || rc=$?
  if [ "$rc" = 3 ]; then return 0; fi
  [ "$rc" = 0 ] || die "[$s] could not work out latest.json"
  store_put "$out" "$key2" || die "[$s] could not write latest.json"
  mkdir -p "$(set_work "$s")"; cp "$out" "$(set_work "$s")/latest.json"
}
slim_restore_forget() { # the journal forgets the rewrite; the kept copy goes last
  if [ "$mid" = 1 ] && ! slim_py journal drop "$journal" --set "$s"; then die "[$s] the journal could not be rewritten"; fi
  if ! slim_py journal forget "$journal" --set "$s" --id "$id" || ! slim_journal_put "$s" "$journal"; then
    die "[$s] $id is the old archive again, but the journal could not be written; run the restore again"
  fi
  if [ "${SLIM_LOCAL_JOURNAL:-0}" = 1 ]; then
    slim_say "[$s] this machine's copy of the journal, without $id, was written back as the store's journal"
  fi
  store_delete "$old" || die "[$s] $id is the old archive again; its kept copy at $old could not be removed"
  # The replace it undid had a temporary object too, which no journal entry names now.
  if [ "$mid" = 1 ] && [ -n "$(store_md5 "$(slim_tmp_key "$s" "$id")" || true)" ]; then
    store_delete "$(slim_tmp_key "$s" "$id")" || slim_say "[$s] the temporary object $(slim_tmp_key "$s" "$id") could not be removed; the next slim removes it"
  fi
}

# AN ID IS A SNAPSHOT ID OR IT REACHES NO PATH (r3.F9). It is spliced into the store's keys,
# and on a folder store one with ../ in it made the kept archive's key and the snapshot's
# own key the same file, a real snapshot.
slim_id() {             # $1 = the flag, $2 = what it was given
  [[ "$2" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || die "$1 takes a snapshot id (like 20260901T000000Z), not '$2'"
}

cmd_slim() {
  SLIM_MODE=1
  local dry=0 only="" s rc sets purge=0 restore="" approved=0 unproven="" one=""
  SLIM_LIMIT=0; SLIM_DONE=0; SLIM_STOP=""; SLIM_NOW=""; SLIM_STATS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --purge) purge=1; shift ;;
      --unproven) unproven="${2:?--unproven needs a snapshot id}"; shift 2 ;;
      --id) one="${2:?--id needs a snapshot id}"; shift 2 ;;
      --restore) restore="${2:?--restore needs a snapshot id}"; shift 2 ;;
      --json) SLIM_JSON=1; shift ;;
      --approved) approved=1; shift ;;
      --limit) SLIM_LIMIT="${2:?--limit needs a number}"
               case "$SLIM_LIMIT" in *[!0-9]*) die "--limit needs a number, not '$SLIM_LIMIT'" ;; esac; shift 2 ;;
      --set) only="${2:?--set needs a set name}"; set_valid "$only" || die "unknown set '$only'; known: $SETS"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  # ONE THING IS ASKED FOR AT A TIME (r3.F9): two of these once resolved silently, the
  # purge winning over a restore named beside it.
  local asked=$((dry + approved + purge))
  if [ -n "$restore" ]; then asked=$((asked + 1)); slim_id --restore "$restore"; fi
  [ "$asked" -le 1 ] || die "slim does one thing at a time: one of --dry-run, --approved, --restore <id>, --purge"
  [ -z "$unproven" ] || slim_id --unproven "$unproven"
  [ -z "$one" ] || slim_id --id "$one"
  [ -z "$one" ] || { [ "$purge" = 1 ] && [ -z "$unproven" ]; } || die "--id goes with --purge alone: slim --purge --id <id> --set <set>"
  need_config
  [ -z "$unproven" ] || [ "$purge" = 1 ] || die "--unproven goes with --purge: slim --purge --unproven <id> --set <set>"
  if [ "$purge" = 1 ] || [ -n "$restore" ]; then
    [ "$dry" = 0 ] || die "--purge and --restore are not dry runs"
    mktmp; ensure_store
    slim_run_lock
    if [ -n "$unproven" ]; then
      slim_purge_unproven "$unproven" "${only:-keel}"
    elif [ -n "$one" ]; then slim_purge "${only:-keel}" "$one"
    elif [ "$purge" = 1 ]; then slim_purge "$only"
    else slim_restore "$restore" "${only:-keel}"; fi
    return 0
  fi
  # NO BARE REWRITE (r1.F2). The dry run is what is read before anything is rewritten, and
  # the rewrite does only what that dry run showed, so each has to be asked for by name.
  if [ "$dry" = "$approved" ]; then
    die "slim rewrites the backups, so it says which: --dry-run shows what would go and writes $SLIM_APPROVAL; --approved rewrites exactly what that file covers"
  fi
  # ONE SET HAS ONE WRITER, and a rewrite is a write. A dry run reads, so it may name any set.
  if [ -n "$only" ] && ! writes_set "$only"; then
    [ "$dry" = 1 ] || die "$HOST does not write the $only set (config.toml [backup] sets is '${MY_SETS}'), and only its writer rewrites it"
  fi
  sets="${only:-$MY_SETS}"
  if [ -z "$sets" ]; then
    say "$HOST writes no backup sets and none was named; nothing to slim"
    return 0
  fi
  mktmp; ensure_store
  slim_run_lock
  SLIM_RUN="$TMPDIR_RUN/slim-run.jsonl"; : > "$SLIM_RUN"
  for s in $sets; do
    rc=0; slim_set "$s" "$dry" || rc=$?
    [ "$rc" != 2 ] || break
  done
  local flags=()
  if [ "$dry" = 1 ]; then flags+=(--dry); fi
  if [ "$SLIM_JSON" = 1 ]; then flags+=(--json); fi
  for s in $sets; do
    if [ -f "$(set_work "$s")/slim-old.tsv" ]; then flags+=(--old "$s=$(set_work "$s")/slim-old.tsv"); fi
  done
  slim_py summary --run "$SLIM_RUN" ${SLIM_STATS[@]+"${SLIM_STATS[@]}"} ${flags[@]+"${flags[@]}"}
  [ -z "$SLIM_STOP" ] || die "$SLIM_STOP"
  # A REWRITE THAT REWROTE NOTHING BECAUSE NOTHING WAS APPROVED HAS NOT DONE WHAT WAS ASKED
  # (r2.F8): every snapshot it came to was one the dry run has not shown.
  if [ "$approved" = 1 ] && [ -s "$SLIM_RUN" ] && ! grep -qv '"state": "unapproved"' "$SLIM_RUN"; then
    die "slim --approved rewrote nothing: the dry run has shown none of these snapshots. Run bin/keel backup slim --dry-run --set <set> first, read what it says, then --approved."
  fi
  if grep -qE '"state": "(failed|refused)"' "$SLIM_RUN"; then
    die "slim: some snapshots could not be read or proven, or were not what the dry run showed, and were left as they are (each says why above)"
  fi
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
cmd_status() {
  local json=0 announce=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --announce) announce=1; shift ;;   # used by the hourly job, not by a status read
      *) die "unknown argument: $1" ;;
    esac
  done
  local last age vlast vage kept size err stale verr s newest plast page
  last="$(state_get last_success)"; age="$(age_seconds "$last")"
  vlast="$(state_get last_verify)"; vage="$(age_seconds "$vlast")"
  plast="$(state_get last_pull)"; page="$(age_seconds "$plast")"
  err="$(state_get last_error)"
  kept="$(snapshot_count)"; size="$(store_mb)"; [ -n "$size" ] || size=0
  stale=0
  if [ -n "$MY_SETS" ] && { [ -z "$age" ] || [ "$age" -gt $((STALE_HOURS * 3600)) ]; }; then stale=1; fi

  # The newest id across this host's sets, as of the last run's listing.
  newest=""
  for s in $MY_SETS; do
    local nid; nid="$(newest_id "$s")"
    if [ -n "$nid" ] && { [ -z "$newest" ] || [ "$nid" \> "$newest" ]; }; then newest="$nid"; fi
  done

  if [ "$announce" = 1 ]; then
    if [ "$stale" = 1 ]; then
      announce_broken "Keel has not backed up in over ${STALE_HOURS}h" \
        "The last successful run on $HOST was $(human_age "$age") ($last). Everything in the sets $MY_SETS since then exists only on this machine. Check: bin/keel backup status, and the log at $LOGDIR/backup.out. This card retires itself on the next successful run."
    elif [ -n "$MY_SETS" ]; then
      clear_broken
    fi
    # The pull's clock, checked hourly by the job that certainly runs, so a pull job that
    # never runs at all (never loaded, a broken plist) is caught too. A pull never run
    # yet counts from when this first noticed it should have.
    if [ "$PULL" = 1 ]; then
      if [ -z "$plast" ]; then
        [ -n "$(state_get pull_expected_since)" ] || state_set pull_expected_since "$(now_iso)"
        page="$(age_seconds "$(state_get pull_expected_since)")"
      fi
      if [ -n "$page" ] && [ "$page" -gt $((PULL_STALE_HOURS * 3600)) ]; then
        announce_pull "Keel backup: no nightly copy for over ${PULL_STALE_HOURS}h" "$(pull_brief)"
      fi
    fi
  fi

  if [ "$json" = 1 ]; then
    local setargs=()
    for s in $MY_SETS; do
      setargs+=("$s|$(set_root "$s")|$(newest_id "$s")|$(set_count "$s")|$(set_mb "$s")|$(slim_old_count "$s")|$(slim_old_mb "$s")")
    done
    "$PY" - "$last" "${age:-}" "$newest" "$kept" "$size" "$vlast" "${vage:-}" "$err" "$stale" "$STORE" \
          "$HOST" "$plast" "$PULL" "$(slim_old_total_mb)" "${setargs[@]}" <<'PY'
import json, sys
last, age, sid, kept, size, vlast, vage, err, stale, store, host, plast, pull, old = sys.argv[1:15]
sets = {}
for line in sys.argv[15:]:
    name, root, newest, count, mb, old_count, old_mb = line.split("|")
    sets[name] = {"root": root, "last_snapshot": newest or None,
                  "snapshots_kept": int(count or 0), "mb": int(mb or 0),
                  # what a slim kept of the archives it rewrote, beside the set (c-724)
                  "slim_old": {"count": int(old_count or 0), "mb": int(old_mb or 0)}}
print(json.dumps({
    "last_success": last or None,
    "age_seconds": int(age) if age else None,
    "last_snapshot": sid or None,
    "snapshots_kept": int(kept or 0),
    "store_mb": int(size or 0),
    # beside the sets and apart from them: the old archives a slim keeps until a purge
    "slim_old_mb": int(old or 0),
    "last_verify": vlast or None,
    "verify_age_seconds": int(vage) if vage else None,
    "last_pull": (plast or None) if pull == "1" else None,
    "last_error": err or None,
    "stale": stale == "1",
    "store": store,
    "host": host,
    "sets": sets,
}))
PY
    return 0
  fi

  echo "store         ${STORE:-NOT CONFIGURED}"
  echo "host          $HOST, writing: ${MY_SETS:-nothing}"
  echo "keys          main $([ -s "$KEYFILE" ] && echo present || echo MISSING), helm $([ -s "$HELM_KEYFILE" ] && echo present || echo absent)"
  if [ -n "$MY_SETS" ]; then
    echo "last success  $(human_age "$age")${last:+  ($last)}$([ "$stale" = 1 ] && echo "   STALE" || true)"
    echo "last snapshot ${newest:-none}"
    echo "retained      $kept snapshots, ${size}MB (as of the last run's listing)"
    if [ "$(slim_old_total_mb)" -gt 0 ]; then
      echo "slim-old      $(slim_old_total_mb)MB more: old archives a slim kept, beside the sets, counted by the size warning"
    fi
    echo "last verify   $(human_age "$vage")${vlast:+  ($vlast)}"
  fi
  [ -n "$err" ] && echo "last error    $err"
  # Separately from last_error, because they fail differently: one means new data is not
  # getting out, the other means what is already out cannot be read back. A status that
  # folded them into one line would hide the second behind a healthy-looking first.
  verr="$(state_get last_verify_error)"
  [ -n "$verr" ] && echo "verify error  $verr"
  if [ "$PULL" = 1 ]; then
    echo "last pull     $(human_age "$page")${plast:+  ($plast)}, mirror $(du -sm "$MIRROR" 2>/dev/null | cut -f1 || echo 0)MB at $MIRROR"
    local perr; perr="$(state_get last_pull_error)"
    [ -n "$perr" ] && echo "pull error    $perr"
  fi

  for s in $MY_SETS; do
    local sid sage
    sid="$(newest_id "$s")"
    sage="$(age_seconds "$(id_to_iso "$sid")")"
    echo
    echo "set $s"
    echo "  source      $(set_root "$s")  ($(set_label "$s"))"
    echo "  last        ${sid:-none}$([ -n "$sid" ] && echo "  $(human_age "$sage")" || true)"
    echo "  retained    $(set_count "$s") snapshots, $(set_mb "$s")MB  (hourly $(set_hourly_days "$s")d, daily $(set_daily_days "$s")d, floor $(( $(set_min_interval "$s") / 60 ))m)"
    # Beside the set, not in it: the archives a slim rewrote, kept as the way back (c-724).
    if [ "$(slim_old_count "$s")" -gt 0 ]; then
      echo "  slim        $(slim_old_count "$s") old archives kept, $(slim_old_mb "$s")MB, until: bin/keel backup slim --purge --set $s"
    fi
  done
  return 0
}

case "${1:-}" in
  # ANNOUNCE_ON_FAIL arms the exit trap above. It is set only for `snapshot`, because
  # that is the unattended one: a hand-run restore that fails is being watched by the
  # person who ran it and does not need a card on a phone. The pull and the verify raise
  # their own, better-worded cards.
  snapshot) shift; ANNOUNCE_ON_FAIL=1; cmd_snapshot "$@"
            cmd_status --announce >/dev/null ;;
  restore)  shift; cmd_restore "$@" ;;
  verify)   shift; cmd_verify "$@" ;;
  pull)     shift; cmd_pull "$@" ;;
  status)   shift; cmd_status "$@" ;;
  init)     shift; cmd_init "$@" ;;
  migrate-from-git) shift; cmd_migrate "$@" ;;
  # The notice verbs themselves (`queue` above), by hand or from a test: the same function
  # every announce_* and clear_* speaks, against whichever board $KEEL_HOME/bin/kb reads.
  notice)   shift; queue "$@" ;;
  slim)     shift; cmd_slim "$@" ;;
  *) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
