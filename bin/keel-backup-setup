#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill for Keel phase 1.6 (<install>/history/docs/vps-plan.md, card c-285).
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

# The backup store, set up once (docs/atlas/85-backup.md). Runs on the machine Keel runs on,
# which has the browser and the GitHub clone. Every stage checks first and skips when
# its check already passes, so a rerun (after the merge, or after a token died) does only
# what is missing. Nothing secret is printed or written anywhere but its one home: the
# Google client secret and token into ~/.keel-backup/rclone.conf (0600), the passphrases
# onto their password-manager cards by bin/keel-backup itself.
#
# In the personal space: no work credentials, no GitHub secrets (the template's set_secret
# and set_var are dropped on purpose).

KEEL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_HOME="${KEEL_BACKUP_HOME:-$HOME/.keel-backup}"
RCONF="$BACKUP_HOME/rclone.conf"
REMOTE=keel-drive                    # config.toml [backup] store = "rclone:keel-drive:keel-backup"
ENV_FILE="$BACKUP_HOME/setup.env"    # only the (public) OAuth client id, for a rerun's default
export SUPPRESS_LABEL_WARNING=True
mkdir -p "$BACKUP_HOME"; chmod 700 "$BACKUP_HOME"

keel() { KEEL_HOME="$KEEL_ROOT" "$KEEL_ROOT/bin/keel" "$@"; }
remote_ok() { [ -s "$RCONF" ] && rclone --config "$RCONF" lsd "$REMOTE:" >/dev/null 2>&1; }
done_note() { printf '  %s✓ %s%s\n' "$GREEN" "$1" "$RESET"; }

TOTAL_STAGES=8

banner "Keel backups: the store moves to Google Drive"

# ── 1. rclone ──────────────────────────────────────────────────────────────
stage "rclone, the store's client"
if command -v rclone >/dev/null 2>&1; then
  done_note "$(rclone version | head -1) is installed"
else
  say "bin/keel-backup talks to Drive through rclone (OAuth refresh and resumable uploads are"
  say "rclone's problem, not a hand-written client's)."
  if confirm "Install it with Homebrew (brew install rclone)?"; then brew install rclone
  else SKIPPED+=("rclone: brew install rclone"); fi
fi
pause

if remote_ok; then
  # Stages 2 to 5 exist to mint the token; with a working one they are four skips.
  for s in "Google Cloud: a project with the Drive API" "The consent screen, PUBLISHED to production" \
           "A desktop OAuth client" "The token, minted once, in rclone.conf"; do
    stage "$s"; done_note "$REMOTE: already answers from $RCONF"
  done
  pause
else
# ── 2. project and API ─────────────────────────────────────────────────────
stage "Google Cloud: a project with the Drive API"
say "Your own OAuth client, not rclone's shared one (that one is rate limited for everybody)."
open_url "https://console.cloud.google.com/projectcreate"
step "Project name: keel-backup. No organisation. Create, then make sure it is the selected project."
pause "Press Enter once the project exists"
open_url "https://console.cloud.google.com/apis/library/drive.googleapis.com"
step "Google Drive API: Enable (in the keel-backup project)."
pause "Press Enter once it says API enabled"

# ── 3. consent screen ──────────────────────────────────────────────────────
stage "The consent screen, PUBLISHED to production"
warn "THIS IS THE TRAP. An app left in Testing gets refresh tokens that die after 7 days,"
warn "and the hourly backup would stop a week from now. It must be In production."
open_url "https://console.cloud.google.com/auth/overview"
step "Google Auth Platform: Get started. App name keel-backup, your Gmail as support email."
step "Audience: External. Contact email: yours. Agree, Create."
open_url "https://console.cloud.google.com/auth/audience"
step "Audience page: Publishing status, click Publish app, then Confirm."
note "The only scope used is drive.file (non-sensitive), so publishing needs no Google review."
note "Since late August 2026 Google greys out Publish app until the Branding page has an"
note "Application home page, an Application privacy policy link, and their domain under"
note "Authorized domains, even for a one-user app. Two small public pages on a domain you own"
note "are enough (the privacy page says: a personal backup tool, it stores nothing about anyone)."
note "Leave the LOGO and the terms link empty, and do NOT click Verify branding: a logo or a"
note "verification request starts a review this app does not need. Publishing unverified is"
note "allowed for a personal app, and it is what stops the 7 day token expiry."
step "Branding page: home page URL, privacy policy URL, Authorized domains, then Save."
note "drive.file lets the token see only files this app made, never the rest of your Drive."
while ! confirm "Does the Audience page now say In production?"; do
  warn "Not yet: a Testing app's token dies in 7 days. Click Publish app, then answer again."
done

# ── 4. OAuth client ────────────────────────────────────────────────────────
stage "A desktop OAuth client"
open_url "https://console.cloud.google.com/auth/clients"
step "Create client. Application type: Desktop app. Name: keel-backup rclone. Create."
step "The dialog shows the Client ID and the Client secret: copy each in turn."
ask GOOGLE_CLIENT_ID "Paste the Client ID (ends .apps.googleusercontent.com):"
ask_secret GOOGLE_CLIENT_SECRET "Paste the Client secret (hidden):"
write_env GOOGLE_CLIENT_ID "$GOOGLE_CLIENT_ID"
note "The secret goes only into $RCONF, in the next stage."

# ── 5. the token ───────────────────────────────────────────────────────────
stage "The token, minted once, in rclone.conf"
say "rclone opens your browser: sign in with the Google account whose Drive holds the"
say "backups, and allow keel-backup to see the files it creates."
note "Google may say the app is unverified: Advanced, then Go to keel-backup. It is your own app."
pause "Press Enter to open the sign-in"
( umask 077
  rclone --config "$RCONF" config create "$REMOTE" drive \
    client_id="$GOOGLE_CLIENT_ID" client_secret="$GOOGLE_CLIENT_SECRET" scope=drive.file ) \
  || warn "rclone config create did not finish"
chmod 600 "$RCONF" 2>/dev/null || true
unset GOOGLE_CLIENT_SECRET
if remote_ok; then done_note "$REMOTE: answers; the token is in $RCONF (0600)"
else SKIPPED+=("the Drive token: rerun this wizard; stage 5 retries it"); warn "$REMOTE: does not answer yet"; fi
pause
fi

# ── 6. init ────────────────────────────────────────────────────────────────
stage "The store, and the helm set's own passphrase"
say "Proves the store from here, and makes the helm set's passphrase (helm gets a key of its"
say "own, which exists on this machine only, so no other key ever reads its review notes)."
say "A new passphrase lands on the board as a card: copy it into your password manager as"
say "\"Keel backup passphrase (helm set)\", then tick the card off."
if remote_ok && confirm "Run keel backup init?"; then
  keel backup init || SKIPPED+=("keel backup init failed; its output is above")
else
  SKIPPED+=("keel backup init (after the token works)")
fi
pause

# ── 7. migration ───────────────────────────────────────────────────────────
stage "The move off GitHub"
say "Copies every retained snapshot from ~/.keel-backup/harbor-data (the GitHub clone) into"
say "the store under sets/<name>/, re-encrypting the helm set under its own passphrase, and"
say "then runs the ordinary weekly verify against the store for all three sets. Rerunnable:"
say "what is already there is not sent again. About 2 GB, so allow some minutes."
if [ -n "$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("migrated_at",""))
except Exception: print("")' "$BACKUP_HOME/state.json")" ]; then
  done_note "migrated already; rerun by hand with: bin/keel backup migrate"
elif remote_ok && confirm "Migrate now?"; then
  keel backup migrate || SKIPPED+=("the migration stopped; rerun it: bin/keel backup migrate")
else
  SKIPPED+=("the migration: bin/keel backup migrate")
fi
pause

# ── 8. the jobs ────────────────────────────────────────────────────────────
stage "The jobs: hourly snapshot, weekly verify, nightly pull"
if [ "$KEEL_ROOT" != "$HOME/keel" ]; then
  warn "This wizard is running from $KEEL_ROOT, not ~/keel: the change is not merged yet."
  say "Approve the card's outcome (that merges it), then run: ~/keel/bin/keel backup install --load"
  say "Until then the old hourly job keeps writing to GitHub, which is harmless: the first new"
  say "run after the merge compares against the store and takes a fresh snapshot."
  SKIPPED+=("after the merge: ~/keel/bin/keel backup install --load (adds the nightly pull)")
elif confirm "Install and load the three jobs (keel backup install --load)?"; then
  keel backup install --load || SKIPPED+=("keel backup install --load failed")
  keel backup run || SKIPPED+=("the first snapshot to the store failed; bin/keel backup status says why")
else
  SKIPPED+=("keel backup install --load")
fi
pause

finish
note "Then archive the GitHub repo (gh repo archive ${KEEL_BACKUP_LEGACY_REPO:-<owner>/<repo>}, [backup] legacy_repo) and delete it after 90 days."
