# --------------------------------------------------------------------------- #
# V7 (card c-312): he picks the engine, the gateway picks the speaker, and the
# chain takes both PER CALL instead of reading two module globals once.
# --------------------------------------------------------------------------- #

def spoken_voice_section():
    print()
    print("== the spoken voice: his engine, the gateway's speaker, both per call ==")

    class Engine:
        """Records the voice it was asked for on every call, and speaks."""

        def __init__(self, name, fails=False):
            self.name = name
            self.ready = True
            self.asked = []
            self.fails = fails

        def synthesize(self, text, voice=""):
            self.asked.append((text, voice))
            if self.fails:
                raise urllib.error.HTTPError("https://example.invalid", 429, "quota", {}, None)
            yield b"\x01\x00" * 50

    def chain_of(*engines, order=None):
        chain = speech.TTSChain(["browser"], cache=None)
        chain.order = list(order or [e.name for e in engines])
        chain.built = {e.name: e for e in engines}
        return chain

    # ---- his word becomes this machine's backend ---------------------------- #
    # THE CONTROL SAYS "kokoro" ON BOTH MACHINES and the backend differs: the Mac runs
    # torch kokoro, the box runs kokoro-onnx. A control that named the backend would be a
    # different control per machine, which is the opposite of V7's last line.
    box = ["google", "kokoro-onnx", "browser"]
    mac = ["google", "kokoro", "elevenlabs", "say", "browser"]
    check("his word resolves to the box's local backend",
          config.resolve_engine("kokoro", box) == "kokoro-onnx",
          config.resolve_engine("kokoro", box))
    check("and to the Mac's, from the same word",
          config.resolve_engine("kokoro", mac) == "kokoro", config.resolve_engine("kokoro", mac))
    check("an engine this machine's chain does not have resolves to nothing",
          config.resolve_engine("kokoro", ["google", "browser"]) == "")
    check("and so does a word nobody defined",
          config.resolve_engine("elevenlabs", mac) == ""
          and config.resolve_engine("", mac) == "")

    # ---- the order one call walks ------------------------------------------- #
    tts = speech.TTSChain(["browser"], cache=None)
    tts.order = list(box)
    check("no choice walks the configured order, exactly as before V7",
          tts._order_for(None) == box and tts._order_for(speech.Spoken()) == box,
          str(tts._order_for(None)))
    check("choosing the engine that is already first changes nothing",
          tts._order_for(speech.Spoken(engine="google")) == box)
    chosen = tts._order_for(speech.Spoken(engine="kokoro"))
    check("choosing the local one puts it first", chosen[0] == "kokoro-onnx", str(chosen))
    # THE PROPERTY THAT MAKES A PER-CALL CHOICE SAFE. A choice REORDERS the chain, it
    # never truncates it: every engine is still in there and `browser` is still last, so
    # a turn he asked Kokoro for cannot go silent because the local model will not build.
    check("and keeps every other engine beneath it, floor included",
          sorted(chosen) == sorted(box) and chosen[-1] == "browser", str(chosen))
    check("a choice this machine cannot honour leaves the order alone",
          tts._order_for(speech.Spoken(engine="elevenlabs")) == box)

    # ---- the automatic fallback survives a choice --------------------------- #
    # HIS CALL AT c-312's PLAN GATE (Q2, 2026-09-20): V7's words were about speed and
    # sound, not about keeping a turn off the network, so a chosen local engine falls
    # through the cloud one like any other rather than dropping to the floor.
    google, local = Engine("google"), Engine("kokoro-onnx", fails=True)
    chain = chain_of(google, local, speech.BrowserTTS(), order=box)
    report = {}
    heard = list(chain.synthesize("All quiet. Nothing needs you.", report,
                                  speech.Spoken(engine="kokoro")))
    check("a chosen local engine that refuses does not mute the turn", len(heard) == 2,
          f"{len(heard)} chunks for two sentences")
    check("the cloud engine beneath it speaks instead", len(google.asked) == 2,
          str(google.asked))
    check("the refused one is asked once and then left alone", len(local.asked) == 1,
          str(local.asked))
    check("and provenance names what ACTUALLY spoke, not what he chose",
          report["engines"] == ["google"], str(report.get("engines")))

    # A DEMOTION MID-ANSWER IS THE CASE PROVENANCE EXISTS FOR: the engine named when the
    # turn starts is a prediction, and this is the record of what happened instead.
    class FirstThenFails(Engine):
        def synthesize(self, text, voice=""):
            self.asked.append((text, voice))
            if len(self.asked) > 1:
                raise urllib.error.HTTPError("https://example.invalid", 500, "boom", {}, None)
            yield b"\x03\x00" * 50

    top, under = FirstThenFails("google"), Engine("kokoro-onnx")
    both = chain_of(top, under, speech.BrowserTTS(), order=box)
    report2 = {}
    list(both.synthesize("One. Two. Three.", report2))
    check("an answer that starts on one engine and finishes on another says both",
          report2["engines"] == ["google", "kokoro-onnx"], str(report2.get("engines")))

    # ---- the voice is the call's, and one engine serves every speaker ------- #
    # THE WHOLE POINT OF THE SEAM. Two calls, two choices, ONE chain and ONE built engine
    # of each kind: nothing is constructed twice and no module global is touched, which
    # is what "per call, not two module globals" has to mean in practice.
    was_google, was_local = config.GOOGLE_TTS_VOICE, config.TTS_VOICE
    g2, l2 = Engine("google"), Engine("kokoro-onnx")
    shared = chain_of(g2, l2, speech.BrowserTTS(), order=box)
    list(shared.synthesize("Hello there.", None, speech.Spoken(engine="google")))
    list(shared.synthesize("Hello there.", None, speech.Spoken(engine="kokoro")))
    check("one chain served both choices without building anything twice",
          len(g2.asked) == 1 and len(l2.asked) == 1 and len(shared.built) == 3,
          f"{len(g2.asked)} / {len(l2.asked)} / {sorted(shared.built)}")
    check("each engine was handed ITS OWN voice on the call",
          g2.asked[0][1] == config.GOOGLE_TTS_VOICE and l2.asked[0][1] == config.TTS_VOICE,
          f"{g2.asked[0][1]!r} / {l2.asked[0][1]!r}")
    check("and neither global moved",
          (config.GOOGLE_TTS_VOICE, config.TTS_VOICE) == (was_google, was_local))

    # ---- the speaker is a role, and there are two of them ------------------- #
    check("the speaker resolves to the right voice per backend",
          config.voice_id("google") == config.GOOGLE_TTS_VOICE
          and config.voice_id("kokoro-onnx") == config.TTS_VOICE
          and config.voice_id("say") == config.TTS_SAY_VOICE)
    check("an engine with no voice of its own says so rather than guessing",
          config.voice_id("browser") == "" and config.voice_id("elevenlabs") == "")
    # A ROLE NOBODY HAS DEFINED MUST COST A FAMILIAR VOICE, NEVER THE TURN, inside the one
    # method whose rule is degrade-never-mute.
    check("a speaker nobody has defined falls back to Harbor's voice",
          config.voice_id("google", "nobody") == config.GOOGLE_TTS_VOICE
          and config.voice_id("google", "") == config.GOOGLE_TTS_VOICE)
    check("there are two speakers and a house is the second",
          config.SPEAKERS == (config.SPEAKER_HARBOR, config.SPEAKER_HOUSE))

    # ---- ONE VOICE THROUGHOUT (V13, 2026-09-21) ----------------------------- #
    # HIS DECISION, AND IT REVERSES V8's SECOND VOICE. In his words: "the way we should
    # play this out is Harbor entering and exiting a house so that we keep the same Harbor
    # voice; Harbor enters, the house responds, but it feels like Harbor is the one
    # speaking; similarly it exits." So the SPEAKER is still recorded, because the page's
    # header and the transcript still have to say which house said a thing, and the VOICE
    # no longer follows it. The two questions are separated by one function, and this is
    # the assertion that keeps them separated: an engine added to `HARBOR_VOICE_TTS`
    # tomorrow cannot quietly bring a second voice back.
    check("the voice is Harbor's whoever the speaker is",
          config.voice_speaker(config.SPEAKER_HOUSE) == config.SPEAKER_HARBOR
          and config.voice_speaker(config.SPEAKER_HARBOR) == config.SPEAKER_HARBOR)
    split = [name for name in config.TTS_CHAIN
             if config.voice_id(name.strip())                # it has a voice of its own
             and config.voice_id(name.strip())
             != config.voice_id(name.strip(), config.SPEAKER_HOUSE)]
    check("no engine in the chain speaks a house in a voice of its own any more",
          not split, f"these still do: {split}")
    check("and the clip cache cannot key one line two ways either",
          speech.voice_id_for("google", config.SPEAKER_HOUSE)
          == speech.voice_id_for("google")
          and corpus.Line("Right.", "handoff", "handoff", config.SPEAKER_HOUSE).audio_key
          == corpus.Line("Right.", "handoff", "handoff").audio_key)
    # THE FLOOR IS THE ONE THAT COULD STILL DIFFER, because the gateway sends no samples
    # there and the page says the words with its own synthesiser off the `speak` message.
    # So the message carries the VOICE and not the record, which is what keeps the page's
    # second-system-voice branch from ever firing without the page having to change.
    check("the floor is told whose VOICE speaks, not whose words they are",
          "voice_speaker" in (PKG / "harbor_voice" / "server.py").read_text())

    # ---- the tone under the words (V8, one tone since V13) ------------------ #
    # IT IS A MARKER AND NO LONGER A DIRECTION. Two sounds asked him to remember which was
    # which; with one voice either side of the switch, the line itself says which way it
    # went ("Entering card 272" against "Leaving card 272"), so the tone only has to say
    # that a switch happened at all. The words can be lost to a bad connection and a short
    # note of arithmetic cannot fail the way a spoken line can, which is why it stays.
    tone = speech.tone_pcm()
    check("the tone is one short note",
          60 <= 1000 * len(tone) / 2 / config.TTS_RATE <= 160,
          f"{1000 * len(tone) / 2 / config.TTS_RATE:.0f} ms")
    check("and it is the same sound on the way in and on the way out",
          speech.tone_pcm() == tone)
    check("and it neither clicks nor drowns the line after it",
          abs(array.array("h", tone[:2])[0]) < 100
          and max(abs(x) for x in array.array("h", tone)) < 0.3 * 32767)

    # ---- the rendered clips belong to ONE engine ---------------------------- #
    # A CACHE HIT ASKS NO QUESTIONS, which is the bug found on 2026-09-04 by reading the
    # meter. With a per-call engine the same hazard returns in a new shape: a clip
    # rendered in Charon played inside a turn he asked Kokoro for, so the turn opens in
    # one voice and continues in another.
    class Cache:
        def __init__(self):
            self.asked = []

        def read(self, text, voice=None):
            self.asked.append(voice)
            return b""

        def stats(self, lines=None, voice=None):
            return {}

    cache = Cache()
    keyed = speech.TTSChain(["browser"], cache=cache)
    keyed.order = list(box)
    keyed.built = {"google": Engine("google"), "kokoro-onnx": Engine("kokoro-onnx"),
                   "browser": speech.BrowserTTS()}
    list(keyed.synthesize("Right.", None, speech.Spoken(engine="kokoro")))
    list(keyed.synthesize("Right.", None, speech.Spoken(engine="google")))
    check("the cache is read under the engine of THIS call, not the preferred one",
          cache.asked == [f"kokoro-onnx:{config.TTS_VOICE}",
                          f"google:{config.GOOGLE_TTS_VOICE}"], str(cache.asked))
    check("and the render side builds the same key from the same function",
          speech.voice_id_for("google") == speech.preferred_voice_id()
          if (config.TTS_CHAIN or [""])[0].strip() == "google" else True)
    check("an engine with no voice of its own keys as its bare name",
          speech.voice_id_for("browser") == "browser")

    # ---- a chosen fallback is not let go while it is the voice -------------- #
    # `_covered` asks whether something AHEAD IN THE CONFIGURED ORDER is up, which was
    # the whole truth until a choice could put an engine that is not first in front:
    # with Kokoro chosen, Google is up and ahead, so the local model read as covered and
    # was dropped after ten idle minutes. The next turn he asked to be local would open
    # on `browser` while 556 MB rebuilt.
    class Local:
        name = "kokoro-onnx"
        ready = True
        unload_after = 600.0

        def synthesize(self, text, voice=""):
            yield b"\x02\x00"

    keep = speech.TTSChain(["browser"], cache=None)
    keep.order = list(box)
    now = time.time()
    keep.built = {"google": Engine("google"), "kokoro-onnx": Local(),
                  "browser": speech.BrowserTTS()}
    keep._used = {"google": now, "kokoro-onnx": now}
    list(keep.synthesize("Local, please.", None, speech.Spoken(engine="kokoro")))
    check("the engine that just spoke is never let go, however idle it looks",
          keep.unload_idle(now + 10_000) == [], str(keep.unloaded))
    keep._spoke_last = "google"
    check("and once something else is the voice, it is a fallback again and goes",
          keep.unload_idle(now + 10_000) == ["kokoro-onnx"], str(keep.unloaded))

    # ---- what the page is told, and what it may say ------------------------- #
    offered = config.engines_for_page(box)
    check("the control is offered only the engines this machine's chain has",
          [e["id"] for e in offered] == ["google", "kokoro"], str(offered))
    check("and each one carries the backend behind it, so provenance can be named",
          [e["backend"] for e in offered] == ["google", "kokoro-onnx"], str(offered))
    check("a chain with one family offers one, and the page hides a one-value control",
          [e["id"] for e in config.engines_for_page(["google", "browser"])] == ["google"])

    # THE RECORDED FACT, so the control is not sold as something it is not. The box
    # benchmark of 2026-09-18: kokoro-onnx is 4.97 s for 12 words and 14.8 s for 44, with
    # no streaming advantage. V7's "Kokoro is faster" holds on Apple silicon and NOT here.
    check("on Apple silicon the local engine is called faster",
          "faster" in config.kokoro_note("darwin"), config.kokoro_note("darwin"))
    check("on the box it is called about real time, with the measured number",
          "real time" in config.kokoro_note("linux")
          and "4.97" in config.kokoro_note("linux"), config.kokoro_note("linux"))
    check("and the box's note never claims speed",
          "faster" not in config.kokoro_note("linux"), config.kokoro_note("linux"))

    flags = config.flags_for_page()
    check("flags.js carries the default and the list, so the page copies neither",
          flags["engineDefault"] == config.ENGINE_DEFAULT
          and flags["engines"] == config.engines_for_page(), str(flags.get("engines")))
    js = config.flags_js().decode()
    check("and they reach the page through the one script it already loads",
          '"engineDefault"' in js and '"engines"' in js)

    app = page_js(HERE.parent)
    html = (HERE.parent / "segments" / "voice" / "app" / "index.html").read_text()
    check("the page reads the list rather than hardcoding an engine",
          "FLAGS.engines" in app and "FLAGS.engineDefault" in app)
    check("it remembers his choice the way it remembers the mode",
          'stored("engine")' in app and 'store("engine"' in app)
    check("and sends it on the release, beside the mode and the space",
          'engine: state.engine' in app and '"end"' in app)
    # THE ENGINE IS A SETTING PICKED ONCE A SESSION, so since the rebuild (VP-1) it lives in
    # the sheet beside the chain it reorders, and adds nothing to the main screen.
    check("the control lives in the sheet and adds no top-level element to the page",
          'id="engineswitch"' in app and "V.cycleEngine()" in app
          and 'id="voicebtn"' not in html)

    # ---- the choice travels the whole way ----------------------------------- #
    # END TO END, through the real socket handler's own message shape: what the page
    # sends is what the chain is handed. Nothing between them keeps a copy.
    spoken = []
    d = _dispatcher({}, spoken)
    d.capture("a thought", space="personal", engine="kokoro")
    check("a capture carries his engine to the speaker",
          spoken and spoken[-1][2] is not None
          and getattr(spoken[-1][2], "engine", "") == "kokoro", str(spoken[-1:]))
    check("and the turn records which engines answered it",
          d.turn.spoke_with == ["fake"], str(d.turn.spoke_with))
    check("the turn's JSON carries both, for the page's provenance line",
          d.turn.as_json()["engine"] == "kokoro"
          and d.turn.as_json()["spokeWith"] == ["fake"], str(d.turn.as_json()["spokeWith"]))
    server_src = (PKG / "harbor_voice" / "server.py").read_text()
    check("the socket reads it off the `end` message and hands it on",
          'msg.get("engine")' in server_src and server_src.count('msg.get("engine")') == 2,
          "once for `end` and once for `text`")
    check("and the gateway keeps no copy of it, the way it keeps no mode",
          "self.engine" not in server_src and "self.mode" not in server_src)


# --------------------------------------------------------------------------- #
# The narration table. It used to read a stopwatch out loud.
# --------------------------------------------------------------------------- #

def narration_section():
    print()
    print("== the narration says state, never a clock ==")

    # THE REGRESSION, written as the sentence that must never come back. "still working,
    # twelve seconds" was spoken aloud twice on 2026-09-03 and named as wrong.
    joined = " ".join(dispatcher.NARRATION.values()).lower()
    for word in ("second", "minute", "elapsed", "still working"):
        check(f"no narration line contains {word!r}",
              not re.search(rf"\b{word}s?\b", joined),
              f"the table says: {joined}")
    # AND NO LINE COUNTS ANYTHING, which is the other half of "never a clock": a number
    # in a spoken line is almost always a stopwatch being read out.
    #
    # `busy` IS THE ONE EXCEPTION AND IT IS NOT A CLOCK. "One at a time, I'm still on the
    # last one" counts TURNS, not seconds, and it is the whole content of the sentence:
    # he said a third thing while one turn was running and one was waiting, and what he
    # needs to hear is that there is already a queue of one. Named here rather than
    # loosening the screen for every line.
    counting = " ".join(v for k, v in dispatcher.NARRATION.items() if k != "busy").lower()
    for word in ("one", "two", "three", "four", "five", "six", "seven", "eight",
                 "nine", "ten", "eleven", "twelve"):
        check(f"no narration line counts {word!r}",
              not re.search(rf"\b{word}s?\b", counting),
              f"the table says: {counting}")
    check("there is no `elapsed` trigger at all", "elapsed" not in dispatcher.NARRATION)

    # Every line still has to be a sentence a person would say, which mostly means it
    # ends in a full stop and does not read as a log record.
    for kind, line in dispatcher.NARRATION.items():
        # `card` is V5's late-answer preface, which names the card he asked about.
        spoken = line.format(name="voice2", title="a card", card="c-272")
        check(f"narration {kind!r} is a sentence", spoken.strip().endswith("."), spoken)
        check(f"narration {kind!r} reads as speech, not a log record",
              not set(spoken) & set("[]{}<>|="), spoken)

    # WHAT REPLACED IT, AND THEN WHAT REPLACED THAT. The stopwatch line became a question
    # to harbor-session-state ("is Harbor's pane blocked?") narrated only when the answer
    # was `blocked`, which was a fact about his question rather than about the clock. The
    # cutover removed the pane, and with it the only thing that mark could observe. So
    # the mark now passes in silence, and this is written as the regression: a dispatcher
    # that reaches for a pane again is a dispatcher asking a question nothing can answer.
    # COMMENTS STRIPPED, the same way authority_section does it and for the same reason
    # it had to learn to: the note in dispatcher.py that RECORDS what was removed names
    # the thing it removed, and a guard that reads its own explanation as a violation is
    # a guard that punishes writing one down.
    src = (PKG / "harbor_voice" / "dispatcher.py").read_text()
    code = "\n".join(line for line in src.splitlines()
                     if not line.strip().startswith("#"))
    check("the twelve-second mark no longer asks anything about a pane",
          "pane_state(" not in code and "_ask_pane_state" not in code,
          "there is no pane: a headless turn is running or it is finished")
    check("and no narration line is reached from a pane's state",
          '== "blocked"' not in code and "blocked" not in dispatcher.NARRATION,
          str(sorted(dispatcher.NARRATION)))
    check("the narration table still renders every line it is asked for",
          'NARRATION[kind]' in code)
    check("and the failure sentence names a destination that exists",
          "pane" not in dispatcher.NARRATION["undelivered"],
          dispatcher.NARRATION["undelivered"])


# --------------------------------------------------------------------------- #
# What was heard, repaired. It must fix the observed errors and touch nothing else.
# --------------------------------------------------------------------------- #

def hearing_section():
    print()
    print("== the transcript repair fixes what was observed and invents nothing ==")

    # The two real ones, from his own voice, 2026-09-03.
    got, _ = hearing.repair("Hmm, so you are doing the routing wrong. "
                            "You should have sent this to Harper.")
    check("`Harper` is read as Harbor (transcript turn 16, a 29-second round trip)",
          "Harbor" in got and "Harper" not in got, got)
    got, _ = hearing.repair("Why do you need to send that into Harbor Spain?")
    check("`Harbor Spain` is read as Harbor's pane (transcript turn 7)",
          "Harbor's pane" in got, got)

    # THE COST SIDE. Ordinary English containing every near-miss the rejected phonetic
    # matcher wanted to rewrite. If any of these changes, the table has started guessing.
    for said in ("That was harder than I thought and I am in pain",
                 "is there a plane to Spain next week",
                 "the labour of it was harder than Harvard",
                 "conduct a review of the panel and the ledge",
                 "I heard the header was hard to read"):
        got, changed = hearing.repair(said)
        check(f"ordinary English is untouched: {said!r}", got == said and not changed,
              f"it became {got!r}")

    # It reports what it did, or the table cannot be audited.
    got, changed = hearing.repair("what is harbour doing")
    check("a repair is reported, not made silently", changed == [("harbour", "Harbor")],
          str(changed))

    # AND THE REPORT HAS TO ARRIVE SOMEWHERE A PERSON LOOKS. It did not, for one commit:
    # server broadcast {"type": "heard"} and app.js switches on msg.type over exactly
    # three names, so the page dropped it in silence while this file's docstring claimed
    # visibility as its safety argument.
    #
    # THESE RUN THE CODE RATHER THAN GREPPING IT. The first version of this block matched
    # source strings, which passes when a variable is renamed and the product breaks, and
    # fails when the product is fine and a line was reflowed. Review said so and was
    # right. `on_text` needs only a broadcast and a dispatcher, so it is called as an
    # unbound function against a stand-in, which exercises the real message-building.
    sent = []
    fake = type("S", (), {
        "broadcast": lambda _self, obj: sent.append(obj),
        "dispatcher": type("D", (), {"generation": 4,
                                     "answer": staticmethod(lambda *a, **k: None)})(),
        # c-314: `on_text` now asks whether a half sentence is being held before it
        # dispatches, and dispatches through one place. A typed line reaches neither the
        # judge seat nor the conversation words (both are `released_at is not None`), so
        # these two are the whole of what this stand-in needs.
        "take_partial": lambda _self: None,
        "dispatch": lambda _self, said, **kw: None,
    })()
    servermod.Gateway.on_text(fake, "what is harbour doing",
                                  [("harbour", "Harbor")])
    msg = sent[0] if sent else {}
    check("the repair rides on the transcript message the page already handles",
          msg.get("type") == "transcript"
          and msg.get("repairs") == [{"heard": "harbour", "readAs": "Harbor"}], str(msg))

    # And the turn writes it to the transcript FILE, which is the auditable half.
    with tempfile.TemporaryDirectory() as tmp:
        d = _dispatcher(fixture(), [], tmp=Path(tmp))
        d.answer("what is harbour doing", [("harbour", "Harbor")])
        rows = [json.loads(x) for x in
                (Path(tmp) / "transcript.jsonl").read_text().splitlines()]
        said = [r for r in rows if r["kind"] == "said"]
        check("and the transcript records it, so the table can be audited",
              bool(said) and said[0].get("repairs")
              == [{"heard": "harbour", "readAs": "Harbor"}],
              str(said[:1]))

    # ONE SPELLING FOR ONE FIELD, across both audiences. They differed for one commit.
    check("the websocket and the transcript spell the field the same way",
          msg.get("repairs") == said[0].get("repairs"),
          f"{msg.get('repairs')} vs {said[0].get('repairs')}")

    # The page is not Python and cannot be exercised here, so this pair IS a text check,
    # and it is a narrow one: that the field is read and that it has somewhere to show.
    app = page_js(HOME)
    check("the page reads the repairs off the message it already handles",
          "msg.repairs" in app and "t.repairs" in app)
    css = (HOME / "segments" / "voice" / "app" / "app.css").read_text()
    check("and there is a style for it, so it is not invisible text", ".v-heard" in css)

    # Every target has to be a real name, or this is a place vocabulary gets invented.
    vocab = (HOME / "etc" / "dictation-vocabulary.md").read_text().lower()
    spoken = "pane ledger queue conductor briefing card gate notice board"
    unknown = sorted({t.lower().strip(".,'s") for t in
                      (list(hearing.WORDS.values()) + list(hearing.PHRASES.values()))
                      for t in re.split(r"[-\s']+", t)
                      if t and t.lower() not in vocab and t.lower() not in spoken})
    check("every repair target is a name this repository already uses", not unknown,
          f"{unknown}: the vocabulary has one home and it is not this table")

    # And it can never run away: one word must not become a different word forever.
    once, _ = hearing.repair("harbour")
    twice, _ = hearing.repair(once)
    check("repairing twice changes nothing the second time", once == twice,
          f"{once!r} then {twice!r}")


# --------------------------------------------------------------------------- #
# c-286: the box's speech. sherpa-onnx behind make_stt, kokoro-onnx beneath Google, and
# the fallback voice let go when nothing has needed it for ten minutes.
# --------------------------------------------------------------------------- #

def box_speech_section():
    print()
    print("== the box hears through sherpa-onnx and lets an idle fallback voice go ==")
    from harbor_voice import onnx                                       # noqa: PLC0415

    # A NAMED BACKEND THAT WILL NOT LOAD IS A REPORTED FACT, NOT A CRASH. Under systemd a
    # raise here is a restart loop with nothing on /voice/health to say why.
    real_models = config.MODELS_DIR
    config.MODELS_DIR = Path(tempfile.mkdtemp())
    try:
        missing = speech.make_stt("sherpa")
    finally:
        config.MODELS_DIR = real_models
    check("a missing sherpa model is NoSTT with the reason, never an exception",
          missing.name == "none" and "sherpa-onnx" in missing.why, getattr(missing, "why", ""))
    check("and the aliases a person would type select the same backend",
          speech.STT_ALIASES["sherpa-onnx"] == "sherpa" and speech.STT_ALIASES["mlx"] == "parakeet")
    try:
        speech.make_stt("whisper-of-the-week")
        unknown = False
    except ValueError:
        unknown = True
    check("an unknown backend name is still refused loudly", unknown)
    check("the 110M is the default and the 0.6B is one alias away",
          onnx.model_dir("parakeet-110m").name.startswith("sherpa-onnx-nemo-parakeet_tdt_ctc_110m")
          and onnx.model_dir("parakeet-0.6b").name.endswith("0.6b-v2-int8")
          and onnx.model_dir().name == onnx.model_dir(config.SHERPA_MODEL).name,
          str(onnx.model_dir()))
    check("a path names a model directory directly",
          onnx.model_dir("/opt/m/x") == Path("/opt/m/x"), str(onnx.model_dir("/opt/m/x")))

    # THE REAL MODEL, where this interpreter has it: one silent second must come back as
    # a string. The box's venv has sherpa-onnx; the Mac's does not, and says so.
    try:
        import sherpa_onnx  # noqa: F401, PLC0415
        have = (onnx.model_dir() / "tokens.txt").is_file()
    except ImportError:
        have = False
    if have:
        stt = onnx.SherpaSTT()
        check("sherpa-onnx transcribes PCM16 from memory", stt.transcribe(b"\x00\x00" * 16000) == ""
              and stt.transcribe(b"") == "")
    else:
        print("  skip  sherpa-onnx or its model is not in this interpreter (the Mac's venv)")

    # THE CHAIN LETS AN IDLE FALLBACK GO, and only a fallback.
    class Hosted:
        name = "google"
        ready = True

        def synthesize(self, text, voice=""):
            yield b"\x01\x00"

    class Local:
        name = "kokoro-onnx"
        ready = True
        unload_after = 600.0

        def synthesize(self, text, voice=""):
            yield b"\x02\x00"

    chain = speech.TTSChain(["browser"], cache=None)
    chain.order = ["google", "kokoro-onnx", "browser"]
    now = time.time()
    chain.built = {"google": Hosted(), "kokoro-onnx": Local(), "browser": speech.BrowserTTS()}
    chain._used = {"google": now, "kokoro-onnx": now}
    check("a fallback idle less than its limit is kept", chain.unload_idle(now + 599) == [])
    chain._busy["kokoro-onnx"] = 1
    check("a fallback in the middle of a sentence is never let go",
          chain.unload_idle(now + 601) == [])
    chain._busy["kokoro-onnx"] = 0
    chain.demoted["google"] = {"why": "HTTPError 429", "at": now, "until": now + 10_000}
    check("while the voice above it is demoted, the fallback IS the voice and stays",
          chain.unload_idle(now + 601) == [])
    chain.demoted.clear()
    check("idle past its limit with the hosted voice up, it is let go",
          chain.unload_idle(now + 601) == ["kokoro-onnx"] and "kokoro-onnx" not in chain.built)
    idle = chain.as_json()["idle"]
    check("and /voice/health says it was unloaded rather than silently missing it",
          "unloadedSecondsAgo" in idle.get("kokoro-onnx", {}), str(idle))
    check("an engine that does not declare unload_after is never let go",
          "google" in chain.built and chain.unload_idle(now + 10**6) == [])

    # SPEAKING MARKS IT USED, and the mark is cleared even when the answer is cut off.
    chain.built["kokoro-onnx"] = Local()
    chain.built["google"] = type("Refuses", (), {
        "name": "google", "ready": True,
        "synthesize": lambda self, text, voice="": (
            (_ for _ in ()).throw(RuntimeError("quota")))})()
    gen = chain.synthesize("First sentence. Second sentence.")
    next(gen)
    check("a sentence being spoken holds its engine busy", chain._busy.get("kokoro-onnx") == 1,
          str(chain._busy))
    gen.close()
    check("and a barge-in that closes the answer releases it",
          chain._busy.get("kokoro-onnx") == 0, str(chain._busy))

    check("kokoro-onnx is a chain backend and owns its own cache key",
          speech.TTS_BACKENDS["kokoro-onnx"] is onnx.KokoroOnnxTTS
          and onnx.KokoroOnnxTTS.name == "kokoro-onnx")

    # THE ADAPTER'S MISHEARINGS: merged, traced, and invented nowhere.
    check("every adapter's hearing table loads cleanly", hearing.ADAPTER_ERRORS == [],
          str(hearing.ADAPTER_ERRORS))
    for path in sorted(config.ADAPTERS_DIR.glob("*/hearing.json")):
        data = json.loads(path.read_text())
        entries = {**data.get("phrases", {}), **data.get("words", {})}
        others = "\n".join(p.read_text(errors="ignore").lower()
                           for p in path.parent.rglob("*.py")).lower()
        unknown = sorted({e["said"] for e in entries.values() if e["said"].lower() not in others})
        check(f"{path.parent.name}: every repair target is a name that adapter already uses",
              not unknown, f"{unknown}")
        for heard, entry in entries.items():
            got, changed = hearing.repair(f"what about {heard} today")
            check(f"{path.parent.name}: {heard!r} is repaired whole",
                  got == f"what about {entry['said']} today" and len(changed) == 1, got)
    with tempfile.TemporaryDirectory() as tmp:
        bad = Path(tmp) / "someone"
        bad.mkdir()
        (bad / "hearing.json").write_text('{"words": {"guess": {"said": "Thing"}}}')
        (Path(tmp) / "broken").mkdir()
        (Path(tmp) / "broken" / "hearing.json").write_text("{not json")
        phrases, words, errors = hearing._adapter_tables(Path(tmp))
    check("an adapter entry with no observation behind it is refused, and a broken file skipped",
          words == {} and phrases == {} and len(errors) == 2, str(errors))

    # KEEL, as the box's model hears it.
    for heard in ("What is Kil doing right now", "What is Kiel doing right now",
                  "What is Kel doing right now"):
        got, _ = hearing.repair(heard)
        check(f"{heard.split()[2]!r} is read as Keel", got == "What is Keel doing right now", got)
    got, _ = hearing.repair("Tell Harba to read me the cbe")
    check("`Harba` and `the cbe` are read as Harbor and the queue",
          got == "Tell Harbor to read me the queue", got)
    for said in ("the kelp by the kiln killed the skill", "Kelly flew to Kielce"):
        got, changed = hearing.repair(said)
        check(f"a word that merely starts like Keel is untouched: {said!r}",
              got == said and not changed, got)


# --------------------------------------------------------------------------- #
# c-221, item 5: the vocabulary is harvested from live state, never hand-typed.
# --------------------------------------------------------------------------- #

KEY_CUSTODY_DRIVER = r"""
import json, os, subprocess, sys
from harbor_voice import config, speech
child = subprocess.run([sys.executable, "-c",
                        "import os; print(os.environ.get('CREDENTIALS_DIRECTORY', ''))"],
                       capture_output=True, text=True).stdout.strip()
sys.platform = "linux"
key = speech.GoogleTTS._key()
try:
    speech.GoogleTTS()
    built = "built"
except RuntimeError as exc:
    built = str(exc)
print("RESULT " + json.dumps({"environ": os.environ.get("CREDENTIALS_DIRECTORY", ""),
                              "child": child, "held": config.CREDENTIALS_DIRECTORY,
                              "key": key, "built": built}))
"""


def class_body(source: str, name: str) -> str:
    """One class's own text, from its `class X:` line to the next top-level `class`.

    Matched on the WHOLE name: `class Jev` also matches `class JevError`, which is the
    class above it in `jev.py`, so a plain split hands back the wrong body and the custody
    check passes or fails for the wrong reason.
    """
    found = re.search(rf"^class {re.escape(name)}\b[(:]", source, re.M)
    if not found:
        return ""
    rest = source[found.start():]
    after = re.search(r"\nclass \w", rest)
    return rest[: after.start()] if after else rest


def key_custody_section():
    print()
    print("== on Linux the Google key is the unit's systemd credential, and no child sees it ==")
    creds = Path(tempfile.mkdtemp())
    (creds / config.GOOGLE_TTS_CREDENTIAL).write_text("dummy-key-for-the-selftest\n")
    env = {"PATH": os.environ.get("PATH", ""), "HOME": os.environ.get("HOME", ""),
           "PYTHONPATH": str(PKG), "CREDENTIALS_DIRECTORY": str(creds)}
    got = _run_driver(env, KEY_CUSTODY_DRIVER)
    check("the gateway reads the key from $CREDENTIALS_DIRECTORY/google-tts-key",
          got.get("key") == "dummy-key-for-the-selftest" and got.get("built") == "built",
          str({k: v for k, v in got.items() if k != "key"}))
    check("and takes the pointer out of its environment the moment the package loads",
          got.get("environ") == "" and got.get("held") == str(creds), got.get("environ", "?"))
    check("so a child it starts (a talker turn, kb) never inherits it",
          got.get("child") == "", got.get("child", "?"))
    (creds / config.GOOGLE_TTS_CREDENTIAL).write_text("")
    empty = _run_driver(env, KEY_CUSTODY_DRIVER)
    check("an empty source is no key: Google steps aside, named, and the key is never printed",
          empty.get("key") == "" and "systemd credential" in empty.get("built", "")
          and "dummy" not in json.dumps(empty), empty.get("built", "?"))
    unset = _run_driver({k: v for k, v in env.items() if k != "CREDENTIALS_DIRECTORY"},
                        KEY_CUSTODY_DRIVER)
    check("with no credential directory there is no key, and no fallback to a guessed path",
          unset.get("key") == "" and unset.get("built", "").startswith("no Google key"),
          unset.get("built", "?"))


# --------------------------------------------------------------------------- #
# The judges (V10, c-313).
#
# The whole of this section is about NOT deciding. Every judge ships in `shadow`, and what
# has to be proved is that a seat written against this interface behaves identically
# whatever the switch says until a floor exists and somebody sets it: the rule's verdict
# comes back, the call never blocks the turn, every way it can fail is the rule's verdict
# and a counted miss, and the text that leaves is only the text handed in.
#
# It runs in a DRIVER SUBPROCESS because `harbor_voice.config` reads KEEL_HOME, KEEL_CONFIG
# and CREDENTIALS_DIRECTORY as the package loads, so the switch's two files and the log have
# to be somewhere disposable before the first import. No call leaves the machine: the wire
# is exercised by replacing `Jev._once`, with response bodies copied from the live API on
# 2026-09-20, which is the only place the noul shape can be got right.

JUDGES_DRIVER = r"""
import json, os, sys, time
from pathlib import Path
from harbor_voice import config, jev as jevmod, judges

out = {}
fixture = json.loads(Path(sys.argv[1]).read_text())

# 1. the shared switch cases, the same ones tests/test_judges.py reads
bad = []
for case in fixture["cases"]:
    lines = ["[voice]", "port = 4390", "", "[voice.judges]"]
    lines += ['"%s" = "%s"' % (k, v) for k, v in case["defaults"].items()]
    lines += ["", "[voice.judge_floors]"]
    lines += ['"%s" = %s' % (k, v) for k, v in case["floors"].items()]
    config.KEEL_TOML.write_text("\n".join(lines) + "\n")
    config.JUDGES_SWITCH.write_text(json.dumps(case["override"]))
    time.sleep(0.01)
    table = judges.SWITCH.table()
    for key, want in case["expect"].items():
        for field, value in want.items():
            if table[key][field] != value:
                bad.append("%s: %s.%s is %r not %r" % (case["name"], key, field,
                                                       table[key][field], value))
out["switch_mismatches"] = bad

# 2. the two answer shapes, exactly as the live API sends them. A noul carries NO
#    confidence field: the probability is the answer and the certainty at once.
live_choice = {"type": "choice", "choice": "board_read", "confidence": 0.8,
               "probabilities": {"board_read": 0.8, "talk": 0.2}}
live_noul = {"type": "noul", "noul": 0.88}
client = jevmod.Jev()
read = client._read({"route": live_choice, "complete": live_noul},
                    {"route": judges.PRETURN.questions["route"],
                     "complete": judges.PRETURN.questions["complete"]})
out["choice"] = read["route"]
out["noul_true"] = read["complete"]
low = client._read({"complete": {"type": "noul", "noul": 0.12}},
                   {"complete": judges.PRETURN.questions["complete"]})
out["noul_false"] = low["complete"]
for label, answer in (("outside the criteria", {"type": "choice", "choice": "elsewhere",
                                                "confidence": 0.9}),
                      ("not a probability", {"type": "noul", "noul": "yes"})):
    question = (judges.PRETURN.questions["route"] if "criteria" in label
                else judges.PRETURN.questions["complete"])
    name = "route" if "criteria" in label else "complete"
    try:
        client._read({name: answer}, {name: question})
        out["malformed_" + name] = "accepted"
    except jevmod.JevError as exc:
        out["malformed_" + name] = exc.reason

# 3. the three modes, with the wire replaced and nothing leaving the machine
sent = []

def fake_once(self, body, questions, timeout):
    sent.append(json.loads(body.decode()))
    answers = {name: ({"type": "noul", "noul": 0.9} if q["type"] == "noul"
                      else {"type": "choice", "choice": "board_read", "confidence": 0.97})
               for name, q in questions.items()}
    return jevmod.Reply(self._read(answers, questions), 0.12, "req_selftest")

jevmod.Jev._once = fake_once
judges.CLIENT = jevmod.Jev()
judges.CLIENT._key = "not-a-real-key"
jevmod.retention = lambda: "accept-default-retention"

def switch(defaults, floors=None, override=None):
    lines = ["[voice]", "port = 4390", "", "[voice.judges]"]
    lines += ['"%s" = "%s"' % (k, v) for k, v in defaults.items()]
    lines += ["", "[voice.judge_floors]"]
    lines += ['"%s" = %s' % (k, v) for k, v in (floors or {}).items()]
    config.KEEL_TOML.write_text("\n".join(lines) + "\n")
    config.JUDGES_SWITCH.write_text(json.dumps(override or {}))
    time.sleep(0.01)

def log_lines():
    if not config.JUDGES_LOG.exists():
        return []
    return [json.loads(x) for x in config.JUDGES_LOG.read_text().splitlines() if x.strip()]

rule = judges.rule("preturn", complete=True, addressed=True, route="talk")
every_off = {k: "off" for k in judges.KEYS}

# off: no call, no log line, the rule untouched
switch(every_off)
config.JUDGES_LOG.unlink(missing_ok=True)
sent.clear()
got = judges.ask("preturn", "anything waiting on me", rule, turn="t-off")
out["off"] = {"sent": len(sent), "logged": len(log_lines()),
              "sources": sorted({a.source for a in got.answers.values()})}

# shadow: the rule comes straight back, and the call is logged from the thread
switch({k: "shadow" for k in judges.KEYS})
config.JUDGES_LOG.unlink(missing_ok=True)
sent.clear()
started = time.perf_counter()
got = judges.ask("preturn", "anything waiting on me", rule, turn="t-shadow")
out["shadow_returned_in"] = round(time.perf_counter() - started, 4)
out["shadow_sources"] = sorted({a.source for a in got.answers.values()})
judges.wait_for_shadow()
rows = log_lines()
out["shadow_logged"] = len(rows)
out["shadow_line"] = {k: rows[0].get(k) for k in
                      ("judge", "turn", "text", "miss", "decided_by", "modes")}
out["shadow_calls"] = len(sent)
out["sent_keys"] = sorted(sent[0].keys()) if sent else []
out["sent_state"] = sent[0]["state"] if sent else ""
out["sent_model"] = sent[0]["model"] if sent else ""
out["one_call_three_answers"] = sorted(sent[0]["questions"].keys()) if sent else []

# on, over the floor: jev decides that answer and only that answer
switch({**{k: "shadow" for k in judges.KEYS}, "preturn.route": "on"},
       {"preturn.route": 0.9})
config.JUDGES_LOG.unlink(missing_ok=True)
got = judges.ask("preturn", "anything waiting on me", rule, turn="t-on")
out["on"] = {name: [got[name].value, got[name].source] for name in sorted(got.answers)}

# on, under the floor: the rule decides, and it is not counted as a miss
switch({**{k: "shadow" for k in judges.KEYS}, "preturn.route": "on"},
       {"preturn.route": 0.99})
config.JUDGES_LOG.unlink(missing_ok=True)
got = judges.ask("preturn", "anything waiting on me", rule, turn="t-under")
out["under_floor"] = [got["route"].value, got["route"].source,
                      log_lines()[0].get("miss")]

# every way it can fail is the rule's verdict and a counted miss
fails = {}
for reason in ("timeout", "error", "malformed", "no-key"):
    def boom(self, body, questions, timeout, reason=reason):
        raise jevmod.JevError(reason, "the selftest said so")
    jevmod.Jev._once = boom
    switch({**{k: "shadow" for k in judges.KEYS}, "preturn.route": "on"},
           {"preturn.route": 0.5})
    config.JUDGES_LOG.unlink(missing_ok=True)
    got = judges.ask("preturn", "anything waiting on me", rule, turn="t-" + reason)
    rows = log_lines()
    fails[reason] = [got["route"].value, got["route"].source,
                     rows[0].get("miss") if rows else "no line"]
jevmod.Jev._once = fake_once
out["fail_open"] = fails

# the fake judge V10 asks for: the held path, and failing open on demand
switch(every_off)
with judges.pretend(complete=(False, 0.91)):
    got = judges.ask("preturn", "so I was thinking that we", rule, turn="t-pretend")
out["pretend"] = [got["complete"].value, got["complete"].source,
                  got["addressed"].source]
with judges.pretend("timeout", complete=(False, 0.91)):
    got = judges.ask("preturn", "so I was thinking that we", rule, turn="t-pretend-fail")
out["pretend_fails_open"] = [got["complete"].value, got["complete"].source]

# an outcome is its own line, and health reads the switch rather than guessing
config.JUDGES_LOG.unlink(missing_ok=True)
judges.outcome("t-1", "carried-on")
out["outcome_line"] = log_lines()[0]
# c-552: an outcome may carry fields, and a talker's tool call maps to a section name
config.JUDGES_LOG.unlink(missing_ok=True)
judges.outcome("t-2", "connected", card="c-9", kind="call")
out["outcome_fields"] = log_lines()[0]
out["read_sections"] = [judges.read_section("Bash", {"command": c}) for c in (
    "keel deck reviews", "~/keel/bin/kb show c-12", "kb needs-you",
    "kb list --space personal", "grep -rn drain docs/atlas")]
out["read_sections"].append(judges.read_section("Read", {"file_path": "kb show"}))
# c-552: a seat that names no answers asks what its rule gave a verdict for, and one that
# names them asks exactly those
switch({k: "shadow" for k in judges.KEYS})
config.JUDGES_LOG.unlink(missing_ok=True)
sent.clear()
judges.ask("preturn", "anything waiting on me", rule, turn="t-some",
           answers=["complete"], facts={"space": "personal"})
judges.wait_for_shadow()
out["answers_named"] = sorted(sent[0]["questions"]) if sent else []
out["answers_named_row"] = {k: log_lines()[0].get(k) for k in ("modes", "facts", "questions")}
switch({k: "shadow" for k in judges.KEYS})
health = judges.health()
out["health_keys"] = sorted(health["keys"].keys())
out["health_modes"] = sorted({e["mode"] for e in health["keys"].values()})
out["health_has_key_question"] = "key" in health["jev"] and "ready" in health["jev"]
out["health_never_says_the_key"] = "not-a-real-key" not in json.dumps(health)

print("RESULT " + json.dumps(out))
"""


def judges_section():
    print()
    print("== the judges decide nothing, cost the turn nothing, and fail open every way ==")
    home = Path(tempfile.mkdtemp())
    (home / "state" / "voice").mkdir(parents=True)
    (home / "keel.toml").write_text("[voice]\nport = 4390\n")
    env = {"PATH": os.environ.get("PATH", ""), "HOME": os.environ.get("HOME", ""),
           "PYTHONPATH": str(PKG), "KEEL_HOME": str(home),
           "KEEL_CONFIG": str(home / "keel.toml")}
    fixture_path = PKG / "harbor_voice" / "fixtures" / "judges_switch.json"
    got = _run_driver(env, JUDGES_DRIVER, str(fixture_path))
    if "switch_mismatches" not in got:
        check("the judges driver ran", False, json.dumps(got)[:700])
        return

    check("the switch reads the same way here as it does in keel/judges.py",
          got["switch_mismatches"] == [], json.dumps(got["switch_mismatches"])[:600])

    check("a choice answer is read with its own confidence",
          got["choice"] == {"value": "board_read", "confidence": 0.8}, str(got["choice"]))
    check("a noul is ONE probability and no confidence field: 0.88 is yes, sure to 0.88",
          got["noul_true"] == {"value": True, "confidence": 0.88}, str(got["noul_true"]))
    check("and 0.12 is no, sure to 0.88: the confidence is the distance from the fence",
          got["noul_false"] == {"value": False, "confidence": 0.88}, str(got["noul_false"]))
    check("a choice outside the question's own criteria is malformed, never a verdict",
          got.get("malformed_route") == "malformed", str(got.get("malformed_route")))
    check("and a noul that is not a probability is malformed too",
          got.get("malformed_complete") == "malformed", str(got.get("malformed_complete")))

    check("off asks nothing, logs nothing, and leaves the rule alone",
          got["off"] == {"sent": 0, "logged": 0, "sources": ["rule"]}, str(got["off"]))

    check("shadow hands the rule's verdict back at once, never awaiting the call",
          got["shadow_sources"] == ["rule"] and got["shadow_returned_in"] < 0.05,
          f"{got['shadow_sources']} in {got['shadow_returned_in']}s")
    check("and the call is still logged, with the turn, the text and who decided",
          got["shadow_logged"] == 1
          and got["shadow_line"]["turn"] == "t-shadow"
          and got["shadow_line"]["miss"] == ""
          and set(got["shadow_line"]["decided_by"].values()) == {"rule"},
          str(got["shadow_line"]))
    check("one call carries all three of preturn's answers, not three calls",
          got["shadow_calls"] == 1
          and got["one_call_three_answers"] == ["addressed", "complete", "route"],
          f"{got['shadow_calls']} calls, {got['one_call_three_answers']}")
    check("what leaves the machine is the text handed in, the questions and the pinned model",
          got["sent_keys"] == ["model", "questions", "state"]
          and got["sent_state"] == "anything waiting on me"
          and got["sent_model"] == config.JEV_MODEL,
          str({k: got[k] for k in ("sent_keys", "sent_state", "sent_model")}))

    check("on, over the floor: jev decides that one answer and no other",
          got["on"]["route"] == ["board_read", "jev"]
          and got["on"]["complete"][1] == "rule"
          and got["on"]["addressed"][1] == "rule", str(got["on"]))
    check("on, under the floor: the rule decides, and it is a deferral rather than a miss",
          got["under_floor"] == ["talk", "rule", ""], str(got["under_floor"]))

    for reason, row in sorted(got["fail_open"].items()):
        check(f"a {reason} is the rule's verdict and a counted miss, never a stall",
              row == ["talk", "rule", reason], str(row))

    check("the fake judge drives the held path with no network anywhere",
          got["pretend"] == [False, "jev", "rule"], str(got["pretend"]))
    check("and a fake judge told to fail proves the seat falls back to its rule",
          got["pretend_fails_open"] == [True, "rule"], str(got["pretend_fails_open"]))

    check("an outcome is its own line, so it can arrive after the call did",
          got["outcome_line"].get("kind") == "outcome"
          and got["outcome_line"].get("outcome") == "carried-on",
          str(got["outcome_line"]))
    check("c-552: an outcome carries its fields, and a field never overwrites its kind",
          got["outcome_fields"].get("card") == "c-9"
          and got["outcome_fields"].get("kind") == "outcome", str(got["outcome_fields"]))
    check("a talker's tool call is kept as a section name, never its arguments",
          got["read_sections"] == ["reviews", "card", "needs_you", "cards", "", ""],
          str(got["read_sections"]))
    check("a seat that names its answers asks exactly those, with its facts on the line",
          got["answers_named"] == ["complete"]
          and got["answers_named_row"] == {"modes": {"complete": "shadow"},
                                           "facts": {"space": "personal"},
                                           "questions": 1},
          f"{got['answers_named']} {got['answers_named_row']}")
    check("/voice/health carries every key, its mode, and the key question",
          got["health_keys"] == sorted(judges_keys())
          and got["health_modes"] == ["shadow"]
          and got["health_has_key_question"],
          str({k: got[k] for k in ("health_keys", "health_modes")}))
    check("and health never contains the key itself",
          got["health_never_says_the_key"], "the key appeared in /voice/health")


def judges_keys():
    from harbor_voice import judges as judgesmod
    return list(judgesmod.KEYS)



# --------------------------------------------------------------------------- #
# The preturn seat (V10, c-324).
#
# THE WHOLE OF THIS SECTION IS ONE CLAIM: with a judge answering every way it can, the
# turn goes exactly where it would have gone with no judge at all. That is V10's day-one
# guard ("Jev decides NOTHING: it is asked beside the path that decides, its answer is
# logged, and the turn goes the way it would have gone without it") written as something
# that can fail rather than as something that is promised.
#
# It is proved by DRIVING THE REAL `Gateway.on_text` against a recording dispatcher and
# comparing the recorded dispatch, argument for argument, against the same utterance with
# every key `off`. The fake judge is `judges.pretend`, which V10 asks for by name; the
# held partial and the quiet end are not here to be entered, because they are c-314's.
#
# A DRIVER SUBPROCESS for the same reason the judges section uses one: the package reads
# KEEL_HOME as it imports, so the switch's files and the log have to be disposable first.

PRETURN_DRIVER = r"""
import json, threading, time
from pathlib import Path
from harbor_voice import config, dispatcher, jev as jevmod, judges
from harbor_voice import server as servermod

out = {}
sent = []                       # what WOULD have left the machine, and nothing does


def fake_once(self, body, questions, timeout):
    sent.append(json.loads(body.decode()))
    answers = {name: ({"type": "noul", "noul": 0.97} if q["type"] == "noul"
                      else {"type": "choice", "choice": "board_read", "confidence": 0.97})
               for name, q in questions.items()}
    return jevmod.Reply(self._read(answers, questions), 0.09, "req_selftest")


jevmod.Jev._once = fake_once
judges.CLIENT = jevmod.Jev()
judges.CLIENT._key = "not-a-real-key"
jevmod.retention = lambda: "accept-default-retention"


class FakeDispatcher:
    '''Records the dispatch and does nothing else.

    `rule_route` is the REAL method, bound here rather than reimplemented: it reads no
    instance state, so what this test sees is the rule the gateway actually asks.
    '''

    generation = 7
    rule_route = dispatcher.Dispatcher.rule_route
    # c-315: the pin is instance state the real `rule_route` reads, and `pinned` is the
    # real method for the same reason `rule_route` is. `pin = None` is an unpinned page,
    # which is every utterance this driver sends.
    pinned = dispatcher.Dispatcher.pinned
    pin = None

    def __init__(self):
        self.calls = []
        self.landed = threading.Event()

    def capture(self, **kw):
        self.calls.append(("capture", kw))
        self.landed.set()

    def answer(self, **kw):
        self.calls.append(("answer", kw))
        self.landed.set()

    def quiet(self, said, **kw):
        # c-314: the turn that ends with no Harbor turn spent. Recorded like the other
        # two, so "what did this utterance do" is one list however it ended.
        self.calls.append(("quiet", dict(kw, said=said)))
        self.landed.set()


def switch(defaults, floors=None, override=None):
    lines = ["[voice]", "port = 4390", "", "[voice.judges]"]
    lines += ['"%s" = "%s"' % (k, v) for k, v in defaults.items()]
    lines += ["", "[voice.judge_floors]"]
    lines += ['"%s" = %s' % (k, v) for k, v in (floors or {}).items()]
    config.KEEL_TOML.write_text("\n".join(lines) + "\n")
    config.JUDGES_SWITCH.write_text(json.dumps(override or {}))
    time.sleep(0.01)


def log_lines():
    if not config.JUDGES_LOG.exists():
        return []
    return [json.loads(x) for x in config.JUDGES_LOG.read_text().splitlines() if x.strip()]


def drive(said="what do you make of all that", mode="talk", released_at=1.0,
          gateway=None, hands_free=False):
    '''One utterance through the real `Gateway.on_text`, with everything it did recorded.

    `turn_id` is lifted out of the recorded dispatch because it is fresh every run; it is
    asserted separately, against the log line that has to name the same turn.

    `gateway` REUSES THE ONE FROM THE LAST CALL, which is how the held partial is driven
    (c-314): the half sentence is held ON the gateway, so joining it to the next
    utterance is two calls against one gateway, exactly as two utterances down one socket
    would be.
    '''
    config.JUDGES_LOG.unlink(missing_ok=True)
    sent.clear()
    if gateway is None:
        gateway = servermod.Gateway.__new__(servermod.Gateway)
        gateway.dispatcher = FakeDispatcher()
        # c-314: the conversation and the half sentence it may be holding. One object,
        # and the driver builds it because `__new__` runs no `__init__`.
        gateway.talk = servermod.Conversation()
    gateway.dispatcher.calls.clear()
    gateway.dispatcher.landed.clear()
    broadcasts = []
    gateway.broadcast = broadcasts.append
    gateway.on_text(said, [("harbour", "Harbor")], mode=mode, released_at=released_at,
                    hands_free=hands_free)
    # c-314: a HELD half sentence dispatches nothing at all, so this waits briefly and
    # then reports what did happen, rather than blocking on a turn that is not coming.
    gateway.dispatcher.landed.wait(2)
    judges.wait_for_shadow()
    method, kwargs = (gateway.dispatcher.calls[0] if gateway.dispatcher.calls
                      else ("NOTHING WAS DISPATCHED", {}))
    kwargs = dict(kwargs)
    return {"dispatch": [method, kwargs], "turn_id": kwargs.pop("turn_id", ""),
            "broadcast": broadcasts, "log": log_lines(), "sent": list(sent),
            "gateway": gateway}


every_off = {key: "off" for key in judges.KEYS}
every_shadow = {key: "shadow" for key in judges.KEYS}

# THE BASELINE: no judge at all. Every other run is compared against this one.
switch(every_off)
base = drive()
out["baseline"] = base["dispatch"]
out["off_asked_nothing"] = [len(base["sent"]), len(base["log"])]

runs = {}
switch(every_shadow)
runs["shadow"] = drive()
switch(every_off)
for label, answers in (("complete-no", {"complete": (False, 0.99)}),
                       ("addressed-no", {"addressed": (False, 0.99)}),
                       ("route-board_read", {"route": ("board_read", 0.99)}),
                       ("route-capture", {"route": ("capture", 0.99)}),
                       ("route-other", {"route": ("other", 0.99)}),
                       ("every-answer-flipped", {"complete": (False, 0.99),
                                                 "addressed": (False, 0.99),
                                                 "route": ("capture", 0.99)})):
    with judges.pretend(**answers):
        runs[label] = drive()
with judges.pretend("timeout", complete=(False, 0.99)):
    runs["jev-timed-out"] = drive()

out["unchanged"] = sorted(label for label, got in runs.items()
                          if got["dispatch"] == base["dispatch"]
                          and got["broadcast"] == base["broadcast"])
out["changed"] = {label: [got["dispatch"][0],
                          [b.get("type") for b in got["broadcast"]]]
                  for label, got in runs.items()
                  if got["dispatch"] != base["dispatch"]
                  or got["broadcast"] != base["broadcast"]}
# c-314: what the two verdict paths actually did with the words.
out["held_said"] = runs["complete-no"]["dispatch"][1].get("said", "")
out["quiet_why"] = runs["addressed-no"]["dispatch"][1].get("why", "")
out["quiet_said"] = runs["addressed-no"]["dispatch"][1].get("said", "")
out["board_read_route"] = runs["route-board_read"]["dispatch"][1].get("route", "")
out["capture_route"] = runs["route-capture"]["dispatch"][0]

# THE HELD HALF IS JOINED TO THE NEXT UTTERANCE, and the join is one turn. Two calls
# against ONE gateway, which is what two utterances down one socket are.
with judges.pretend(complete=(False, 0.99)):
    first = drive(said="so I was thinking that maybe we should")
rest = drive(said="just merge phase two into phase one", gateway=first["gateway"])
out["join"] = [first["dispatch"][0], rest["dispatch"][0],
               rest["dispatch"][1].get("said", "")]
out["join_told_the_page"] = [b.get("state") for b in first["broadcast"] + rest["broadcast"]
                             if b.get("type") == "partial"]
out["reopened_the_mic"] = [b.get("reason") for b in first["broadcast"]
                           if b.get("type") == "listen"]

# AND A HELD HALF IS NEVER HELD TWICE: the second utterance is dispatched whatever the
# judge says about it, so one wrong verdict costs one pause and never a chain of them.
with judges.pretend(complete=(False, 0.99)):
    first = drive(said="so I was thinking that maybe we should")
with judges.pretend(complete=(False, 0.99)):
    second = drive(said="just merge phase two into phase one", gateway=first["gateway"])
out["never_held_twice"] = [second["dispatch"][0], second["dispatch"][1].get("said", "")]

# AND IT EXPIRES INTO AN ORDINARY TURN, under the mode it was SPOKEN in.
import harbor_voice.config as _cfg
_cfg.JUDGE_HOLD_SECONDS = 0.2
with judges.pretend(complete=(False, 0.99)):
    expiring = drive(said="a thought I did not finish", mode="capture")
time.sleep(0.6)
expired = expiring["gateway"].dispatcher.calls
out["expired_into"] = [[method, kw.get("said", ""), kw.get("mode", "")]
                       for method, kw in expired]
_cfg.JUDGE_HOLD_SECONDS = 4.0

# THE CONVERSATION WORDS, matched before anything is dispatched and with no judge at all.
switch(every_off)
out["thats_all"] = drive(said="that's all")["dispatch"]
out["hold_on"] = drive(said="hold on")["dispatch"]
out["thats_all_told_the_page"] = [b for b in drive(said="that is all")["broadcast"]
                                  if b.get("type") == "conversation"]
out["a_sentence_containing_the_words_is_not_the_words"] = drive(
    said="that's all I could find in the log")["dispatch"][0]
switch(every_shadow)
out["jev_did_answer"] = {label: [row.get("decided_by"), row.get("miss")]
                         for label, got in runs.items() for row in got["log"][:1]}

# The call line names the turn the dispatcher was then handed.
shadow = runs["shadow"]
out["turn_id_reaches_the_turn"] = bool(shadow["turn_id"]) and \
    bool(shadow["log"]) and shadow["log"][0].get("turn") == shadow["turn_id"]
out["turn_id_is_a_turn_id"] = len(shadow["turn_id"])
out["one_call_for_three_answers"] = [len(shadow["sent"]),
                                     sorted(shadow["sent"][0]["questions"])
                                     if shadow["sent"] else []]
out["what_left"] = sorted(shadow["sent"][0].keys()) if shadow["sent"] else []
out["only_the_utterance"] = shadow["sent"][0]["state"] if shadow["sent"] else ""
out["the_fixed_menu"] = (sorted(shadow["sent"][0]["questions"]["route"]["criteria"])
                         if shadow["sent"] else [])
out["the_connect_option"] = ((shadow["sent"][0]["questions"]["route"]["criteria"]
                             .get("connect") or "") if shadow["sent"] else "")
out["shadow_decided_by"] = shadow["log"][0].get("decided_by") if shadow["log"] else {}

# The rule's verdict is the dispatcher's own, for all three of today's routes.
out["rule_talk"] = shadow["log"][0].get("rule") if shadow["log"] else {}
switch(every_shadow)
read = drive(said="what's waiting on me")
out["rule_board_read"] = read["log"][0].get("rule") if read["log"] else {}
cap = drive(mode="capture")
out["rule_capture"] = cap["log"][0].get("rule") if cap["log"] else {}
out["capture_still_captures"] = cap["dispatch"][0]
out["capture_carries_a_turn_id"] = bool(cap["turn_id"])

# c-552: each answer only in the state it is about, the card menu personal and live only,
# the barge-in answer once after a cut, and the facts on the call line.
switch(every_shadow)
gw = servermod.Gateway.__new__(servermod.Gateway)
