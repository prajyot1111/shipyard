out["c552_pinned_logs_no_route"] = sorted((held["log"][0].get("modes") or {})
                                          if held["log"] else {})

# Typed text is not judged, and is still dispatched.
typed = drive(released_at=None)
out["typed"] = [typed["dispatch"] == base["dispatch"], len(typed["sent"]),
                len(typed["log"])]

# A judge that raises where it is not supposed to be able to is still not his turn.
def boom(self, state, questions, criteria=None, **kw):
    raise RuntimeError("the selftest broke the judge")

judges.ask = boom
broke = drive()
out["a_broken_judge_is_not_a_lost_turn"] = broke["dispatch"] == base["dispatch"]

print("RESULT " + json.dumps(out))
