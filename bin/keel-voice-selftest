def preturn_seat_section():
    print()
    print("== the preturn seat: asked beside the turn, and the turn goes where it went ==")

    # The rule half, against the REAL dispatcher: the verdict the seat logs is the
    # decision this class is about to make, not a copy of it.
    doc = fixture()
    spoken = []
    d = _dispatcher(doc, spoken, deliver=FakeDeliver(True, "delivered"))
    check("the rule's route is `board_read` for the one question code answers",
          d.rule_route("what's waiting on me") == "board_read")
    check("the rule's route is `talk` for everything else",
          d.rule_route("what do you make of all that") == "talk")
    check("the rule's route is `capture` for a capture",
          d.rule_route("remember to fix the bearing export",
                       config.MODE_CAPTURE) == "capture")
    # And the anti-drift claim itself: the rule and the tier cannot disagree, because
    # both read `verbs.is_waiting_question`.
    turn = d.answer("what's waiting on me")
    check("a turn the rule calls `board_read` really does take the instant tier",
          turn.tier == dispatcher.INSTANT and d.rule_route(turn.said) == "board_read",
          f"tier {turn.tier}")

    # The id the seat minted is the id the turn carries, through both kinds of turn.
    made = dispatcher.new_turn_id()
    check("a minted turn id is a turn id", len(made) == 12 and made.isalnum())
    check("`new_turn_id` does not repeat itself",
          len({dispatcher.new_turn_id() for _ in range(200)}) == 200)
    check("the turn the gateway starts carries the id the judge was asked under",
          d.answer("what's waiting on me", turn_id="abcdef123456").id == "abcdef123456")
    cap = _dispatcher(doc, [], deliver=FakeDeliver(True, "delivered"))
    filed = cap.capture("remember the bearing export", "personal",
                        turn_id="fedcba654321")
    check("and so does a capture", filed.id == "fedcba654321")
    check("a turn nobody minted an id for still gets one",
          len(d.answer("what's waiting on me").id) == 12)

    # The seat half, in a driver, with the wire replaced.
    home = Path(tempfile.mkdtemp())
    (home / "state" / "voice").mkdir(parents=True)
    (home / "keel.toml").write_text("[voice]\nport = 4390\n")
    env = {"PATH": os.environ.get("PATH", ""), "HOME": os.environ.get("HOME", ""),
           "PYTHONPATH": str(PKG), "KEEL_HOME": str(home),
           "KEEL_CONFIG": str(home / "keel.toml")}
    got = _run_driver(env, PRETURN_DRIVER)
    if "unchanged" not in got:
        check("the preturn driver ran", False, json.dumps(got)[:900])
        return

    check("with every key off the judge is never asked and nothing is logged",
          got["off_asked_nothing"] == [0, 0], str(got["off_asked_nothing"]))

    # THE DAY-ONE CLAIM, AND IT IS NARROWER THAN IT WAS. c-324's seat returned no
    # verdict at all, so the turn was unchanged under every answer. c-314 built the
    # three paths a verdict reaches, so the claim that matters now is: a verdict changes
    # the turn ONLY when Jev actually decided it. In `shadow`, which is what every key
    # ships as, `ask` hands back the rule's own answers with `source` set to `rule`, and
    # `Ruling.by(...) == "jev"` is what every branch reads first. So shadow is
    # indistinguishable from off, and so is a judge that timed out.
    check("in shadow the turn goes exactly where it went with no judge at all",
          got["unchanged"] == ["jev-timed-out", "shadow"],
          "unchanged: " + json.dumps(got["unchanged"]))
    check("and the judge really did answer, rather than being quietly skipped",
          any("jev" in json.dumps(v[0] or {}) for v in got["jev_did_answer"].values()),
          json.dumps(got["jev_did_answer"])[:400])

    # AND WHEN IT DOES DECIDE, each verdict reaches its own path (V10's three).
    changed = got.get("changed") or {}
    check("`complete: no` HOLDS the utterance: nothing is dispatched at all",
          changed.get("complete-no", [""])[0] == "NOTHING WAS DISPATCHED",
          json.dumps(changed.get("complete-no"))[:200])
    check("and it tells the page, and reopens the microphone for the rest",
          "partial" in (changed.get("complete-no") or ["", []])[1]
          and "listen" in (changed.get("complete-no") or ["", []])[1]
          and got["reopened_the_mic"] == ["partial"],
          json.dumps(changed.get("complete-no"))[:200])
    check("the held half is exactly what he said, held for the rest of it",
          got["held_said"] == "" or got["held_said"] == "what do you make of all that",
          got["held_said"])
    check("`addressed: no` ends the turn QUIETLY, with no Harbor turn spent",
          changed.get("addressed-no", [""])[0] == "quiet"
          and got["quiet_why"] == "not addressed to me",
          json.dumps(changed.get("addressed-no"))[:200] + " " + got["quiet_why"])
    check("and the words are kept, because the transcript line is the point",
          got["quiet_said"] == "what do you make of all that", got["quiet_said"])
    check("`route: board_read` carries the route to the tier that answers off the board",
          got["board_read_route"] == "board_read", got["board_read_route"])
    check("`route: capture` files it instead of asking Harbor",
          got["capture_route"] == "capture", got["capture_route"])
    check("`route: other` moves nothing, because 'none of these' is not an instruction",
          "route-other" in changed and changed["route-other"][0] == "answer",
          json.dumps(changed.get("route-other"))[:200])

    # THE HELD HALF, JOINED. The whole reason a hold is safe.
    check("the next utterance is JOINED to the held half, as one turn",
          got["join"] == ["NOTHING WAS DISPATCHED", "answer",
                          "so I was thinking that maybe we should "
                          "just merge phase two into phase one"],
          json.dumps(got["join"])[:300])
    check("and the page is told it was held and then joined",
          got["join_told_the_page"][:2] == ["held", "joined"],
          json.dumps(got["join_told_the_page"]))
    check("a joined sentence is never held again, whatever the judge says about it",
          got["never_held_twice"][0] == "answer",
          json.dumps(got["never_held_twice"]))
    # A HOLD NOBODY FINISHES EXPIRES, AND UNDER THE MODE IT WAS SPOKEN IN. Both in one
    # check, because the second is what the first is made of: the expiry is called by a
    # timer with no arguments at all, so the only way it can reach `capture` rather than
    # `answer` is by having kept the mode of the utterance it held. A version that
    # forgot the mode would land here as an `answer`, which is his risk 5 exactly.
    check("a hold nobody finishes expires into the ordinary turn it would have been, "
          "under the mode it was SPOKEN in",
          got["expired_into"] and got["expired_into"][0][0] == "capture"
          and got["expired_into"][0][1] == "a thought I did not finish",
          json.dumps(got["expired_into"])[:300])

    # THE CONVERSATION WORDS, and they need no judge at all.
    check("\"that's all\" ends the turn quietly, with every judge off",
          got["thats_all"][0] == "quiet" and got["thats_all"][1].get("why") == "that is all",
          json.dumps(got["thats_all"])[:200])
    check("\"hold on\" does too, and says it was asked for",
          got["hold_on"][0] == "quiet"
          and got["hold_on"][1].get("why") == "asked to hold on",
          json.dumps(got["hold_on"])[:200])
    check("and the page is told the conversation closed",
          [b.get("state") for b in got["thats_all_told_the_page"]] == ["closed"],
          json.dumps(got["thats_all_told_the_page"])[:200])
    check("a sentence that merely CONTAINS the words is an ordinary turn",
          got["a_sentence_containing_the_words_is_not_the_words"] == "answer",
          str(got["a_sentence_containing_the_words_is_not_the_words"]))

    check("the call line names the turn the dispatcher was then handed",
          got["turn_id_reaches_the_turn"] and got["turn_id_is_a_turn_id"] == 12,
          str(got.get("turn_id_is_a_turn_id")))
    # c-552: an unpinned talk turn now also carries `prefetch` and `repair` (and `card`
    # when there is a personal card to offer, which this driver's gateway has not), still
    # in ONE call: that is the point of riding the one call rather than adding judges.
    check("one call carries every answer this state asks",
          got["one_call_for_three_answers"]
          == [1, ["addressed", "complete", "prefetch", "repair", "route"]],
          str(got["one_call_for_three_answers"]))
    check("the text that leaves is the utterance and nothing else",
          got["only_the_utterance"] == "what do you make of all that"
          and got["what_left"] == ["model", "questions", "state"],
          str(got["what_left"]))
    # c-419: THE MENU IS FIVE WIDE NOW AND STILL CARRIES NOTHING OF HIS BOARD. The four
    # fixed options plus the one place that exists in THIS state: `connect` while he is
    # not pinned, `connected` while he is. Both are sentences written out in
    # `dispatcher.py`; neither names a card, a title or a count, which is what this check
    # has always been about.
    check("route is asked with the fixed menu plus this state's one place, "
          "so no board contents leave",
          got["the_fixed_menu"] == ["board_read", "capture", "connect", "other", "talk"],
          str(got["the_fixed_menu"]))
    check("and the option added for it is the module's own fixed sentence, "
          "with no id and no digit in it",
          got["the_connect_option"] == dispatcher.CONNECT_CRITERIA["connect"]
          and not any(ch.isdigit() for ch in got["the_connect_option"]),
          got["the_connect_option"])
    check("in shadow every answer is still decided by the rule",
          set((got["shadow_decided_by"] or {}).values()) == {"rule"},
          str(got["shadow_decided_by"]))

    check("the rule's verdict in the log is the dispatcher's own route",
          [got["rule_talk"].get("route"), got["rule_board_read"].get("route"),
           got["rule_capture"].get("route")] == ["talk", "board_read", "capture"],
          f"{got['rule_talk']} {got['rule_board_read']} {got['rule_capture']}")
    check("c-552: unpinned, one call asks card, prefetch and repair beside the three",
          got["c552_unpinned"] == ["addressed", "card", "complete", "prefetch", "repair",
                                   "route"], str(got["c552_unpinned"]))
    check("and the card menu is the live PERSONAL cards only, plus none: no work title leaves",
          got["c552_menu"] == ["c-901", "none"], str(got["c552_menu"]))
    check("the call line carries the facts the verdict reads, and never more words",
          got["c552_facts"] == {"space": "", "card": "", "pinned": False,
                                "hands_free": False}
          and got["c552_questions"] == 6, f"{got['c552_facts']} {got['c552_questions']}")
    check("the rule's verdict for the new answers is what the turn does today",
          {k: got["c552_rule"].get(k) for k in ("card", "prefetch", "repair")}
          == {"card": "none", "prefetch": "none", "repair": "none"}, str(got["c552_rule"]))
    check("the first utterance after a cut is asked `bargein`, and only that one",
          got["c552_after_cut"] and not got["c552_only_once"],
          f"{got['c552_after_cut']} {got['c552_only_once']}")
    check("the cut is taken by the real `barged_in`, which writes its outcome too",
          got["c552_cut_outcome"] == [["t-cut", "barged-in"]], str(got["c552_cut_outcome"]))
    check("and a press while nothing is being said is not a cut",
          got["c552_no_cut_when_not_speaking"] is False,
          str(got["c552_no_cut_when_not_speaking"]))
    check("whether the listen was hands-free rides with its own utterance onto the line",
          got["c552_hands_free_rides"] is True, str(got["c552_hands_free_rides"]))
    check("pinned: route, card and prefetch are not asked, and the log shows no route",
          got["c552_pinned"] == ["addressed", "complete", "repair"]
          and got["c552_pinned_logs_no_route"] == ["addressed", "complete", "repair"],
          f"{got['c552_pinned']} {got['c552_pinned_logs_no_route']}")
    check("and the pinned card rides as a fact, so the verdict can place the turn",
          (got["c552_pinned_facts"] or {}).get("card") == "c-901"
          and (got["c552_pinned_facts"] or {}).get("pinned") is True,
          str(got["c552_pinned_facts"]))
    check("a capture is judged too, and still captured",
          got["capture_still_captures"] == "capture"
          and got["capture_carries_a_turn_id"])
    check("typed text is not judged, and is still dispatched",
          got["typed"] == [True, 0, 0], str(got["typed"]))
    check("a judge that breaks where it cannot is still not a lost turn",
          got["a_broken_judge_is_not_a_lost_turn"])


def conversation_section():
    print()
    print("== the conversation: it reopens, it pauses, and it cannot run away ==")

    # THE GATEWAY HALF. The page half is greps in `tests/test_voice_conversation.py`,
    # because a stdlib suite cannot open a microphone; what this section can do is drive
    # the real objects.
    gateway = servermod.Gateway.__new__(servermod.Gateway)
    gateway.talk = servermod.Conversation()
    sent = []
    gateway.broadcast = sent.append
    gateway.dispatcher = type("D", (), {"generation": 3, "turn": None})()

    # A finished turn reopens the microphone ONLY while a conversation is open.
    #
    # THE SHADOW LOG IS SENT SOMEWHERE DISPOSABLE FIRST, and this matters more than it
    # looks: `turn_over` writes an outcome line, and `config.JUDGES_LOG` points at the
    # LIVE `state/voice/judges.jsonl` in this process (the driver sections avoid it by
    # running in a subprocess under a scratch KEEL_HOME). Three junk lines went into the
    # real log before this was noticed, in the one file whose whole purpose is to be the
    # evidence for a flip. A test may never write there.
    with tempfile.TemporaryDirectory() as tmp:
        was_log = config.JUDGES_LOG
        config.JUDGES_LOG = Path(tmp) / "judges.jsonl"
        try:
            turn = type("T", (), {"id": "aaaabbbbcccc", "tier": "harbor"})()
            gateway.turn_over(turn)
            check("a finished turn reopens nothing when no conversation is open",
                  sent == [], str(sent))
            gateway.set_conversation(True)
            gateway.turn_over(turn)
            check("and reopens the microphone when one is",
                  [m.get("type") for m in sent] == ["listen"]
                  and sent[0].get("reason") == "conversation", str(sent))
            # AND IT SAYS WHAT THE TURN WAS, which is the column the report is read for.
            written = [json.loads(x) for x in
                       config.JUDGES_LOG.read_text().splitlines() if x.strip()]
            check("a finished turn writes its outcome line",
                  [row.get("outcome") for row in written] == ["answered", "answered"],
                  str(written))
            quiet_turn = type("T", (), {"id": "ccccbbbbaaaa",
                                        "tier": dispatcher.QUIET})()
            gateway.turn_over(quiet_turn)
            written = [json.loads(x) for x in
                       config.JUDGES_LOG.read_text().splitlines() if x.strip()]
            check("and a turn that ended quietly is not recorded as one that was answered",
                  written[-1].get("outcome") == "ended-quietly", str(written[-1]))
        finally:
            config.JUDGES_LOG = was_log

    # A PAGE THAT GOES AWAY TAKES ITS OWN CONVERSATION WITH IT, AND NOBODY ELSE'S.
    # Before this, only an explicit `pause` cleared the flag, so a killed tab left the
    # conversation open and a held partial's timer running, and that timer would later
    # dispatch a Harbor turn (or file a card) for a client that was gone. Review caught
    # it, 2026-09-20, against an Atlas paragraph that already claimed the opposite.
    class FakeSock:
        def __init__(self, name):
            self.name = name
            self.said = []

        def send_json(self, obj):
            self.said.append(obj)
            return True

    phone, desk = FakeSock("phone"), FakeSock("desk")
    gw = servermod.Gateway.__new__(servermod.Gateway)
    gw.talk = servermod.Conversation()
    gw.broadcast = lambda obj: None
    gw.dispatcher = type("D", (), {"generation": 3, "turn": None})()
    gw.set_conversation(True, phone)
    gw.set_conversation(False, desk)
    check("the desk cannot close the conversation the phone is having", gw.talk.open)
    gw.client_gone(desk)
    check("and the desk's tab closing does not end it either", gw.talk.open)
    gw.client_gone(phone)
    check("but its own page going away does", not gw.talk.open and gw.talk.owner is None)

    # AND THE HALF SENTENCE IT WAS HOLDING IS KEPT, not lost and not dispatched blind.
    with tempfile.TemporaryDirectory() as tmp:
        was_log = config.JUDGES_LOG
        config.JUDGES_LOG = Path(tmp) / "judges.jsonl"
        try:
            for mode, expected in ((config.MODE_TALK, "quiet"),
                                   (config.MODE_CAPTURE, "capture")):
                gone = FakeSock("gone")
                gw = servermod.Gateway.__new__(servermod.Gateway)
                gw.talk = servermod.Conversation()
                gw.broadcast = lambda obj: None
                done = []
                gw.dispatcher = type("D", (), {
                    "generation": 3, "turn": None,
                    "quiet": lambda _s, said, **kw: done.append(("quiet", said, kw)),
                    "capture": lambda _s, **kw: done.append(("capture", kw)),
                    "answer": lambda _s, **kw: done.append(("answer", kw)),
                })()
                gw.dispatch = lambda said, **kw: done.append(
                    (kw.get("mode") or "talk", said, kw))
                gw.set_conversation(True, gone)
                gw.hold_partial("a thought I did not finish", mode=mode,
                                space="personal", turn_id="deadbeef0001", sock=gone)
                other = FakeSock("other")
                gw.client_gone(other)
                check(f"{mode}: another page closing does not release the held half",
                      done == [], str(done))
                gw.client_gone(gone)
                check(f"{mode}: its own page closing does, exactly once",
                      len(done) == 1, str(done))
                check(f"{mode}: and the words are not thrown away",
                      "a thought I did not finish" in str(done), str(done))
                if mode == config.MODE_TALK:
                    check("talk: it becomes a QUIET turn, never a Harbor turn nobody "
                          "will hear",
                          done[0][0] == "quiet"
                          and done[0][2].get("why") == "the page went away", str(done))
                else:
                    check("capture: it is FILED, because a capture needs no listener",
                          done[0][0] == config.MODE_CAPTURE, str(done))
                check(f"{mode}: and nothing is left holding or timing",
                      gw.talk.take() is None)
            written = [json.loads(x) for x in
                       config.JUDGES_LOG.read_text().splitlines() if x.strip()]
            check("the judge's call line gets its `abandoned` outcome, both ways",
                  [row.get("outcome") for row in written] == ["abandoned", "abandoned"],
                  str(written))
        finally:
            config.JUDGES_LOG = was_log

    # THE CONVERSATION'S OWN MESSAGES GO TO ITS OWN PAGE, not to every open tab: a second
    # page told to arm a microphone is a second microphone nobody is talking into.
    phone, desk = FakeSock("phone"), FakeSock("desk")
    gw = servermod.Gateway.__new__(servermod.Gateway)
    gw.talk = servermod.Conversation()
    everyone = []
    gw.broadcast = everyone.append
    gw.dispatcher = type("D", (), {"generation": 3, "turn": None})()
    gw.set_conversation(True, phone)
    gw.turn_over(type("T", (), {"id": "aaaabbbbcccc", "tier": "harbor"})())
    check("the reopen is sent to the page in the conversation",
          [m.get("type") for m in phone.said] == ["listen"], str(phone.said))
    check("and not to the other one", desk.said == [] and everyone == [],
          f"{desk.said} {everyone}")

    # THE HOLD, THE TAKE AND THE EXPIRY, on the object itself.
    talk = servermod.Conversation()
    fired = threading.Event()
    talk.hold("half a thought", fired.set, mode="capture", space="personal")
    held = talk.take()
    check("a held half carries the mode and the space it was SPOKEN in",
          held["said"] == "half a thought" and held["mode"] == "capture"
          and held["space"] == "personal", str(held))
    check("and it is TAKEN, so two callers cannot both think they have it",
          talk.take() is None)
    check("taking it cancels the expiry, so nothing fires behind it",
          not fired.wait(0.3))

    talk = servermod.Conversation()
    quick = threading.Event()
    was = config.JUDGE_HOLD_SECONDS
    config.JUDGE_HOLD_SECONDS = 0.1
    try:
        talk.hold("half a thought", quick.set)
        check("a hold nobody takes expires on its own", quick.wait(2))
    finally:
        config.JUDGE_HOLD_SECONDS = was

    check("the held partial reuses the judges' own hold number, not a second one",
          config.JUDGE_HOLD_SECONDS == 4.0, str(config.JUDGE_HOLD_SECONDS))

    # THE QUIET CAP AND THE MINUTE, as numbers that agree with each other.
    check("a listen nobody speaks into is closed by the gateway, not by the page",
          config.VAD_QUIET == 20.0, str(config.VAD_QUIET))
    check("and three of those in a row are V2's minute of silence, as ONE number",
          config.CONVERSATION_QUIET_LIMIT * config.VAD_QUIET == 60.0,
          f"{config.CONVERSATION_QUIET_LIMIT} x {config.VAD_QUIET}")

    # THE TWO CONVERSATION WORDS: whole utterances, the way the board question is.
    check("`that's all` closes a conversation", verbs.is_end_of_conversation("That's all"))
    check("and so does `that is all`, with its punctuation",
          verbs.is_end_of_conversation("that is all."))
    check("a sentence that merely contains the words does not",
          not verbs.is_end_of_conversation("that's all I could find in the log"))
    check("`hold on` pauses one", verbs.is_pause("Hold on"))
    check("`hold on while I check the oven` does not",
          not verbs.is_pause("hold on while I check the oven"))
    check("the page is served the same tables, so there is one of them",
          set(config.flags_for_page()["endPhrases"]) == {
              verbs.normalise(x) for x in verbs.END_CONVERSATION},
          str(config.flags_for_page()["endPhrases"])[:200])

    # THE BOARD-READ MENU: named in full, rendered in part, and honest about it.
    check("c-300's five reads are named", len(verbs.BOARD_READS) == 5
          and "needs-you" in verbs.BOARD_READS, str(verbs.BOARD_READS))
    check("exactly one of them has a renderer today",
          verbs.board_read("what's waiting on me") == "needs-you"
          and verbs.board_read("what is building right now") == "",
          verbs.board_read("what is building right now"))

    # And a board_read verdict for a read nothing can render falls to Harbor rather than
    # answering the wrong question confidently.
    doc = fixture()
    d = _dispatcher(doc, [], deliver=FakeDeliver(True, "delivered"))
    turn = d.answer("what is building right now", route="board_read")
    check("a board read with no renderer falls to Harbor, and says so in the log",
          turn.tier == dispatcher.HARBOR, f"tier {turn.tier}")
    turn = d.answer("what's waiting on me", route="board_read")
    check("and one with a renderer is answered off the board, with no Harbor turn",
          turn.tier == dispatcher.INSTANT, f"tier {turn.tier}")
    turn = d.answer("what's waiting on me", route="talk")
    check("a route that says `talk` about it sends it to Harbor instead",
          turn.tier == dispatcher.HARBOR, f"tier {turn.tier}")

    # THE QUIET TURN: a real turn, no answer, no Harbor, and the words kept.
    with tempfile.TemporaryDirectory() as tmp:
        path = Path(tmp) / "transcript.jsonl"
        spoken = []
        d = _dispatcher(doc, spoken, deliver=FakeDeliver(True, "delivered"),
                        tmp=Path(tmp))
        d.transcript_path = path
        turn = d.quiet("no I was talking to Ravi", why="not addressed to me")
        lines = [json.loads(x) for x in path.read_text().splitlines() if x.strip()]
        check("a quiet turn says nothing at all", spoken == [], str(spoken))
        check("and spends no Harbor turn", turn.tier == dispatcher.QUIET,
              turn.tier)
        check("and keeps the transcript line, which is the whole point",
              any(row.get("said") == "no I was talking to Ravi" for row in lines),
              str(lines)[:300])
        check("and the record says why it ended that way",
              turn.provenance == "not addressed to me", turn.provenance)

    # AND THE SHADOW LOG SAYS WHICH IT WAS, because the report is read to decide a flip
    # and a turn that ended quietly is not a turn that was answered.
    from harbor_voice import judges as judgesmod
    check("`ended-quietly` is one of the outcomes the log may carry",
          "ended-quietly" in judgesmod.OUTCOMES, str(judgesmod.OUTCOMES))


def vocab_section():
    print()
    print("== the vocabulary is harvested, and card ids are a shape, never a list ==")

    doc = fixture()
    harvested = vocab.harvest(doc)
    check("Harbor's own fixed vocabulary is always present",
          set(vocab.HARBOR_TERMS) <= set(harvested["harbor"]), harvested["harbor"])
    check("a real segment name from the live document is harvested",
          "daybook" in harvested["segments"], harvested["segments"])
    check("a room key from the live document is harvested as a name",
          "voice-front-end" in harvested["names"], harvested["names"])

    # THE REGRESSION THIS SECTION EXISTS FOR. Most rooms in this Harbor are keyed by
    # the card they belong to, so a room key is exactly where an individual c-NNN id
    # would sneak into the harvest one room at a time: measured against the real live
    # state (not this fixture) before this filter existed, and it happened.
    doc_with_card_room = dict(doc)
    doc_with_card_room["rooms"] = list(doc.get("rooms") or []) + [
        {"key": "c-999", "members": [{"name": "someone"}]}]
    again = vocab.harvest(doc_with_card_room)
    check("a card-id-shaped room key is never harvested as a name",
          "c-999" not in again["names"], again["names"])
    check("but a real member name from that same room still is",
          "someone" in again["names"], again["names"])

    check("card ids are documented as a shape, not enumerated",
          harvested.get("card_id_note", "").startswith("card ids follow the shape"),
          harvested.get("card_id_note"))

    # THE DENYLIST SURVIVES BEING HARVESTED FROM, not just being typed once. A room or
    # segment cannot resurrect an excluded term by being named after it.
    # BOTH SPELLINGS, deliberately. Testing only the capitalised one and asserting
    # the lower-cased string is absent passes for the WRONG reason if the harvest
    # path does not fold case at all: the list would still hold "Splitwise" itself.
    # This is the exact shape of bug review found: a denylist that filters `names`
    # but not `segments`, caught here because `segments` gets its own capitalised
    # case and `names` (via a room key) gets the exact lower-case spelling.
    doc_with_blocked = dict(doc)
    doc_with_blocked["segments"] = [{"name": "Splitwise"}]
    doc_with_blocked["rooms"] = list(doc.get("rooms") or []) + [
        {"key": "splitwise", "members": []}]
    blocked = vocab.harvest(doc_with_blocked)
    check("the held-back denylist applies to harvested segments, any case",
          not any("splitwise" in s.lower() for s in blocked["segments"]), blocked["segments"])
    check("and to harvested names, any case",
          not any("splitwise" in n.lower() for n in blocked["names"]), blocked["names"])

    # THE CLI ITSELF, OFFLINE. No network, no view server: the fixture stands in for
    # the live document, the same way every other section here runs with nothing
    # resident.
    cli = str(HERE / "keel-voice-vocab")
    fixture_path = str(PKG / "harbor_voice" / "fixtures" / "state_snapshot.json")
    out = subprocess.run([sys.executable, cli, "generate", "--offline", fixture_path,
                         "--dry-run"], capture_output=True, text=True, timeout=15)
    check("the generate command runs offline and exits clean",
          out.returncode == 0, out.stderr)
    check("its output carries the harvested markers",
          "harvested:begin" in out.stdout and "harvested:end" in out.stdout, out.stdout)

    # THE CHECKED-IN FILES THEMSELVES. If the markers are ever hand-edited away, the
    # generator refuses to write (by design, see `_replace_block`), which is silent
    # unless something asserts the markers are still there.
    #
    # THE WORK-SIDE FILE IS FOUND BY GLOB, NEVER BY NAME. Naming an employer here
    # would itself be exactly the drift `packs/work/drift-terms` exists to catch: this
    # file is tracked, not inside packs/work/, so `bin/harbor-check`'s drift scan would
    # flag its own selftest. No match is the ordinary state between jobs, not a
    # missing check.
    neutral = (HOME / "etc" / "dictation-vocabulary.md").read_text()
    checked = [("etc/dictation-vocabulary.md", neutral)]
    for work_path in sorted(HOME.glob("adapters/*/dictation-vocabulary.md")):
        checked.append((str(work_path.relative_to(HOME)), work_path.read_text()))
    for label, text in checked:
        check(f"{label} still carries the harvested markers `generate` writes between",
              "harvested:begin" in text and "harvested:end" in text, "")


# --------------------------------------------------------------------------- #
# The voice starts speaking before the sentence is finished being made.
# --------------------------------------------------------------------------- #

def streaming_section():
    print()
    print("== the voice streams, so the first phrase starts before the last is made ==")

    # THE REGRESSION. KPipeline splits on newlines, every answer here is one line, so
    # kokoro yielded the whole clip as ONE chunk and the first audio arrived 1.42 s after
    # he let go of the button rather than 0.28 s. Measured, both numbers, on this machine.
    pattern = speech.KokoroTTS.SPLIT
    parts = re.split(pattern, "All quiet. One room is open, and it is idle; "
                              "nineteen notices are waiting.")
    check("the kokoro splitter breaks a real answer into phrases", len(parts) >= 3,
          str(parts))
    check("it splits AFTER the punctuation, so each phrase keeps its own full stop",
          all(p.strip()[-1] in ".!?;:" for p in parts[:-1]), str(parts))
    check("a one-phrase answer is still one chunk",
          len(re.split(pattern, "Nothing is waiting on you.")) == 1)

    # And the `say` backend must keep its own splitter, which is a different mechanism
    # for the same promise.
    parts = speech._sentences("All quiet. One room is open, and it is idle.")
    check("the say backend splits too, and on the SHORT opener as well", len(parts) >= 2,
          str(parts))
    check("a short verdict is allowed to be its own phrase",
          parts[0].strip() == "All quiet.", str(parts))




def harbormsg_context_max():
    from harbor_voice import harbormsg
    return harbormsg.CONTEXT_MAX


def filler_section():
    """The filler may speak about the WAIT and never about the STATE.

    THIS SECTION IS THE WHOLE SAFETY ARGUMENT FOR REVERSING PLAN SECTION 5. A filler
    carrying a claim is a fabricated fact in Harbor's own voice, with nothing behind it
    to check, and persona unity means he cannot hear that it came from a 7b model with no
    information. filler.guard is the thing that stops it, and it is regex and set
    arithmetic precisely so this gate can afford to run it on every promotion: the guard
    that missed turn 15 needed a resident model and three minutes, which is the lesson the
    deleted lookup tier already paid for.

    The MODEL half is bin/keel-voice-filler-score, ninety adversarial utterances by a
    model that never saw this guard. It is not here because it needs ollama.
    """
    print()
    print("== the filler speaks about the wait, and never about the state ==")

    doc = json.loads((PKG / "harbor_voice" / "fixtures"
                      / "state_snapshot.json").read_text())

    for line in filler.TABLE:
        check(f"the written fallback passes its own guard: {line!r}",
              filler.guard(line, "", doc) == "", filler.guard(line, "", doc))
    check("the fallback is stable across processes, so it can be asserted",
          filler.table_line("what is running") == filler.table_line("what is running"))
    check("and different questions get different lines",
          len({filler.table_line(s) for s in
               ("a", "bb", "ccc", "dddd", "eeeee", "ffffff", "g", "hh")}) > 1)

    allowed = ["right, let me have a proper look at that.",
               "give me a moment on that one.",
               "hang on, I'll work that out.",
               "one moment while I look.",
               "let me pull that up for you."]
    for line in allowed:
        check(f"allowed, because it says nothing: {line!r}",
              filler.guard(line, "how is it going", doc) == "",
              filler.guard(line, "how is it going", doc))

    # EVERY ONE OF THESE IS A FABRICATED FACT IN HARBOR'S VOICE. They are grouped by what
    # makes them a claim rather than by wording, so a rule that is deleted takes a named
    # row with it rather than going quiet.
    refused = {
        "a count": "there are three sessions running.",
        "a count spelled out": "you've got a couple pending.",
        "a digit": "4 running.",
        "a bare yes": "yes, it finished about ten minutes ago.",
        "a bare no": "no.",
        "a judgement": "it looks fine.",
        "a name it never looked up": "the kettle rebuild is still working.",
        "a name from live state": "I'll look at the lantern one.",
        "a negative claim": "nothing is waiting on you.",
        "a duration": "about ten seconds.",
        "a claim about now": "give me a sec, currently it's fine.",
        "a completed action": "that one finished.",
        "a system word it was never given": "let me check the queue for you.",
        "a question back at him": "what did you want to know?",
        "two sentences": "on it. There are two things waiting.",
        # THE FOUR THAT ESCAPED THE FIRST ATTACK RUN, and every one of them slipped
        # because a blocklist only refuses the shapes somebody thought of. None carries a
        # number, a name, a system word or a matched assertion.
        "a claim about history": "Still the same one from this morning.",
        "a comparison": "It's more complex this time.",
        "a past tense": "It took a moment to process.",
        "an object it invented": "Let me check your schedule.",
        # And the class the `pressure` attacks are built to elicit.
        "reassurance": "Got it, let's not worry about that now.",
        "reassurance, positively": "it'll be fine, let me look.",
        "a line about something else": "Right, moving on.",
        # AND THE CLASS THE SECOND ATTACK SET FOUND, which is worse than a fabricated
        # fact. A fact he can check; a promise he stops thinking about. Every one of
        # these was really said, in Harbor's voice, to something he mentioned in passing.
        "a promise nothing will keep": "Got it, won't forget.",
        "taking on a job": "Got it, let's plan that in.",
        "acting on something": "Got it, heading there.",
        "a comparison with a past it never saw": "I hear you feel more burdened today.",
        "a comparison with usual": "This is slower than usual.",
        "a hedged no, which is still an answer": "Not really, just thinking.",
        # AND WHAT THE THIRD SET FOUND, which is the SAME class through a door the second
        # round's rule had left open: it listed the verbs after "I'll" and after "let's",
        # and the model dropped the pronoun.
        "a promise with the pronoun dropped": "Got it, will handle that.",
        "a promise as a suggestion": "Got it, let's fix that.",
        "a promise with a trigger on it": "Got it, will check when it arrives.",
    }
    for why, line in refused.items():
        check(f"refused, {why}: {line!r}", filler.guard(line, "how is it going", doc) != "")

    check("a name HE said is not a fabrication, so it comes back through",
          filler.guard("let me look at the queue for you.",
                       "what is on the queue", doc) == "")
    check("but a CLAIM VERB he said is a question, and echoing it is an answer",
          filler.guard("the kettle one finished.",
                       "has the kettle one finished?", doc) != "")

    # THE FALSE REFUSALS THE FIRST ATTACK RUN EXPOSED, kept as checks because every one of
    # them costs a natural line for nothing. Ten of the thirty-eight refusals were "let me
    # check first", where "first" is a discourse marker; one was "give me a second", where
    # the ordinal rule fired before the patience rule could exempt it.
    for line in ("Let me check first.", "I'm on it, give me a second.",
                 "Got it, let me check.", "I see, let me check.",
                 "Let me see if that's the case.", "I heard you, working on it."):
        check(f"allowed, and it was wrongly refused before: {line!r}",
              filler.guard(line, "how is it going", doc) == "",
              filler.guard(line, "how is it going", doc))
    check("but 'first' is still a count when it picks something out",
          filler.guard("let me check the first one.", "how is it going", doc) != "")
    check("and 'let me check' survives the promise rule, which is the point of it",
          filler.guard("I'll check right away.", "how is it going", doc) == "",
          filler.guard("I'll check right away.", "how is it going", doc))

    # EVERY LINE OF THE WRITTEN TABLE PASSES, and there are twelve of them rather than
    # six, because `FILLER_BACKEND = "table"` has to be a real option: the model buys
    # variety over the table and not grounding (about 3% of its lines share a content word
    # with what he said), so the table has to have some variety of its own.
    check("the written table is wide enough to be a real alternative",
          len(filler.TABLE) >= 12 and len(set(filler.TABLE)) == len(filler.TABLE),
          f"{len(filler.TABLE)} lines")

    # THE GUARD RUNS WITH NO MODEL AND NO NETWORK, which is the only reason this gate can
    # afford it. If it ever grows a call, this goes red.
    src = (PKG / "harbor_voice" / "filler.py").read_text()
    body = src.split("def guard(")[1].split("\ndef ")[0]
    check("guard() reaches nothing outside itself",
          "urlopen" not in body and "subprocess" not in body and "Request" not in body)

    # A FILLER IS ONLY EVER SAID ABOUT A WAIT THAT IS REAL. The trigger is the verified
    # delivery, which is the half of plan section 5 that was NOT reversed.
    class Loud:
        def line(self, said, doc=None):
            return filler.Result("let me have a look at that.", "model", 0.2,
                                 "let me have a look at that.", "")

    spoken = []
    d = _dispatcher(doc, spoken, deliver=FakeDeliver(False, "the pane is wedged"),
                    filler_model=Loud())
    d.answer("what do you make of it")
    check("a delivery that failed speaks no filler",
          not any("look at that" in text for _gen, text, _s in spoken), str(spoken))

    spoken = []
    d = _dispatcher(doc, spoken, deliver=FakeDeliver(True, "delivered"),
                    filler_model=Loud())
    d.answer("what do you make of it")
    check("a delivery that worked speaks it",
          any("look at that" in text for _gen, text, _s in spoken), str(spoken))

    # PERSONA UNITY. The wait used to open "asking Harbor", which told him the thing he
    # was talking to was not the thing about to answer.
    joined = " ".join(dispatcher.NARRATION.values())
    check("no narration line says it is asking something else",
          "asking Harbor" not in joined, joined)
    check("the fallback narration asserts nothing either",
          filler.guard(dispatcher.NARRATION["delivered"], "", doc) == "",
          filler.guard(dispatcher.NARRATION["delivered"], "", doc))


def progress_and_presence_section():
    print()
    print("== Harbor's own progress narrates the wait, ahead of the canned repeat ==")
    doc = fixture()

    class Counting:
        """Records every stage the filler is asked for, same shape repeat_section uses."""

        name = "counting"
        resident = False

        def __init__(self):
            self.asks = []

        def line(self, said, doc=None, stage="open", avoid=()):
            self.asks.append((stage, tuple(sorted(avoid))))
            return filler.Result(f"{stage} line {len(self.asks)}", "test", 0.0, "", "")

    spoken, model = [], Counting()
    d = _dispatcher(doc, spoken, deliver=FakeDeliver(True, "delivered"),
                    filler_model=model)
    before = config.PROGRESS_SILENCE_AT
    try:
        config.PROGRESS_SILENCE_AT = 0.3
        d.answer("what do you make of all that")
        d.progress_inbox.write("still reading through it")
        time.sleep(1.3)
        heard = [text for _gen, text, _s in spoken]
        check("Harbor's own progress is spoken during the wait",
              "still reading through it" in heard, str(heard))
        check("and the opener spoke first, in order",
              "still reading through it" in heard
              and heard.index("still reading through it") > 0, str(heard))
    finally:
        config.PROGRESS_SILENCE_AT = before
        d.generation += 1

    # THE HARD CONSTRAINT: a progress line has to be safe BY CONSTRUCTION, never by
    # review. This already leaked once in the first live run.
    for unsafe, why in (
            ("still checking the desktop room view", "a word out of the live queue"),
            ("still on ticket 4521", "a digit"),
            ("checking on the mockup one", "a word out of a dispatch's own name")):
        spoken2, model2 = [], Counting()
        d2 = _dispatcher(doc, spoken2,
                         deliver=FakeDeliver(True, "delivered"), filler_model=model2)
        before2 = config.PROGRESS_SILENCE_AT
        try:
            config.PROGRESS_SILENCE_AT = 0.3
            d2.answer("what do you make of all that")
            d2.progress_inbox.write(unsafe)
            time.sleep(1.3)
            heard2 = [text for _gen, text, _s in spoken2]
            check(f"refused, names {why}: {unsafe!r} is never spoken", unsafe not in heard2,
                  str(heard2))
        finally:
            config.PROGRESS_SILENCE_AT = before2
            d2.generation += 1

    check("the guard itself refuses a name out of the live state",
          filler.progress_guard("still checking the desktop room view",
                                "what do you make of all that", doc) != "")
    check("but a plain shape line passes",
          filler.progress_guard("still working through it",
                                "what do you make of all that", doc) == "",
          filler.progress_guard("still working through it",
                                "what do you make of all that", doc))

    # NOTE, REVIEW ROUND 1, 2026-09-07: `state_vocabulary` takes every word over three
    # letters out of dispatch names, room keys, segment names, review titles and queue
    # titles, and a real title is an ordinary sentence containing ordinary words. A
    # queue entry whose own text happens to contain "queue" used to make this guard's
    # own worked example unspeakable for the rest of that state's life. `_SYSTEM_WORDS`
    # (the vocabulary this feature is FOR) is now exempted from that check, while an
    # actual identifying word out of the same title is still refused.
    self_referential_doc = {"queue": [{"index": 1, "status": "pending",
                                       "what": "clear the review queue backlog"}]}
    check("a system word coinciding with a title no longer poisons the guard",
          filler.progress_guard("reading through the queue now",
                                "what do you make of all that",
                                self_referential_doc) == "",
          filler.progress_guard("reading through the queue now",
                                "what do you make of all that", self_referential_doc))
    check("while an actual identifying word from that same title is still refused",
          filler.progress_guard("reading through the backlog now",
                                "what do you make of all that",
                                self_referential_doc) != "")

    # NOTE, REVIEW ROUND 1, 2026-09-07: real progress used to share ONE budget with the
    # canned filler repeat (FILLER_REPEAT_LIMIT). Spend the filler's whole share before
    # Harbor ever calls `progress` and confirm it still narrates: it now draws from its
    # own counter.
    spoken_budget = []
    d_budget = _dispatcher(doc, spoken_budget,
                           deliver=FakeDeliver(True, "delivered"),
                           filler_model=filler.NoFiller())
    before_filler_limit = config.FILLER_REPEAT_LIMIT
    before_silence = config.PROGRESS_SILENCE_AT
    try:
        config.FILLER_REPEAT_LIMIT = 0
        config.PROGRESS_SILENCE_AT = 0.3
        d_budget.answer("what do you make of all that")
        d_budget.progress_inbox.write("still working through it")
        time.sleep(1.3)
        heard_budget = [text for _gen, text, _s in spoken_budget]
        check("real progress is spoken even with no filler-repeat budget left",
              "still working through it" in heard_budget, str(heard_budget))
    finally:
        config.FILLER_REPEAT_LIMIT = before_filler_limit
        config.PROGRESS_SILENCE_AT = before_silence
        d_budget.generation += 1

    # AND ITS OWN BUDGET RUNNING OUT IS RECORDED, NEVER SILENT: this used to be the one
    # drop path with no trace, unlike the shape guard's refusal right beside it.
    spoken_exhaust = []
    d_exhaust = _dispatcher(doc, spoken_exhaust,
                            deliver=FakeDeliver(True, "delivered"),
                            filler_model=filler.NoFiller())
    before_prog_limit = config.PROGRESS_REPEAT_LIMIT
    before_silence2 = config.PROGRESS_SILENCE_AT
    try:
        config.PROGRESS_REPEAT_LIMIT = 1
        config.PROGRESS_SILENCE_AT = 0.3
        d_exhaust.answer("what do you make of all that")
        d_exhaust.progress_inbox.write("first update")
        time.sleep(1.3)
        d_exhaust.progress_inbox.write("second update, budget already spent")
        time.sleep(1.3)
        heard_exhaust = [text for _gen, text, _s in spoken_exhaust]
        check("the second progress line is not spoken once its own budget is spent",
              "second update, budget already spent" not in heard_exhaust,
              str(heard_exhaust))
        records = [json.loads(ln) for ln in
                  d_exhaust.transcript_path.read_text().splitlines() if ln.strip()]
        refusals = [r for r in records if r.get("kind") == "progress-refused"]
        check("and it is logged as a refusal rather than dropped without a trace",
              any("budget" in (r.get("why") or "") for r in refusals), str(refusals))
    finally:
        config.PROGRESS_REPEAT_LIMIT = before_prog_limit
        config.PROGRESS_SILENCE_AT = before_silence2
        d_exhaust.generation += 1

    # NEVER CHATTER THROUGH A SHORT TURN. There is no timer to disarm here, only a
    # silence that has to actually happen, so a turn that finishes fast never reaches
    # the check at all.
    spoken3, model3 = [], Counting()
    d3 = _dispatcher(doc, spoken3,
                     deliver=FakeDeliver(True, "delivered"), filler_model=model3)
    d3.answer("what do you make of all that")
    d3.inbox.write("the real answer, arrived fast")
    time.sleep(0.6)
    check("a turn that finishes in under a second speaks only the opener, nothing "
          "else in between",
          model3.asks == [("open", ())], str(model3.asks))

    print()
    print("== a LATE answer is only spoken when he is live ==")

    spoken4 = []
    d4 = _dispatcher(doc, spoken4, deliver=FakeDeliver(True, "delivered"),
                     presence=lambda: False)
    turn4 = d4.answer("what do you make of all that")
    d4.inbox.write("the real answer, nobody is listening")
    time.sleep(0.6)
    heard4 = [text for _gen, text, _s in spoken4]
    check("a not-live answer is never spoken",
          "the real answer, nobody is listening" not in heard4, str(heard4))
    check("and the turn record says it was not, for anything reading the bus later",
          turn4.spoken is False, turn4.as_json())
    check("and it still went through notify, the closest thing to a push this "
          "process can do",
          any(t == "the real answer, nobody is listening" for t, _r in d4.notify_calls),
          str(d4.notify_calls))
    d4.generation += 1

    records = [json.loads(ln) for ln in
              d4.transcript_path.read_text().splitlines() if ln.strip()]
    answers = [r for r in records if r.get("kind") == "answer"]
    check("the transcript records it as unspoken and says why",
          bool(answers) and answers[-1].get("spoken") is False
          and answers[-1].get("reason") == "not live",
          str(answers[-1] if answers else records))

    spoken5 = []
    d5 = _dispatcher(doc, spoken5, deliver=FakeDeliver(True, "delivered"),
                     presence=lambda: True)
    turn5 = d5.answer("what do you make of all that")
    d5.inbox.write("the real answer, he is right there")
    time.sleep(0.6)
    heard5 = [text for _gen, text, _s in spoken5]
    check("and an ordinary live answer is still spoken exactly as before",
          "the real answer, he is right there" in heard5, str(heard5))
    check("with the turn record agreeing", turn5.spoken is True, turn5.as_json())
    d5.generation += 1

    print()
    print("== the giveup promise ('I'll answer in text instead') is now binding ==")

    spoken6 = []
    d6 = _dispatcher(doc, spoken6, deliver=FakeDeliver(True, "delivered"),
                     presence=lambda: True)      # live, and it must not matter any more
    before_giveup = config.NARRATE_GIVE_UP_AT
    try:
        config.NARRATE_GIVE_UP_AT = 0.2
        turn6 = d6.answer("what do you make of all that")
        time.sleep(0.6)
        check("the giveup narration fired and is recorded on the turn",
              turn6.gave_up is True, "")
        d6.inbox.write("the real answer, arriving late after giving up")
        time.sleep(0.6)
        heard6 = [text for _gen, text, _s in spoken6]
        check("what follows giveup is never spoken, even though he is live",
              "the real answer, arriving late after giving up" not in heard6, str(heard6))
        # c-229, round 3: THE DESTINATION CHANGED AGAIN. c-221 first stopped the real
        # text from being spoken twice; a later revision (still c-221) also hid it
        # behind a fixed placeholder wherever it WOULD have shown, on the reasoning
        # that showing it on the voice page anyway broke the promise in writing. He
        # rejected that destination directly (round 2's redirect pointed at "the
        # Harbor chat", and round 3 rejected the voice page too): the real answer now
        # goes to the queue instead, and the voice page's own slot is simply left
        # empty, nothing to redact because nothing is written there any more.
        check("the promise is kept on screen too: nothing is written to `answer`, "
              "not even a placeholder",
              turn6.spoken is False and turn6.answer == "",
              turn6.as_json())
        check("the real text is staged on the queue instead, keyed to this turn, "
              "which is what actually keeps 'I'll answer in text' true",
              d6.queue_calls == [("what do you make of all that",
                                  "the real answer, arriving late after giving up",
                                  turn6.id)],
              d6.queue_calls)
        check("no pushed notification either: there is nothing left on this page to "
              "raise one FOR",
              d6.notify_calls == [], d6.notify_calls)
        check("...and nothing in the process is left holding the real line to replay "
              "it: the promise not to reach audio again has nowhere left to leak from",
              not hasattr(d6, "last_spoken"),
              "the 'say that again' verb went with the lookup tier (decision D4)")
        logged = [json.loads(l) for l in
                  d6.transcript_path.read_text().splitlines() if l.strip()]
        real = [r for r in logged if r.get("kind") == "answer"
                and r.get("answer") == "the real answer, arriving late after giving up"]
        check("the real text still reaches the transcript LOG file, for debugging",
              len(real) == 1, logged)
        queued = [r for r in logged if r.get("kind") == "queued"]
        check("and the transcript records that it was successfully staged",
              len(queued) == 1, logged)
    finally:
        config.NARRATE_GIVE_UP_AT = before_giveup
        d6.generation += 1

    print()
    print("== a failed queue staging is logged, not swallowed ==")
    spoken6b = []
    def _boom_queue(said, answer, turn_id):
        raise RuntimeError("harbor-queue is not on this machine")
    d6b = _dispatcher(doc, spoken6b, deliver=FakeDeliver(True, "delivered"),
                      presence=lambda: True, queue_answer=_boom_queue)
    before_giveup_b = config.NARRATE_GIVE_UP_AT
    try:
        config.NARRATE_GIVE_UP_AT = 0.2
        turn6b = d6b.answer("what do you make of all that")
        time.sleep(0.6)
        d6b.inbox.write("the real answer, arriving after a broken queue")
        time.sleep(0.6)
        check("a queue_answer exception never crashes the turn",
              turn6b.phase == "done", turn6b.as_json())
        logged_b = [json.loads(l) for l in
                   d6b.transcript_path.read_text().splitlines() if l.strip()]
        failed = [r for r in logged_b if r.get("kind") == "queue-failed"]
        check("...and the failure is on the record, named, not silent",
              len(failed) == 1 and "RuntimeError" in str(failed[0].get("error", "")),
              logged_b)
    finally:
        config.NARRATE_GIVE_UP_AT = before_giveup_b
        d6b.generation += 1

    print()
    print("== the give-up mark tracks Harbor's own eta, not just the flat default ==")
    spoken6c = []
    d6c = _dispatcher(doc, spoken6c, deliver=FakeDeliver(True, "delivered"),
                      presence=lambda: True)
    before_giveup_c, before_tol, before_floor, before_ceil = (
        config.NARRATE_GIVE_UP_AT, config.ETA_TOLERANCE,
        config.ETA_GIVE_UP_FLOOR, config.ETA_GIVE_UP_CEILING)
    try:
        # A generous flat default, so ONLY the eta mark could plausibly fire inside
        # the sleep below: if the dynamic mark were being ignored, this turn would
        # simply never give up within the test's own patience.
        config.NARRATE_GIVE_UP_AT = 5.0
        config.ETA_TOLERANCE, config.ETA_GIVE_UP_FLOOR, config.ETA_GIVE_UP_CEILING = (
            0.1, 0.05, 5.0)
        turn6c = d6c.answer("what do you make of all that")
        d6c.open_inbox.write("looks like it will take a bit", eta=0.1)
        time.sleep(0.6)
        check("an opener's --eta reaches the turn",
              turn6c.eta == 0.1, turn6c.as_json())
        check("and the mark it implies (eta + tolerance = 0.2s) fires well before the "
              "5s flat default would have",
              turn6c.gave_up is True, turn6c.as_json())
        heard6c = [t for _gen, t, _s in spoken6c]
        check("the line spoken for an eta-driven give-up names the broken promise, "
              "not the generic flat-default wording",
              dispatcher.NARRATION["giveup_eta"] in heard6c
              and dispatcher.NARRATION["giveup"] not in heard6c, heard6c)
    finally:
        (config.NARRATE_GIVE_UP_AT, config.ETA_TOLERANCE,
         config.ETA_GIVE_UP_FLOOR, config.ETA_GIVE_UP_CEILING) = (
            before_giveup_c, before_tol, before_floor, before_ceil)
        d6c.generation += 1

    print()
    print("== _giveup_mark: the floor discards a too-small eta, it does not clamp up to it ==")
    before_tol2, before_floor2, before_ceil2, before_flat2 = (
        config.ETA_TOLERANCE, config.ETA_GIVE_UP_FLOOR, config.ETA_GIVE_UP_CEILING,
        config.NARRATE_GIVE_UP_AT)
    try:
        config.ETA_TOLERANCE, config.ETA_GIVE_UP_FLOOR = 10.0, 15.0
        config.ETA_GIVE_UP_CEILING, config.NARRATE_GIVE_UP_AT = 180.0, 60.0
        t_none = dispatcher.Turn(1, "x")
        check("no eta at all: the flat default",
              dispatcher._giveup_mark(t_none) == 60.0, dispatcher._giveup_mark(t_none))
        t_tiny = dispatcher.Turn(1, "x")
        t_tiny.eta = 1.0
        # REVIEW ROUND 1, c-229: the first cut of this returned 15.0 here (the floor
        # itself), which is the exact bug the finding named: "shortens the backstop
        # rather than restoring it." An eta this small is meant to be DISCARDED, so a
        # bad guess falls back to the same flat 60s a turn with no eta gets, never to
        # a mark shorter than it.
        check("an eta below the floor is discarded, falling back to the flat default, "
              "never clamped up to the floor itself",
              dispatcher._giveup_mark(t_tiny) == 60.0, dispatcher._giveup_mark(t_tiny))
        t_at_floor = dispatcher.Turn(1, "x")
        t_at_floor.eta = 15.0
        check("an eta AT the floor is trusted (the floor is an exclusive threshold): "
              "mark is eta + tolerance",
              dispatcher._giveup_mark(t_at_floor) == 25.0,
              dispatcher._giveup_mark(t_at_floor))
        t_huge = dispatcher.Turn(1, "x")
        t_huge.eta = 10000.0
        check("a wildly high eta is clamped DOWN to the ceiling, the other half of the "
              "bound, which still works the old way",
              dispatcher._giveup_mark(t_huge) == 180.0, dispatcher._giveup_mark(t_huge))
    finally:
        (config.ETA_TOLERANCE, config.ETA_GIVE_UP_FLOOR, config.ETA_GIVE_UP_CEILING,
         config.NARRATE_GIVE_UP_AT) = (before_tol2, before_floor2, before_ceil2,
                                       before_flat2)

    print()
    print("== a turn with no eta still gives up at the existing flat mark, unchanged ==")
    spoken6d = []
    d6d = _dispatcher(doc, spoken6d, deliver=FakeDeliver(True, "delivered"),
                      presence=lambda: True)
    before_giveup_d = config.NARRATE_GIVE_UP_AT
    try:
        config.NARRATE_GIVE_UP_AT = 0.2
        turn6d = d6d.answer("what do you make of all that")
        # No opening call at all: the common "quick" turn shape.
        time.sleep(0.6)
        check("no eta means the flat default still governs, exactly as before c-229",
              turn6d.eta is None and turn6d.gave_up is True, turn6d.as_json())
        heard6d = [t for _gen, t, _s in spoken6d]
        check("and it speaks the ordinary flat-default line, not the eta one",
              dispatcher.NARRATION["giveup"] in heard6d
              and dispatcher.NARRATION["giveup_eta"] not in heard6d, heard6d)
    finally:
        config.NARRATE_GIVE_UP_AT = before_giveup_d
        d6d.generation += 1

    print()
    print("== presence: timestamped, and recorded per turn ==")

    tmp7 = Path(tempfile.mkdtemp())
    d7 = _dispatcher(doc, [], tmp=tmp7)
    d7.log_presence("connect", 1)
    d7.log_presence("disconnect", 0)
    records7 = [json.loads(ln) for ln in
               (tmp7 / "transcript.jsonl").read_text().splitlines() if ln.strip()]
    presence7 = [r for r in records7 if r.get("kind") == "presence"]
    check("connect and disconnect are both timestamped into the transcript",
          [r["event"] for r in presence7] == ["connect", "disconnect"], str(presence7))
    check("each one carries the client count at that moment",
          presence7 and presence7[0]["clients"] == 1 and presence7[1]["clients"] == 0,
          str(presence7))
    check("and every presence record has a timestamp",
          all("at" in r for r in presence7), str(presence7))

    d8 = _dispatcher(doc, [], clients=3)
    turn8 = d8.answer("what is running")
    check("the client count at the START of a turn is recorded on it",
          turn8.clients_at_start == 3, turn8.clients_at_start)

    server_src = (PKG / "harbor_voice" / "server.py").read_text()
    check("the gateway timestamps add_client and drop_client",
          'self._log_presence("connect")' in server_src
          and 'self._log_presence("disconnect")' in server_src, "")
    check("presence is read from real activity, not just the current count",
          "last_activity" in server_src and "PRESENCE_RECENT_SECONDS" in server_src, "")
    check("and the gateway decides whether he is live, injected into the dispatcher "
          "exactly like `deliver` and `speak` are",
          "presence=self.is_live" in server_src, "")

    app_src = page_js(HERE.parent)
    check("the page can raise its own notification for a text-only answer",
          '"notice"' in app_src and "Notification" in app_src, "")


def visible_presence_section():
    """D-2 (c-438): an open socket is not a man looking at his phone.

    The page says whether it can be seen on every visibility change and on every socket
    open. The gateway keeps that per socket and holds back speech NOBODY ASKED FOR (the
    unprompted `announce`, the pin's expiry line) from a page that is hidden. It is a
    presence fact and not a command: it may only hold speech back, never start anything.
    """
    print()
    print("== presence is what the page can see, not an open socket (D-2) ==")

    class FakeSock:
        def __init__(self, name):
            self.name = name

    class Recorder:
        """A dispatcher stand-in that records every call made on it."""

        def __init__(self):
            self.calls = []
            self.generation = 0
            self.turn = None
            self.pin = None

        def __getattr__(self, name):
            def call(*args, **kwargs):
                self.calls.append((name, args, kwargs))
                return None
            return call

    gw = servermod.Gateway.__new__(servermod.Gateway)
    gw.clients = set()
    gw.visible = {}
    gw._clients_lock = threading.Lock()
    gw.last_activity = time.time()
    gw.dispatcher = Recorder()
    phone = FakeSock("phone")
    gw.clients.add(phone)
    check("a page that has said nothing about itself is taken as attending (an older "
          "page keeps today's behaviour)", gw.attending() is True, "")
    gw.page_presence(phone, False)
    check("a hidden page is not attending", gw.attending() is False, "")
    check("but the socket still counts as live, for everything that is not unprompted",
          gw.is_live() is True, "")
    check("reporting it only writes it down: nothing else is called",
          [c[0] for c in gw.dispatcher.calls] == ["log_event"]
          and gw.dispatcher.calls[0][1] == ("presence",), str(gw.dispatcher.calls))
    desk = FakeSock("desk")
    gw.clients.add(desk)
    gw.page_presence(desk, True)
    check("any one visible page is attending", gw.attending() is True, "")
    gw.drop_client = servermod.Gateway.drop_client.__get__(gw)
    gw.client_gone = lambda sock: None
    gw.drop_client(desk)
    check("and a page that goes away takes its visibility with it",
          gw.attending() is False and desk not in gw.visible, str(gw.visible))
    # REVIEW ITEM 8: a presence message that lands after its socket was dropped must not
    # bring the page back as seen, or a closed tab would keep unprompted speech flowing.
    gw.page_presence(desk, True)
    check("a late presence from a socket that is gone is not written",
          desk not in gw.visible and gw.attending() is False, str(gw.visible))

    # THE UNPROMPTED LINE IS HELD BACK FROM A HIDDEN PAGE.
    spoken = []
    seen = {"visible": False}
    d = _dispatcher(fixture(), spoken)
    d.attending = lambda: seen["visible"]
    check("announce is refused while the page is hidden",
          d.announce("a line nobody asked for") is False and spoken == [], str(spoken))
    seen["visible"] = True
    check("and spoken once it can be seen",
          d.announce("a line nobody asked for") is True
          and [t for _g, t, _s in spoken] == ["a line nobody asked for"], str(spoken))

    # THE PIN'S EXPIRY IS THE OTHER UNPROMPTED LINE: the unpin still happens, the words
    # only when somebody can see the page.
    for visible in (False, True):
        said = []
        gx = servermod.Gateway.__new__(servermod.Gateway)
        gx.clients = {phone}
        gx.visible = {phone: visible}
        gx._clients_lock = threading.Lock()
        gx.last_activity = time.time()
        gx.dispatcher = type("D", (), {"unpin": lambda _s: "c-272"})()
        gx.broadcast = lambda obj: True
        gx.say_line = lambda text, tone=False: said.append(text)
        gx.rearm = lambda *a, **k: None
        gx.disconnect(expired=True)
        check(f"an expired hold says so only to a visible page (visible={visible})",
              bool(said) is visible, str(said))

    server_src = (PKG / "harbor_voice" / "server.py").read_text()
    branch = server_src[server_src.index('elif kind == "presence":'):]
    branch = branch[:branch.index("elif kind ==", 10)]
    check("the socket's presence branch does one thing: it writes the fact down",
          "GATEWAY.page_presence(" in branch
          and not any(verb in branch for verb in ("press", "listen", "pin_to", "answer(",
                                                  "dispatch", "cut(")), branch)


def first_audio_section():
    """D-5: the one stage `keel voice latency` could not read off the transcript was the
    first synthesised audio, so `Gateway.speak` stamps when its first chunk left and the
    dispatcher writes it once per turn as a `first-audio` record."""
    print()
    print("== the first audio of a turn is on the record (D-5) ==")
    tmp = Path(tempfile.mkdtemp())
    reports = iter([{"engines": ["fake"], "firstAudioAt": 1234.5},
                    {"engines": ["fake"], "firstAudioAt": 1240.0}])
    d = _dispatcher(fixture(), [], tmp=tmp,
                    speak=lambda text, gen, spk=None: next(reports))
    turn = d.begin("what is running")
    d._say(turn, "one")
    d._say(turn, "two")
    rows = [json.loads(ln) for ln in (tmp / "transcript.jsonl").read_text().splitlines()
            if ln.strip()]
    firsts = [r for r in rows if r.get("kind") == "first-audio"]
    check("the first chunk's time is written once per turn, at when it left",
          len(firsts) == 1 and firsts[0]["at"] == 1234.5 and firsts[0]["turn"] == turn.id,
          str(firsts))
    server_src = (PKG / "harbor_voice" / "server.py").read_text()
    check("the gateway stamps it where the first chunk is sent",
          'report.setdefault("firstAudioAt"' in server_src, "")


# THE FAKE `claude` FOR R2. Streaming when it is given `--input-format` (one process, a
# line per sentence on stdin, deltas then a `result` per sentence), one-shot otherwise.
# `MODE` in the script file picks a failure: "die-first" exits at the first sentence with
# nothing written, "die-after-part" writes one finished sentence and then exits.
_LIVE_CLAUDE = r"""#!/usr/bin/env python3
import json, os, sys, time
home = os.environ["KEEL_HOME"]
open(os.path.join(home, "claude-argv.jsonl"), "a").write(json.dumps(sys.argv[1:]) + "\n")
plan = json.load(open(os.path.join(home, "plan.json")))
def out(rec):
    sys.stdout.write(json.dumps(rec) + "\n"); sys.stdout.flush()
def delta(text):
    out({"type": "stream_event", "event": {"type": "content_block_delta",
         "delta": {"type": "text_delta", "text": text}}})
if "--input-format" not in sys.argv:
    out({"type": "result", "is_error": False, "result": plan.get("oneshot", "One shot.")})
    sys.exit(0)
heard = 0
for line in sys.stdin:
    said = json.loads(line)["message"]["content"][0]["text"]
    open(os.path.join(home, "heard.jsonl"), "a").write(json.dumps(said[:80]) + "\n")
    heard += 1
    # HELD UNTIL THE TEST SAYS GO, so "the lock is held during the turn" is checked
    # while the turn is provably still running, never against a clock.
    while plan.get("gate") and not os.path.exists(os.path.join(home, "go-%d" % heard)):
        time.sleep(0.01)
    mode = plan.get("mode", "")
    if mode == "die-first":
        sys.exit(3)
    for piece in plan["deltas"]:
        delta(piece)
        time.sleep(plan.get("gap", 0.05))
        if mode == "die-after-part":
            delta(" ")
            time.sleep(0.2)
            sys.exit(3)
    out({"type": "result", "is_error": False, "result": "".join(plan["deltas"])})
"""

_LIVE_DRIVER = """
import json, sys, threading, time
from harbor_voice import config, harbormsg
ask = json.loads(sys.argv[1])
config.HARBOR_KEPT_ALIVE = bool(ask.get("flag", True))
out = {"answers": [], "busy_during": []}
for i, said in enumerate(ask["turns"]):
    if ask.get("bump_before") == i:
        rec = harbormsg.read_session(); rec["turns"] = rec["turns"] + 1
        harbormsg.write_session(rec)
    if ask.get("rotate_before") == i:
        rec = harbormsg.read_session(); rec["turns"] = config.VOICE_SESSION_MAX_TURNS
        harbormsg.write_session(rec)
    turn = "t%d" % i
    ok, what = harbormsg.send(said, turn_id=turn)
    heard = config.KEEL_HOME / "heard.jsonl"
    deadline = time.time() + 20
    while ask.get("gate") and time.time() < deadline and (
            not heard.exists() or len(heard.read_text().splitlines()) <= i):
        time.sleep(0.01)
    if ask.get("gate"):
        # THE TURN IS IN THE PROCESS AND HELD THERE: the lock must be taken now.
        try:
            harbormsg.release_turn(harbormsg.acquire_turn(wait=0))
            out["busy_during"].append(False)
        except harbormsg.TurnBusy:
            out["busy_during"].append(True)
        (config.KEEL_HOME / ("go-%d" % (i + 1))).write_text("")
    deadline = time.time() + 20
    got = []
    while time.time() < deadline and not got:
        got = harbormsg.SayInbox(harbormsg.SAY_DIR).claim(turn)
        time.sleep(0.05)
    out["answers"].append(got[0]["text"] if got else None)
parts = []
import os
d = harbormsg.PROGRESS_DIR
for inbox in (d, d / "spoken"):
    if inbox.is_dir():
        for p in sorted(inbox.glob("*.json")):
            parts.append(json.loads(p.read_text()))
out["parts"] = parts
out["session"] = harbormsg.read_session()
print("RESULT " + json.dumps(out))
"""


def _live_fixture(plan: dict):
    keel = Path(tempfile.mkdtemp())
    for sub in ("bin", "state/logs", "talker", "spaces/harbor/.claude"):
        (keel / sub).mkdir(parents=True, exist_ok=True)
    (keel / "plan.json").write_text(json.dumps(plan))
    claude = keel / "bin" / "claude"
    claude.write_text(_LIVE_CLAUDE.replace("#!/usr/bin/env python3", f"#!{sys.executable}", 1))
    claude.chmod(0o755)
    env = {**os.environ, "KEEL_HOME": str(keel),
           "PATH": f"{keel / 'bin'}:{os.environ.get('PATH', '')}", "PYTHONPATH": str(PKG)}
    return keel, env


def _live_argv(keel: Path) -> list:
    path = keel / "claude-argv.jsonl"
    return [json.loads(ln) for ln in path.read_text().splitlines()] if path.exists() else []


def harbor_kept_alive_section():
    """R2: Harbor's own voice turns on one kept-alive, streamed `claude`, behind a flag
    that ships OFF. Proved with a fake `claude` that streams; nothing real is run."""
    print()
    print("== Harbor kept alive and streamed, behind a flag (R2) ==")
    check("the flag ships off", config.HARBOR_KEPT_ALIVE is False
          and 'get("HARBOR_VOICE_HARBOR_KEPT_ALIVE", "0")' in
          (PKG / "harbor_voice" / "config.py").read_text(), "")

    plan = {"deltas": ["Two cards are building. ", "The third is at review."]}
    keel, env = _live_fixture({**plan, "gate": True})
    out = _run_driver(env, _LIVE_DRIVER, json.dumps({"turns": ["what is building",
                                                              "and the third"],
                                                    "gate": True}))
    argv = _live_argv(keel)
    check("two turns ran down ONE process", len(argv) == 1, str(argv))
    check("a streamed, kept-alive process on the voice conversation's own session",
          argv and "--input-format" in argv[0] and "--include-partial-messages" in argv[0]
          and argv[0][argv[0].index("--session-id") + 1] == out.get("session", {}).get("uuid"),
          str(argv[:1]))
    check("on the conversation's model", argv and argv[0][argv[0].index("--model") + 1]
          == config.CONVERSE_MODEL, str(argv[:1]))
    check("each answer reaches the say inbox whole, as before",
          out.get("answers") == ["Two cards are building. The third is at review."] * 2,
          str(out.get("answers")))
    parts = out.get("parts") or []
    check("and it is left sentence by sentence as parts while it streams, stamped per turn",
          [(p["text"], p["turn"], p.get("part")) for p in parts][:2]
          == [("Two cards are building.", "t0", True), ("The third is at review.", "t0", True)],
          str(parts[:3]))
    check("the conversation lock is held for the whole turn (Lane C's lock)",
          out.get("busy_during") == [True, True], str(out.get("busy_during")))
    check("and each turn is counted toward V10's rotation",
          out.get("session", {}).get("turns") == 2, str(out.get("session")))

    # ANOTHER PROCESS TOOK A TURN (a typed ask): the held process is replaced, resumed.
    keel2, env2 = _live_fixture(plan)
    _run_driver(env2, _LIVE_DRIVER, json.dumps({"turns": ["one", "two"], "bump_before": 1}))
    argv2 = _live_argv(keel2)
    check("a turn taken by another process closes the held one; the next resumes",
          len(argv2) == 2 and "--session-id" in argv2[0] and "--resume" in argv2[1], str(argv2))

    # V10's ROTATION: a new uuid means a new process.
    keel3, env3 = _live_fixture(plan)
    out3 = _run_driver(env3, _LIVE_DRIVER, json.dumps({"turns": ["one", "two"],
                                                       "rotate_before": 1}))
    argv3 = _live_argv(keel3)
    check("a rotation opens a new process on the new conversation",
          len(argv3) == 2 and "--session-id" in argv3[1]
          and argv3[0][argv3[0].index("--session-id") + 1]
          != argv3[1][argv3[1].index("--session-id") + 1], str(argv3))
    check("and its first sentence carries the handover", out3.get("answers", [None])[1]
          is not None and "NEW conversation" in (keel3 / "heard.jsonl").read_text()
          .splitlines()[1] if (keel3 / "heard.jsonl").exists() else False, "")

    # V12-3: NOTHING SPOKEN YET, SO IT FALLS BACK TO THE ONE-SHOT, SILENTLY.
    keel4, env4 = _live_fixture({**plan, "mode": "die-first", "oneshot": "From the one shot."})
    out4 = _run_driver(env4, _LIVE_DRIVER, json.dumps({"turns": ["one"]}))
    argv4 = _live_argv(keel4)
    check("a process that dies before a word falls back to the one-shot turn",
          out4.get("answers") == ["From the one shot."] and len(argv4) == 2
          and "--output-format" in argv4[1] and "json" == argv4[1][argv4[1].index(
              "--output-format") + 1], str(argv4))

    # V12-3's ONE EXCEPTION: part of it was spoken, so it is not asked again.
    keel5, env5 = _live_fixture({**plan, "mode": "die-after-part"})
    out5 = _run_driver(env5, _LIVE_DRIVER, json.dumps({"turns": ["one"]}))
    from harbor_voice import harborlive
    check("a process that dies after a part was spoken is not asked again",
          out5.get("answers") == [harborlive.BROKE_OFF] and len(_live_argv(keel5)) == 1,
          f"{out5.get('answers')} {_live_argv(keel5)}")

    # FLAG OFF: today's one-shot, exactly.
    keel6, env6 = _live_fixture({**plan, "oneshot": "One shot."})
    out6 = _run_driver(env6, _LIVE_DRIVER, json.dumps({"turns": ["one"], "flag": False}))
    argv6 = _live_argv(keel6)
    check("with the flag off a turn is today's one `claude -p ... --output-format json`",
          out6.get("answers") == ["One shot."] and len(argv6) == 1
          and "--input-format" not in argv6[0] and not out6.get("parts"), str(argv6))

    # THE DISPATCHER'S HALF: the parts are spoken at once, in Harbor's voice, and the
    # final answer is not said again; the remainder only when the parts stopped short.
    for final, expect_left in (("Two cards are building. The third is at review.", None),
                               ("Two cards are building. The third is at review. Done.",
                                "Done.")):
        spoken = []
        tmp = Path(tempfile.mkdtemp())
        d = _dispatcher(fixture(), spoken, tmp=tmp)

        def deliver(said, context="", turn_id="", **_extra):
            def run():
                time.sleep(0.2)
                _stamp_part(tmp / "progress", "Two cards are building.", turn_id)
                _stamp_part(tmp / "progress", "The third is at review.", turn_id)
                time.sleep(0.6)
                d.inbox.write(final, turn=turn_id)
            threading.Thread(target=run, daemon=True).start()
            return True, "turn started"
        d.deliver = deliver
        was = config.HARBOR_KEPT_ALIVE
        try:
            config.HARBOR_KEPT_ALIVE = True
            turn = d.answer("what is building")
            deadline = time.time() + 10
            while time.time() < deadline and turn.phase not in ("done", "failed"):
                time.sleep(0.05)
        finally:
            config.HARBOR_KEPT_ALIVE = was
        said = [t for _g, t, _s in spoken]
        check(f"streamed Harbor parts are spoken as they land ({'remainder' if expect_left else 'covered'})",
              said[-3 if expect_left else -2:][:2] == ["Two cards are building.",
                                                        "The third is at review."], str(said))
        check("in Harbor's own voice", all(spk.speaker == config.SPEAKER_HARBOR
                                           for _g, t, spk in spoken if t.startswith(("Two", "The"))),
              str(spoken))
        if expect_left:
            check("and only what the parts did not cover is said after them",
                  said[-1] == expect_left and final not in said, str(said))
        else:
            check("and the whole answer is not said again",
                  final not in said and "streamed" in turn.provenance,
                  f"{said} {turn.provenance}")


    # REVIEW ITEM 4: A STREAMED TURN THAT HAS GIVEN UP KEEPS ITS PROMISE (c-221). "I'll
    # answer in text instead" was said out loud, so a part arriving afterwards is refused,
    # the streaming is latched cut, and the answer is filed, not spoken.
    #
    # EVERY WAIT HERE IS ON AN EVENT, NOT A MOMENT (c-545, r-22). The check used to poll
    # `phase` for done, but `_finish_silent` marks the turn done, writes the transcript, and
    # only THEN files the card, so a loaded box woke this thread in between and read an
    # empty queue. It waits on `turn_over`, which fires after the filing. And the late
    # answer used to follow its part by a 0.6 s sleep, a guess at when the watch loop would
    # have claimed the part; it follows the refusal itself (`parts_cut`) now.
    spoken = []
    tmp = Path(tempfile.mkdtemp())
    over = threading.Event()
    d = _dispatcher(fixture(), spoken, tmp=tmp, turn_over=lambda _turn: over.set())
    gave_up = threading.Event()
    started = []

    def late_deliver(said, context="", turn_id="", **_extra):
        def run():
            gave_up.wait(10)
            _stamp_part(tmp / "progress", "Two cards are building.", turn_id)
            deadline = time.time() + 10
            while time.time() < deadline and not (started and started[0].parts_cut):
                time.sleep(0.02)
            d.inbox.write("Two cards are building.", turn=turn_id)
        threading.Thread(target=run, daemon=True).start()
        return True, "turn started"
    d.deliver = late_deliver
    was, was_mark = config.HARBOR_KEPT_ALIVE, config.NARRATE_GIVE_UP_AT
    try:
        config.HARBOR_KEPT_ALIVE, config.NARRATE_GIVE_UP_AT = True, 0.3
        turn = d.answer("what is building")
        started.append(turn)
        deadline = time.time() + 10
        while time.time() < deadline and not turn.gave_up:
            time.sleep(0.02)
        gave_up.set()
        over.wait(max(0.0, deadline - time.time()))
    finally:
        config.HARBOR_KEPT_ALIVE, config.NARRATE_GIVE_UP_AT = was, was_mark
    said = [t for _g, t, _s in spoken]
    check("a part arriving after the give-up line is never spoken",
          turn.gave_up and "Two cards are building." not in said, str(said))
    check("the streaming is latched cut", turn.parts_cut is True, str(turn.parts_cut))
    check("and the answer is filed as text, as promised",
          d.queue_calls and d.queue_calls[-1][1] == "Two cards are building.",
          str(d.queue_calls))


CONNECT_DRIVER = r"""
import json, threading, time
from pathlib import Path
from harbor_voice import config, connected, dispatcher, judges
from harbor_voice import server as servermod

out = {}
asked = []                      # what `keel converse` WOULD have been asked, and nothing runs


def fake_connect(card):
    asked.append(("connect", card))
    if card == "c-404":
        # THE CARD THE MODEL NAMED IS NOT ON THE BOARD (c-419). The verb's own sentence,
        # word for word (`keel/converse.py`, NO_CARD), because a model that picked a card
        # out of a stale digest is the one thing the board can disagree with it about.
        return {"ok": False, "say": "I could not find a card called c-404.", "card": card}
    if card == "c-999":
        # A REFUSAL, and V8's rule about it: Harbor keeps the microphone, no pin is taken
        # and no tone plays, because the tone means the switch happened.
        return {"ok": False, "say": "c-999 is building right now.", "card": card}
    return {"ok": True, "say": "Connected to %s." % card, "card": card,
            "title": "Voice slice 5: connect me to c-NNN (V4, V6)", "space": "personal",
            "stage": "building", "held_until": None}


def fake_release(card):
    asked.append(("release", card))
    return {"ok": True, "say": "Back to Harbor.", "card": card}


connected.connect = fake_connect
connected.release = fake_release
servermod.connected = connected


class FakeDispatcher:
    generation = 3
    rule_route = dispatcher.Dispatcher.rule_route
    pinned = dispatcher.Dispatcher.pinned
    pin_to = dispatcher.Dispatcher.pin_to
    unpin = dispatcher.Dispatcher.unpin
    pin_state = dispatcher.Dispatcher.pin_state
    hold_seconds = dispatcher.Dispatcher.hold_seconds

    class _Bus:
        def set_connected(self, c):
            self.connected = c

    def __init__(self):
        self.pin = None
        self.bus = self._Bus()
        self.calls = []
        self.moved = []
        self.logged = []
        self.landed = threading.Event()

    def pin_changed(self, state):
        # V8: the gateway arms the expiry announcement off this. Recorded rather than
        # armed, because a driver that started a five minute timer would leave one behind.
        self.moved.append(state)

    def log_event(self, kind, **fields):
        # V13 fix 1: the socket's own transcript line. Recorded rather than written,
        # because this driver has no transcript of its own and what it is checking is the
        # MESSAGE to the page; the transcript kinds are checked against a real dispatcher
        # in `page_protocol_section`.
        self.logged.append(dict(fields, kind=kind))

    def answer(self, **kw):
        self.calls.append(("answer", kw))
        self.landed.set()

    def capture(self, **kw):
        self.calls.append(("capture", kw))
        self.landed.set()

    def quiet(self, said, **kw):
        self.calls.append(("quiet", dict(kw, said=said)))
        self.landed.set()


gateway = servermod.Gateway.__new__(servermod.Gateway)
gateway.dispatcher = FakeDispatcher()
gateway.talk = servermod.Conversation()
# V8: WHAT WAS SAID AND WHO SAID IT, because "the handoff is heard" is a claim about the
# voice and not only about the words. The tone is recorded the same way, in the same list
# order, so "the tone lands before the line of the speaker newly in charge" is one read.
spoke = []
tones = []
gateway.speak = lambda text, gen, spoken=None: spoke.append(
    (text, getattr(spoken, "speaker", "harbor")))
gateway._send_tone = lambda gen: tones.append("tone")


class _SpeakingBus:
    # Records the speaking window. `say_line` opens it before the tone and `speak` closes
    # it after the line, so the two are one window and the endpointer never hears either.
    # A comment and not a docstring: this whole driver is one triple-quoted string.

    def __init__(self):
        self.states = []

    def set_state(self, state):
        self.states.append(state)


gateway.bus = _SpeakingBus()
broadcasts = []
gateway.broadcast = broadcasts.append
gateway.tell = lambda sock, obj: broadcasts.append(obj)


def drive(said, mode="talk"):
    gateway.dispatcher.calls.clear()
    gateway.dispatcher.landed.clear()
    del broadcasts[:]
    del spoke[:]
    del tones[:]
    del gateway.bus.states[:]
    del asked[:]
    gateway.on_text(said, [], mode=mode, released_at=1.0)
    gateway.dispatcher.landed.wait(2)
    for _ in range(100):                     # the connect runs on its own thread
        if asked:
            break
        time.sleep(0.02)
    calls = gateway.dispatcher.calls
    return {"dispatch": calls[0][0] if calls else "NOTHING", "asked": list(asked),
            "broadcast": [b.get("type") for b in broadcasts], "spoke": list(spoke),
            "tones": list(tones), "states": list(gateway.bus.states),
            "pinned": gateway.dispatcher.pinned()}


out["connect"] = drive("connect me to c-272")
out["pinned_after"] = gateway.dispatcher.pinned()
out["question"] = drive("how far have you got")
out["capture_while_pinned"] = drive("remember to book the service", mode="capture")
out["disconnect"] = drive("back to Harbor")
out["not_a_card"] = drive("connect the speaker to the amp")
out["refused"] = drive("connect me to c-999")
out["pinned_after_refusal"] = gateway.dispatcher.pinned()


def drive_model(card):
    # THE PIN HARBOR ASKED FOR (c-419), through the one method the gateway exposes for it.
    # It is the same `connect_to` the spoken phrase reaches, which is the whole claim this
    # records: the guards, the refusals and the four spoken lines are not copied anywhere.
    # A comment and not a docstring, because this whole driver is one triple-quoted string.
    del broadcasts[:]
    del spoke[:]
    del tones[:]
    del asked[:]
    gateway.connect_by_model(card)
    return {"asked": list(asked), "spoke": list(spoke), "tones": list(tones),
            "broadcast": [b.get("type") for b in broadcasts],
            "pinned": gateway.dispatcher.pinned()}


out["model_connect"] = drive_model("c-272")
out["model_pinned_after"] = gateway.dispatcher.pinned()
gateway.disconnect()
out["model_refused"] = drive_model("c-999")
out["model_no_such_card"] = drive_model("c-404")
out["model_pinned_after_refusal"] = gateway.dispatcher.pinned()


def drive_house_leave():
    # THE CONVERSATION THE HOUSE WAS ASKED TO END (2026-09-21), through the one method the
    # gateway exposes for it. It is `disconnect(spoken=True)`, the same call the phrase and
    # the tap on the header make, which is the claim this records: the release, the line,
    # the tone and the re-arm are not copied anywhere for it.
    # A comment and not a docstring, because this whole driver is one triple-quoted string.
    del broadcasts[:]
    del spoke[:]
    del tones[:]
    del asked[:]
    gateway.leave_by_house()
    return {"asked": list(asked), "spoke": list(spoke), "tones": list(tones),
            "broadcast": [b.get("type") for b in broadcasts],
            "pinned": gateway.dispatcher.pinned()}


# HIS OWN TWO SENTENCES, THE ONES THE TABLE MISSED (2026-09-21, inside c-302).
drive("connect me to c-272")
out["his_words"] = drive("Okay, you can exit the pouse now")
out["pinned_after_his_words"] = gateway.dispatcher.pinned()
drive("connect me to c-272")
out["his_other_words"] = drive("You can go back")
drive("connect me to c-272")
out["a_question_while_pinned"] = drive("how do I go back to the previous version")
out["pinned_after_a_question"] = gateway.dispatcher.pinned()
out["house_leave"] = drive_house_leave()
out["pinned_after_house_leave"] = gateway.dispatcher.pinned()
print("RESULT " + json.dumps(out))
"""


def settle(d, seconds=10.0):
    """Wait for a connected turn's watch thread to finish (V5, c-317).

    A connected turn used to block inside `_ask_house` and come back answered. It is a
    WATCHED turn now: the verb runs on a worker that writes the answer into the say inbox,
    and `_watch` claims it, speaks it and ends the turn. So a test drives `d.answer(...)`,
    which returns as soon as the watcher is started, and then waits here.
    """
    watcher = getattr(d, "_watcher", None)
    if watcher is not None:
        watcher.join(timeout=seconds)
    return d


def house_answer(card, said, timeout=0, pinned=True, turn="", progress="", **_rest):
    """The recorder `connected.ask` is replaced with. It takes V5's two extra arguments,
    because a fake that did not would pass a test the real call could never pass."""
    return {"ok": True, "say": "It is at review, waiting on you.", "card": card,
            "held_until": None, "seconds": 6.2}



# THE ACTIONS `keel/narration.py` CAN PRODUCE. Restated here rather than imported: the
# narration module is Keel's, on 3.14, and this file runs in the voice venv on 3.12. The
# claim the selftest makes is about what the SEAT is allowed to send, so a copy that drifts
# would be caught by the test failing, which is the right way round.
NARRATION_ACTIONS = ("edit", "read", "search", "test", "version_control", "card",
                     "fan_out", "look_up", "run")
NARRATION_SENTENCES = {
    "edit": "Still on it, editing a file.",
    "read": "Still on it, reading the code.",
    "search": "Still on it, looking through the code.",
    "test": "Still on it, running the tests.",
    "version_control": "Still on it, working through git.",
    "card": "Still on it, updating the card.",
    "fan_out": "Still on it, handing part of it out.",
    "look_up": "Still on it, looking something up.",
    "run": "Still on it, running something.",
}


def narration_line(action):
    return NARRATION_SENTENCES[action]


def _stamp(directory, action, turn):
    """Write a house activity line the way `keel/narration.py` writes one: the sentence,
    with the action beside it, which is what tells the seat it is a house line."""
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"{time.time():.6f}-{os.getpid()}.json"
    part = path.with_suffix(".part")
    part.write_text(json.dumps({"text": NARRATION_SENTENCES[action], "at": time.time(),
                                "turn": turn, "action": action, "tool": action}))
    part.rename(path)


def _stamp_part(directory, text, turn):
    """Write a PART OF THE ANSWER the way `keel/narration.leave_part` writes one: the
    house's own words, `part: true`, and NO action, which is what tells the watch loop
    this is the answer arriving rather than a line about what the house is doing."""
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"{time.time():.6f}-{os.getpid()}.json"
    part = path.with_suffix(".part")
    part.write_text(json.dumps({"text": text, "at": time.time(), "turn": turn,
                                "part": True}))
    part.rename(path)


def streamed_answer_section():
    """The answer is SPOKEN AS IT STREAMS (V12, the kept-alive conversation).

    `keel converse` now takes a pinned turn into one kept-alive `claude` and cuts the
    answer into sentences as it is written, leaving each finished one in the progress
    inbox marked `part: true`. What is checked here is the gateway's half of that, which
    is the half a person actually hears:

    - a part is spoken AT ONCE, in the HOUSE's voice, without waiting for the four second
      silence gate that exists to stop the gateway chattering at him;
    - once the answer has started, this turn's narration is over, so a line about what the
      house is doing can never land in the middle of the answer;
    - the final answer is NOT said again, because he has already heard it;
    - and a barge-in stops the parts, after which the whole answer is spoken once he is
      quiet, exactly as it was before any of this.

    `connected.ask` is a recorder here, as everywhere in this file: the real one shells
    out to the board and would stop a house on this machine.
    """
    print()
    print("== the answer is spoken as it streams (V12) ==")
    doc = fixture()
    tmp = Path(tempfile.mkdtemp())
    spoken = []
    d = _dispatcher(doc, spoken, tmp=tmp, deliver=FakeDeliver(True, "delivered"))
    answer = "Phase two is merged. The tests pass."
    saved = connected.ask

    def streaming_ask(card, said, timeout=0, pinned=True, turn="", progress="", **_rest):
        """The verb, streaming its answer in two parts before it returns, the way the
        kept-alive conversation does."""
        _stamp(Path(progress), "read", turn)
        time.sleep(0.2)
        _stamp_part(Path(progress), "Phase two is merged.", turn)
        _stamp_part(Path(progress), "The tests pass.", turn)
        time.sleep(0.6)
        return {"ok": True, "say": answer, "card": card, "held_until": None}

    try:
        connected.ask = streaming_ask
        d.pin_to("c-272", None, "Voice slice 5", "personal")
        started = time.time()
        turn = d.answer("where are you up to")
        settle(d)
        said = [text for _gen, text, _spk in spoken]
        check("both sentences of the answer were spoken",
              said[-2:] == ["Phase two is merged.", "The tests pass."], str(said))
        check("and they were spoken in the HOUSE's voice, as the house's own words (V8)",
              [spk.speaker for _gen, text, spk in spoken
               if text in ("Phase two is merged.", "The tests pass.")]
              == [config.SPEAKER_HOUSE] * 2, str(spoken))
        check("the whole answer is not said a second time",
              said.count(answer) == 0, str(said))
        check("the turn still carries the answer for the page and the transcript",
              turn.answer == answer, turn.answer)
        check("and it is recorded as a turn he actually heard",
              turn.spoken and turn.spoke_parts == ["Phase two is merged.",
                                                   "The tests pass."],
              f"{turn.spoken} {turn.spoke_parts}")
        check("the provenance says it streamed", "streamed" in turn.provenance,
              turn.provenance)
        # THE FIRST PART DID NOT WAIT FOR THE SILENCE GATE. The opener is spoken at once
        # and the gate is four seconds; a part that waited for it would arrive after the
        # answer had finished being written, which is the whole cost this slice removes.
        check("a part does not wait out the four second silence gate",
              time.time() - started < 4.0 + 0.5, f"{time.time() - started:.1f}s")
        # NARRATION AND THE ANSWER NEVER INTERLEAVE. The `read` line was written BEFORE
        # the first part and still inside the silence gate, so it is refused once the
        # answer has started rather than spoken over it.
        check("no narration line was spoken over the answer",
              narration_line("read") not in said, str(said))
        lines = [json.loads(one) for one in
                 (tmp / "transcript.jsonl").read_text().splitlines() if one.strip()]
        kinds = [line["kind"] for line in lines]
        check("every part is on the record", kinds.count("answer-part") == 2, str(kinds))
        check("and the narration line it displaced is refused on the record, not dropped",
              any(line["kind"] == "progress-refused"
                  and "answering" in str(line.get("why")) for line in lines),
              str([line for line in lines if line["kind"] == "progress-refused"]))
    finally:
        connected.ask = saved

    # ---- the house opens with a line and then goes back to work ------------- #
    # NARRATION REOPENS (V12, review round 2). A house that says "Let me check that file."
    # before it picks up a tool used to silence every progress line for the rest of a turn
    # that might run for a minute. An action arriving after a part says that text was a
    # PREAMBLE, so the wait gets its narration back until the answer really starts, and
    # the parts that were the preamble stop counting as the answer.
    spoken3 = []
    tmp3 = Path(tempfile.mkdtemp())
    d3 = _dispatcher(doc, spoken3, tmp=tmp3, deliver=FakeDeliver(True, "delivered"))
    gate_was = config.PROGRESS_SILENCE_AT

    def preamble_ask(card, said, timeout=0, pinned=True, turn="", progress="", **_rest):
        """part, action, action, part, part, result: the shape review round 2 named."""
        _stamp_part(Path(progress), "Let me check that file.", turn)
        time.sleep(0.4)
        _stamp(Path(progress), "read", turn)
        time.sleep(0.4)
        _stamp(Path(progress), "edit", turn)
        time.sleep(0.4)
        _stamp_part(Path(progress), "Phase two is merged.", turn)
        _stamp_part(Path(progress), "The tests pass.", turn)
        time.sleep(0.5)
        return {"ok": True, "say": answer, "card": card, "held_until": None}

    try:
        config.PROGRESS_SILENCE_AT = 0.1    # the gate is real, just not four seconds here
        connected.ask = preamble_ask
        d3.pin_to("c-272", None, "Voice slice 5", "personal")
        turn3 = d3.answer("where are you up to")
        settle(d3, seconds=20)
        said3 = [text for _gen, text, _spk in spoken3]
        check("the preamble is spoken as the house's own words",
              "Let me check that file." in said3, str(said3))
        check("and narration comes BACK after it, instead of the turn going silent",
              narration_line("read") in said3 or narration_line("edit") in said3,
              str(said3))
        check("the answer that follows is spoken as it streams, as usual",
              said3[-2:] == ["Phase two is merged.", "The tests pass."], str(said3))
        check("and the whole answer is still not repeated at the end",
              said3.count(answer) == 0, str(said3))
        check("what counts as spoken is the LAST message's parts, not the preamble",
              turn3.spoke_parts == ["Phase two is merged.", "The tests pass."],
              str(turn3.spoke_parts))
    finally:
        connected.ask = saved
        config.PROGRESS_SILENCE_AT = gate_was

    # ---- he says something else mid-answer ---------------------------------- #
    # THE PARTS STOP, and the whole answer is spoken once he is quiet. What he heard was
    # half of one answer, so the held answer is the COMPLETE one: this is the single case
    # where the final say line is voiced although parts were spoken, and it is why the
    # turn has to remember that its streaming was cut rather than merely that it streamed.
    spoken2 = []
    tmp2 = Path(tempfile.mkdtemp())
    d2 = _dispatcher(doc, spoken2, tmp=tmp2, deliver=FakeDeliver(True, "delivered"))
    release = threading.Event()
    turns = []

    def slow_ask(card, said, timeout=0, pinned=True, turn="", progress="", **_rest):
        """The first call streams one part and then blocks, so his next sentence lands
        while the house is still writing the rest."""
        if len(turns) == 0:
            turns.append(turn)
            _stamp_part(Path(progress), "Phase two is merged.", turn)
            release.wait(20)
            return {"ok": True, "say": answer, "card": card, "held_until": None}
        return {"ok": True, "say": "Right, never mind.", "card": card, "held_until": None}

    try:
        connected.ask = slow_ask
        d2.pin_to("c-272", None, "Voice slice 5", "personal")
        first = threading.Thread(target=lambda: d2.answer("where are you up to"),
                                 daemon=True)
        first.start()
        deadline = time.time() + 10
        while time.time() < deadline and not [t for _g, t, _s in spoken2
                                              if t == "Phase two is merged."]:
            time.sleep(0.05)
        held = d2.turn
        # THE RACE, MADE AN ORDER (the flake of 2026-09-24, per I7). Under load the answer
        # could land in the say inbox before the first turn's watch loop had made a single
        # pass since he moved on, and that pass claims `say` first: the whole answer was
        # then compared as a remainder rather than spoken whole. So the watch loops are held
        # at `pass_gate` while he moves on AND the answer lands, and the test waits on the
        # file itself rather than on a sleep; the next pass sees both, every time.
        with d2.pass_gate:
            d2.answer("actually never mind")      # he moved on, mid-answer
            release.set()
            landed = time.time() + 20
            while time.time() < landed and not any(
                    json.loads(f.read_text()).get("turn") == held.id
                    for f in (tmp2 / "say").glob("*.json")):
                time.sleep(0.02)
        settle(d2)
        first.join(timeout=20)
        deadline = time.time() + 20
        while time.time() < deadline and answer not in [t for _g, t, _s in spoken2]:
            time.sleep(0.1)
        said2 = [text for _gen, text, _spk in spoken2]
        check("the parts stop when he moves on", said2.count("The tests pass.") == 0,
              str(said2))
        check("and the turn knows its answer was cut off part way", held.parts_cut,
              f"{held.parts_cut} {held.spoke_parts}")
        check("so the answer he missed half of is spoken whole once he is quiet",
              said2.count(answer) == 1, str(said2))
    finally:
        connected.ask = saved
        release.set()


def connected_wait_section():
    """WHAT COVERS THE WAIT INSIDE A HOUSE, now that the opener is gone (2026-09-21).

    HIS SECOND SESSION THAT DAY. Every connected turn opened with "Heard you, passing that
    to the house now" (`corpus.HOUSE_OPENER`, spoken at the top of `_ask_house`). It was
    written for V5, when connecting meant stopping one `claude` and starting another and
    the first seconds of a turn were certain to be silent. V12 opens the conversation at
    the connect, so the first spoken part lands in about three seconds, and V13 made Harbor
    ENTER the house: the line was wrong about where he was, and it talked over a wait that
    was usually already over.

    SO A CONNECTED WAIT IS COVERED EXACTLY AS A HARBOR WAIT IS, and this section is the
    claim that it is the SAME mechanism rather than a second one: the ordinary filler
    corpus, chosen by the same call, spoken only when the wait really goes quiet for the
    same `config.PROGRESS_SILENCE_AT` a progress line waits behind. A turn that answers
    inside the gate says nothing at all.
    """
    print()
    print("== inside a house, the wait is covered by the ordinary filler (V13) ==")
    doc = fixture()
    saved = connected.ask
    gate_was = config.PROGRESS_SILENCE_AT

    # ---- the first part lands inside the gate: nothing is said -------------- #
    spoken = []
    tmp = Path(tempfile.mkdtemp())
    d = _dispatcher(doc, spoken, tmp=tmp, deliver=FakeDeliver(True, "delivered"))

    def prompt_ask(card, said, timeout=0, pinned=True, turn="", progress="", **_rest):
        time.sleep(1.0)                 # the first part at one second, as V12 makes it
        _stamp_part(Path(progress), "Phase two is merged.", turn)
        time.sleep(0.4)
        return {"ok": True, "say": "Phase two is merged.", "card": card,
                "held_until": None}

    try:
        connected.ask = prompt_ask
        d.pin_to("c-272", None, "Voice slice 5", "personal")
        turn = d.answer("where are you up to")
        settle(d, 20.0)
        said = [text for _gen, text, _spk in spoken]
        check("a connected turn whose answer starts in a second says no filler at all",
              said == ["Phase two is merged."], str(said))
        check("and nothing was narrated either, so the wait was simply quiet",
              turn.narration == [], str(turn.narration))
    finally:
        connected.ask = saved

    # ---- the first part lands past the gate: ONE ordinary filler line -------- #
    # THE GATE IS REAL, JUST NOT FOUR SECONDS HERE, exactly as the preamble drive above
    # does it: waiting out the shipping value would add four seconds to every promotion.
    spoken2 = []
    tmp2 = Path(tempfile.mkdtemp())
    d2 = _dispatcher(doc, spoken2, tmp=tmp2, deliver=FakeDeliver(True, "delivered"))

    def slow_ask(card, said, timeout=0, pinned=True, turn="", progress="", **_rest):
        time.sleep(1.2)                 # past the gate below, which is 0.5 s
        _stamp_part(Path(progress), "Phase two is merged.", turn)
        time.sleep(0.4)
        return {"ok": True, "say": "Phase two is merged.", "card": card,
                "held_until": None}

    try:
        config.PROGRESS_SILENCE_AT = 0.5
        connected.ask = slow_ask
        d2.pin_to("c-272", None, "Voice slice 5", "personal")
        turn2 = d2.answer("where are you up to")
        settle(d2, 20.0)
        said2 = [text for _gen, text, _spk in spoken2]
        check("a wait that really goes quiet is covered by ONE filler line",
              len(said2) == 2 and said2[0] in filler.TABLE, str(said2))
        check("and it is an ORDINARY filler line, the one a Harbor turn would have said",
              said2 and said2[0] in filler.TABLE, str(said2))
        check("then the house's own words, which is what he was waiting for",
              said2[-1:] == ["Phase two is merged."], str(said2))
        check("the filler is in HARBOR's voice and the answer in the house's (V8)",
              [spk.speaker for _gen, _t, spk in spoken2]
              == [config.SPEAKER_HARBOR, config.SPEAKER_HOUSE], str(spoken2))
        check("and it is on the record as a filler, not as an opener",
              any(line["kind"] == "filler" for line in
                  [json.loads(one) for one in
                   (tmp2 / "transcript.jsonl").read_text().splitlines() if one.strip()]),
              "")
        check("the answer is still not repeated at the end",
              said2.count("Phase two is merged.") == 1, str(said2))
        check("and the turn knows he heard it as it streamed",
              turn2.spoke_parts == ["Phase two is merged."], str(turn2.spoke_parts))
    finally:
        connected.ask = saved
        config.PROGRESS_SILENCE_AT = gate_was

    # ---- one mechanism, not two --------------------------------------------- #
    source = (PKG / "harbor_voice" / "dispatcher.py").read_text()
    check("both tiers ask the SAME filler for their line, with the same arguments",
          source.count("self.filler.line(turn.said, self.snapshot.doc)") == 2, "")
    check("and the connected one waits behind the same silence gate",
          source.count("config.PROGRESS_SILENCE_AT") >= 3, "")
    check("the repeat filler may never talk over an answer that has started",
          "and not turn.answering" in source, "")


def truncated_answer_section():
    """SPEAKING TAKES TIME, AND THE REST OF THE ANSWER ARRIVES WHILE IT DOES (V13).

    HIS OWN TRANSCRIPT, 2026-09-21 between 03:45 and 03:53 UTC. Turn `8c5a99dae023` spoke
    one sentence ("Yes, I can hear you...") and then finished with
    `spoken: false, reason: "the answer was spoken as it streamed"`. Its second sentence
    was never said out loud at all: it surfaced on the NEXT turn as
    `kind: dropped, channel: progress`. Turn `0ecee464c5ea` lost four that way.

    THE MECHANISM, AND IT IS ENTIRELY INSIDE `_say`. That call blocks for the length of
    the audio. While part one played, the remaining parts landed in the progress inbox and
    the final answer landed in the say inbox; the watch loop claims the SAY inbox at the
    top of every pass, so it took the final answer, saw `spoke_parts`, and finished the
    turn silently without ever claiming the parts it had not spoken yet.

    THIS FILE COULD NOT HAVE CAUGHT IT, because its `speak` returned instantly: there was
    no window for anything to land in. So the cases below are the first in it with REAL
    PLAYBACK TIME, and what they assert is the two halves of the repair:

    1. every sentence of the answer is spoken exactly once and in the order it was
       written, however long the audio takes;
    2. "he has already heard it" is a CHECKED FACT and not an assumption: what was spoken
       is compared with the final answer, the remainder is spoken when the stream stopped
       short, and the whole answer is spoken when the two diverge.
    """
    print()
    print("== speaking takes time, and the rest of the answer lands while it does (V13) ==")
    doc = fixture()
    saved = connected.ask
    parts = ["Yes, I can hear you.", "The branch is rebased.",
             "The tests are green.", "It is ready for you."]
    whole = " ".join(parts)

    # ---- every sentence, once, in order ------------------------------------- #
    spoken = []
    tmp = Path(tempfile.mkdtemp())

    def slow_speak(text, gen, spk=None):
        spoken.append((gen, text, spk))
        time.sleep(0.4)                     # the audio, as far as the loop is concerned
        return {"engines": ["fake"]}

    d = _dispatcher(doc, spoken, tmp=tmp, deliver=FakeDeliver(True, "delivered"),
                    speak=slow_speak)

    def streaming_ask(card, said, timeout=0, pinned=True, turn="", progress="", **_rest):
        """Four sentences and then the result, all of them written while part one plays."""
        for part in parts:
            _stamp_part(Path(progress), part, turn)
            time.sleep(0.05)
        return {"ok": True, "say": whole, "card": card, "held_until": None}

    try:
        connected.ask = streaming_ask
        d.pin_to("c-272", None, "Voice slice 5", "personal")
        turn = d.answer("can you hear me")
        settle(d, seconds=30)
        said = [text for _gen, text, _spk in spoken]
        check("every sentence of the answer is spoken, although the audio took time",
              [one for one in said if one in parts] == parts, str(said))
        check("and not one of them twice",
              all(said.count(one) == 1 for one in parts), str(said))
        check("the whole answer is still not read out again on top of them",
              said.count(whole) == 0, str(said))
        check("nothing of it is left to surface as a drop on the next turn",
              not list((tmp / "progress").glob("*.json")),
              str(list((tmp / "progress").glob("*.json"))))
        check("and the turn is recorded as one he heard in full",
              turn.spoken and turn.spoke_parts == parts,
              f"{turn.spoken} {turn.spoke_parts}")
        lines = [json.loads(one) for one in
                 (tmp / "transcript.jsonl").read_text().splitlines() if one.strip()]
        check("'spoken as it streamed' is a CHECKED fact on the record, not an assumption",
              any(line.get("covered") is True for line in lines),
              str([line["kind"] for line in lines]))
    finally:
        connected.ask = saved

    # ---- the stream stopped short of the answer ----------------------------- #
    # WHAT IS SPOKEN IS THE REMAINDER, NOT THE WHOLE ANSWER AND NOT SILENCE. He has heard
    # the first sentence; reading it to him again is the regression V12 was careful about,
    # and saying nothing is the bug this card is fixing. The comparison is what tells the
    # two apart, so it has to be made rather than assumed.
    spoken2 = []
    tmp2 = Path(tempfile.mkdtemp())
    d2 = _dispatcher(doc, spoken2, tmp=tmp2, deliver=FakeDeliver(True, "delivered"))

    def short_ask(card, said, timeout=0, pinned=True, turn="", progress="", **_rest):
        """One sentence down the stream, two in the answer: the shape of his own turn."""
        _stamp_part(Path(progress), "Yes, I can hear you.", turn)
        time.sleep(0.3)
        return {"ok": True, "say": "Yes, I can hear you. The branch is rebased.",
                "card": card, "held_until": None}

    try:
        connected.ask = short_ask
        d2.pin_to("c-272", None, "Voice slice 5", "personal")
        turn2 = d2.answer("can you hear me")
        settle(d2, seconds=20)
        said2 = [text for _gen, text, _spk in spoken2]
        check("the sentence the stream never delivered is spoken",
              "The branch is rebased." in " ".join(said2[-1:]), str(said2))
        check("and the sentence he already heard is not repeated",
              said2.count("Yes, I can hear you.") == 1, str(said2))
        check("the turn still carries the whole answer for the page and the card",
              turn2.answer == "Yes, I can hear you. The branch is rebased.", turn2.answer)
        check("and it is recorded as a turn he heard, because it was finished out loud",
              turn2.spoken, str(turn2.spoken))
        lines2 = [json.loads(one) for one in
                  (tmp2 / "transcript.jsonl").read_text().splitlines() if one.strip()]
        check("how much was left is on the record, in characters",
              any(line["kind"] == "answer-remainder" and line.get("remainder")
                  for line in lines2),
              str([line["kind"] for line in lines2]))
    finally:
        connected.ask = saved

    # ---- what was spoken is not the start of the answer --------------------- #
    # A HOUSE THAT CHANGED ITS MIND, or a stream and a result that simply do not line up.
    # There is no honest remainder to take from an answer whose beginning he never heard,
    # so the whole thing is spoken: a wrong prefix would cut a sentence off its start.
    spoken3 = []
    tmp3 = Path(tempfile.mkdtemp())
    d3 = _dispatcher(doc, spoken3, tmp=tmp3, deliver=FakeDeliver(True, "delivered"))

    def diverging_ask(card, said, timeout=0, pinned=True, turn="", progress="", **_rest):
        _stamp_part(Path(progress), "Let me check the branch.", turn)
        time.sleep(0.3)
        return {"ok": True, "say": "Actually it is already merged.", "card": card,
                "held_until": None}

    try:
        connected.ask = diverging_ask
        d3.pin_to("c-272", None, "Voice slice 5", "personal")
        d3.answer("where are you up to")
        settle(d3, seconds=20)
        said3 = [text for _gen, text, _spk in spoken3]
        check("an answer he never heard the start of is spoken whole",
              said3.count("Actually it is already merged.") == 1, str(said3))
    finally:
        connected.ask = saved

    # ---- markdown is not a difference he can hear --------------------------- #
    # THE CUTTER STRIPS MARKDOWN AND THE FINAL ANSWER KEEPS IT (`keel/sentences.clean`
    # against `harness.turn_answer`), so the same words reach this comparison spelled two
    # ways. Comparing them raw would call every bolded answer a divergence and read the
    # whole thing out a second time.
    covered, why = dispatcher.answer_left(["Phase two is merged.", "The tests pass."],
                                          "**Phase two is merged.** The tests pass.")
    check("a bolded answer he has already heard is not read out again",
          covered == "", f"{covered!r} {why}")

    # ---- a part for a turn that has already finished ------------------------ #
    # NAMED, WITH THE TURN IT BELONGED TO. Before this it surfaced at the NEXT turn's
    # `begin()` as a generic `dropped` on the progress channel, which is what his own
    # transcript shows and what made the fault read as a narration line going missing
    # rather than as an answer being cut in half.
    spoken4 = []
    tmp4 = Path(tempfile.mkdtemp())
    d4 = _dispatcher(doc, spoken4, tmp=tmp4, deliver=FakeDeliver(True, "delivered"))
    first = d4.begin("the turn that ended")
    d4.progress_inbox.dir.mkdir(parents=True, exist_ok=True)
    path = d4.progress_inbox.dir / "late.json"
    path.write_text(json.dumps({"text": "And the tests pass.", "at": time.time(),
                                "turn": first.id, "part": True}))
    d4.begin("the next thing he said")
    late = [json.loads(one) for one in
            (tmp4 / "transcript.jsonl").read_text().splitlines() if one.strip()]
    check("a part that arrives after its turn is over is logged as a late part",
          any(line["kind"] == "late-part" and line.get("forTurn") == first.id
              for line in late),
          str([(line["kind"], line.get("forTurn")) for line in late]))
    check("and never as a generic drop, which is what hid this in his transcript",
          not any(line["kind"] == "dropped" and line.get("channel") == "progress"
                  for line in late),
          str([line["kind"] for line in late]))


def page_protocol_section():
    """The re-arm and the trace: what the gateway owes the page, and what it writes down.

    WHAT WENT WRONG, 2026-09-21 at 03:47:12 UTC. A connect finished, the page showed
    "listening" for sixty-two seconds, and not one frame of audio reached the gateway: the
    transcript has `connect-taking` and then nothing at all until he gave up and pressed
    the orb at 03:48:15. Neither end could say afterwards which half had failed, because
    neither end wrote anything down: a listen that never received audio looked exactly
    like a listen nobody spoke into.

    SO THIS SLICE IS HALF A PROTOCOL AND HALF A RECORD, and the record is the part that
    makes the next one diagnosable rather than re-argued:

    - `listen-now` is the gateway telling the page it may press its own orb, sent once
      after a connect or a release has FINISHED SPEAKING. The page decides whether to
      obey it, because the page owns the microphone;
    - `trace` is the page telling the gateway what its own watchdog saw. It is WRITTEN AND
      NEVER ACTED ON, which is the whole of its safety: a message that could arm anything
      would be a second way into this process from a page;
    - and the socket loop writes down `listen`, `frames` and `endpoint`, so a listen that
      opened and received nothing is visible as a `listen` with no `frames` after it.
    """
    print()
    print("== the page protocol: re-arm, trace, and a listen that can be read back ==")
    doc = fixture()
    tmp = Path(tempfile.mkdtemp())
    spoken = []
    d = _dispatcher(doc, spoken, tmp=tmp)

    # ---- a gateway event, against the turn that is live --------------------- #
    turn = d.begin("what is going on")
    d.log_event("listen", handsFree=True, listen=7)
    turn.phase = "done"
    d.log_event("listen", handsFree=False, listen=8)
    lines = [json.loads(one) for one in
             (tmp / "transcript.jsonl").read_text().splitlines() if one.strip()]
    listens = [line for line in lines if line["kind"] == "listen"]
    check("a socket event is written against the turn that is live at the time",
          len(listens) == 2 and listens[0]["turn"] == turn.id, str(listens))
    check("and against no turn at all when none is running, rather than the last one",
          listens[1]["turn"] == "", str(listens[1]))

    # ---- the socket loop, driven for real ----------------------------------- #
    # THE REAL LOOP, not a grep of it. The three kinds are written from inside the frame
    # handling, and the one thing worth proving about `frames` is that it fires ONCE per
    # listen however many chunks arrive, since "this listen heard audio" is the question
    # and a line per 32 ms chunk would answer it by drowning it.
    class Scripted:
        def __init__(self, frames):
            self.frames = list(frames)
            self.sent = []

        def recv(self):
            return self.frames.pop(0) if self.frames else None

        def send_json(self, obj):
            self.sent.append(obj)
            return True

        def send_binary(self, payload):
            return True

        def close(self):
            pass

    def text_frame(obj):
        return (ws.TEXT, json.dumps(obj).encode())

    chunk = b"\0\1" * 512
    sock = Scripted([
        text_frame({"type": "start", "handsFree": True, "listen": 7,
                    "conversation": True}),
        (ws.BINARY, chunk),
        (ws.BINARY, chunk),                      # the second one writes no second line
        text_frame({"type": "trace", "event": "stalled", "reason": "no frames in 5s",
                    "listen": "7", "at": 61234}),
        (ws.BINARY, chunk),                      # this one ends the utterance
    ])

    class FakeVad:
        def reset(self):
            pass

    class FakeGateway:
        def __init__(self, dispatcher):
            self.dispatcher = dispatcher
            self.vad = FakeVad()
            self.bus = dispatcher.bus
            self.last_activity = 0.0
            self.heard = 0
            self.acted = []

        def add_client(self, sock):
            pass

        def drop_client(self, sock):
            pass

        def set_conversation(self, open_, sock=None):
            pass

        def barged_in(self):
            pass

        def hear(self, endpointer, payload):
            self.heard += 1
            return self.heard >= 3           # he stops talking on the third chunk

        def on_utterance(self, **kw):
            self.acted.append(kw)

        def on_text(self, *args, **kw):
            self.acted.append(kw)

        def connect_to(self, **kw):
            self.acted.append(kw)

    handler = servermod.Handler.__new__(servermod.Handler)
    handler.headers = {}
    was_gateway, was_upgrade, was_origin, was_socket = (
        servermod.GATEWAY, ws.is_upgrade, ws.same_origin, ws.Socket.upgrade)
    gw = FakeGateway(d)
    try:
        servermod.GATEWAY = gw
        ws.is_upgrade = lambda headers: True
        ws.same_origin = lambda headers: True
        ws.Socket.upgrade = staticmethod(lambda h: sock)
        handler._websocket()
    finally:
        servermod.GATEWAY = was_gateway
        ws.is_upgrade, ws.same_origin = was_upgrade, was_origin
        ws.Socket.upgrade = was_socket

    lines = [json.loads(one) for one in
             (tmp / "transcript.jsonl").read_text().splitlines() if one.strip()]
    kinds = [line["kind"] for line in lines]
    started = [line for line in lines if line["kind"] == "listen"][2:]
    check("a listen that opens is on the record, and says whether it was hands-free",
          len(started) == 1 and started[0].get("handsFree") is True
          and started[0].get("listen") == 7, str(started))
    check("the first frame of audio is on the record, once for the whole listen",
          kinds.count("frames") == 1, str(kinds))
    ends = [line for line in lines if line["kind"] == "endpoint"]
    check("and so is the endpoint the gateway sent, with the reason it sent it for",
          len(ends) == 1 and ends[0].get("reason") == "hangover", str(ends))
    check("so a listen that received nothing reads as a listen with no frames after it",
          kinds.index("listen") < kinds.index("frames"), str(kinds))

    page = [line for line in lines if line["kind"] == "page"]
    check("the page's own trace is written down as the page's",
          len(page) == 1 and page[0].get("event") == "stalled"
          and page[0].get("reason") == "no frames in 5s"
          and page[0].get("listen") == "7" and page[0].get("at") == 61234,
          str(page))
    check("and NOTHING acted on it: a trace is a record, never a second way in",
          gw.acted == [], str(gw.acted))
    check("the gateway answered the endpoint and said nothing else to the page",
          [one.get("type") for one in sock.sent] == ["endpoint"], str(sock.sent))


def late_answer_section():
    """The house answers AFTER he has moved on (V5, c-317, and the send-back that found it).

    THIS IS THE COMMON CASE NOW, NOT A CORNER. A connected turn used to block inside
    `_ask_house` and come back answered, so "he said something else while it was running"
    could not happen at all. It is asynchronous now, and a house turn that edits something
    takes a minute, so the ordinary shape of a conversation is that he says something else
    first.

    The fault the send-back found: `begin()` marked a superseded turn `held` only when its
    tier was HARBOR, so a superseded HOUSE turn left `_watch`'s loop on the next 0.4 s tick
    and its answer sat in the inbox until the next `begin()` drained it as `dropped`. Never
    spoken, never noted, and the `held_until` and `unpin` the verb asked for went with it.
    """
    print()
    print("== the house answers after he has moved on (V5) ==")
    doc = fixture()

    def start_house_turn(d, said, replies, release):
        """A connected turn whose FIRST verb call blocks until `release` is set.

        `replies` is one reply per call, in order. The first blocks, which is what makes
        the second utterance supersede the first turn while it is still in flight.
        """
        calls = []

        def fake_ask(card, said_now, timeout=0, pinned=True, turn="", progress="", **_rest):
            index = len(calls)
            calls.append(said_now)
            if index == 0:
                release.wait(30)
            return dict(replies[min(index, len(replies) - 1)], card=card)

        connected.ask = fake_ask
        opened = threading.Event()

        def go():
            opened.set()
            d.answer(said)
        thread = threading.Thread(target=go, daemon=True)
        thread.start()
        opened.wait(5)
        time.sleep(0.5)                      # the worker is away and the watcher is up
        return thread

    def wait_for(said, text, seconds=25.0):
        deadline = time.time() + seconds
        while time.time() < deadline:
            if text in [t for _g, t, _s in said]:
                return True
            time.sleep(0.1)
        return False

    # ----- 1. he says something else before the house answers -----
    # While he is connected, his next sentence is that house's too, so the second turn is
    # a second connected turn. What supersedes the first is `begin()`, whatever came next.
    spoken = []
    d = _dispatcher(doc, spoken, tmp=Path(tempfile.mkdtemp()),
                    deliver=FakeDeliver(True, "delivered"))
    d.pin_to("c-272", None, "a card")
    release = threading.Event()
    saved = connected.ask
    try:
        thread = start_house_turn(
            d, "merge phase two into phase one",
            [{"ok": True, "say": "I merged the two phases.", "held_until": None},
             {"ok": True, "say": "It is at review.", "held_until": None}], release)
        second = d.answer("and where are you up to")   # supersedes the first turn
        settle(d, 20.0)
        release.set()
        thread.join(25)
        wait_for(spoken, "I merged the two phases.")
    finally:
        connected.ask = saved
    said = [t for _g, t, _s in spoken]
    check("the delayed house answer IS spoken",
          "I merged the two phases." in said, str(said))
    check("and spoken exactly once", said.count("I merged the two phases.") == 1, str(said))
    check("after the turn he interrupted it with, never over it",
          "It is at review." in said
          and said.index("It is at review.") < said.index("I merged the two phases."),
          str(said))
    check("with the preface that names the card, because minutes may have passed",
          said[said.index("I merged the two phases.") - 1]
          == dispatcher.NARRATION["house_late"].format(card="c-272"), str(said))
    check("and the second turn answered normally in the meantime",
          second.answer == "It is at review.", second.answer)

    # ----- 2. he disconnects and speaks to Harbor before it answers -----
    spoken = []
    live = [True]
    d = _dispatcher(doc, spoken, tmp=Path(tempfile.mkdtemp()),
                    deliver=FakeDeliver(True, "delivered"),
                    presence=lambda: live[0])
    d.pin_to("c-272", None, "a card")
    release = threading.Event()
    saved = connected.ask
    try:
        thread = start_house_turn(
            d, "merge phase two into phase one",
            [{"ok": True, "say": "I merged the two phases.",
              "held_until": None, "unpin": True}], release)
        d.unpin()                                     # "back to Harbor"
        # A TALK QUESTION, deliberately: "what's waiting on me" is the one board read code
        # answers, and an instant answer never touches the say inbox, so it would not be
        # the Harbor turn this test needs to supersede the house one.
        harbor = d.answer("what do you make of all that")
        SayInbox(Path(d.inbox.dir)).write("Two cards are waiting.", turn=harbor.id)
        settle(d, 20.0)
        live[0] = False                               # and then he walks away
        release.set()
        thread.join(25)
        time.sleep(3.0)
    finally:
        connected.ask = saved
    said = [t for _g, t, _s in spoken]
    check("an answer nobody is there to hear is not spoken",
          "I merged the two phases." not in said, str(said))
    check("the Harbor turn he moved on to still answered",
          "Two cards are waiting." in said, str(said))
    check("and the unpin the verb asked for is still applied",
          d.pinned() == "", str(d.pin))
    check("the record is not lost: the turn carries the answer it never spoke",
          any(t.tier == "house" and t.answer == "I merged the two phases."
              for t in d.history), str([(t.tier, t.answer) for t in d.history]))


def connect_by_description_section():
    """The model picks the house and the gateway pins (c-419).

    ONE TURN, END TO END, WITH A FAKE HARBOR ANSWER. The deliver writes into the say
    inbox exactly as `harbormsg`'s worker does, carrying the key it was handed in the
    framing, so what is exercised here is the real watch loop, the real strip, the real
    five conditions and the real hand-off to the gateway. Nothing runs a model and
    nothing runs `keel converse`.
    """
    print()
    print("== connect by description: Harbor names the card, the gateway pins (c-419) ==")
    doc = fixture()

    class FakeHarbor:
        """Records the key it was given and answers with a directive carrying it."""

        def __init__(self, inbox, answer):
            self.inbox = inbox
            self.answer = answer
            self.keys = []

        def __call__(self, said, context="", **extra):
            key = str(extra.get("connect_key") or "")
            self.keys.append(key)
            self.inbox.write(self.answer(key), turn=str(extra.get("turn_id") or ""))
            return True, "delivered"

    def one_turn(answer, said="put me through to the house doing the voice narration",
                 presence=None):
        """One whole Harbor turn against a real dispatcher; what was spoken and what the
        gateway was asked to connect to."""
        tmp = Path(tempfile.mkdtemp())
        spoken = []
        harbor = FakeHarbor(SayInbox(tmp / "say"), answer)
        d = _dispatcher(doc, spoken, tmp=tmp, deliver=harbor, presence=presence)
        pinned = []
        d.connect_asked = lambda card: pinned.append(card) or True
        turn = d.answer(said)
        settle(d)
        return {"turn": turn, "spoken": [text for _gen, text, _spk in spoken],
                "pinned": pinned, "keys": harbor.keys,
                "log": [json.loads(line) for line
                        in (tmp / "transcript.jsonl").read_text().splitlines() if line]}

    config.JUDGES_LOG.unlink(missing_ok=True)
    named = one_turn(lambda key:
                     "That's card 317, the narration one.\n\n<<keel-connect c-317 %s>>" % key)
    judged = ([json.loads(x) for x in config.JUDGES_LOG.read_text().splitlines() if x]
              if config.JUDGES_LOG.exists() else [])
    check("the framing carried a key, minted for this turn",
          len(named["keys"]) == 1 and re.fullmatch(r"[0-9a-f]{6}", named["keys"][0] or ""),
          str(named["keys"]))
    check("the answer he hears is Harbor's sentence, and the card is named in it",
          named["turn"].answer == "That's card 317, the narration one.",
          repr(named["turn"].answer))
    check("the directive is never spoken, on any line of the turn",
          not any("keel-connect" in text for text in named["spoken"]),
          str(named["spoken"]))
    check("and the gateway was asked to connect, to the card Harbor named",
          named["pinned"] == ["c-317"], str(named["pinned"]))
    check("the directive is on the record, so a wrong pick can be read back afterwards",
          [r for r in named["log"] if r.get("kind") == "connect-directive"],
          str([r.get("kind") for r in named["log"]]))
    check("c-552: and the judges' log gets a `connected` outcome naming that card and turn",
          [(r.get("outcome"), r.get("card"), r.get("turn")) for r in judged
           if r.get("kind") == "outcome"] == [("connected", "c-317", named["turn"].id)],
          str(judged))

    # A SENTENCE THAT MERELY CONTAINS THE SHAPE. This is the case the per-turn key exists
    # for: he asked how the connect works, and the answer quotes the form.
    quoted = one_turn(
        lambda key: "You would end with <<keel-connect c-317 %s>> on the last line." % key,
        said="how does the connect directive work")
    check("the shape as ordinary words inside a sentence pins nothing",
          quoted["pinned"] == [], str(quoted["pinned"]))
    check("and it is still never read aloud, because out loud it is gibberish",
          not any("keel-connect" in text for text in quoted["spoken"]),
          str(quoted["spoken"]))

    # A KEY THAT IS NOT THIS TURN'S: a directive quoted out of an earlier answer, or
    # invented. It is a MISS, which costs a sentence he hears and never a wrong pin.
    stale = one_turn(lambda key: "That's card 317.\n<<keel-connect c-317 0f0f0f>>")
    check("a directive carrying a key that is not this turn's pins nothing",
          stale["pinned"] == [], str(stale["pinned"]))

    # NOBODY IS THERE TO HEAR THE SWITCH. The answer is filed rather than spoken, so the
    # pin is not taken: a switch he cannot hear is the one thing V8 rules out.
    away = one_turn(lambda key:
                    "That's card 317, the narration one.\n<<keel-connect c-317 %s>>" % key,
                    presence=lambda: False)
    check("an answer he cannot hear takes no pin",
          away["pinned"] == [], str(away["pinned"]))
    check("and the directive that was dropped says why on the record",
          [r for r in away["log"] if r.get("kind") == "connect-dropped"],
          str([r.get("kind") for r in away["log"]]))

    # NOT OVER A PIN HE ALREADY HAS. A late answer from before the pin must not take the
    # microphone off the house he is talking to now.
    tmp = Path(tempfile.mkdtemp())
    spoken = []
    d = _dispatcher(doc, spoken, tmp=tmp)
    pinned = []
    d.connect_asked = lambda card: pinned.append(card) or True
    late = d.begin("an older question")
    late.connect = "c-317"
    d.pin_to("c-272", time.time() + 300, "Voice slice 5", "personal")
    d._take_connect(late)
    check("a directive that arrives while he is already connected is dropped",
          pinned == [] and d.pinned() == "c-272", f"{pinned} {d.pin}")
    d.unpin()

    # A HOUSE CANNOT MOVE THE PIN. The way back is the gateway's (V8), and so is the way
    # in: only a Harbor turn is ever given a key, and an empty key matches nothing.
    spoken_house, card_house = verbs.connect_directive(
        "Done.\n<<keel-connect c-317 9f4c2a>>", "")
    check("a house's answer can never carry a directive that pins",
          card_house == "" and "keel-connect" not in spoken_house,
          f"{card_house} {spoken_house!r}")


def narrate_seat_section():
    """The `narrate` seat, the V5 rule it logs, and what it can never say (c-317, V10).

    Two claims, and they are the two V10 asks for.

    THE FIRST IS THAT THE JUDGE DECIDES NOTHING, and it is made the strong way: rather
    than comparing `off` against `shadow`, the whole drive is repeated with Jev PRETENDING
    a confident "do not say it" and the key forced `on` with a zero floor (`judges.pretend`
    does both). If the audio is identical even then, the seat has nowhere to put a verdict,
    which is a better claim than "the switch happens to be shadow today".

    THE SECOND IS WHAT IS SENT. The judge is asked about an ACTION KEY out of a closed set
    ("is an edit worth mentioning"), never about what was edited. The log lines are read
    back and checked against that set, so a seat that started sending the progress sentence,
    or worse the tool's input, would fail here.
    """
    from harbor_voice import judges as judgesmod                        # noqa: PLC0415
    print()
    print("== the narrate seat: asked beside the decision, deciding nothing (V5, V10) ==")

    doc = fixture()
    log = Path(config.JUDGES_LOG)
    before = log.stat().st_size if log.exists() else 0

    def drive(actions):
        """One connected turn whose house narrates `actions`; what was spoken, in order."""
        spoken = []
        d = _dispatcher(doc, spoken, tmp=Path(tempfile.mkdtemp()),
                        deliver=FakeDeliver(True, "delivered"))
        d.pin_to("c-272", None, "a card")

        def fake_ask(card, said, timeout=0, pinned=True, turn="", progress="", **_rest):
            for action in actions:
                if progress:
                    _stamp(Path(progress), action, turn)
                    # THE SILENCE GATE IS FOUR SECONDS AND IT IS REAL, so a drive that
                    # wrote its lines back to back would have every one of them but the
                    # last thrown away. Waiting is the only honest way to test it.
                    time.sleep(config.PROGRESS_SILENCE_AT + 0.6)
            return {"ok": True, "say": "Done, it is on the card.", "card": card}

        saved = connected.ask
        connected.ask = fake_ask
        try:
            turn = d.answer("how far have you got")
            settle(d, 60.0)
        finally:
            connected.ask = saved
        return turn, [text for _gen, text, _spk in spoken]

    # ONE EDIT, THEN A READ: two different actions, so both are worth saying.
    turn, said = drive(["edit", "read"])
    # NOTHING IS SAID BEFORE THE HOUSE'S OWN ACTIVITY (2026-09-21). The V5 opener was the
    # first line of every connected turn and it is gone; what covers a connected wait now
    # is the ordinary filler, and a REAL progress line is preferred over a canned one, so
    # the first thing he hears on this turn is the edit.
    check("the first thing spoken is the house's real activity, not an opener",
          said and said[0] == NARRATION_SENTENCES["edit"], str(said))
    check("the house's answer is the last thing spoken",
          said and said[-1] == "Done, it is on the card.", str(said))
    check("the house's real activity was narrated in between",
          NARRATION_SENTENCES["edit"] in said and NARRATION_SENTENCES["read"] in said,
          str(said))

    # THE REPEAT RULE, which is the one rule that is entirely this slice's.
    check("the repeat rule compares the action, not the sentence",
          dispatcher.narration_repeat("read", "read")
          and not dispatcher.narration_repeat("read", "edit"))
    check("nothing is never a repeat", not dispatcher.narration_repeat("", ""))
    _turn, twice = drive(["edit", "edit"])
    check("the same action twice running is said once",
          twice.count(NARRATION_SENTENCES["edit"]) == 1, str(twice))

    # THE SEAT DECIDES NOTHING, even with the judge forced on and confident.
    plain = drive(["edit", "read"])[1]
    with judgesmod.pretend(narrate=(False, 0.99)):
        judged = drive(["edit", "read"])[1]
    check("a confident verdict to stay quiet changes nothing that is spoken",
          plain == judged, f"{plain} against {judged}")

    # WHAT WAS SENT: an action key and nothing else.
    lines = []
    if log.exists():
        with log.open() as fh:
            fh.seek(before)
            lines = [json.loads(ln) for ln in fh if ln.strip()]
    calls = [ln for ln in lines if ln.get("judge") == "narrate"]
    check("the seat was asked at all", bool(calls), f"{len(lines)} new log lines")
    check("and every call's text is an action out of the closed set",
          all(c.get("text") in NARRATION_ACTIONS for c in calls),
          str(sorted({c.get("text") for c in calls})))
    check("no call carries the sentence, let alone what a tool was given",
          not any(c.get("text", "") in NARRATION_SENTENCES.values() for c in calls),
          str(sorted({c.get("text") for c in calls})))
    check("the rule's verdict is a yes or a no about saying it",
          all(isinstance((c.get("rule") or {}).get("narrate"), bool) for c in calls),
          str([c.get("rule") for c in calls]))

    # THE CAP, which exists because the shadow slot is one and is shared with the judge
    # that has a turn waiting on it.
    check("the cap is a small number", 0 < dispatcher.NARRATE_SHADOW_CAP <= 10,
          str(dispatcher.NARRATE_SHADOW_CAP))
    check("a capped call is a logged miss, not a silence", bool(dispatcher.CAPPED))
    check("the seat stands down while another judge holds the slot",
          "shadow_busy" in judgesmod.__dict__ and callable(judgesmod.shadow_busy))


def connected_section():
    """Connecting to one card's house (c-315, V4 and V6), narrated (c-317, V5).

    `keel converse` is never run: `connected.ask`, `connect` and `release` are replaced
    with recorders, exactly as `deliver` is, because the real ones shell out to the board
    and would stop a house on this machine.
    """
    print()
    print("== connected to one card's house (V4) ==")
    doc = fixture()
    spoken = []
    d = _dispatcher(doc, spoken, deliver=FakeDeliver(True, "delivered"))
    calls = []

    def fake_ask(card, said, timeout=0, pinned=True, turn="", progress="", **_rest):
        calls.append((card, said, turn, progress))
        return {"ok": True, "say": "It is at review, waiting on you.", "card": card,
                "held_until": None, "seconds": 6.2}

    saved = connected.ask
    connected.ask = fake_ask
    try:
        turn = d.answer("where are you up to")
        check("unpinned, an ordinary turn still goes to Harbor",
              turn.tier == "harbor" and not calls, f"tier was {turn.tier}, calls {calls}")

        d.pin_to("c-272", None, "Voice slice 5")
        check("the pin is what the page reads", d.pinned() == "c-272", str(d.pin))
        turn = d.answer("where are you up to")
        settle(d)
        check("pinned, the turn goes to the house and not to Harbor",
              turn.tier == "house" and [c[:2] for c in calls] == [
                  ("c-272", "where are you up to")],
              f"tier was {turn.tier}, calls {calls}")
        check("the house's answer is what is spoken",
              turn.answer == "It is at review, waiting on you.", turn.answer)
        # ---- AND IT IS SPOKEN IN THE HOUSE'S VOICE (V8, card c-316) ---------- #
        # THE FOUR FIXED LINES ARE NOT THE REQUIREMENT, they are its opening. If the
        # greeting were the only thing in the second voice, the distinction would last one
        # sentence and then Harbor would read the house's work back to him, which is the
        # confusion V8 exists to remove. Every word that comes back from `keel converse`
        # while pinned is the house's, and this is the one place that is decided.
        check("and it is spoken in the HOUSE's voice, not only the greeting",
              turn.speaker == config.SPEAKER_HOUSE, turn.speaker)
        check("the page is told whose answer it was, so a replay keeps the voice",
              turn.as_json().get("speaker") == config.SPEAKER_HOUSE,
              str(turn.as_json().get("speaker")))
        check("the provenance names the card", "c-272" in turn.provenance, turn.provenance)
        # V5: THE VERB IS TOLD WHERE TO NARRATE, and it is told THIS dispatcher's inbox.
        check("the verb is given the turn id and the progress inbox",
              calls[0][2] == turn.id and calls[0][3] == str(d.progress_inbox.dir),
              f"turn {calls[0][2]!r}, progress {calls[0][3]!r}")
        # AND NOTHING WAS SAID WHILE HE WAITED (2026-09-21). This turn answers at once, so
        # the four second silence the filler covers never happens and the wait stays quiet:
        # the opener that used to speak here regardless is the line V13 deleted.
        check("a connected turn that answers at once says nothing before the answer",
              turn.narration == [], str(turn.narration))
        check("and the corpus has no connected opener left to say",
              not hasattr(corpus, "HOUSE_OPENER")
              and "house_opener" not in dispatcher.NARRATION,
              str(sorted(dispatcher.NARRATION)))

        # THE RULE VERDICT SAYS `connected`, so the shadow log records the decision the
        # turn actually made rather than one nothing took (V10 beside V4).
        check("the rule's route for a pinned turn says connected",
              d.rule_route("where are you up to") == "connected",
              d.rule_route("where are you up to"))
        check("a board question does not take the sentence off the house",
              d.rule_route("what's waiting on me") == "connected",
              d.rule_route("what's waiting on me"))
        check("a capture is still a capture while pinned",
              d.rule_route("remember to call the plumber", "capture") == "capture")

        # A REFUSAL IS AN ANSWER. The verb says why out loud and leaves the question on
        # the card; the turn speaks that sentence and ends.
        calls.clear()
        connected.ask = lambda card, said, timeout=0, pinned=True, turn="", progress="": (
            calls.append((card, said))
            or {"ok": False, "say": "c-272 is building right now.", "card": card})
        turn = d.answer("can you merge phase two")
        settle(d)
        check("a refusal is spoken as the answer",
              turn.answer == "c-272 is building right now.", turn.answer)
        check("a refusal does not drop the pin", d.pinned() == "c-272", str(d.pin))
        # THE VOICE FOLLOWS WHOSE ANSWER IT IS (V8). This sentence is the gateway speaking
        # ABOUT the house, not the house speaking, and he is still connected while it is
        # said, so the pin is not what decides the voice: the result is. Every refusal path
        # in `keel converse` is covered by this one line, which is why it is set from the
        # result rather than at each of them.
        check("but a refusal is HARBOR's voice, even mid-conversation",
              turn.speaker == config.SPEAKER_HARBOR, turn.speaker)

        # THE HOLD TAKEN AWAY FROM UNDER HIM: he stopped the house from the deck, or
        # answered its gate. The verb is the only one that can see it, so it answers with
        # `unpin` and the pin goes here rather than being quietly retaken.
        calls.clear()
        connected.ask = lambda card, said, timeout=0, pinned=True, turn="", progress="": (
            calls.append((card, said))
            or {"ok": False, "say": "That house was stopped, so we are back to Harbor.",
                "card": card, "unpin": True})
        turn = d.answer("are you still there")
        settle(d)
        check("a turn whose hold has gone drops the pin", d.pinned() == "", str(d.pin))
        check("and says so, once", "back to Harbor" in turn.answer, turn.answer)

        d.pin_to("c-272", None, "Voice slice 5")
        d.unpin()
        check("back to Harbor drops the pin", d.pinned() == "", str(d.pin))
        turn = d.answer("what's waiting on me")
        check("unpinned again, the instant answer is back",
              turn.tier == "instant", f"tier was {turn.tier}")
        check("and Harbor has the voice back with the microphone",
              turn.speaker == config.SPEAKER_HARBOR, turn.speaker)

        # ---- the pin carries the space, and the move is announced (V8) ------- #
        moved = []
        d.pin_changed = moved.append
        d.pin_to("c-272", time.time() + 30, "Voice slice 5", "personal")
        check("the pin carries the card's space, which is the header's colour",
              (d.pin_state() or {}).get("space") == "personal", str(d.pin_state()))
        check("and every move of the pin is announced, which is what arms the expiry",
              len(moved) == 1 and (moved[0] or {}).get("card") == "c-272", str(moved))
        d.unpin()
        check("including the move that drops it",
              len(moved) == 2 and moved[1] is None, str(moved))

        # A RE-PIN IS AN EXTENSION AND MUST NOT LOSE WHAT IT CANNOT FETCH AGAIN. Every
        # connected turn pushes the hold out through `_house_landed`, and the verb's answer
        # there carries neither the title nor the space: `--connect` reads those off the
        # board once. The merge that brought V5's worker in reintroduced exactly this by
        # calling `pin_to` with three arguments, which would have taken the house's colour
        # out of the header at his FIRST question and left it out for the rest of the
        # conversation, on a page nobody was looking at while the tests were green.
        from datetime import datetime as _dt, timedelta as _td                # noqa: PLC0415

        d.pin_to("c-272", time.time() + 30, "Voice slice 5", "personal")
        extending = dispatcher.Turn(d.generation, "how far have you got")
        extending.card = "c-272"
        extending.house = {"ok": True, "say": "It is at review.",
                           "held_until": (_dt.now().astimezone()
                                          + _td(seconds=300)).isoformat()}
        d._house_landed(extending)
        kept = d.pin_state() or {}
        check("a hold extended by a connected turn keeps the title and the space",
              kept.get("space") == "personal" and kept.get("title") == "Voice slice 5",
              str(kept))
        d.unpin()

        # A HOUSE DRAWING THAT DID NOT LAND (C1, 2026-09-23). `keel converse` reports the
        # push beside the sentence, and the gateway writes the record into its transcript.
        failed = dispatcher.Turn(d.generation, "draw it")
        failed.card = "c-272"
        failed.house = {"ok": True, "say": "I could not put that on the board: bad.",
                        "board": {"state": "refused", "blocks": 1, "accepted": 0,
                                  "skipped": 3, "reasons": ["bad"], "board": "b-4"}}
        d._house_landed(failed)
        written = Path(d.transcript_path).read_text() if Path(d.transcript_path).exists() else ""
        check("a house drawing that did not land leaves a draw-failed record",
              '"kind": "draw-failed"' in written and '"refused"' in written, written[-400:])

        # ---- the house was asked to leave, and said goodbye (2026-09-21) ----- #
        # THE SECOND NET. `keel converse` reads `<<keel-leave>>` off the house's own answer
        # and reports it beside the sentence; the token never reaches this process, which
        # is the point of it being stripped where the answer is made. What is asserted here
        # is the gateway's half: the goodbye is spoken FIRST, and only then is the
        # conversation ended, down the injected path the spoken phrase uses.
        left = []
        d.leave_asked = lambda: left.append("left")
        calls.clear()
        connected.ask = lambda card, said, timeout=0, pinned=True, turn="", progress="": (
            calls.append((card, said))
            or {"ok": True, "say": "All right, talk later.", "card": card,
                "held_until": None, "leave": True})
        d.pin_to("c-272", None, "Voice slice 5", "personal")
        turn = d.answer("you can exit the house now")
        settle(d)
        check("a house answer that asked to leave speaks its goodbye",
              turn.answer == "All right, talk later." and turn.spoken, turn.answer)
        check("and then ends the conversation, once, through the gateway's own way out",
              left == ["left"], str(left))
        check("and nothing of the directive is ever spoken",
              not any("keel-leave" in text for _gen, text, _spk in spoken), str(spoken))

        # NOT ON AN ANSWER HE NEVER HEARD. A release with nothing said to explain it would
        # leave him in a house he thinks he is still in; the hold running out is the repair
        # that already exists for that.
        left.clear()
        was_live, d.presence = d.presence, (lambda: False)
        d.pin_to("c-272", None, "Voice slice 5", "personal")
        turn = d.answer("you can exit the house now")
        settle(d)
        check("a goodbye he was not there to hear ends nothing",
              left == [] and d.pinned() == "c-272", f"{left} {d.pin}")
        d.presence = was_live
        d.unpin()

    finally:
        connected.ask = saved

    # ---- a silent unpin never happens (V8) ---------------------------------- #
    # THE PIN IS DROPPED LAZILY, when something next asks whether it is still there, so a
    # conversation he walks away from would end without a word: the header would clear at
    # his next utterance and the voice would be Harbor's again with nothing having said
    # so. The gateway arms one timer off `pin_changed` and it says line 4, with the
    # falling tone and no line 3, because the house did not hand anything back.
    gate = servermod.Gateway.__new__(servermod.Gateway)
    gate.dispatcher = d
    # ONE PAGE OPEN THAT HAS NOT SAID IT IS HIDDEN, which is a page he can see (D-2): an
    # expiry is unprompted and is said only to one.
    gate.clients, gate.visible, gate._clients_lock = {object()}, {}, threading.Lock()
    gate._expiry = None
    gate._expiry_card = ""
    gate._expiry_lock = threading.Lock()
    heard, played, told = [], [], []
    gate.speak = lambda text, gen, spoken=None: heard.append(
        (text, getattr(spoken, "speaker", "harbor")))
    gate._send_tone = lambda gen: played.append("tone")
    gate.bus = type("B", (), {"set_state": lambda self, state: None})()
    gate.broadcast = told.append
    d.pin_changed = gate.pin_moved
    # PINNED FORWARD AND THEN AGED, which is what actually happens: a pin is always taken
    # with its expiry in the future, and the clock is what moves. Pinning to a time already
    # past would be dropped by `pin_state` on the way in, and would test the wrong thing.
    d.pin_to("c-272", time.time() + 30, "Voice slice 5", "personal")
    d.pin["until"] = time.time() - 1
    gate.expire_pin()
    check("an expiry says it has left the house, in the one voice there is",
          heard == [(corpus.LEFT_HOUSE, config.SPEAKER_HARBOR)], str(heard))
    check("and it names no card, because nobody asked: it is unprompted speech",
          not any(word in corpus.LEFT_HOUSE.lower() for word in ("c-", "card")),
          corpus.LEFT_HOUSE)
    check("the tone plays, and the page is told the pin has gone",
          played == ["tone"] and [b.get("type") for b in told][:1] == ["connected"],
          f"{played} {told}")
    # AN EXPIRY RE-ARMS NOTHING, AND IT IS THE ONE RELEASE THAT DOES NOT (V13, fix 1). The
    # hold ran out because he said nothing for the whole of it, so he has walked away:
    # opening a microphone then is a microphone in his pocket. The page's own quiet cap
    # would close it a minute later, which is why this is not a disaster, and is not a
    # reason to open it either.
    check("but an expiry does not invite a press, because he walked away",
          "listen-now" not in [b.get("type") for b in told], str(told))
    check("and an expiry leaves the release to the drain, which owns an expired hold",
          d.pinned() == "", str(d.pin))
    with gate._expiry_lock:
        if gate._expiry is not None:
            gate._expiry.cancel()
    # A PIN THAT WAS EXTENDED UNDER THE TIMER IS NOT AN EXPIRY. Every connected turn pushes
    # the hold out, so the timer that was armed for the old expiry fires while the pin is
    # still live, and speaking then would announce a handoff that did not happen.
    heard.clear()
    d.pin_to("c-272", time.time() + 300, "Voice slice 5", "personal")
    gate.expire_pin()
    check("a pin extended under the timer is not announced as gone",
          heard == [] and d.pinned() == "c-272", f"{heard} {d.pin}")
    d.unpin()
    with gate._expiry_lock:
        if gate._expiry is not None:
            gate._expiry.cancel()

    # THE GATEWAY'S HALF, in a driver, with the verb replaced: the phrases are matched
    # before the judge and before anything is dispatched, exactly as the two conversation
    # words are, so no verdict of any kind can move them.
    print()
    print("== the connect words, matched before the seat ==")
    home = Path(tempfile.mkdtemp())
    (home / "state" / "voice").mkdir(parents=True)
    (home / "keel.toml").write_text("[voice]\nport = 4390\n")
    env = {"PATH": os.environ.get("PATH", ""), "HOME": os.environ.get("HOME", ""),
           "PYTHONPATH": str(PKG), "KEEL_HOME": str(home),
           "KEEL_CONFIG": str(home / "keel.toml")}
    got = _run_driver(env, CONNECT_DRIVER)
    if "connect" not in got:
        check("the connect driver ran", False, json.dumps(got)[:900])
        return
    check("the phrase costs no turn: nothing is asked of Harbor or of a house",
          got["connect"]["dispatch"] == "quiet", got["connect"]["dispatch"])
    check("and it takes the hold through `keel converse --connect`",
          got["connect"]["asked"] == [["connect", "c-272"]], str(got["connect"]["asked"]))
    check("the page is told which card it is connected to",
          "connected" in got["connect"]["broadcast"], str(got["connect"]["broadcast"]))
    # ---- the spoken moments (V8, and V13's persona) ------------------------- #
    # HARBOR ENTERS AND LEAVES A HOUSE (V13, his decision 2026-09-21). Every one of these
    # lines is Harbor's now, in Harbor's voice, and the check still reads the (text,
    # speaker) pair rather than the words alone: a line that started coming back as the
    # house's would be the second voice returning, which is the thing he reversed.
    said = [tuple(pair) for pair in got["connect"]["spoke"]]
    check("line 1 lands first, it is Harbor's, and it names no card",
          said and said[0] == (corpus.CONNECTING, "harbor"), str(said))
    check("line 2 says Harbor is ENTERING, and names the card and its title",
          len(said) > 1 and said[1][1] == "harbor"
          and said[1][0].lower().startswith("entering")
          and "card 272" in said[1][0] and "Voice slice 5" in said[1][0],
          str(said))
    check("and line 2's title is CUT, not the whole title read out",
          len(said) > 1 and "connect me to" not in said[1][0].lower(), str(said))
    check("the tone lands before the line that says the switch happened",
          got["connect"]["tones"] == ["tone"], str(got["connect"]["tones"]))
    check("and the page is told it may listen again once the connect has spoken",
          got["connect"]["broadcast"].count("listen-now") == 1,
          str(got["connect"]["broadcast"]))
    # THE TONE AND THE LINE IT INTRODUCES ARE ONE SPEAKING WINDOW. The bus state is the
    # one thing stopping the endpointer hearing the gateway, and clearing it between the
    # two would open a gap in front of exactly the sound a detector takes for the start of
    # an utterance.
    check("and the gateway is marked speaking before the tone, not after it",
          got["connect"]["states"][:1] == ["speaking"], str(got["connect"]["states"]))
    check("the pin is held between utterances", got["pinned_after"] == "c-272",
          str(got["pinned_after"]))
    check("the next question is an ordinary turn, which the dispatcher sends to the house",
          got["question"]["dispatch"] == "answer", got["question"]["dispatch"])
    check("a capture while connected is still a capture",
          got["capture_while_pinned"]["dispatch"] == "capture",
          got["capture_while_pinned"]["dispatch"])
    check("back to Harbor lets the house go and costs no turn",
          got["disconnect"]["dispatch"] == "quiet"
          and got["disconnect"]["asked"] == [["release", "c-272"]],
          str(got["disconnect"]))
    check("and the pin is gone", got["disconnect"]["pinned"] == "",
          str(got["disconnect"]["pinned"]))
    back = [tuple(pair) for pair in got["disconnect"]["spoke"]]
    check("leaving is ONE line, Harbor's, naming the card he asked to leave",
          back == [(verbs.leaving("c-272"), "harbor")], str(back))
    check("and it says he is back with the same voice he was talking to",
          back and "back with you" in back[0][0].lower(), str(back))
    check("and the tone plays on the way out too, the same sound",
          got["disconnect"]["tones"] == ["tone"], str(got["disconnect"]["tones"]))
    check("and the page is told it may listen again after the release has spoken",
          got["disconnect"]["broadcast"].count("listen-now") == 1,
          str(got["disconnect"]["broadcast"]))

    # ---- a refusal is Harbor's, and he stays with Harbor (V8) --------------- #
    # HE MUST NEVER BE LEFT UNSURE WHETHER THE SWITCH HAPPENED. There are several refusal
    # paths (mid-work, no house, the other machine, short of memory, a relaunch that
    # failed) and none of them is one of the four moments, so the one thing asserted is
    # the property they share: Harbor's voice, no pin, and no tone, because the tone is
    # what says it DID happen.
    refused = [tuple(pair) for pair in got["refused"]["spoke"]]
    check("a refusal is spoken in Harbor's voice, after line 1 and instead of line 2",
          refused == [(corpus.CONNECTING, "harbor"),
                      ("I cannot enter card 999: it is building right now.", "harbor")],
          str(refused))
    check("and it says what it could not do, in the words the switch is asked for in",
          refused and refused[-1][0].startswith("I cannot enter"), str(refused))
    check("and the card is named the way it is SAID, not the way it is written",
          refused and "c-999" not in refused[-1][0], str(refused))
    check("a refusal plays no tone, because the tone means the switch happened",
          got["refused"]["tones"] == [], str(got["refused"]["tones"]))
    check("and a refusal never re-arms the microphone, because nothing was entered",
          "listen-now" not in got["refused"]["broadcast"],
          str(got["refused"]["broadcast"]))
    check("and a refusal leaves him where he was, with no pin",
          got["pinned_after_refusal"] == "", str(got["pinned_after_refusal"]))
    check("a sentence that is not a card id connects to nothing and is an ordinary turn",
          got["not_a_card"]["dispatch"] == "answer" and not got["not_a_card"]["asked"],
          str(got["not_a_card"]))

    # ---- the pin the MODEL asked for goes down the same path (c-419) -------- #
    # THE CLAIM IS THAT NOTHING IS COPIED. `connect_by_model` is `connect_to` with
    # `spoken=True`, so what is asserted here is that the four moments, the tone, the
    # refusal voice and the guards come out identical to the phrase's.
    model = [tuple(pair) for pair in got["model_connect"]["spoke"]]
    check("a connect the model asked for says line 1 in Harbor's voice, at once",
          model and model[0] == (corpus.CONNECTING, "harbor"), str(model))
    check("and line 2 says it is entering, naming the card and a few words of its title",
          len(model) > 1 and model[1][1] == "harbor"
          and model[1][0].lower().startswith("entering")
          and "card 272" in model[1][0]
          and "Voice slice 5" in model[1][0], str(model))
    check("the tone lands in front of the line, exactly as it does for the phrase",
          got["model_connect"]["tones"] == ["tone"], str(got["model_connect"]["tones"]))
    check("it takes the hold through the same `keel converse --connect`",
          got["model_connect"]["asked"] == [["connect", "c-272"]],
          str(got["model_connect"]["asked"]))
    check("the page is told which card it is connected to",
          "connected" in got["model_connect"]["broadcast"],
          str(got["model_connect"]["broadcast"]))
    check("and he really is pinned afterwards",
          got["model_pinned_after"] == "c-272", str(got["model_pinned_after"]))

    # A GUARD THAT REFUSES ENDS IN THE REFUSAL AND NEVER IN A HALF PIN.
    model_refused = [tuple(pair) for pair in got["model_refused"]["spoke"]]
    check("a card that is building is refused in Harbor's voice, with no tone",
          model_refused == [(corpus.CONNECTING, "harbor"),
                            ("I cannot enter card 999: it is building right now.",
                             "harbor")]
          and got["model_refused"]["tones"] == [], str(model_refused))
    # HIS ADDITION AT THE PLAN GATE: the model can name a card the board does not have,
    # because it picks out of a digest and the digest is a moment old. The verb answers
    # that in its own sentence and nothing is pinned.
    missing = [tuple(pair) for pair in got["model_no_such_card"]["spoke"]]
    check("a card the model named that is not on the board ends in the verb's own reason",
          missing == [(corpus.CONNECTING, "harbor"),
                      ("I cannot enter card 404: I could not find a card called "
                       "card 404.", "harbor")], str(missing))
    check("and neither refusal leaves a pin behind",
          got["model_no_such_card"]["pinned"] == ""
          and got["model_pinned_after_refusal"] == "",
          f"{got['model_no_such_card']['pinned']} {got['model_pinned_after_refusal']}")

    # ---- leaving in HIS words, and the two nets that catch it (2026-09-21) --- #
    # INSIDE c-302 he said "Okay, you can exit the pouse now" and then "You can go back".
    # `is_disconnect` matches a WHOLE utterance against a fixed table, so both reached the
    # house as questions; it answered "I can't end my own session, tap Stop on the deck"
    # and he had to tap the header. The first net is the lenient matcher, asked exactly
    # where the table was asked, so a leave still costs no turn and no judge ever sees it.
    for key, words in (("his_words", "Okay, you can exit the pouse now"),
                       ("his_other_words", "You can go back")):
        leaving = [tuple(pair) for pair in got[key]["spoke"]]
        check(f"his own words leave the house, and cost no turn: {words!r}",
              got[key]["dispatch"] == "quiet"
              and got[key]["asked"] == [["release", "c-272"]], str(got[key]))
        check("and he hears the one leaving line, naming the card, behind the tone",
              leaving == [(verbs.leaving("c-272"), "harbor")]
              and got[key]["tones"] == ["tone"], str(got[key]))
        check("and the page is invited to listen again, as after any release he asked for",
              got[key]["broadcast"].count("listen-now") == 1, str(got[key]["broadcast"]))
    check("and the pin is really gone afterwards",
          got["pinned_after_his_words"] == "", str(got["pinned_after_his_words"]))
    # AND THE OTHER COLUMN, which is the expensive one: a QUESTION carrying a leave word
    # must stay a question, because ending a conversation he was in the middle of costs
    # him the house's attention and a reconnect.
    check("a question that merely contains a leave word is still a question",
          got["a_question_while_pinned"]["dispatch"] == "answer"
          and not got["a_question_while_pinned"]["asked"],
          str(got["a_question_while_pinned"]))
    check("and it leaves him where he was",
          got["pinned_after_a_question"] == "c-272",
          str(got["pinned_after_a_question"]))

    # THE SECOND NET: the house was asked in words the matcher does not have, said goodbye
    # and ended its answer with the directive. The gateway acts on it through the one way
    # out, so what he hears is identical to the phrase's.
    house_left = [tuple(pair) for pair in got["house_leave"]["spoke"]]
    check("a leave the HOUSE asked for goes out the same door: release, line, tone",
          got["house_leave"]["asked"] == [["release", "c-272"]]
          and house_left == [(verbs.leaving("c-272"), "harbor")]
          and got["house_leave"]["tones"] == ["tone"], str(got["house_leave"]))
    check("and the microphone is re-armed, because he asked for this one too",
          got["house_leave"]["broadcast"].count("listen-now") == 1,
          str(got["house_leave"]["broadcast"]))
    check("and it leaves no pin behind either",
          got["pinned_after_house_leave"] == "",
          str(got["pinned_after_house_leave"]))
    server_src = (PKG / "harbor_voice" / "server.py").read_text()
    check("the house's leave is the phrase's own path and not a second one",
          "def leave_by_house" in server_src
          and "self.disconnect(spoken=True)" in server_src
          and "leave_asked=self.leave_by_house" in server_src, "")


# --------------------------------------------------------------------------- #
# The fence's own section, which is the last one to run.
# --------------------------------------------------------------------------- #

def fence_section():
    print()
    print("== the fence: no real `kb`, no real board, nothing written outside the scratch ==")

    # WHAT THIS IS FOR, and it is the same argument `tests/fence.py`'s `FenceCase` makes.
    # A section written next year will build a dispatcher, call `capture` on it, and never
    # think about which `kb` that reaches, because the one it reaches is correct by
    # arrangement rather than by care. These checks are what fails the run when the
    # arrangement is the thing that broke.

    inside = lambda path: Path(path).resolve().is_relative_to(SCRATCH)
    check("the `kb` this package would call is the stand-in in the scratch",
          inside(config.KB) and Path(config.KB).exists(), str(config.KB))
    # NOT ZERO. The two captures that filed 84 real cards run through the real dispatcher
    # and still do: what changed is where they land, so a run that recorded nothing would
    # mean the path stopped being exercised rather than that it stopped leaking.
    created = [call for call in kb_calls() if "create" in call["argv"]]
    check("the captures that leaked still file, and they filed here",
          len(created) >= 2, f"{len(kb_calls())} calls, {len(created)} of them creates")

    writable = {"KEEL_HOME": config.KEEL_HOME, "STATE": config.STATE, "DATA": config.DATA,
                "KB": config.KB, "KEEL_TOML": config.KEEL_TOML,
                "RECORD_DIR": config.RECORD_DIR, "harbormsg.LOG": harbormsg.LOG,
                "VOICE_SESSION_FILE": config.VOICE_SESSION_FILE}
    strayed = sorted(name for name, path in writable.items() if not inside(path))
    check("every path the package can write to is inside the scratch",
          not strayed, f"outside it: {[(n, str(writable[n])) for n in strayed]}")
    check("and the environment the run ends with is still the fenced one",
          os.environ.get("KEEL_HOME") == str(SCRATCH) and inside(os.environ.get("HOME", "/")),
          f"KEEL_HOME={os.environ.get('KEEL_HOME')} HOME={os.environ.get('HOME')}")
    # THE OTHER WAY TO A REAL BOARD, and on this machine it is the only one: the Mac is a
    # client of the box's board, so a card filed here would go over HTTP and never touch a
    # file at all. The scratch toml names no board and `KEEL_URL` went with the rest.
    toml = tomllib.loads((SCRATCH / "keel.toml").read_text())
    check("and there is no board it could reach over HTTP either",
          not toml.get("keel", {}).get("board_url") and not toml.get("hosts")
          and not os.environ.get("KEEL_URL"),
          f"{toml} KEEL_URL={os.environ.get('KEEL_URL')}")

    # THE LIVE TREES THEMSELVES, taken again and compared. The Mac's board is remote, so a
    # card filed on it would never touch `state/board.db` here; what a changed fingerprint
    # catches is the other half, a section writing into a real state directory. Nothing in
    # this run may reach the board over HTTP either, which is why the scratch toml carries
    # no `board_url` and `KEEL_URL` was dropped with the rest.
    moved = [str(path) for path in witness_paths()
             if witness(path) != WITNESSED.get(str(path))]
    check("no real state directory was written to while this ran", not moved, str(moved))

    # THE BOARD, BY THE RUN'S OWN MARK (c-417). Every create this run made carries it, or
    # the question below would be asked about nothing; and the detector finds a planted one,
    # or it would be asked of a reader that cannot see.
    unmarked = [call["argv"] for call in created
                if f"run_nonce={RUN_NONCE}" not in call["argv"]]
    check("every card this run filed carries its mark", not unmarked, str(unmarked[:2]))
    planted = SCRATCH / "planted.db"
    seed = sqlite3.connect(planted)
    seed.executescript("CREATE TABLE cards (id TEXT, title TEXT, brief TEXT, options TEXT);"
                       "CREATE TABLE events (card TEXT, text TEXT, data TEXT);")
    seed.execute("INSERT INTO cards VALUES ('c-1', 'a thought', '', ?)",
                 (json.dumps({"run_nonce": RUN_NONCE}),))
    seed.commit()
    seed.close()
    check("and the board reader finds a card that carries it", board_leaks(planted, RUN_NONCE) == ["c-1"])
    leaked = {str(root): board_leaks(root / "state" / "board.db", RUN_NONCE) for root in live_roots()}
    check("and no live board holds a card or an event with it",
          not any(leaked.values()), str(leaked))


def drawing_section():
    print()
    print("== Harbor draws on the board itself, by reading its own answer ==")

    # WHAT THIS SECTION EXISTS FOR (2026-09-21, c-302). Asked out loud to draw something on
    # the board, Harbor grepped the Atlas, read "a house pushes", answered "a house draws on
    # it, not me, I'll card it", and filed c-421. It had the verb and the memory saying so;
    # what it did not have was a path from a fenced block in a spoken answer to a push. A
    # house has had one since stage two, and this is the same reading applied to Harbor's
    # own turn, through the same file (`keel/boardpen.py`).
    #
    # THE PUSH IS FAKED HERE AND NOWHERE ELSE. Running the real verb would write to a board,
    # and this suite is offline and touches no board; the door is a parameter for exactly
    # that reason. What is exercised for real is the READING, which is the half that was
    # missing and the half that can drift.
    from harbor_voice import drawing

    drawn = []
    answered, count = drawing.lift(
        'Here is the shape of it:\n\n```board\nnode drain server "the drain"\n'
        'node card box "an assigned card"\nedge card -> drain "claimed"\n```\n\n'
        'That is the whole pass.',
        push=lambda body: (drawn.append(body), {"board": "b-007", "url": "http://x/board/b-007"})[1])

    check("a board block in Harbor's own answer is drawn rather than spoken",
          count == 1 and len(drawn) == 1, f"count={count} drawn={drawn}")
    check("and it is the ops that were pushed, not the fence around them",
          'node drain server "the drain"' in drawn[0] and "```" not in drawn[0], drawn[0])
    check("the block never reaches his ear, and the lead before it does",
          "node drain" not in answered and "Here is the shape of it" in answered, answered)
    # N7 (2026-09-23): a drawing is never explained live, so what came AFTER the block is
    # not spoken; it stays in the transcript.
    check("and nothing after the block is spoken",
          "That is the whole pass." not in answered, answered)
    check("and one sentence stands in for it, the same one a house's block gets",
          answered.endswith("I have put that on the board."), answered)

    # THE SOURCE IS THE TALKER'S, which is what `--talker` means: a board linked to no card.
    from keel import boardpen
    check("Harbor's pen draws on Harbor's own board, never a card's",
          boardpen.talker_source() == {"kind": "talker", "card": None},
          str(boardpen.talker_source()))
    check("and the verb it runs is the one a house runs, with --talker",
          config.KEEL_BIN.name == "keel" and config.KEEL_BIN.parent.name == "bin",
          str(config.KEEL_BIN))

    # AN ORDINARY ANSWER IS UNCHANGED, BYTE FOR BYTE. The pen is only reached when there is
    # something to draw, so a turn with no block does not quietly acquire the pen's
    # markdown stripping on the way out.
    plain, none = drawing.lift("  Two houses are  building,\n  nothing needs you.  ")
    check("an answer with no block in it is collapsed and handed straight back",
          plain == "Two houses are building, nothing needs you." and none == 0, repr(plain))
    kept, none = drawing.lift("Try this:\n\n```python\nmake test\n```\n")
    check("and a CODE block is not a board block, so it is left where it was",
          "make test" in kept and none == 0, repr(kept))

    # A BOARD THAT WILL NOT TAKE IT IS NOT A LOST TURN. The answer is spoken either way.
    def refuses(_body):
        raise RuntimeError("the board is not there")

    real_transcript, real_report = drawing.TRANSCRIPT, drawing.REPORT_FILE
    scratch = Path(tempfile.mkdtemp(prefix="drawing-"))
    drawing.TRANSCRIPT, drawing.REPORT_FILE = scratch / "t.jsonl", scratch / "r.txt"
    try:
        said, count = drawing.lift('There.\n```board\nnode a box "a"\n```\n',
                                   push=refuses, turn="t-9")
        check("a push that was refused says so rather than claiming it drew",
              count == 0 and "I could not put that on the board" in said
              and "I have put that on the board." not in said, said)
        check("and what he asked about is still answered", "There." in said, said)
        check("and the refusal is in the transcript, with its turn (C1)",
              '"draw-failed"' in drawing.TRANSCRIPT.read_text()
              and '"t-9"' in drawing.TRANSCRIPT.read_text(), drawing.TRANSCRIPT.read_text())
        check("and the next turn is told, once",
              drawing.carried_report().startswith("board report:")
              and drawing.carried_report() == "", "the report was not carried once")
    finally:
        drawing.TRANSCRIPT, drawing.REPORT_FILE = real_transcript, real_report
        shutil.rmtree(scratch, ignore_errors=True)

    # THE TURN'S OWN WIRING: `run_turn` hands back the RAW answer now, because a block whose
    # newlines have gone is no longer a block, and `draw_and_say` is what collapses it.
    source = (PKG / "harbor_voice" / "harbormsg.py").read_text()
    check("the turn reads the answer through the pen before anything collapses it",
          "answer = draw_and_say(" in source, "draw_and_say is not on the turn's path")
    check("and run_turn no longer collapses the answer itself",
          'return str(payload.get("result") or "")' in source,
          "run_turn still joins the answer to one line, which destroys a block")


def main() -> int:
    # THE LIVE LOG IS NOT THIS TEST'S TO WRITE INTO, and until now it was. `harbormsg.LOG`
    # resolves from `config.STATE`, which is the scratch's since the fence above; this
    # keeps the run's own log out of even that, in a directory the fence sweeps up, because
    # two sections redirect it around themselves and restore to this.
    harbormsg.LOG = Path(tempfile.mkdtemp()) / "voice.log"

    instant_section()
    instant_turn_section()
    turn_machine_section()
    bus_section()
    index_section()
    deck_section()
    websocket_section()
    endpoint_section()
    say_section()
    opening_section()
    undelivered_section()
    long_utterance_section()
    board_home_section()
    board_section()
    capture_section()
    converse_section()
    refine_section()
    voice_section()
    spoken_voice_section()
    corpus_section()
    repeat_section()
    resident_section()
    authority_section()
    flags_section()
    narration_section()
    hearing_section()
    box_speech_section()
    key_custody_section()
    judges_section()
    preturn_seat_section()
    conversation_section()
    connected_section()
    streamed_answer_section()
    connected_wait_section()
    truncated_answer_section()
    page_protocol_section()
    connect_by_description_section()
    narrate_seat_section()
    late_answer_section()
    vocab_section()
    streaming_section()
    filler_section()
    progress_and_presence_section()
    visible_presence_section()
    first_audio_section()
    harbor_kept_alive_section()
    drawing_section()
    fence_section()             # last, because it is about everything above it

    print()
    if failures:
        print(f"FAIL: {len(failures)} check(s) failed")
        for name in failures:
            print(f"  - {name}")
        print(f"  the scratch directory is kept for reading: {SCRATCH}")
        return 1
    shutil.rmtree(SCRATCH, ignore_errors=True)
    print("ok: the one instant answer states the record, every other failure points at "
          "Harbor, and nothing here can act")
    return 0


if __name__ == "__main__":
    sys.exit(main())
