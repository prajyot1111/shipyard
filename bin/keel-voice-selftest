def instant_section():
    print("== the one instant answer: an exact phrase, and never a guess ==")
    doc = fixture()

    # THE TABLE FIRES ON A WHOLE UTTERANCE AND NOTHING ELSE. The two marked "observed"
    # are his own words out of the transcript; the rest are the same question in the
    # wordings a person reaches for.
    for said in ("Hey, anything waiting on me?", "what is waiting on me right now",
                 "What's waiting on me?", "what is waiting on me",
                 "anything waiting", "what needs me", "what's waiting for me",
                 "WHAT'S WAITING ON ME", "  what's waiting on me   "):
        check(f"the table answers: {said!r}", verbs.is_waiting_question(said))

    # THE COST SIDE, AND IT IS THE WHOLE REASON THIS IS A TABLE. The router answered 6 of
    # every 90 ordinary sentences out of the ledger because they carried a destination
    # word. Every one of these carries one and none of them is the question.
    for said in ("what's waiting at the supermarket",
                 "is anything waiting for the train",
                 "what's waiting on me at the dentist tomorrow",
                 "what needs me to do something about the rent",
                 "read me what is waiting on me and then close it",
                 "waiting"):
        check(f"NOT the question, so it goes to Harbor: {said!r}",
              not verbs.is_waiting_question(said))

    # THE RENDERING, against the three shapes the board actually has.
    empty = verbs.render({"queue": []})
    check("an empty queue is said plainly, with no lead-in to pad it",
          empty == "The queue is empty.", empty)

    gate = verbs.render({"queue": [dict(doc["queue"][3])]})
    check("a gate is counted as an approval",
          "1 pending: 1 approval" in gate, gate)
    check("and the counted form says which record it read, because its own words do not",
          gate.startswith("On your queue: "), gate)
    check("and the gate's own title is read off the row, verbatim",
          "harbor-close ends a dispatch" in gate, gate)

    notice = verbs.render({"queue": [dict(doc["queue"][1])]})
    check("a notice is counted as a notice", "1 pending: 1 notice" in notice, notice)
    never_says("the answer never says nothing needs a decision", notice, "nothing needs")
    never_says("and never says whether it needs him at all", notice, "needs you")

    both = verbs.render(doc)
    check("the two kinds are counted separately, through the shared fold",
          "1 approval" in both and "2 notices" in both, both)
    check("the folded ones are mentioned rather than dropped",
          "1 older notice" in both, both)
    check("and the top one is named", "The top one is:" in both, both)

    # A RENDER THAT CANNOT ANSWER RAISES, and the turn goes to Harbor: it never
    # apologises and it never says it does not know.
    try:
        out = verbs.render({"queue": "not a list at all"})
        never_says("a broken document says nothing about not knowing", out, "sorry")
        never_says("and never says it does not know", out, "don't know")
    except Exception:                                                   # noqa: BLE001
        check("a document it cannot read raises rather than guessing", True)


def instant_turn_section():
    print()
    print("== and it is answered without a model, without a lock, and only in converse ==")
    doc = fixture()

    # THE WHOLE TURN, through the real dispatcher, with the board read replaced by a
    # recorder: nothing here shells out to `kb` and nothing reaches a model.
    rows = list(doc["queue"])
    spoken, sent = [], FakeDeliver(True, "delivered")
    d = _dispatcher(doc, spoken, deliver=sent)
    import harbor_voice.verbs as verbsmod
    real_rows = verbsmod.snapshot.needs_you_rows
    verbsmod.snapshot.needs_you_rows = lambda: rows
    try:
        turn = d.answer("what's waiting on me?")
        check("the turn is answered from the board, not by the model",
              turn.tier == "instant" and not sent.calls, f"{turn.tier}, {sent.calls}")
        check("and the sentence says which record it read",
              turn.answer.startswith("On your queue: "), turn.answer)
        check("the provenance says the board and how long it took",
              turn.provenance.startswith("board, "), turn.provenance)
        check("it was actually spoken", any("On your queue" in t for _g, t, _s in spoken),
              str(spoken[-1:]))

        # IT NEVER TAKES THE TURN LOCK. A converse turn already in flight must not delay
        # it, and it must not be answered with "one at a time" either.
        harbormsg.take_slot()
        try:
            busy = d.answer("what's waiting on me")
            check("a converse turn in flight does not block it",
                  busy.tier == "instant" and busy.answer.startswith("On your queue: "),
                  f"{busy.tier}: {busy.answer}")
        finally:
            harbormsg.release_slot()

        # A BOARD READ THAT FAILS IS A FALL TO HARBOR, not an apology and not a guess.
        def boom():
            raise RuntimeError("kb: no board at that KEEL_HOME")

        verbsmod.snapshot.needs_you_rows = boom
        fell = d.answer("what's waiting on me")
        check("a board read that fails goes to Harbor rather than guessing",
              fell.tier == "harbor" and sent.calls == ["what's waiting on me"],
              f"{fell.tier}, {sent.calls}")

        # AND IN CAPTURE MODE IT IS A CARD, because capture files everything and asks
        # nothing: the mode is the message's, and the table is only read on the converse
        # path.
        verbsmod.snapshot.needs_you_rows = lambda: rows
        filed = []
        d.file_capture = lambda said, space="", heard=None: (
            filed.append((said, space)) or {"id": "c-901", "space": "personal"})
        sent.calls.clear()
        cap = d.capture("what's waiting on me", "personal")
        check("in capture mode the same words become a card",
              cap.tier == "capture" and cap.card == "c-901"
              and filed == [("what's waiting on me", "personal")], str(filed))
        check("and nothing was answered, from the board or from the model",
              not sent.calls and "On your queue" not in cap.answer,
              f"{sent.calls}, {cap.answer!r}")
    finally:
        verbsmod.snapshot.needs_you_rows = real_rows


class FakeSnapshot:
    def __init__(self, doc):
        self._doc = doc
        self.error = ""

    @property
    def doc(self):
        return self._doc

    @property
    def age(self):
        return 0.0

    @property
    def healthy(self):
        return True


class FakeBus:
    def __init__(self):
        self.states = []
        self.turns = []
        self.narrations = []

    def set_state(self, s):
        self.states.append(s)

    def set_turn(self, t):
        self.turns.append(t)

    def set_narration(self, n):
        self.narrations.append(n)

    def set_loading(self, v):
        pass

    def set_alert(self, v):
        pass

    def set_connected(self, c):
        self.connected = c

    def set_speech(self, v):
        pass


class FakeDeliver:
    """Stands in for `harbor-message send harbor`, and RECORDS rather than delivers.

    THE BUG THIS EXISTS FOR was in this file. The Harbor tier was exercised with the
    real, module-level delivery, so every run of this selftest typed two spurious voice
    questions into Harbor's LIVE tmux pane and pressed Enter. Harbor answered them. It
    happened on every promotion gate and on every harbor-check, including runs certifying
    something else entirely, and neither assertion could have noticed: both check
    `turn.tier == "harbor"`, which is set before anything is delivered.

    Review found it by reading; the pane confirmed it had already happened twice.
    """

    def __init__(self, ok=False, why="the pane is a fixture, so nothing was typed"):
        self.calls = []
        self.contexts = []
        # WHAT ELSE RODE ON THE TURN: the board digest and its age (the framing's trim,
        # <install>/history/docs/voice-two-modes.md 1.1 item 2), recorded so a test can assert the turn
        # was given one rather than that the sentence merely exists.
        self.extras = []
        self.ok = ok
        self.why = why

    def __call__(self, said, context="", **extra):
        self.calls.append(said)
        self.contexts.append(context)
        self.extras.append(extra)
        return self.ok, self.why


def _dispatcher(doc, spoken, tmp=None, deliver=None, filler_model=None,
                progress=None, opening=None, notify=None, presence=None, clients=0,
                queue_answer=None, speak=None, turn_over=None):
    """A dispatcher with every outside thing replaced by a recorder.

    `speak` IS THE ONE RECORDER THAT SOMETIMES HAS TO TAKE TIME (V13, 2026-09-21). The
    default appends and returns at once, which is what every other test of the turn
    machine wants. A real `speak` blocks for the LENGTH OF THE AUDIO, and the truncated
    answer of 2026-09-21 happened entirely inside that block: while part one played, the
    rest of the answer and the final result both landed, and the loop came back to the say
    inbox first. A recorder with no playback time cannot see that, which is exactly why
    this file did not.

    THE FILLER IS INJECTED FOR THE SAME REASON THE DELIVERY IS. Left to build itself from
    config it is an OllamaFiller, so a Harbor-tier turn in this file would make a live
    model call: this selftest runs on every promotion, it has to pass with no ollama
    resident, and a gate that needs a 4.7 GB model to be loaded is a gate people learn to
    skip. The fixed table asserts nothing and answers instantly, which is exactly what a
    test of the turn machine wants; filler.guard is tested directly and offline in its
    own section, and the model half is bin/keel-voice-filler-score's job.

    THE PROGRESS AND OPENING INBOXES ARE ISOLATED FOR THE SAME REASON `inbox` IS. Left
    to their defaults they are harbormsg.PROGRESS_DIR and harbormsg.OPENING_DIR, which
    are real paths under KEEL_HOME: a test run would read and write outside its own
    tmpdir. `presence` defaults to "live", which is the harmless default (every
    existing caller of Dispatcher wants that), and `notify` defaults to a recorder
    rather than a no-op so a test can assert on it.

    `queue_answer` DEFAULTS TO A RECORDER TOO (c-229), for the same reason `deliver`
    is never left to build itself from config: the real one shells out to
    `bin/harbor-queue`, and a turn machine test must never do that.
    """
    tmp = tmp or Path(tempfile.mkdtemp())
    notify_calls = []
    queue_calls = []
    d = Dispatcher(FakeSnapshot(doc), FakeBus(),
                   # THE THIRD ARGUMENT IS THIS CALL'S ENGINE AND SPEAKER (V7). It is
                   # recorded rather than ignored so a test can assert that the choice
                   # on the `end` message reached the chain, and the report it returns
                   # is what `_say` records on the turn as what actually spoke.
                   speak or (lambda text, gen, spk=None:
                             (spoken.append((gen, text, spk))
                              or {"engines": ["fake"]})),
                   SayInbox(tmp / "say"), tmp / "transcript.jsonl",
                   deliver=deliver or FakeDeliver(),
                   filler_model=filler_model or filler.NoFiller(),
                   progress_inbox=progress or SayInbox(tmp / "progress"),
                   open_inbox=opening or SayInbox(tmp / "opening"),
                   notify=notify or (lambda turn, text, reason:
                                     notify_calls.append((text, reason)) or False),
                   presence=presence or (lambda: True),
                   clients_fn=(lambda: clients) if not callable(clients) else clients,
                   queue_answer=queue_answer or (lambda said, answer, turn_id:
                                                 queue_calls.append((said, answer, turn_id))
                                                 or True),
                   turn_over=turn_over)
    d.notify_calls = notify_calls
    d.queue_calls = queue_calls
    return d


def turn_machine_section():
    print()
    print("== the generation counter, which is the whole of barge-in ==")
    doc = fixture()
    spoken = []
    d = _dispatcher(doc, spoken, deliver=FakeDeliver(True, "delivered"))

    turn = d.answer("what do you make of all this")
    check("an ordinary turn goes to Harbor, which is the whole cascade now",
          turn.tier == "harbor", f"tier was {turn.tier}")

    stale = turn.generation
    d.begin("something else")
    before = len(spoken)
    d._say(turn, "this is from the turn he interrupted")
    check("a line from a superseded turn is dropped rather than spoken",
          len(spoken) == before,
          "without this the dead turn's stop signal kills the new answer")
    check("and the new turn has a higher generation", d.generation > stale)

    print()
    print("== narration is rendered from observed changes, never written ==")
    from harbor_voice.dispatcher import NARRATION, _changes, _observable
    before = _observable(doc)
    grown = json.loads(json.dumps(doc))
    grown["running"].append({"id": "cccc" * 8, "name": "a new one", "state": "working"})
    grown["queue"].insert(0, {"index": 99, "status": "pending", "kind": "approval",
                              "what": "a new card", "summary": ""})
    kinds = [k for k, _ in _changes(before, _observable(grown))]
    check("a new dispatch is a narration line", "spawned" in kinds, str(kinds))
    check("a new card is a narration line", "card" in kinds, str(kinds))
    check("nothing disappearing is narrated",
          not [k for k, _ in _changes(_observable(grown), before)],
          "a dispatch ending while he waits is not news about what he asked")
    check("every narration line is a fixed string with no model anywhere",
          all(isinstance(v, str) for v in NARRATION.values()))


def bus_section():
    print()
    print("== the state bus, and the two rules that make a face drop in ==")
    tmp = Path(tempfile.mkdtemp())
    b = busmod.Bus(data_dir=tmp, mirror=True)

    b.set_state("thinking")
    check("the state word is what was written", b.read()["state"] == "thinking")

    b.feed_waveform([3000] * 128)
    r = b.read()
    check("a fresh waveform overrides the state word to speaking",
          r["state"] == "speaking", r["state"])
    check("and it is downsampled to exactly 64 points",
          len(r["samples"]) == config.BUS_SAMPLES, str(len(r["samples"])))
    check("level is mean(|samples|)/3000, capped at 1",
          abs(r["level"] - 1.0) < 1e-9, str(r["level"]))

    b2 = busmod.Bus(data_dir=tmp, mirror=False)
    b2.feed_waveform([1500] * 64)
    check("and half amplitude is half level",
          abs(b2.read()["level"] - 0.5) < 1e-9, str(b2.read()["level"]))

    b._wave_at = time.time() - (config.BUS_WAVE_FRESH + 0.1)
    check("a waveform older than 0.6s stops overriding",
          b.read()["state"] == "thinking", b.read()["state"])
    check("and its samples are not published as current",
          b.read()["samples"] == [])

    check("the file mirror carries the original's four names",
          (tmp / ".voice_state").exists() and (tmp / ".voice_waveform").exists()
          and (tmp / ".voice_alert").exists())

    b.set_turn({"id": "x", "tier": "harbor"})
    check("the turn says which tier is answering, which the original could not",
          b.read()["turn"]["tier"] == "harbor")

    check("there is no way to write the bus over HTTP",
          "def do_POST" not in (PKG / "harbor_voice" / "server.py").read_text(),
          "the feed is one-way; Harbor's input arrives as a file, not a POST")


def index_section():
    print()
    print("== the digest carries names, ids, states and counts. Never values ==")
    doc = index.deckdigest.fold(deck_state(), harbor_running=True)
    blob = index.as_json(doc)
    check("a card's body is not in it",
          "a card body nobody should ever hear read out loud" not in blob,
          "if code will read it to answer, the model does not need to see it")
    check("a review's findings are not in it",
          "a review body nobody should ever hear read out loud" not in blob
          and "another body" not in blob and "a pull request description" not in blob
          and "a scanner body" not in blob)
    check("nor a comment waiting on a pull request",
          "a reviewer comment nobody should ever hear" not in blob)
    # THE REVIEWS SECTION ITSELF, not merely somewhere in the blob: a review card is a
    # card too, so its title also rides in the cards section, and that alone would not
    # prove the Reviews list can be named back.
    review_rows = index.deckdigest.build(doc)["reviews"]["rows"]
    check("but the names ARE, which is what repairs a garbled transcript",
          any("widget list drops its second page" in line and "c-106" in line
              for line in review_rows), str(review_rows))
    check("and the ids are, in both spaces, which is how he can name one back",
          "c-101" in blob and "c-103" in blob)
    size, tokens = index.measure(doc)
    # THE BUDGET IS BIGGER THAN THE BOARD-ONLY DIGEST'S AND IT SHOULD BE: three of that
    # one's sections were hard-coded empty. The live deck measured 6,508 bytes on
    # 2026-09-18 with 190 cards, 28 reviews and 13 pull requests, which is what the caps
    # in `keel/deckdigest.py` were set against.
    check("and it stays a few kilobytes, not a document", size < 16000,
          f"{size} bytes, ~{tokens} tokens; the live deck measured 6,508")


def deck_section():
    print()
    print("== the digest is of the DECK, both spaces, and it says which record it had ==")

    # THE READ IS OVER A REAL LOOPBACK SOCKET, to a real `/api/state`, because that hop
    # is the whole change: everything below was reachable the night it was answered
    # "that is on the work side and I cannot reach it".
    from harbor_voice import snapshot as snapshotmod

    port, stop = serve_state(deck_state())
    try:
        doc = snapshotmod.board_doc(port=port)
    finally:
        stop()

    check("it says out loud that it read the deck", doc.get("source") == "deck",
          str(doc.get("source")))
    ids = [row["id"] for row in doc.get("cards") or []]
    check("cards from BOTH spaces are in it", "c-101" in ids and "c-103" in ids, str(ids))
    check("and the archived one is not", "c-105" not in ids, str(ids))
    check("the card that wants him is first, because the sample is capped",
          ids[:1] == ["c-104"], str(ids))

    reviews = index.deckdigest.provider_rows(doc, "reviews")
    shipping = next((row for row in doc.get("cards") or [] if row["id"] == "c-108"), {})
    # THE SENTENCE THIS SECTION EXISTS FOR, written as the thing that must never come
    # back: "the PR review screen is on the work side and I cannot reach it". The rows
    # were on loopback the whole time.
    check("the review rows the deck shows are in it",
          [row["id"] for row in reviews] == ["c-106", "c-107"], str(reviews))
    check("and the old scanner's rows are not, so a Harbor says only what the deck shows",
          not any(row["id"] == "review:a-901" or "stale scanner" in row["title"]
                  for row in reviews), str(reviews))
    check("and a work pull request is in it on its card, state and counts, never a body",
          shipping.get("pr") == "open, 3 comments, 1 approval, checks passed, 2 behind, 1 waiting",
          str(shipping))
    check("and the retired watcher's rows are not, so a Harbor says only what the deck shows",
          index.deckdigest.provider_rows(doc, "prs") == []
          and "a stale watcher row" not in json.dumps(doc), str(doc.get("providers")))
    check("a row carries its lane and its repo, and nothing else of it",
          reviews[0]["state"] == "waiting" and reviews[0]["repo"] == "widgets"
          and set(reviews[0]) == {"id", "title", "repo", "state"}, str(reviews[0]))
    check("the segments carry a name and a headline",
          (doc.get("segments") or [{}])[0] == {"name": "daybook",
                                               "headline": "New since last look 4"},
          str(doc.get("segments")))
    check("the drain pill comes through, so 'is the drain alive' is answerable",
          (doc.get("drain") or {}).get("alive") is True, str(doc.get("drain")))
    check("and the topics still do, which is what the refine picks from",
          (doc.get("topics") or {}).get("work") == ["widgets"], str(doc.get("topics")))

    digest = index.build(doc)
    check("every section carries its real count beside its capped rows",
          digest["reviews"]["count"] == 2 and "prs" not in digest
          and digest["cards"]["work"]["count"] == 5, json.dumps(digest["reviews"]))
    check("and each space carries a per-stage tally, so counting survives the cap",
          digest["cards"]["work"]["stages"] == {"assigned": 1, "inbox": 1, "planning": 1,
                                                "review": 1, "shipping": 1},
          str(digest["cards"]["work"]["stages"]))
    # A BREAKDOWN IS A COUNT TOO, and the first live turn after this landed got one
    # wrong: "three open and the rest behind" about thirteen pull requests, because a
    # fourth open row sat past the sample. The lanes are tallied over every row. A review
    # card's lane is where the review stands (`derived.review`), not its card stage; a
    # work pull request's state is on its card's line, which the stage tally counts.
    check("and a provider section breaks down by lane over every row, not the sample",
          digest["reviews"]["states"] == {"reviewing": 1, "waiting": 1},
          str(digest["reviews"]["states"]))
    check("and the card line says the pull request's state where he would ask for it",
          any(line.startswith("c-108 ") and "(shipping, pr: open, 3 comments" in line
              for line in digest["cards"]["work"]["rows"]), str(digest["cards"]["work"]["rows"]))

    # -- the cap is real, and it never touches the count ------------------------- --
    many = deck_state()
    row = next(card for card in many["cards"] if card["id"] == "c-106")
    many["cards"] = [card for card in many["cards"] if "review" not in card["derived"]] + [
        dict(row, id=f"c-{200 + n}") for n in range(40)]
    capped = index.build(index.deckdigest.fold(many))
    check("a section past its cap samples its rows and still counts every one",
          capped["reviews"]["count"] == 40
          and len(capped["reviews"]["rows"]) == index.deckdigest.REVIEW_ROWS,
          f"{capped['reviews']['count']} counted, {len(capped['reviews']['rows'])} rows")
    check("and its lane breakdown counts every one too",
          capped["reviews"]["states"] == {"waiting": 40}, str(capped["reviews"]["states"]))

    # -- the framing, which is what makes the digest usable --------------------- --
    line = harbormsg.build_line("what's on the pr review screen", "", index.as_json(doc),
                                2.0, "", doc["source"])
    check("the framing says the digest is of the DECK, both spaces",
          "digest of the DECK is attached, both spaces" in line, line[:200])
    check("and says which record it was read from, so a fallback cannot pass for the deck",
          "read from the deck" in line, line[:300])
    check("and points at `keel deck <section>` for anything on a deck screen",
          "run `keel deck <section>`" in line
          and "reviews, a card in either space, a segment" in line
          and "a pull request is on its card" in line and "PRs" not in line, line[:400])
    check("and keeps the rule that made the digest worth attaching",
          "do not run `kb list`" in line, line[:400])
    check("and keeps `kb show <id>` for a card the user names",
          "`kb show <id>` for a card the user names" in line, line[:400])
    check("and keeps `kb needs-you` for the one question it answers",
          "`kb needs-you` only if they ask what is waiting on them" in line, line[:400])
    check("a board-only digest says board, not deck",
          "read from the board" in harbormsg.build_line("x", "", "{}", 1.0, "", "board"))

    # -- the egress split ------------------------------------------------------- --
    check("the framing carries the unprompted rule",
          "nothing UNPROMPTED" in harbormsg.FRAMING
          and "work identifier, a ticket number or a customer name" in harbormsg.FRAMING,
          harbormsg.FRAMING)
    check("and the direct-answer half, so a question he asked can actually be answered",
          "A DIRECT ANSWER to what they just asked may name what they asked about"
          in harbormsg.FRAMING, harbormsg.FRAMING)
    check("and neither half lets a customer name or a credential be spoken",
          "customer names and credentials stay out of speech either way" in harbormsg.FRAMING,
          harbormsg.FRAMING)
    from harbor_voice import refine as refinemod
    # THE REFINE IS UNPROMPTED BY DEFINITION: nobody asked for it and nobody is waiting
    # on it, so it keeps the strict half verbatim and gets none of the split.
    check("the refine keeps the unprompted rule verbatim and gains no exception",
          "no card body" in refinemod.REFINE_FRAMING
          and "no work identifier (speaking-is-egress)" in refinemod.REFINE_FRAMING
          and "DIRECT ANSWER" not in refinemod.REFINE_FRAMING, "")

    # -- the repo, which a code card cannot build without ----------------------- --
    # A card with no repo is an errand with no worktree. Three code cards were filed
    # without one on 2026-09-19 (c-296, c-297, c-298), so both turns that file cards carry
    # the same rule: set it from his words, else ask him with the choices `kb repos`
    # prints. The capture path stays out of it: it is one `kb create` and it stays fast.
    from harbor_voice import capture as capturemod
    check("the converse framing asks for a repo on a card that changes code",
          "carries `--repo <key>`" in harbormsg.FRAMING
          and "`kb repos`" in harbormsg.FRAMING, harbormsg.FRAMING)
    check("and says what to do when his words do not settle it",
          "file the card in the inbox without one" in harbormsg.FRAMING
          and "`kb set <id> repo=<key>`" in harbormsg.FRAMING, harbormsg.FRAMING)
    refine_line = refinemod.Refiner(topics=lambda space: ["deck"]).framing(
        {"card": "c-001", "said": "fix the thing", "space": "personal"}, ["keel", "harbor"])
    check("the refine is offered this space's real repo keys, read by Keel",
          '"repo": if it must change code, the likeliest of ["keel", "harbor"]' in refine_line,
          refine_line)
    check("and never asks him out loud: it picks the likeliest and Keel files it as a "
          "guess (D-3)", "Never ask about a repo" in refine_line
          and "Keel records it as a guess" in refine_line, refine_line)
    check("and the capture path is untouched, so it stays one fast `kb create`",
          "--repo" not in capturemod.command("fix the thing", "personal")[0],
          str(capturemod.command("fix the thing", "personal")[0]))

    # -- `keel deck <section>` renders the same rows ---------------------------- --
    table = index.deckdigest.render_section(doc, "reviews", "work")
    check("`keel deck reviews --space work` renders the rows the deck shows",
          "c-106" in table and "widget list drops its second page" in table
          and "stale scanner" not in table and table.endswith("2 reviews in work"), table)
    check("`keel deck cards --space work` shows that space and not the other",
          "c-103" in index.deckdigest.render_section(doc, "cards", "work")
          and "c-101" not in index.deckdigest.render_section(doc, "cards", "work"), "")
    check("a section with nothing in it says so rather than printing a bare heading",
          index.deckdigest.render_section(doc, "reviews", "personal") == "no reviews in personal",
          index.deckdigest.render_section(doc, "reviews", "personal"))



def endpoint_section():
    """The end of an utterance: the wire, the speaking gate, and the untouched half.

    IN THE VENV, unlike the endpointer's arithmetic, which `make test` covers with no
    model anywhere. What this section is for is the part that needs the real classes: that
    a hands-free listen gets an `endpoint` on the socket and a push-to-talk listen does
    not, that nothing fires while the bus says `speaking`, and that the detector really is
    absent rather than merely quiet when there is no model.
    """
    print()
    print("== end of utterance (V1): the wire, and the gateway never hearing itself ==")

    frame = config.VAD_WINDOW / config.MIC_RATE

    class FakeVAD:
        """Speech while `talking` is True. The detector's answer, without the model.

        A fake rather than the real Silero because this asserts the WIRING: which frames
        reach the detector, and what the gateway does with a fire. Whether Silero can hear
        a voice is Silero's business and was measured on the box before any of this was
        built.
        """

        name = "fake"
        ready = True
        why = ""

        def __init__(self):
            self.talking = True
            self.resets = 0
            self.heard = 0

        def is_speech(self, pcm):                                       # noqa: ARG002
            self.heard += 1
            return self.talking

        def reset(self):
            self.resets += 1

    def gateway_with(vad):
        gw = servermod.Gateway.__new__(servermod.Gateway)
        gw.vad = vad
        gw.bus = busmod.Bus(data_dir=Path(tempfile.mkdtemp()), mirror=False)
        return gw

    # A hangover of ten frames, so the arithmetic below is countable by hand.
    hang = 10 * frame
    chunk = b"\x00\x00" * config.VAD_WINDOW

    vad = FakeVAD()
    gw = gateway_with(vad)
    ep = vadmod.Endpointer(hangover=hang, min_speech=3 * frame)
    for _ in range(5):
        gw.hear(ep, chunk)                       # he is talking
    vad.talking = False
    fires = [gw.hear(ep, chunk) for _ in range(20)]
    check("the detector fires one hangover after the last word",
          fires.count(True) == 1 and fires.index(True) == 9,
          f"fired at {fires.index(True) if True in fires else 'never'}")

    # The speaking gate.
    vad = FakeVAD()
    gw = gateway_with(vad)
    ep = vadmod.Endpointer(hangover=hang, min_speech=3 * frame)
    for _ in range(5):
        gw.hear(ep, chunk)
    gw.bus.set_state("speaking")
    vad.talking = False
    heard_before = vad.heard
    fired = any(gw.hear(ep, chunk) for _ in range(100))
    check("nothing fires while the gateway is speaking", not fired)
    check("the gateway's own voice never reaches the detector",
          vad.heard == heard_before,
          f"{vad.heard - heard_before} frames got through while speaking")
    check("the detector is RESET while speaking, not merely paused",
          not ep.armed and vad.resets > 0)

    # And after it stops, fresh speech is required before anything can fire.
    gw.bus.set_state("idle")
    fired = any(gw.hear(ep, chunk) for _ in range(100))
    check("after speaking, silence alone still does not end a turn", not fired)

    # The socket's own half: `start` carries handsFree, `endpoint` goes down, `end` is
    # what actually flushes.
    source = page_js(HOME)
    check("the page asks for the detector only on a hands-free listen",
          'handsFree: !!state.autoHeld' in source)
    # THE PROPERTY, NOT THE SPELLING. This used to grep for `release();` exactly, and the
    # page's watchdog (V13, the page half) gave `release` a REASON argument, so the literal
    # went stale the moment a listen could end for more than one nameable cause. What is
    # actually being defended is that an endpoint ends the turn through the SAME release
    # every other ending goes through, rather than through a second path of its own, so the
    # check is the call and its guard with whatever arguments it carries.
    endpoint_release = re.search(
        r"if \(state\.holding && state\.autoHeld\) release\([^)]*\);", source)
    check("an endpoint goes through the same release every other ending goes through",
          'function onEndpoint(msg)' in source and bool(endpoint_release),
          "nothing releases on an endpoint through the ordinary path")
    ends = [line for line in source.splitlines() if 'type: "end"' in line]
    check("the page still ends the turn with the ordinary `end`, and only that way",
          len(ends) == 1, str(ends))
    check("and it carries what the page is showing at the moment he lets go",
          all(f"{field}: state.{field}" in ends[0]
              for field in ("mode", "space", "engine")), ends[0].strip())

    server_source = (HOME / "voice" / "harbor_voice" / "server.py").read_text()
    check("the gateway never flushes its own buffer on an endpoint",
          server_source.count('name="voice-stt"') == 1,
          "there is more than one place that hands a buffer to on_utterance")
    check("the endpoint message carries the generation",
          '{"type": "endpoint",' in server_source and '"generation"' in server_source)

    # No model, no detector, and that is today's behaviour rather than an error.
    null = vadmod.make_vad("off")
    check("no detector means nothing ever fires, which is the old behaviour",
          not null.ready and not null.is_speech(chunk))
    missing = vadmod.make_vad.__doc__ or ""
    check("a missing model degrades rather than raising", "degrades" in missing)

    # The corpus is off unless it is asked for.
    with tempfile.TemporaryDirectory() as tmp:
        before = config.RECORD_ENABLED, config.RECORD_DIR
        config.RECORD_DIR = Path(tmp) / "pcm"
        try:
            config.RECORD_ENABLED = False
            check("the recorder writes nothing when it is off",
                  recordmod.write(b"\x00\x00" * 1000, "a") == "")
            config.RECORD_ENABLED = True
            wrote = recordmod.write(b"\x00\x00" * 1000, "a")
            check("the recorder writes one wav per utterance when it is on",
                  wrote == "a.wav" and (config.RECORD_DIR / "a.wav").is_file())
            check("the corpus reports itself as recording", recordmod.stats()["recording"])
        finally:
            config.RECORD_ENABLED, config.RECORD_DIR = before

    # The real detector, when this machine has one. Skipped rather than failed elsewhere:
    # the Mac has no model until its next venv build, and that is a supported state.
    real = vadmod.make_vad()
    if getattr(real, "ready", False):
        loud = (b"\x40\x00" * config.VAD_WINDOW)
        real.reset()
        check("the real detector loads and answers a frame",
              isinstance(real.is_speech(loud), bool))
    else:
        print(f"  skip  no detector on this machine: {getattr(real, 'why', '')}")


def websocket_section():
    print()
    print("== the websocket's framing, in all three length encodings ==")

    class Pipe:
        def __init__(self):
            self.out = b""
            self.inbox = b""

        def sendall(self, b):
            self.out += b

        def recv(self, n):
            take, self.inbox = self.inbox[:n], self.inbox[n:]
            if not take:
                raise ConnectionError("closed")
            return take

        def close(self):
            pass

    for size, why in ((10, "inline"), (300, "a two-byte length"),
                      (70000, "an eight-byte length")):
        pipe = Pipe()
        sock = ws.Socket(pipe)
        payload = bytes(range(256)) * (size // 256) + bytes(size % 256)
        pipe.inbox = ws.mask_frame(ws.BINARY, payload)
        got = sock.recv()
        check(f"a client frame of {size} bytes ({why}) is read whole",
              got is not None and got[1] == payload,
              f"got {len(got[1]) if got else 0} bytes")

    pipe = Pipe()
    sock = ws.Socket(pipe)
    sock.send(ws.TEXT, b"hello")
    check("a server frame is NOT masked",
          not (pipe.out[1] & 0x80),
          "a browser drops a masked server frame silently, with no error anywhere")

    pipe = Pipe()
    sock = ws.Socket(pipe)
    pipe.inbox = ws.mask_frame(ws.PING, b"are you there")
    pipe.inbox += ws.mask_frame(ws.TEXT, b"and then this")
    got = sock.recv()
    check("a ping is answered here, not handed up",
          got is not None and got[1] == b"and then this" and pipe.out,
          "a ping the application has to remember to answer is a socket that dies "
          "whenever the application is busy, which here is whenever it is speaking")

    check("the handshake key is the RFC's worked example",
          ws.accept_key("dGhlIHNhbXBsZSBub25jZQ==") == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")

    print()
    print("== and the handshake is where a cross-site page is stopped ==")
    # A WEBSOCKET IS EXEMPT FROM THE SAME-ORIGIN POLICY. It sends no preflight and asks
    # no permission, so any page in any tab can open one to any host it can name, and
    # this socket accepts {"type": "text"}, which is typed into Harbor's live pane and
    # submitted. It reads in the other direction too. The handshake is the only place to
    # stop that, which makes this check the whole defence rather than a layer of one.
    #
    # The view's proxy makes the same check one hop earlier and that is the one that
    # runs in production. This one is here for the same reason harbor-message enforces
    # the space rule on send rather than trusting the layer above: a check that lives in
    # exactly one place disappears the first time something reaches this port another way.
    for headers, allowed, why in (
            ({"Host": "phone.example", "Origin": "https://phone.example"},
             True, "Harbor's own page"),
            ({"Host": "phone.example", "Sec-Fetch-Site": "same-origin"},
             True, "the browser saying same-origin"),
            ({"Host": "phone.example"}, True,
             "no headers at all, which is a non-browser client on loopback"),
            ({"Host": "phone.example", "Origin": "https://evil.example"},
             False, "a foreign Origin"),
            ({"Host": "phone.example", "Sec-Fetch-Site": "cross-site"},
             False, "the browser saying cross-site"),
            ({"Host": "phone.example", "Origin": "null"},
             False, "a sandboxed frame's literal null origin"),
            ({"Host": "phone.example", "Origin": "https://phone.example",
              "Sec-Fetch-Site": "cross-site"},
             False, "a forged Origin the browser contradicts")):
        got = ws.same_origin(headers)
        check(f"{'allowed' if allowed else 'refused'}: {why}", got is allowed,
              f"same_origin({headers!r}) said {got}")

    check("the port comparison ignores the port, because TLS is terminated in front",
          ws.host_of("https://phone.example") == ws.host_of("phone.example:8823"))

    # THE ONE THAT SHIPPED BROKEN. The only way a browser reaches this port is through
    # the view's proxy, which rewrites Host to loopback so the upstream accepts it. A
    # check comparing Origin against that rewritten value refuses every real handshake
    # from the phone and passes at the desk, where both sides happen to say 127.0.0.1:
    # it works where he is sitting and fails where the segment tells him to use it.
    #
    # bin/harbor-view-selftest asserts the composed path, in front of a fixture that runs
    # this very function, because the fault only exists in the composition and neither
    # half could see it alone.
    check("Origin is judged against what the BROWSER asked for, not the rewritten Host",
          ws.same_origin({"Host": "127.0.0.1:4390",
                          "X-Forwarded-Host": "mac.example.ts.net",
                          "Origin": "https://mac.example.ts.net"}),
          "the proxy rewrites Host, so comparing against it kills voice on the phone")
    check("and a foreign Origin is still refused behind the proxy",
          not ws.same_origin({"Host": "127.0.0.1:4390",
                              "X-Forwarded-Host": "mac.example.ts.net",
                              "Origin": "https://evil.example"}))
    check("with no proxy in front, Host is what was asked for",
          ws.same_origin({"Host": "127.0.0.1:4390",
                          "Origin": "http://127.0.0.1:4390"}))


def say_section():
    print()
    print("== how an answer comes back, and how it does not ==")
    tmp = Path(tempfile.mkdtemp())
    inbox = SayInbox(tmp)
    inbox.write("first")
    inbox.write("second")
    lines = [r["text"] for r in inbox.claim()]
    check("say lines come back in the order they were written",
          lines == ["first", "second"], str(lines))
    check("and a claimed line is never spoken twice", inbox.claim() == [])

    inbox.write("an answer to the previous question")
    inbox.drain()
    check("draining throws away an answer to the question he already moved on from",
          inbox.claim() == [],
          "otherwise it is spoken over the turn he is having now")

    from harbor_voice import harbormsg

    # THE FRAMING IS THREE LINES NOW, AND THE CHECKS FOLLOW THE ROUTE. Every assertion
    # this block used to make was about the pane era's three channels: speak first with
    # `opening`, narrate with `progress`, end the turn with `say`, and do not expect your
    # pane to be read. A headless turn has ONE output, so there is nothing left to
    # instruct about channels, and the only thing the framing was ever really about, that
    # the reply is read out loud, is the only thing left in it.
    check("the framing says plainly that the reply is read aloud",
          "read aloud" in harbormsg.FRAMING, harbormsg.FRAMING)
    check("and asks for spoken sentences rather than a document",
          "one to three" in harbormsg.FRAMING
          and "plain spoken sentences" in harbormsg.FRAMING, harbormsg.FRAMING)
    check("and names what is unspeakable, so it is not sent",
          "no markdown" in harbormsg.FRAMING and "no lists" in harbormsg.FRAMING
          and "no paths" in harbormsg.FRAMING, harbormsg.FRAMING)
    check("and asks for the actionable thing first, which is the whole of the phone rule",
          "Lead with what the user can act on" in harbormsg.FRAMING, harbormsg.FRAMING)
    check("and says what to do when the answer genuinely will not fit in speech",
          "If it needs the deck, say so once." in harbormsg.FRAMING, harbormsg.FRAMING)

    # WRITTEN AS THE REGRESSION, the way the rest of this file is. Every one of these
    # strings was an assertion here before the cutover, and each one now names a thing
    # that does not exist: there is no pane to read, and no second or third channel for
    # the answering turn to write to. A framing that grew any of them back would be
    # instructing a headless turn to shell out to a Harbor binary it cannot see.
    for gone, why in (("never reads your pane", "there is no pane"),
                      ("Before you open or read anything", "there is no opener to run"),
                      ("harbor-voice opening", "a `-p` turn has one output, not three"),
                      ("harbor-voice progress", "the gateway's own filler covers the wait"),
                      ("harbor-voice say", "the answer is the `result` field, not a file "
                                           "the turn writes"),
                      ("--eta", "an eta was a promise about an opener that no longer "
                                "exists"),
                      ("on your queue", "Keel has no queue: decision Q8")):
        check(f"the framing no longer says {gone!r} ({why})",
              gone not in harbormsg.FRAMING, harbormsg.FRAMING)

    # THE BUDGET WENT UP ONCE, ON PURPOSE, and this is the record of it: the egress split
    # (decision V17) put its two sentences in here rather than leaving them in a memory
    # file a turn has to think to open. It is still a few lines and not a page. The bound
    # moved from 900 to 1050 on 2026-09-24 (lane H, H1) for one sentence, answer first and
    # look second, which a turn has to have in front of it for the same reason V17's do.
    check("and the whole of it fits in a few lines, not a page",
          len(harbormsg.FRAMING) < 1050, f"{len(harbormsg.FRAMING)} characters")

    # THE TAG AND THE SEPARATOR SURVIVE THE REPOINT. The transcript keys on them, and
    # they are built in `send`, not in the framing.
    line = f"[voice] what is running -- {harbormsg.FRAMING}"
    check("a spoken turn is still tagged so the transcript can find it",
          line.startswith("[voice] ") and " -- " in line, line[:60])

    check("progress writes into its own inbox, never the answer's",
          harbormsg.PROGRESS_DIR != harbormsg.SAY_DIR
          and harbormsg.PROGRESS_DIR.name == "progress",
          str(harbormsg.PROGRESS_DIR))

    cli = (HERE / "keel-voice").read_text()
    check("the CLI has a progress verb, so Harbor has a way to emit one",
          "def cmd_progress" in cli and '"progress"' in cli, "")


def opening_section():
    print()
    print("== the opener and the answer are two different channels ==")
    from harbor_voice import harbormsg
    doc = fixture()

    check("opening writes into its own inbox, never say's and never progress's",
          harbormsg.OPENING_DIR != harbormsg.SAY_DIR
          and harbormsg.OPENING_DIR != harbormsg.PROGRESS_DIR
          and harbormsg.OPENING_DIR.name == "opening",
          str(harbormsg.OPENING_DIR))
    # THE THREE INBOXES ARE THE GATEWAY'S INPUT SURFACE AND THEY ALL STAY, which is a
    # different claim from "the framing still asks for them". The Harbor tier no longer
    # feeds `opening` or `progress`: a headless turn has one output and the framing asks
    # for that one output. `bin/keel-voice opening` and `bin/keel-voice progress`
    # still work, the dispatcher still drains all three per turn, and the round trips
    # below are exactly what would break if a future change collapsed them into one.
    for gone in ("harbor-voice opening", "harbor-voice say", "does not end the turn"):
        check(f"the framing no longer instructs a channel ({gone!r})",
              gone not in harbormsg.FRAMING, harbormsg.FRAMING)

    cli = (HERE / "keel-voice").read_text()
    check("the CLI has an opening verb, so Harbor has a way to emit one",
          "def cmd_opening" in cli and '"opening"' in cli, "")
    check("and it takes an --eta, c-229",
          "--eta" in cli and "cmd_opening(" in cli, "")

    # c-229: THE ETA RIDES ON THE SAME RECORD, and a turn that never sends one is
    # unaffected. Driven through the real SayInbox, not asserted against the CLI
    # module directly, so this proves the round trip the watch loop actually reads.
    eta_tmp = Path(tempfile.mkdtemp())
    box = SayInbox(eta_tmp)
    box.write("a slow one", eta=42.0)
    recs = box.claim()
    check("an eta passed to SayInbox.write survives the round trip",
          len(recs) == 1 and recs[0].get("eta") == 42.0, recs)
    box.write("a quick one")
    recs2 = box.claim()
    check("and a call with no eta carries none at all, not a null placeholder",
          len(recs2) == 1 and "eta" not in recs2[0], recs2)

    # THE REPRODUCTION. Review round 1, 2026-09-07: the framing asked Harbor to call
    # `say` twice per turn, once as an opener and once with the real answer, and the
    # watch loop claimed whichever line it read first out of `say`'s inbox as the WHOLE
    # answer, finished the turn on it, and silently dropped the real answer that landed
    # seconds later. This drives the real turn machine exactly as a live Harbor turn
    # would: `opening` first, then `say`.
    spoken = []
    d = _dispatcher(doc, spoken, deliver=FakeDeliver(True, "delivered"),
                    filler_model=filler.NoFiller())
    turn = d.answer("what do you make of all that")
    d.open_inbox.write("checking the queue, should be quick")
    time.sleep(0.6)
    heard_after_opener = [text for _gen, text, _s in spoken]
    check("the opener is spoken",
          "checking the queue, should be quick" in heard_after_opener,
          str(heard_after_opener))
    check("and speaking it does not finish the turn",
          turn.phase not in ("done", "speaking") and turn.answer == "",
          turn.as_json())

    d.inbox.write("the real answer, arriving after the opener")
    time.sleep(0.6)
    heard = [text for _gen, text, _s in spoken]
    check("the real answer still lands and is spoken, rather than dropped",
          "the real answer, arriving after the opener" in heard, str(heard))
    check("in order, after the opener",
          heard.index("checking the queue, should be quick")
          < heard.index("the real answer, arriving after the opener"), str(heard))
    check("the turn is finished by the answer, not by the opener",
          turn.phase == "done"
          and turn.answer == "the real answer, arriving after the opener",
          turn.as_json())
    d.generation += 1

    # A SECOND `opening` CALL IN ONE TURN IS NOT TRUSTED. The framing asks for exactly
    # one; if it happened anyway, the machine claims it once and never speaks a second
    # one, rather than repeating the opener over the real wait.
    spoken2 = []
    d2 = _dispatcher(doc, spoken2, deliver=FakeDeliver(True, "delivered"),
                     filler_model=filler.NoFiller())
    d2.answer("what do you make of all that")
    d2.open_inbox.write("first opener")
    time.sleep(0.6)
    d2.open_inbox.write("second opener, should never be heard")
    time.sleep(0.6)
    heard2 = [text for _gen, text, _s in spoken2]
    check("only the first opening line of a turn is ever spoken",
          "first opener" in heard2
          and "second opener, should never be heard" not in heard2, str(heard2))
    d2.generation += 1

    # THE DROP PATH ITSELF, review round 3's remaining note: an opener that loses the
    # race to `say` (both pending in the same watch pass) is never spoken, correctly,
    # since the answer supersedes it. It used to vanish with no record at all, the one
    # channel here that was silent about it, when the next turn's `begin()` drained the
    # stale file. It is dropped now the same as before; the difference is it is logged.
    spoken3 = []
    d3 = _dispatcher(doc, spoken3, deliver=FakeDeliver(True, "delivered"),
                     filler_model=filler.NoFiller())
    d3.answer("a turn whose opener loses the race")
    # THE SAME PASS IS MADE, NOT HOPED FOR (c-418). The two writes used to go in back to back
    # and rely on the watch loop not running a pass between them, which a loaded machine
    # broke about one run in ten. `pass_gate` is held for the whole of each pass, so holding
    # it here keeps every pass out until both files are down. The sleep is the proof: it is
    # longer than a pass, and without the gate the opener is claimed on its own and spoken.
    with d3.pass_gate:
        d3.open_inbox.write("an opener that will never be heard")
        time.sleep(0.6)
        d3.inbox.write("the answer, arriving in the same pass")
    time.sleep(0.6)
    heard3 = [text for _gen, text, _s in spoken3]
    check("the opener that lost the race is never spoken",
          "an opener that will never be heard" not in heard3, str(heard3))
    d3.generation += 1
    d3.begin("the next turn drains the stale opener")
    records3 = [json.loads(ln) for ln in
                d3.transcript_path.read_text().splitlines() if ln.strip()]
    dropped3 = [r for r in records3 if r.get("kind") == "dropped"]
    check("and the drop is on the record, not silent",
          any(r.get("channel") == "opening"
              and "an opener that will never be heard" in str(r.get("text"))
              for r in dropped3),
          str(dropped3))


def _keel_fixture(result: str = "", fail: str = "", exit_code: int = 0,
                  lost: bool = False, echo: bool = False, delay: float = 0.0):
    """A throwaway KEEL_HOME with a stub `claude` on PATH.

    A STUB BINARY ON PATH RATHER THAN A MONKEYPATCH, for the reason the pane era's own
    version of this recorded: KEEL_HOME is read at import time and it
    decides where the log, the say inbox and the session file live. Patching it in this
    process would exercise an arrangement that only exists inside this test. The stub
    also records its argv, which is the only way to assert that the SECOND turn resumes
    the conversation rather than minting a second one.

    Returns (home, keel, argv_path, env).
    """
    home = Path(tempfile.mkdtemp())
    keel = Path(tempfile.mkdtemp())
    (home / "bin").mkdir(parents=True, exist_ok=True)
    (keel / "state" / "logs").mkdir(parents=True, exist_ok=True)
    (keel / "talker").mkdir(parents=True, exist_ok=True)
    argv_path = home / "argv.jsonl"
    stub = home / "bin" / "claude"
    body = ["#!/usr/bin/env python3", "import json, sys",
            f"open({str(argv_path)!r}, 'a').write(json.dumps(sys.argv) + chr(10))"]
    if lost:
        # THE HARNESS'S OWN SENTENCE, recorded on 2026-09-17 against Claude Code 2.1.274
        # and kept verbatim: a resume of a conversation that is not there exits 1 with
        # "No conversation found with session ID: <uuid>" on stderr.
        body += ["if '--resume' in sys.argv:",
                 "    sys.stderr.write('No conversation found with session ID: '",
                 "                     + sys.argv[sys.argv.index('--resume') + 1]",
                 "                     + chr(10))",
                 "    sys.exit(1)"]
    if delay:
        # A TURN THAT TAKES TIME, which is what makes a race observable at all: the
        # turn lock is only interesting while a turn is still running.
        body = body[:2] + ["import time"] + body[2:] + [f"time.sleep({delay})"]
    if exit_code:
        body += [f"sys.stderr.write({fail!r} + chr(10))", f"sys.exit({exit_code})"]
    elif echo:
        # THE ANSWER SAYS WHICH UTTERANCE IT WAS, so two turns can be told apart in the
        # order they were answered.
        body += ["print(json.dumps({'type': 'result', 'is_error': False,",
                 "                  'result': 'answered: ' + sys.argv[-1][:60]}))"]
    else:
        body += [f"print(json.dumps({{'type': 'result', 'is_error': False, "
                 f"'result': {result!r}}}))"]
    stub.write_text("\n".join(body) + "\n")
    stub.chmod(0o755)
    env = {**os.environ, "KEEL_HOME": str(keel),
           "PATH": f"{home / 'bin'}:{os.environ.get('PATH', '')}",
           "PYTHONPATH": str(PKG)}
    return home, keel, argv_path, env


# WAIT FOR THE THREAD, DO NOT SLEEP THROUGH IT. `send` returns the moment the turn
# STARTS; the answer arrives in the say inbox from a worker. A fixed sleep would either
# make this test slow or make it flaky on a loaded machine, so the driver polls for the
# file the gateway itself polls for.
_DRIVER = """
import json, sys, time
from pathlib import Path
from harbor_voice import harbormsg
ok, why = harbormsg.send(%s)
box = harbormsg.SayInbox(harbormsg.SAY_DIR)
lines = []
deadline = time.time() + 20
while time.time() < deadline and not lines:
    lines = [r.get("text") for r in box.claim()]
    if not lines:
        time.sleep(0.05)
print("RESULT " + json.dumps([ok, why, lines]))
"""


def _drive(env, utterance="what is running"):
    run = subprocess.run([sys.executable, "-c", _DRIVER % repr(utterance)], env=env,
                         capture_output=True, text=True, timeout=60)
    rows = [ln for ln in run.stdout.splitlines() if ln.startswith("RESULT ")]
    if not rows:
        return None, run.stderr[-400:], []
    return json.loads(rows[0][7:])


def undelivered_section():
    print()
    print("== a turn that fails says WHY, out loud once and in the log ==")

    # THE BUG THIS SECTION EXISTS FOR is not that a turn failed, it is that nothing
    # anywhere recorded why. Voice shipped, every Harbor-tier turn came back "I could not
    # get that through to Harbor", and state/logs/voice.log ended at the startup banner. The
    # tool had printed the cause on its own stderr, in one sentence, on every one of those
    # turns, and `send()` dropped it on the floor. The evening that took to find is what
    # these checks buy back.
    #
    # AND ONE THE CUTOVER ADDED. `send` now returns before the turn is answered, so a
    # turn that dies mid-flight cannot report itself through the return value. It has to
    # speak, once, into the say inbox, or the turn hangs until the gateway's own give-up
    # mark with the cause written nowhere he can hear.

    # -- the happy path first, because "it failed" only means something against it ----
    home, keel, argv_path, env = _keel_fixture(
        result="Two cards are building, the deck redesign and the work adapter.")
    ok, why, lines = _drive(env)
    check("a turn that runs comes back ACCEPTED, not answered", ok is True, str(why))
    check("and what it returns says the turn is running rather than answered",
          "turn started" in str(why), str(why))
    check("the answer lands in the say inbox, which is where the watch loop reads it",
          lines and "Two cards are building" in lines[0], str(lines))

    session_file = keel / "state" / "voice-session.json"
    record = json.loads(session_file.read_text()) if session_file.exists() else {}
    minted = str(record.get("uuid") or "")
    check("the voice conversation is minted on first use and kept in "
          "state/voice-session.json",
          len(minted) == 36 and minted.count("-") == 4, repr(record))
    check("and the record carries what bounds it: the turns it has answered and when "
          "it started",
          record.get("turns") == 1 and float(record.get("started_at") or 0) > 0,
          repr(record))
    sent = [json.loads(ln) for ln in argv_path.read_text().splitlines() if ln.strip()]
    check("the first turn CREATES the conversation rather than resuming a missing one",
          sent and "--session-id" in sent[0] and minted in sent[0], str(sent[:1]))
    check("and it asks for the JSON shape the answer is read out of",
          sent and "--output-format" in sent[0] and "json" in sent[0], str(sent[:1]))
    check("and his words travel on it, tagged, with the framing after the separator",
          sent and any("[voice] what is running -- " in a for a in sent[0]),
          str(sent[:1]))

    # -- the second turn RESUMES. A conversation that restarted every turn would be a
    # conversation in name only, and the file above is the whole mechanism.
    ok2, why2, lines2 = _drive(env, "and how long has that one been going")
    sent = [json.loads(ln) for ln in argv_path.read_text().splitlines() if ln.strip()]
    check("the second turn resumes the same conversation rather than minting another",
          len(sent) == 2 and "--resume" in sent[1] and minted in sent[1],
          str(sent[1:]))
    after = json.loads(session_file.read_text())
    check("and the session file still names it, with the turn counted",
          after.get("uuid") == minted and after.get("turns") == 2, repr(after))

    # -- a session file that outlived its conversation ---------------------------- --
    # A REAL STATE, AND IT USED TO BE TERMINAL. A config dir rebuilt, a transcript
    # pruned, or a uuid minted by a run that failed before the conversation existed (how
    # this was found, fifteen minutes after the code was written) leaves a file naming a
    # conversation the harness has never heard of. Every turn from then on failed
    # identically, forever, until somebody deleted one file by hand.
    home, keel, argv_path, env = _keel_fixture(result="Right, I have it.", lost=True)
    # WRITTEN IN THE OLD SHAPE ON PURPOSE, which exercises the migration too: a bare
    # uuid in `state/voice-session` is what every machine had before 2026-09-17, and a
    # live conversation must not be thrown away by an upgrade.
    kept = "11111111-2222-3333-4444-555555555555"
    (keel / "state" / "voice-session").write_text(kept + "\n")
    ok, why, lines = _drive(env)
    sent = [json.loads(ln) for ln in argv_path.read_text().splitlines() if ln.strip()]
    check("a resume of a conversation that is gone is retried, not spoken as a failure",
          lines and "Right, I have it." in lines[0], str(lines))
    check("and it is retried under the SAME id, so there is still one conversation",
          len(sent) == 2 and "--resume" in sent[0] and "--session-id" in sent[1]
          and kept in sent[0] and kept in sent[1], str(sent))
    check("and the session file still names it, in the new shape",
          json.loads((keel / "state" / "voice-session.json").read_text())
          .get("uuid") == kept, "")
    check("and the old bare-uuid file is gone, so nothing can read it back as "
          "authoritative",
          not (keel / "state" / "voice-session").exists(), "")
    log = keel / "state" / "logs" / "voice.log"
    text = log.read_text() if log.exists() else ""
    check("and the lost history is written down rather than passed over in silence",
          "is not in" in text and "Its earlier history is gone." in text,
          repr(text[-300:]))

    # -- the failing path -------------------------------------------------------- --
    refusal = ("Invalid session ID: no conversation with that id exists in this config "
               "directory.")
    home, keel, argv_path, env = _keel_fixture(fail=refusal, exit_code=1)
    ok, why, lines = _drive(env)
    check("a turn that cannot run is still ACCEPTED, because it did start",
          ok is True, str(why))
    check("but it speaks a failure rather than leaving the turn hanging",
          lines and "could not get that to harbor" in lines[0].lower(), str(lines))

    log = keel / "state" / "logs" / "voice.log"
    text = log.read_text() if log.exists() else ""
    check("and state/logs/voice.log has the record, which is where anyone will look first",
          "a turn did NOT reach Harbor" in text, repr(text[-300:]))
    check("the reason carries the turn's OWN words, not a sentence this gateway chose",
          refusal in text, repr(text[-500:]))
    for want, name in (("the voice conversation", "which conversation it addressed"),
                       ("claude -p --resume <session>", "the command shape it ran"),
                       ("config dir", "the config dir the turn ran under"),
                       ("[voice] what is running", "the line it sent")):
        check(f"the record names {name}", want in text, repr(text[-600:]))

    # THE COLUMNS THAT FOLLOWED THE PANE ARE GONE, written as the regression: a record
    # naming a tmux session and its pane state would be naming two things that no longer
    # exist, which is the one way a diagnostic can be worse than none.
    for gone in ("tmux session", "pane state"):
        check(f"and it no longer names {gone!r}, which does not exist any more",
              gone not in text, repr(text[-600:]))

    # THE OTHER FAILING PATH. A refusal at least has stderr; a missing binary has nothing
    # but its own exception type, and that is the one that used to reach the log as
    # silence.
    (home / "bin" / "claude").unlink()
    env_gone = {**env, "PATH": str(home / "bin")}
    ok, why, lines = _drive(env_gone)
    text = log.read_text() if log.exists() else ""
    check("a turn that could not start at all is logged too, not just a refusal",
          "FileNotFoundError" in text, repr(text[-400:]))
    check("and it is still spoken rather than swallowed",
          lines and "could not get that to harbor" in lines[0].lower(), str(lines))

    # AND THE TRANSCRIPT AGREES WITH THE LOG. The narration table has one sentence for
    # every way this can fail, so the transcript's `undelivered` records were three
    # identical lines naming none of a dozen causes.
    doc = fixture()
    spoken = []
    tmp2 = Path(tempfile.mkdtemp())
    d = _dispatcher(doc, spoken, tmp=tmp2,
                    deliver=FakeDeliver(False, "the session file could not be read"))
    d.answer("ask Harbor something")
    records = [json.loads(ln) for ln in
               (tmp2 / "transcript.jsonl").read_text().splitlines() if ln.strip()]
    undelivered = [r for r in records if r.get("kind") == "undelivered"]
    check("the transcript's undelivered record carries the reason",
          bool(undelivered)
          and "session file" in str(undelivered[-1].get("error", "")),
          str(undelivered[-1] if undelivered else records))


def long_utterance_section():
    print()
    print("== his whole sentence reaches Harbor, however long it is ==")

    # THE BUG THIS SECTION EXISTS FOR, and it is the one that made the product refuse to
    # work. On 2026-09-04 he asked a 294 character question. The speech model heard every
    # character and the transcript records all 294; harbormsg.UTTERANCE_MAX was 160 and
    # was applied as a bare slice, so the second half never left this machine and Harbor
    # answered "your message cut off at spawn a session on the work, so I did not get the
    # actual ask." The ask was in the half that was dropped, which is the ordinary shape
    # of spoken English: the sentence sets the scene first and asks last.
    #
    # WHY IT ASSERTS ON THE ARGV RATHER THAN ON THE CONSTANT. A test that reads
    # UTTERANCE_MAX and compares it to a number passes with the slice still in place at a
    # bigger value, and it says nothing at all about whether anything else on this path
    # clips. What has to be true is that the characters he spoke are in the string handed
    # to the turn, so that is what is measured, at the real boundary, with a stub standing
    # in for the model. Delete the fix and the tail of the sentence is missing from argv
    # and both checks below go red.
    #
    # THE BOUNDARY MOVED AND THE CHECK DID NOT. It used to be `--text` in
    # harbor-message's argv; it is now the last argument of `claude -p`. The thing being
    # defended is the same: what he said arrives whole.
    home, keel, argv_path, env = _keel_fixture(result="Right, I have it.")

    # HIS OWN SENTENCE'S SHAPE, WRITTEN FRESH. 294 characters, several clauses of
    # scene-setting, and the actual request in the last twenty words, which is what the
    # 160 character slice ate. It is not his transcript verbatim: that turn is about his
    # employer's work and this file is repository content, where bin/harbor-check refuses
    # employer names outside packs/work/.
    said = ("Right, so earlier on this week we went through the whole backlog for the "
            "flat, and I think there were five or six jobs left over from last month "
            "that never actually got sorted out, so could you please have a proper look "
            "at what is still outstanding and then tell me which of them really needs "
            "doing before the weekend")
    check("the fixture is as long as the sentence that was lost",
          len(said) >= 290, f"{len(said)} characters")

    ok, why, lines = _drive(env, said)
    sent = [json.loads(ln) for ln in argv_path.read_text().splitlines() if ln.strip()]
    line = sent[0][-1] if sent else ""
    check("the turn was started at all", bool(line), str(why))
    check("and every word he said is in the line it was given",
          said in line,
          f"it was given: ...{line[max(0, len(line) - 220):]!r}")

    # AND THE TAIL SPECIFICALLY, named separately, because that is the half that carried
    # the request and the half a slice takes.
    check("including the request at the end of the sentence, which is what was dropped",
          said[-60:] in line, f"missing: {said[-60:]!r}")

    # THE SANITY BOUND IS NOT SILENT. Something has gone wrong upstream long before a
    # push-to-talk turn is five minutes of speech, and the rule this file got wrong was
    # not the cap, it was dropping text without saying so.
    from harbor_voice import harbormsg
    huge = "and then " * ((harbormsg.UTTERANCE_MAX // 9) + 40)
    _drive(env, huge)
    sent = [json.loads(ln) for ln in argv_path.read_text().splitlines() if ln.strip()]
    line = sent[-1][-1] if sent else ""
    check("past the sanity bound the delivered line says it was cut, and by how much",
          "cut here" in line and "more characters were spoken" in line,
          f"...{line[max(0, len(line) - 200):]!r}")
    log = keel / "state" / "logs" / "voice.log"
    check("and the log says so too, so a drop is never silent",
          "was cut to" in (log.read_text() if log.exists() else ""),
          repr((log.read_text() if log.exists() else "")[-300:]))


# --------------------------------------------------------------------------- #
# Where the document comes from, now that it is not an endpoint.
# --------------------------------------------------------------------------- #

# THE BOARD AS `kb` PRINTS IT, trimmed to the fields board_doc() actually reads and
# carrying one of each trap. Two cards are live work and one of them has a session the
# harness does not list, which has to read `exited` rather than as its stage; one card is
# in review with no session at all and must not appear as running; one needs-you row is a
# gate (an approval) and the other is not (a notice) and carries a blocked reason that
# has to reach the spoken line.
#
# EVERY STAMP IS RELATIVE TO THIS RUN'S OWN NOW. The shared fold (`harbor_queue_fold`)
# reads the wall clock and folds a notice older than NOTICE_FOLD_DAYS, and the rows cross
# a real subprocess boundary into `render`, which takes no clock. Fixed dates therefore
# made "1 notice" true for a week and then "1 older notice folded away" forever (it went
# red on 2026-09-24). Stamps a few hours old keep every row fresh on any day, against the
# same clock the fold reads.
_BOARD_NOW = datetime.now(timezone.utc)


def _ago(hours: float) -> str:
    return (_BOARD_NOW - timedelta(hours=hours)).isoformat(timespec="seconds")


_BOARD_CARDS = [
    {"id": "c-042", "space": "personal", "title": "the deck redesign",
     "stage": "building", "session_id": "sess-live", "blocked_reason": None,
     "updated_at": _ago(1),
     "derived": {"plan_gate": False, "outcome_gate": False}},
    {"id": "c-043", "space": "work", "title": "the work adapter",
     "stage": "planning", "session_id": "sess-dead", "blocked_reason": None,
     "updated_at": _ago(1.2),
     "derived": {"plan_gate": False, "outcome_gate": False}},
    {"id": "c-044", "space": "work", "title": "release notes integration",
     "stage": "review", "session_id": None, "blocked_reason": None,
     "updated_at": _ago(10.5),
     "derived": {"plan_gate": False, "outcome_gate": True}},
]
_BOARD_NEEDS = [
    {"id": "c-044", "title": "release notes integration", "blocked_reason": None,
     "updated_at": _ago(10.5),
     "derived": {"plan_gate": False, "outcome_gate": True}},
    # AN HOUR OLD, WHENEVER THIS RUNS (2026-09-24). It was a fixed 2026-09-17 stamp, and
    # a notice folds away after `NOTICE_FOLD_DAYS` (7): a week later the fixture's one
    # fresh notice had become a folded one and the check below failed on the calendar.
    {"id": "c-045", "title": "the segment fetcher", "blocked_reason": "no credentials",
     "updated_at": _ago(2),
     "derived": {"plan_gate": False, "outcome_gate": False}},
]
_BOARD_AGENTS = [{"sessionId": "sess-live", "kind": "background", "status": "busy"}]


def _board_fixture(kb_fails: str = "", agents_fail: bool = False):
    """A throwaway KEEL_HOME with a stub `kb` and a stub `claude` beside it.

    STUBS ON DISK RATHER THAN A MONKEYPATCH, for the reason the delivery sections record:
    config.KEEL_HOME and config.KB are read at import time, and `board_doc` shells out.
    Patching either in this process would exercise an arrangement that only exists inside
    this test, and the thing worth defending is that the real subprocess boundary is
    crossed correctly: the argv, the exit code, and stderr on the way back.
    """
    keel = Path(tempfile.mkdtemp())
    (keel / "bin").mkdir(parents=True, exist_ok=True)
    (keel / "state").mkdir(parents=True, exist_ok=True)
    argv_path = keel / "kb-argv.jsonl"
    kb = keel / "bin" / "kb"
    kb.write_text(
        "#!/usr/bin/env python3\n"
        "import json, sys\n"
        f"open({str(argv_path)!r}, 'a').write(json.dumps(sys.argv[1:]) + chr(10))\n"
        + (f"sys.stderr.write({kb_fails!r} + chr(10))\nsys.exit(3)\n" if kb_fails else
           f"rows = {_BOARD_CARDS!r} if sys.argv[1] == 'list' else {_BOARD_NEEDS!r}\n"
           "print(json.dumps(rows))\n"))
    kb.chmod(0o755)
    agents = keel / "bin" / "claude"
    agents.write_text(
        "#!/usr/bin/env python3\n"
        "import json, sys\n"
        + ("sys.stderr.write('the harness is not answering' + chr(10))\nsys.exit(1)\n"
           if agents_fail else f"print(json.dumps({_BOARD_AGENTS!r}))\n"))
    agents.chmod(0o755)
    # THE DECK IS POINTED AT A CLOSED PORT, which is what makes this the FALLBACK fixture.
    # `board_doc` reads the deck first now (decision V16) and this machine has a live deck
    # on 8790, so without this the section would quietly stop exercising the stub `kb`
    # beside it and start asserting against the real board.
    env = {**os.environ, "KEEL_HOME": str(keel),
           "KEEL_SERVE_PORT": str(closed_port()),
           "PATH": f"{keel / 'bin'}:{os.environ.get('PATH', '')}",
           "PYTHONPATH": str(PKG)}
    return keel, argv_path, env


_BOARD_DRIVER = """
import json, sys
from harbor_voice import snapshot, verbs
out = {}
snap = snapshot.Snapshot()
out["fetched"] = snap.fetch()
out["doc"] = snap.doc
out["error"] = snap.error
try:
    out["waiting_said"] = verbs.render(snap.doc)
    out["waiting_live"] = verbs.waiting_answer()
except Exception as exc:
    out["render_raised"] = f"{exc.__class__.__name__}: {exc}"
print("RESULT " + json.dumps(out))
"""


def _board(env):
    run = subprocess.run([sys.executable, "-c", _BOARD_DRIVER], env=env,
                         capture_output=True, text=True, timeout=60)
    rows = [ln for ln in run.stdout.splitlines() if ln.startswith("RESULT ")]
    return json.loads(rows[0][7:]) if rows else {"stderr": run.stderr[-500:]}


def board_home_section():
    print()
    print("== which board this gateway would write to, said before it binds ==")

    # WHY THIS EXISTS. On 2026-09-20 four houses ran a scratch gateway from their worktree
    # for a live-socket check, each isolated with its own KEEL_HOME, port and PATH, and
    # every capture they spoke into it was filed as a real card on his board, because the
    # `kb` those launches reached was the live checkout's. Nothing in the log said so.
    # `keel/config.py` gives a worktree its own scratch board; what is left for this
    # package is the one case a default cannot reach, a gateway HANDED the live `kb`.

    home = Path(tempfile.mkdtemp())
    live = home / "keel"
    worktree = live / "state" / "worktrees" / "c-999"
    (worktree / "bin").mkdir(parents=True)
    (live / "bin").mkdir(parents=True, exist_ok=True)
    check("a checkout is a worktree only at state/worktrees/<card>",
          config.is_worktree(worktree) and not config.is_worktree(live),
          f"{worktree} / {live}")

    saved = (config.KB, config.CHECKOUT, config.LIVE_STATE)
    try:
        config.KB, config.CHECKOUT, config.LIVE_STATE = worktree / "bin" / "kb", worktree, False
        check("a worktree's own kb is a scratch board", config.board_kind() == "scratch",
              config.board_kind())
        check("and the startup line says so, with the state directory beside it",
              config.board_line().startswith("voice: board scratch via ")
              and str(config.DATA) in config.board_line(), config.board_line())
        check("a worktree's gateway pointed at its own kb starts",
              servermod.refuse_live_board() == "", servermod.refuse_live_board())

        config.KB = live / "bin" / "kb"
        check("the live checkout's kb is the live board", config.board_kind() == "live",
              config.board_kind())
        refusal = servermod.refuse_live_board()
        check("a worktree's gateway pointed at the live kb refuses", bool(refusal), "")
        check("and the refusal names both ways round it",
              "KEEL_HOME" in refusal and "KEEL_LIVE_STATE=1" in refusal, refusal)

        config.LIVE_STATE = True
        check("the opt-in is the one thing that lets it through",
              servermod.refuse_live_board() == "", servermod.refuse_live_board())

        config.LIVE_STATE, config.CHECKOUT = False, live
        check("the live checkout's own gateway is untouched",
              servermod.refuse_live_board() == "" and config.board_kind() == "live", "")
    finally:
        config.KB, config.CHECKOUT, config.LIVE_STATE = saved

    body = (PKG / "harbor_voice" / "server.py").read_text().split("def serve(", 1)[1]
    check("serve says the board before it builds or binds anything",
          body.index("board_line()") < body.index("Gateway()")
          and body.index("refuse_live_board()") < body.index("Gateway()"), "")
    check("KEEL_HOME defaults to this package's own checkout, never the home directory",
          'os.environ.get("KEEL_HOME") or CHECKOUT'
          in (PKG / "harbor_voice" / "config.py").read_text(), "")
    shutil.rmtree(home, ignore_errors=True)


def board_section():
    print()
    print("== the fallback: no deck, so the board alone, and it says so ==")

    # WHAT THIS SECTION EXISTS FOR. The document used to be fetched whole from a
    # dashboard, so the only thing that could go wrong with it was the fetch. It is built
    # now, out of three readings, which means it can be WRONG rather than merely missing:
    # a card folded into the wrong section, a dead session reported as live, a count that
    # disagrees with the rows under it. Every check here is one of those.
    #
    # IT IS THE FALLBACK PATH NOW (decision V16). The deck is read first, and this fixture
    # points `KEEL_SERVE_PORT` at a closed one on purpose: there is no way to prove the
    # fallback against the live deck, which is the tailnet root and is never stopped to
    # make a test pass.

    keel, argv_path, env = _board_fixture()
    (keel / "state" / "talker.pid").write_text(f"{os.getpid()}\n")
    out = _board(env)
    doc = out.get("doc") or {}

    check("the fetch succeeds against a board that answers", out.get("fetched") is True,
          str(out.get("error") or out.get("stderr")))
    asked = [json.loads(ln) for ln in argv_path.read_text().splitlines() if ln.strip()]
    check("the warm document costs exactly two readings, both as JSON",
          asked[:2] == [["list", "--json"], ["needs-you", "--json"]], str(asked))
    check("and the instant answer's own live read is one more, and only that one",
          asked[2:] == [["needs-you", "--json"]], str(asked))
    check("a deck that does not answer falls back rather than failing the turn",
          out.get("fetched") is True and doc.get("source") == "board", str(doc.get("source")))
    check("the document carries every section the digest reads",
          all(k in doc for k in ("source", "counts", "harbor", "running", "queue", "cards",
                                 "providers", "segments", "topics")), str(sorted(doc)))
    check("and the sections only the deck can fill are empty rather than invented",
          doc.get("providers") == {} and doc.get("segments") == [], str(doc.get("providers")))

    running = doc.get("running") or []
    check("a card that is building with a live session is running, under its own stage",
          any(r["id"] == "c-042" and r["state"] == "building"
              and r["name"] == "the deck redesign" and r["space"] == "personal"
              for r in running), str(running))
    # THE ONE THAT MATTERS MOST, and it is the direction that costs trust: a session the
    # harness does not list is EXITED, not "planning". Saying a card is still going when
    # its session died is a confident wrong answer about the one thing he asks out loud.
    check("a card whose session the harness does not list reads as exited, not as its "
          "stage",
          any(r["id"] == "c-043" and r["state"] == "exited" for r in running),
          str(running))
    check("a card with no session at all is not running",
          not any(r["id"] == "c-044" for r in running), str(running))

    queue = doc.get("queue") or []
    check("a card at a gate is an approval",
          any(q["id"] == "c-044" and q["kind"] == "approval" for q in queue), str(queue))
    check("and one that is not at a gate is a notice, not an approval",
          any(q["id"] == "c-045" and q["kind"] == "notice" for q in queue), str(queue))
    check("a blocked card says WHY in the line that is read out",
          any("no credentials" in q["what"] for q in queue), str(queue))
    # WRITTEN AS THE SENTENCE THAT MUST NEVER COME BACK, like the rest of this file. The
    # queue verb counts through the SHARED fold, and that fold reads what a row carries
    # rather than its `kind` label: a gate row with nothing on it but `kind: approval`
    # counts as a notice, and the spoken answer becomes "nothing needs a decision" while
    # a gate is sitting there. `by_hand` is what says otherwise, and `kb approve` needing
    # the deck's human token is why that is the true field rather than `on_approve`.
    check("a gate carries the fact that only his own hands can answer it",
          all(q.get("by_hand") for q in queue if q["kind"] == "approval"), str(queue))
    check("and a notice carries no such claim",
          not any(q.get("by_hand") for q in queue if q["kind"] == "notice"), str(queue))
    check("every queue row can be dated, so an old notice can actually fold",
          all(q.get("at") for q in queue), str(queue))
    # AND IT DOES FOLD, proved against an explicit clock rather than today's: the same
    # rows through the shared fold, once at this run's own now and once past the window.
    # The notice moves from fresh to folded; the approval is owed at any age.
    import harbor_queue_fold as qfold
    later = _BOARD_NOW + timedelta(days=qfold.NOTICE_FOLD_DAYS + 1)
    _, fresh_now, folded_now = qfold.partition(queue, now=_BOARD_NOW)
    owed_later, _, folded_later = qfold.partition(queue, now=later)
    check("and a notice folds only once it is past the window, by an explicit clock",
          [q["id"] for q in fresh_now] == ["c-045"] and folded_now == []
          and [q["id"] for q in folded_later] == ["c-045"]
          and [q["id"] for q in owed_later] == ["c-044"],
          f"now: {fresh_now} / {folded_now}; later: {owed_later} / {folded_later}")

    counts = doc.get("counts") or {}
    check("the counts agree with the rows under them, since both are spoken in one turn",
          counts.get("running") == len(running) and counts.get("notices") == len(queue),
          str(counts))
    check("Harbor is up when his pid file names a live process",
          (doc.get("harbor") or {}).get("running") is True, str(doc.get("harbor")))

    # THE INSTANT ANSWER RENDERS AGAINST THE SAME ROWS, both from the warm document and
    # from its own live `kb needs-you` read, and the two have to agree: they are the same
    # fold over the same rows, and a phone that hears one number while the deck shows
    # another is the lie the fold was added to stop.
    check("the waiting answer counts the approval and the notice separately",
          "1 approval" in str(out.get("waiting_said"))
          and "1 notice" in str(out.get("waiting_said")), str(out.get("waiting_said")))
    check("and its own live read of the board says the same thing",
          out.get("waiting_live") == out.get("waiting_said"),
          f"{out.get('waiting_live')!r} vs {out.get('waiting_said')!r}")

    # -- Harbor down, which is a fact and not a failure --------------------------- --
    keel2, _argv2, env2 = _board_fixture()
    out2 = _board(env2)
    check("with no pid file, Harbor is reported down rather than unknown",
          (out2.get("doc") or {}).get("harbor", {}).get("running") is False,
          str(out2.get("doc", {}).get("harbor")))

    # -- the board refusing ------------------------------------------------------- --
    # A FETCH THAT FAILS MUST NOT LEAVE A DOCUMENT BEHIND. `_doc` is replaced, never
    # merged, and on this path it is not replaced at all, so what is read afterwards is
    # an empty document rather than the last good one, which would be a stale fact spoken
    # as a current one.
    refusal = "kb: no board at that KEEL_HOME"
    keel3, argv3, env3 = _board_fixture(kb_fails=refusal)
    out3 = _board(env3)
    check("a `kb` that refuses makes the fetch fail rather than half-succeed",
          out3.get("fetched") is False, str(out3))
    check("and the error carries kb's own words, not a sentence this gateway chose",
          refusal in str(out3.get("error")), str(out3.get("error")))
    check("and no document is left behind to be spoken as current",
          out3.get("doc") == {}, str(out3.get("doc")))
    check("and the instant answer refuses rather than speaking an empty board as news",
          "render_raised" in out3 or out3.get("waiting_said") == "The queue is empty.",
          str(out3.get("waiting_said")))

    # -- the harness refusing, which is NOT the same thing ------------------------- --
    # LIVENESS IS A DECORATION ON THE BOARD, NOT THE BOARD. A harness that cannot answer
    # must not be able to empty the whole document: the cards are still real, and every
    # session reads as exited, which is the honest direction.
    keel4, _argv4, env4 = _board_fixture(agents_fail=True)
    out4 = _board(env4)
    check("a harness that cannot answer does not empty the board",
          out4.get("fetched") is True
          and len(out4.get("doc", {}).get("running") or []) == 2, str(out4))
    check("and every session reads as exited rather than as still going",
          all(r["state"] == "exited"
              for r in (out4.get("doc", {}).get("running") or [])),
          str(out4.get("doc", {}).get("running")))


# --------------------------------------------------------------------------- #
# Capture: the second mode, and the one with no model in it.
# --------------------------------------------------------------------------- #

_CAPTURE_DRIVER = """
import json, sys
from harbor_voice import capture
ask = json.loads(sys.argv[1])
out = {}
try:
    out["card"] = capture.file(ask["said"], ask.get("space") or "",
                               ask.get("repairs") or [])
except capture.CaptureFailed as exc:
    out["refused"] = f"{exc}"
print("RESULT " + json.dumps(out))
"""


def _capture_fixture(kb_fails: str = ""):
    """A throwaway KEEL_HOME with a stub `kb` that records its argv.

    THE SUBPROCESS BOUNDARY IS THE THING WORTH DEFENDING, exactly as `_board_fixture`
    argues: `config.KB` and `config.KEEL_HOME` are read at import time and `capture.file`
    shells out, so a monkeypatch would exercise an arrangement that exists only in this
    test. What a capture must get right is the argv, the actor and kb's own words on a
    refusal, and all three cross this boundary.
    """
    keel = Path(tempfile.mkdtemp())
    (keel / "bin").mkdir(parents=True, exist_ok=True)
    (keel / "state").mkdir(parents=True, exist_ok=True)
    argv_path = keel / "kb-argv.jsonl"
    kb = keel / "bin" / "kb"
    kb.write_text(
        "#!/usr/bin/env python3\n"
        "import json, sys\n"
        f"open({str(argv_path)!r}, 'a').write(json.dumps(sys.argv[1:]) + chr(10))\n"
        + (f"sys.stderr.write({kb_fails!r} + chr(10))\nsys.exit(1)\n" if kb_fails else
           "print(json.dumps({'id': 'c-231', 'space': 'personal', "
           "'stage': 'inbox', 'topic': 'voice'}))\n"))
    kb.chmod(0o755)
    env = {**os.environ, "KEEL_HOME": str(keel),
           "PATH": f"{keel / 'bin'}:{os.environ.get('PATH', '')}",
           "PYTHONPATH": str(PKG)}
    return keel, argv_path, env


def _capture(env, said, space="", repairs=None):
    ask = json.dumps({"said": said, "space": space, "repairs": repairs or []})
    run = subprocess.run([sys.executable, "-c", _CAPTURE_DRIVER, ask], env=env,
                         capture_output=True, text=True, timeout=60)
    rows = [ln for ln in run.stdout.splitlines() if ln.startswith("RESULT ")]
    return json.loads(rows[0][7:]) if rows else {"stderr": run.stderr[-800:]}


def _argv_flags(argv: list) -> dict:
    """`kb`'s argv read back as a mapping, with `--option k=v` folded into `options`."""
    flags: dict = {"options": {}}
    i = 0
    while i < len(argv):
        item = argv[i]
        if item == "--option" and i + 1 < len(argv):
            name, _, value = argv[i + 1].partition("=")
            flags["options"][name] = value
            i += 2
        elif item.startswith("--") and item != "--json" and i + 1 < len(argv):
            flags[item[2:]] = argv[i + 1]
            i += 2
        else:
            i += 1
    return flags


def capture_section():
    print()
    print("== capture: what he said becomes an inbox card, with no model in the loop ==")

    # WHAT THIS SECTION EXISTS FOR. A capture is the one path in this package that
    # WRITES, and it writes to the board he actually reads. Every check here is a way
    # that write could be wrong rather than merely slow: the wrong actor, the wrong
    # space, a title that is a flag, a quote that is not verbatim, a refusal he is told
    # nothing about.

    keel, argv_path, env = _capture_fixture()
    said = ("Remind me to look at the bearing scores again. The trend one looked "
            "wrong, and the export is slow.")
    out = _capture(env, said)
    check("a capture lands and comes back with the id kb printed",
          (out.get("card") or {}).get("id") == "c-231", str(out))

    asked = [json.loads(ln) for ln in argv_path.read_text().splitlines() if ln.strip()]
    check("one capture is exactly one `kb` call, and it is a create",
          len(asked) == 1 and asked[0][2] == "create", str(asked))
    argv = asked[0]
    # THE ACTOR IS THE FIRST THING ON THE LINE AND IT IS NOT HIM. `--actor human` needs
    # the deck's token and this process must never hold one, so a capture that filed as
    # the human would be the gateway claiming an authority it was deliberately denied.
    check("it files as the voice actor, never as him",
          argv[:3] == ["--actor", "voice", "create"], str(argv[:3]))
    check("and it asks for the answer as JSON, so the id is read rather than parsed out "
          "of a sentence", "--json" in argv, str(argv))

    flags = _argv_flags(argv)
    check("the space is personal by default (decision D2)",
          flags.get("space") == "personal", str(flags.get("space")))
    check("the topic is `voice` until the refine sets a real one",
          flags.get("topic") == "voice", str(flags.get("topic")))
    check("the title is the first sentence, with no trailing stop",
          flags.get("title") == "Remind me to look at the bearing scores again",
          str(flags.get("title")))
    # HIS WORDS GO ON THE CARD VERBATIM, and the quote is the whole of the brief: the
    # lines under it are the refine's slot, one turn later.
    check("the brief is his whole sentence as a quote, verbatim, and nothing else",
          flags.get("brief") == "> " + said + "\n\n", repr(flags.get("brief")))
    check("it is marked as coming from voice, and as raw until the refine runs",
          flags["options"].get("source") == "voice"
          and flags["options"].get("capture") == "raw", str(flags["options"]))
    check("nothing was heard wrongly, so there is no `heard` option to audit",
          "heard" not in flags["options"], str(flags["options"]))
    # `card-it-means-inbox`, WITH NO EXCEPTION. `kb create` lands at inbox on its own,
    # so the guard is that a capture never says anything else: no stage, no assignment,
    # no autonomy, no session.
    check("a capture can never assign, stage or start anything",
          not {"stage", "autonomy", "repo", "model", "parent"} & set(flags),
          str(sorted(flags)))

    # -- the clip ----------------------------------------------------------- --
    keel2, argv2, env2 = _capture_fixture()
    longer = ("I want the deck to show which cards came in by voice so I can tell them "
              "apart from the ones I typed at the desk.")
    _capture(env2, longer)
    title = _argv_flags(json.loads(argv2.read_text().splitlines()[0]))["title"]
    check(f"a long first sentence is clipped to {config.CAPTURE_TITLE_CHARS} characters",
          len(title) <= config.CAPTURE_TITLE_CHARS, f"{len(title)}: {title!r}")
    check("and it is clipped on a word boundary, saying so with an ellipsis",
          title.endswith("...") and longer.startswith(title[:-3].rstrip()), title)

    # -- "work:" as the first word ------------------------------------------- --
    # THE SPOKEN PREFIX WINS OVER THE PAGE'S TOGGLE: it is the more recent and the more
    # deliberate of the two, and space is immutable on a card, so the one chance to get
    # it right is here.
    keel3, argv3, env3 = _capture_fixture()
    spoken_work = "Work: the release notes need a second pass before Friday."
    _capture(env3, spoken_work, space="personal")
    work = _argv_flags(json.loads(argv3.read_text().splitlines()[0]))
    check("a spoken 'work:' files it in work even when the page said personal",
          work.get("space") == "work", str(work.get("space")))
    check("the word stays in the quote, because the quote is the verbatim record",
          work.get("brief") == "> " + spoken_work + "\n\n", repr(work.get("brief")))
    check("and it is not in the title, which is about the idea",
          not work.get("title", "").lower().startswith("work"), str(work.get("title")))

    # -- what the speech model got wrong ------------------------------------- --
    keel4, argv4, env4 = _capture_fixture()
    _capture(env4, "the kayleigh board is slow", repairs=[["kayleigh", "Keel"]])
    heard = _argv_flags(json.loads(argv4.read_text().splitlines()[0]))["options"]
    check("a repaired word is recorded on the card, so a correction is auditable",
          json.loads(heard.get("heard") or "[]") == [{"heard": "kayleigh",
                                                      "readAs": "Keel"}],
          str(heard))

    # -- `kb` refusing -------------------------------------------------------- --
    # THE ONE FAILURE THAT MATTERS, and it must not be silent. His words are already on
    # the page and in the transcript by the time this runs, so nothing is lost; what
    # would be lost is his belief that it landed.
    refusal = "kb: unknown space 'personal'; one of work"
    keel5, _argv5, env5 = _capture_fixture(kb_fails=refusal)
    out5 = _capture(env5, "this one cannot land")
    check("a `kb` that refuses raises rather than answering with a card",
          "card" not in out5 and out5.get("refused"), str(out5))
    check("and the reason carries kb's own words, not a sentence this gateway chose",
          refusal in str(out5.get("refused")), str(out5.get("refused")))

    # -- the ack ------------------------------------------------------------- --
    print()
    print("== the ack is a fixed line played from disk, and the ramble is never read "
          "back ==")
    check("there is more than one way to say it, so a run of captures is not a machine "
          "talking", len(corpus.ACKS) >= 3, str(corpus.ACKS))
    check("every ack says where it went, in words he can act on",
          all("board" in line or "inbox" in line for line in corpus.ACKS),
          str(corpus.ACKS))
    check("the same line is never played twice in a row",
          all(corpus.pick_ack(avoid=line) != line for line in corpus.ACKS
              for _ in range(8)), "")
    check("the failure line points at the page, where his words already are",
          "page" in corpus.ACK_FAILED, corpus.ACK_FAILED)
    keys = {line.text for line in corpus.ack_lines()}
    check("the acks and the failure line are rendered with the filler, into one cache",
          keys == set(corpus.ACKS) | {corpus.ACK_FAILED}, str(sorted(keys)))
    renderer = (HERE / "keel-voice-corpus").read_text()
    # THE PROPERTY, NOT THE SPELLING. This used to grep the renderer for `ack_lines()`,
    # which stopped being true the moment V8 gave the render a speaker dimension and moved
    # the enumeration into `corpus.audio_sets`. What it is actually defending is that a
    # fixed line nobody picks still gets a clip, so it asks the set that is rendered.
    harbor = {line.text for line in corpus.lines_for(config.SPEAKER_HARBOR)}
    check("and `bin/keel-voice-corpus render` is what renders them",
          "audio_sets" in renderer and keys <= harbor,
          str(sorted(keys - harbor)))
    # ONE ENUMERATION, TWO READERS (V8). The render fills the sets and `keel voice audio`
    # counts them; a second list in either would be a cache that reports itself full while
    # something in it is silent, which is the exact failure V8's brief named.
    check("and the verb that counts the clips walks the same sets",
          "corpus.set_stats()" in (HOME / "keel" / "voice.py").read_text())
    speakers = {one["speaker"] for one in corpus.audio_sets()}
    check("every speaker has a set of its own, so neither is counted as the other",
          speakers == set(config.SPEAKERS), str(sorted(speakers)))
    # A HOUSE HAS NO FIXED LINE OF ITS OWN SINCE V13. Harbor enters and leaves, so every
    # sentence code renders is Harbor's; what a house says is only ever its ANSWER, which
    # is written by a model and can never be a clip. The set is kept rather than removed
    # so the render and `keel voice audio` still walk one enumeration, and it is EMPTY
    # rather than absent, which is the truthful answer to "how many of a house's clips are
    # rendered".
    house = corpus.lines_for(config.SPEAKER_HOUSE)
    check("a house speaks no fixed line, so it has no clips of its own",
          house == [], str([line.text for line in house]))

    # -- the turn machine ----------------------------------------------------- --
    print()
    print("== a capture turn: a card, an ack, and no model anywhere ==")
    tmp = Path(tempfile.mkdtemp())
    # THE LOG GOES TO THE TMPDIR, NOT TO THE LIVE ONE. `harbormsg.LOG` is read from the
    # config at import time, and this section drives the dispatcher IN THIS PROCESS,
    # where KEEL_HOME is the real checkout: without this, running the selftest writes
    # "a capture did NOT land on the board" into `state/logs/voice.log` beside the real
    # gateway's records, where the next person reading that file would take it for one.
    live_log = harbormsg.LOG
    harbormsg.LOG = tmp / "voice.log"
    spoken = []
    d = _dispatcher(fixture(), spoken, tmp=tmp)
    filed = []
    d.file_capture = lambda text, space, heard=None: (
        filed.append((text, space, heard)) or {"id": "c-231",
                                               "space": space or "personal"})
    told = []
    d.captured = lambda turn, card: told.append((turn.id, card.get("id")))

    turn = d.capture("keep this one, the export is slow", "personal")
    check("the turn is a capture, in both the mode and the tier",
          turn.mode == "capture" and turn.tier == "capture",
          f"{turn.mode}/{turn.tier}")
    check("his words reached the board exactly as spoken",
          filed == [("keep this one, the export is slow", "personal", None)],
          str(filed))
    check("no model was asked anything at all",
          not d.deliver.calls, str(d.deliver.calls))
    check("the ack is one of the fixed lines, and it is what was spoken",
          turn.answer in corpus.ACKS and spoken and spoken[-1][1] == turn.answer,
          str(spoken[-1:]))
    # THE RAMBLE IS NEVER SPOKEN BACK. He just said it; reading it to him is the one
    # thing a capture must not spend his time on.
    check("the ramble itself is never read back",
          not any(turn.said in text for _gen, text, _s in spoken), str(spoken))
    check("the card id is on the turn for the page to draw, never in the spoken line",
          turn.card == "c-231" and "c-231" not in turn.answer,
          str(turn.as_json()))
    check("the provenance under the turn names the card and how long it took",
          turn.provenance.startswith("card c-231, ")
          and turn.provenance.endswith("s"), turn.provenance)
    check("the page is told the id at once rather than at its next poll",
          told == [(turn.id, "c-231")], str(told))

    lines = [json.loads(ln) for ln in
             (tmp / "transcript.jsonl").read_text().splitlines() if ln.strip()]
    kinds = [ln["kind"] for ln in lines]
    check("the transcript records the capture as a capture",
          all(ln["mode"] == "capture" for ln in lines) and "captured" in kinds,
          str(kinds))
    landed = [ln for ln in lines if ln["kind"] == "captured"][0]
    check("and the record carries the card, the space and the seconds it took",
          landed.get("card") == "c-231" and landed.get("space") == "personal"
          and isinstance(landed.get("seconds"), float), str(landed))

    # -- the capture that did not land ---------------------------------------- --
    tmp2 = Path(tempfile.mkdtemp())
    spoken2 = []
    d2 = _dispatcher(fixture(), spoken2, tmp=tmp2)

    def _refuse(text, space, heard=None):
        raise capturemod.CaptureFailed("kb: the board is not there")

    d2.file_capture = _refuse
    turn2 = d2.capture("this one will not land", "personal")
    check("a refusal is spoken once, in the one fixed failure line",
          turn2.answer == corpus.ACK_FAILED
          and [text for _gen, text, _s in spoken2] == [corpus.ACK_FAILED], str(spoken2))
    check("the turn carries no card and says so under it",
          turn2.card == "" and turn2.provenance == "not captured",
          str(turn2.as_json()))
    check("and his words survive on the page and in the transcript, which is what the "
          "failure line tells him",
          turn2.said == "this one will not land"
          and "this one will not land" in (tmp2 / "transcript.jsonl").read_text(),
          "")
    why = [json.loads(ln) for ln in
           (tmp2 / "transcript.jsonl").read_text().splitlines()
           if '"capture-failed"' in ln]
    check("the reason is on the record in kb's own words",
          why and "the board is not there" in why[0].get("error", ""), str(why))

    harbormsg.LOG = live_log

    # -- the page's two defaults ---------------------------------------------- --
    flags_page = config.flags_for_page()
    check("the page is told which mode to open in, and where a capture is filed",
          flags_page.get("modeDefault") in ("capture", "talk")
          and flags_page.get("captureDefaultSpace") in ("personal", "work"),
          str({k: flags_page.get(k) for k in ("modeDefault", "captureDefaultSpace")}))
    app = page_js(HERE.parent)
    # THE PAGE RESTS IN TALK (VP-2, 2026-09-24): Capture is one hold armed from the + menu,
    # so the mode default is no longer a mode the page opens in; the space still is read.
    check("and the page reads the space by name, and rests in talk whatever the mode default",
          "FLAGS.captureDefaultSpace" in app and "FLAGS.modeDefault" not in app, "")
    check("an unknown mode from an old page is talk, not a capture nobody asked for",
          config.normal_mode("") == "talk" and config.normal_mode("nonsense") == "talk"
          and config.normal_mode("capture") == "capture"
          and config.normal_mode("converse") == "talk", "")


# --------------------------------------------------------------------------- #
# Converse: the digest, the lock, the card for an answer he did not hear, and the
# conversation's two bounds.
# --------------------------------------------------------------------------- #

_LOCK_DRIVER = """
import json, sys, time
from harbor_voice import harbormsg
sends = [harbormsg.send("first thing"), harbormsg.send("second thing")]
time.sleep(0.2)
sends.append(harbormsg.send("third thing"))
box = harbormsg.SayInbox(harbormsg.SAY_DIR)
lines = []
deadline = time.time() + 40
while time.time() < deadline and len(lines) < 2:
    lines += [r.get("text") for r in box.claim()]
    time.sleep(0.05)
print("RESULT " + json.dumps({"sends": sends, "lines": lines}))
"""

_QUEUE_DRIVER = """
import json, sys
from harbor_voice import harbormsg
staged = harbormsg.queue_answer("what do you make of all that",
                                "The deck redesign is at the outcome gate.", "t-9")
print("RESULT " + json.dumps({"staged": staged}))
"""

_SESSION_DRIVER = """
import json, sys, time
from harbor_voice import harbormsg
before = harbormsg.read_session()
session, existed, handover = harbormsg.open_session()
print("RESULT " + json.dumps({"before": before, "uuid": session, "existed": existed,
                              "handover": handover,
                              "after": harbormsg.read_session()}))
"""


def _run_driver(env, source, *args):
    run = subprocess.run([sys.executable, "-c", source, *args], env=env,
                         capture_output=True, text=True, timeout=120)
    rows = [ln for ln in run.stdout.splitlines() if ln.startswith("RESULT ")]
    return json.loads(rows[0][7:]) if rows else {"stderr": run.stderr[-800:]}


def converse_section():
    print()
    print("== converse: the board arrives with the turn, so the turn stops reading it ==")

    # WHAT THIS SECTION EXISTS FOR. Every voice turn used to open by booting the whole
    # board, because the talker's rulebook says to and the rulebook is shared with the
    # phone session, where that is right. `kb list --json` is 616 KB and 189 cards; for a
    # spoken question that is pure latency, and the two `kb` reads were the first two
    # tool calls of every turn.
    doc = fixture()
    spoken = []
    d = _dispatcher(doc, spoken, deliver=FakeDeliver(True, "delivered"))
    d.answer("what do you make of the bearing scores")
    time.sleep(0.2)
    extra = d.deliver.extras[-1] if d.deliver.extras else {}
    check("the turn carries a board digest", bool(extra.get("digest")), str(extra)[:200])
    check("and says how old it is, so nothing has to guess whether to re-read it",
          extra.get("age") is not None, str(extra)[:200])
    check("the digest is the index, which is names, ids, states and counts",
          '"queuePending"' in str(extra.get("digest"))
          and "the desktop room view" not in str(extra.get("digest")),
          str(extra.get("digest"))[:300])

    line = harbormsg.build_line("what do you make of the bearing scores", "",
                                extra.get("digest", ""), extra.get("age") or 0)
    check("the framing tells the turn to answer from it and not to run `kb list`",
          "do not run `kb list`" in line, line[:400])
    check("and says which two readings are still allowed, and when",
          "`kb needs-you` only if they ask what is waiting on them" in line
          and "`kb show <id>` for a card the user names" in line, line[:400])
    check("the digest itself travels under the framing, not inside it",
          line.index("Deck digest:") > line.index("do not run `kb list`"), "")
    check("the [voice] tag and the -- separator are untouched, because the transcript "
          "keys on them",
          line.startswith("[voice] what do you make of the bearing scores -- "), line[:80])
    # THE 70 PERCENT ARE COMMANDS, and a command answered with a preamble is a 30 second
    # turn where a 10 second one would do.
    check("the framing carries the command contract",
          "For a command, do it, then say what changed in one sentence, with the card "
          "id." in harbormsg.FRAMING, harbormsg.FRAMING)

    print()
    print("== one conversation, one turn in flight, and the third is told so ==")

    # THE BUG THIS CLOSES. `server.on_text` spawns a thread per utterance and `send` a
    # worker per turn, and until 2026-09-17 there was no lock anywhere between them: two
    # `claude -p --resume` runs on the SAME conversation, racing, and whichever finished
    # last wrote the transcript.
    home, keel, argv_path, env = _keel_fixture(echo=True, delay=1.5)
    out = _run_driver(env, _LOCK_DRIVER)
    sends = out.get("sends") or []
    check("the first two utterances are both accepted",
          len(sends) == 3 and sends[0][0] is True and sends[1][0] is True, str(sends))
    check("and the second one says it is waiting rather than racing",
          "queued" in str(sends[1][1]), str(sends[1]))
    check("the third is refused with the fixed line's marker, not queued",
          sends[2] == [False, harbormsg.BUSY], str(sends[2:]))
    check("and what he hears for it counts turns rather than reading a clock",
          dispatcher.NARRATION["busy"] == "One at a time, I'm still on the last one.",
          dispatcher.NARRATION["busy"])
    lines = out.get("lines") or []
    check("both accepted turns answer, in the order he said them",
          len(lines) == 2 and "first thing" in lines[0] and "second thing" in lines[1],
          str(lines))
    ran = [json.loads(ln) for ln in argv_path.read_text().splitlines() if ln.strip()]
    check("exactly two turns ever ran, so the third cost no model call at all",
          len(ran) == 2, str(len(ran)))
    check("and the second resumed the conversation the first created",
          "--session-id" in ran[0] and "--resume" in ran[1], str(ran))

    # -- and each answer lands on the turn that asked for it ----------------- --
    # OBSERVED LIVE, 2026-09-18, and it is the reason the say inbox grew a turn id. A
    # turn he has moved on from is HELD, not cancelled: its watch loop keeps waiting for
    # the answer it is owed, so while a second turn is in flight there are TWO loops
    # reading one directory. Whichever polled first claimed whatever had arrived, and the
    # two answers were recorded against each other's questions.
    box = SayInbox(Path(tempfile.mkdtemp()))
    box.write("the answer to the first", turn="t-one")
    box.write("the answer to the second", turn="t-two")
    box.write("a line from `keel-voice say`, which belongs to nobody")
    first = [r["text"] for r in box.claim("t-one")]
    check("a watch loop claims its own answer and leaves the other turn's alone",
          first == ["the answer to the first",
                    "a line from `keel-voice say`, which belongs to nobody"], str(first))
    second = [r["text"] for r in box.claim("t-two")]
    check("and the other turn's answer is still there for it",
          second == ["the answer to the second"], str(second))

    print()
    print("== an answer he could not hear goes on the board, not only in the log ==")

    keel2, argv2, env2 = _capture_fixture()
    out2 = _run_driver(env2, _QUEUE_DRIVER)
    check("it reports that it was staged, which is what the transcript records",
          out2.get("staged") is True, str(out2))
    filed = _argv_flags(json.loads(argv2.read_text().splitlines()[0]))
    check("it is a card, filed as the voice actor",
          json.loads(argv2.read_text().splitlines()[0])[:3]
          == ["--actor", "voice", "create"], argv2.read_text())
    check("in personal, never wherever a capture happens to be pointed (decision D3)",
          filed.get("space") == "personal", str(filed.get("space")))
    check("its title is the question, so the board reads as questions rather than "
          "replies",
          filed.get("title") == "Answer: what do you make of all that",
          str(filed.get("title")))
    check("its body is what he asked and then the answer, because the answer alone is "
          "unreadable a day later",
          filed.get("brief") == ("what do you make of all that\n\n"
                                 "The deck redesign is at the outcome gate."),
          repr(filed.get("brief")))
    check("and it is marked as an answer from voice, so a sweep can tell it from work",
          filed["options"].get("source") == "voice"
          and filed["options"].get("kind") == "answer", str(filed["options"]))

    # AND BOTH SILENT PATHS FILE ONE NOW. The give-up path redacts the text from this
    # page (it promised out loud that it would); the not-live path does not, because
    # nobody was promised anything, and the answer should be waiting on the page too.
    spoken7 = []
    live_log = harbormsg.LOG                 # the tmpdir, for the same reason as above
    harbormsg.LOG = Path(tempfile.mkdtemp()) / "voice.log"
    d7 = _dispatcher(fixture(), spoken7,
                     deliver=FakeDeliver(True, "delivered"), presence=lambda: False)
    turn7 = d7.answer("what do you make of all that")
    d7.inbox.write("the answer nobody was there to hear")
    time.sleep(0.6)
    check("a not-live answer is filed as a card too, not left on a page he does not read",
          d7.queue_calls == [("what do you make of all that",
                              "the answer nobody was there to hear", turn7.id)],
          str(d7.queue_calls))
    check("and it is still shown on the page, because nobody was promised otherwise",
          turn7.answer == "the answer nobody was there to hear", str(turn7.as_json()))
    d7.generation += 1
    harbormsg.LOG = live_log

    print()
    print("== the conversation is bounded, and rotating it hands over ==")

    # EVERY `-p --resume` RE-READS THE WHOLE TRANSCRIPT, so latency grows with age and
    # nothing local resets it. Two bounds, and a handover so the new conversation is not
    # a stranger.
    home3, keel3, _argv3, env3 = _keel_fixture()
    (keel3 / "state" / "voice").mkdir(parents=True, exist_ok=True)
    (keel3 / "state" / "voice" / "transcript.jsonl").write_text("\n".join(
        json.dumps({"kind": "said", "said": said}) for said in
        ("the bearing scores look wrong", "assign both of those to me",
         "what is waiting on me")) + "\n")
    old = {"uuid": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
           "turns": config.VOICE_SESSION_MAX_TURNS, "started_at": time.time()}
    (keel3 / "state" / "voice-session.json").write_text(json.dumps(old))
    out3 = _run_driver(env3, _SESSION_DRIVER)
    check(f"a conversation that has answered {config.VOICE_SESSION_MAX_TURNS} turns is "
          "retired", out3.get("uuid") != old["uuid"], str(out3))
    check("the fresh one is CREATED rather than resumed, which is what --session-id is "
          "for", out3.get("existed") is False, str(out3))
    check("and its first turn carries a one line handover in his own words",
          "new conversation" in str(out3.get("handover")).lower()
          and "what is waiting on me" in str(out3.get("handover")), str(out3))
    check("the record starts again from zero turns",
          (out3.get("after") or {}).get("turns") == 0, str(out3.get("after")))

    home4, keel4, _argv4, env4 = _keel_fixture()
    aged = {"uuid": "11111111-2222-3333-4444-555555555555", "turns": 2,
            "started_at": time.time() - config.VOICE_SESSION_MAX_AGE - 60}
    (keel4 / "state" / "voice-session.json").write_text(json.dumps(aged))
    out4 = _run_driver(env4, _SESSION_DRIVER)
    check("a conversation older than a day is retired on age alone",
          out4.get("uuid") != aged["uuid"] and out4.get("existed") is False, str(out4))
    check("with a handover even when the transcript has nothing to hand over",
          "new conversation" in str(out4.get("handover")).lower(), str(out4))

    home5, keel5, _argv5, env5 = _keel_fixture()
    young = {"uuid": "99999999-8888-7777-6666-555555555555", "turns": 3,
             "started_at": time.time() - 60}
    (keel5 / "state" / "voice-session.json").write_text(json.dumps(young))
    out5 = _run_driver(env5, _SESSION_DRIVER)
    check("and a conversation inside both bounds is simply resumed, with no handover",
          out5.get("uuid") == young["uuid"] and out5.get("existed") is True
          and not out5.get("handover"), str(out5))

    # The talker's memory is the install's own since c-722 (landing B took it out of the
    # code), so what one owner's memory says about a voice turn is that owner's to hold, not
    # this selftest's: the checks that read it left with it.


# --------------------------------------------------------------------------- #
# The refine: the second half of a capture, a minute later, that nobody waits for.
# --------------------------------------------------------------------------- #

_REFINE_DRIVER = """
import json, sys, time
from harbor_voice import config, harbormsg, refine
ask = json.loads(sys.argv[1])
r = refine.Refiner(topics=lambda space: ask.get("topics") or [],
                   delay=ask.get("delay", 0.4))
for item in ask["captures"]:
    r.add(item["card"], item["said"], item.get("space", ""))
    time.sleep(ask.get("gap", 0.05))
# WHILE HE IS STILL TALKING: due() is measured from the LAST capture, so a run of them
# coalesces into one drain after he stops.
out = {"early_ran": r.drain(), "early_due": r.due()}
if ask.get("hold_a_turn"):
    # A CONVERSE TURN HAS TAKEN ITS SLOT. The refine must put the lock straight back
    # down rather than make him wait out a model turn.
    harbormsg.take_slot()
    time.sleep(ask.get("delay", 0.4) + 0.2)
    out["ran_while_busy"] = r.drain()
    out["claude_calls_while_busy"] = ask["calls_path"]
    harbormsg.release_slot()
ran = 0
deadline = time.time() + 60
while time.time() < deadline and r.waiting:
    ran += r.drain()
    time.sleep(0.05)
# D-3: WHAT A REFINE LEAVES OF HARBOR'S VOICE CONVERSATION, which must be nothing: no
# session record minted or bumped, and nothing it could have spoken with.
out.update({"ran": ran, "stats": r.as_json(),
            "voice_session": config.VOICE_SESSION_FILE.exists(),
            "can_speak": any(hasattr(r, name) for name in ("say", "live", "spoken"))})
print("RESULT " + json.dumps(out))
"""


def _refine_fixture(result: str):
    """A KEEL_HOME with a stub `kb` and a stub `claude` (round 2, item A).

    THE STUB `claude` ONLY ANSWERS: the refine has no tools, so every write on the board is
    Keel's own, made through `kb` by `refineapply`, and the stub `kb` records each one with
    the `KEEL_REFINE_CARD` it was run under.
    """
    keel = Path(tempfile.mkdtemp())
    (keel / "bin").mkdir(parents=True, exist_ok=True)
    (keel / "state" / "logs").mkdir(parents=True, exist_ok=True)
    (keel / "talker").mkdir(parents=True, exist_ok=True)
    kb_argv = keel / "kb-argv.jsonl"
    claude_argv = keel / "claude-argv.jsonl"
    (keel / "result.txt").write_text(result)
    kb = keel / "bin" / "kb"
    kb.write_text(
        f"#!{sys.executable}\n"
        "import json, os, sys\n"
        "argv = [a for a in sys.argv[1:] if a != '--json']\n"
        f"open({str(kb_argv)!r}, 'a').write(json.dumps({{'argv': argv, "
        "'scope': os.environ.get('KEEL_REFINE_CARD')}) + chr(10))\n"
        "if 'repos' in argv:\n"
        "    print(json.dumps([{'repo': 'keel'}, {'repo': 'harbor'}]))\n"
        "elif 'show' in argv:\n"
        "    print(json.dumps({'id': argv[-1], 'options': {}}))\n"
        "else:\n"
        "    print(json.dumps({'id': 'c-909', 'space': 'personal', 'stage': 'inbox'}))\n")
    kb.chmod(0o755)
    claude = keel / "bin" / "claude"
    # THE REAL ENVELOPE'S SHAPE (2.1.281, `tests/fixtures/harness/structured.json`): with
    # `--json-schema` an object answer rides in `structured_output` beside `result`; an
    # answer that is not one object leaves `structured_output` out, as a turn with no
    # valid structured result would.
    claude.write_text(
        f"#!{sys.executable}\n"
        "import json, sys\n"
        f"open({str(claude_argv)!r}, 'a').write(json.dumps(sys.argv) + chr(10))\n"
        f"text = open({str(keel / 'result.txt')!r}).read()\n"
        "out = {'type': 'result', 'subtype': 'success', 'is_error': False, 'result': text,\n"
        "       'num_turns': 1, 'session_id': '00000000-0000-0000-0000-000000000000'}\n"
        "try:\n"
        "    found = json.loads(text)\n"
        "except ValueError:\n"
        "    found = None\n"
        "if '--json-schema' in sys.argv and isinstance(found, dict):\n"
        "    out['structured_output'] = found\n"
        "print(json.dumps(out))\n")
    claude.chmod(0o755)
    env = {**os.environ, "KEEL_HOME": str(keel),
           "PATH": f"{keel / 'bin'}:{os.environ.get('PATH', '')}",
           "PYTHONPATH": str(PKG)}
    return keel, kb_argv, claude_argv, env


def _refine(env, **ask):
    ask.setdefault("captures", [{"card": "c-231", "said": "the bearing scores look wrong"}])
    out = _run_driver(env, _REFINE_DRIVER, json.dumps(ask))
    return out


def _answer(**over):
    base = {"title": None, "topic": None, "repo": None, "note": None, "question": None,
            "choices": [], "split": None, "line": "tidied"}
    base.update(over)
    return json.dumps(base)


def _writes(path: Path) -> list:
    rows = [json.loads(ln) for ln in path.read_text().splitlines() if ln.strip()]
    return [r for r in rows if r["argv"][:1] not in (["repos"], ["show"])]


def refine_section():
    print()
    print("== the refine: one bounded turn per capture, no tools, and Keel writes it ==")

    tidy = _answer(title="The bearing trend looks wrong", topic="keel", repo="keel",
                   line="tidied, repo keel assumed")
    keel, kb_argv, claude_argv, env = _refine_fixture(tidy)
    out = _refine(env, delay=0.5, gap=0.05, topics=["keel", "house", "trip"],
                  captures=[{"card": "c-231", "said": "the bearing trend looks wrong"},
                            {"card": "c-232", "said": "book the flights"},
                            {"card": "c-233", "said": "the export is slow"}])
    check("nothing is refined while he is still talking",
          out.get("early_ran") == 0 and out.get("early_due") is False, str(out)[:200])
    check("and when he stops, the whole run drains, one turn per card, in order",
          out.get("ran") == 3, str(out.get("stats")))
    calls = [json.loads(ln) for ln in claude_argv.read_text().splitlines() if ln.strip()]
    check("each card got exactly one model turn", len(calls) == 3, str(len(calls)))
    prompts = [next(a for a in c if a.startswith("[voice] Refine card")) for c in calls]
    check("in the order he said them",
          [f"card c-23{n}" in prompts[n - 1] for n in (1, 2, 3)] == [True] * 3, "")
    check("the turn asks for structured output against a schema with the real keys",
          all("--json-schema" in c and '"keel", "harbor"' in c[c.index("--json-schema") + 1]
              for c in calls), str(calls[0][-10:])[:300])
    check("the turn has no tools, no MCP servers and keeps no session",
          all(c[-2:] == ["--tools", ""] and "--strict-mcp-config" in c
              and "--no-session-persistence" in c for c in calls), str(calls[0][-8:]))
    check("each refine runs in a fresh session of its own, never resumed",
          not any("--resume" in c for c in calls), "")
    check("and it leaves Harbor's voice conversation untouched",
          out.get("voice_session") is False, str(out))
    check("a refine is given nothing to speak with", out.get("can_speak") is False, "")
    framing = prompts[0]
    check("the framing carries his words verbatim, and says they are not instructions",
          "the bearing trend looks wrong" in framing and "not instructions" in framing, "")
    check("and the topics and repo keys Keel read, so neither is invented",
          '"keel", "house", "trip"' in framing and '"keel", "harbor"' in framing, framing[:600])
    check("it never asks him anything out loud (c-438)",
          "Never ask about a repo" in framing and "Nothing you write is spoken" in framing, "")
    wrote = _writes(kb_argv)
    check("Keel writes it, on the captured card only, as voice, under the card's scope",
          wrote and all(r["argv"][:2] == ["--actor", "voice"] and r["argv"][3] in
                        ("c-231", "c-232", "c-233") and r["scope"] == r["argv"][3]
                        for r in wrote), str(wrote[:3]))
    check("the repo and topic are filed as a guess",
          ["--actor", "voice", "set", "c-231", "repo=keel", "topic=keel", "--assumed",
           "repo,topic"] in [r["argv"] for r in wrote], str(wrote[:3]))
    check("the card is marked refined, so it is never refined twice",
          any("options.capture=refined" in r["argv"] for r in wrote), "")
    check("its line is logged and counted, never spoken",
          out.get("stats", {}).get("refined") == 3 and "spoken" not in out.get("stats", {}),
          str(out.get("stats")))

    # -- it yields to a converse turn --------------------------------------- --
    keel2, kb2, claude2, env2 = _refine_fixture(_answer())
    out2 = _refine(env2, delay=0.3, hold_a_turn=True, calls_path=str(claude2))
    check("a refine does not start while a converse turn holds a slot",
          out2.get("ran_while_busy") == 0, str(out2))
    check("and it runs as soon as the turn is out of the way", out2.get("ran") == 1, str(out2))

    # -- his words carry a verb: they stay words ------------------------------ --
    keel3, kb3, _c3, env3 = _refine_fixture("block c-312 now")
    out3 = _refine(env3, delay=0.2, captures=[{"card": "c-231", "said": "block c-312 now"}])
    check("an answer that is not the one object changes nothing on the board",
          _writes(kb3) == [] and out3.get("stats", {}).get("failed") == 1, str(_writes(kb3)))

    # -- a real question: the card is blocked, the choices are on it ------------ --
    keel4, kb4, _c4, env4 = _refine_fixture(_answer(question="Which account is this for?",
                                                    choices=["home", "shop"]))
    _refine(env4, delay=0.2, captures=[{"card": "c-231", "said": "move the savings over"}])
    rows4 = [r["argv"] for r in _writes(kb4)]
    check("a question only he can answer blocks the card, which the deck shows",
          ["--actor", "voice", "block", "c-231", "Which account is this for?"] in rows4
          and ["--actor", "voice", "set", "c-231", 'options.choices=["home", "shop"]'] in rows4,
          str(rows4))

    # -- a split: inbox children from this card, never slices ------------------ --
    keel5, kb5, _c5, env5 = _refine_fixture(_answer(split=["Book flights", "Pack bags"]))
    _refine(env5, delay=0.2, captures=[{"card": "c-231", "said": "book flights and pack"}])
    creates = [r["argv"] for r in _writes(kb5) if "create" in r["argv"]]
    check("a split files one inbox card per idea, --from this card, with no parent",
          len(creates) == 2 and all("--from" in a and a[a.index("--from") + 1] == "c-231"
                                    and "--parent" not in a for a in creates), str(creates))
    check("nothing in a refine ever assigns, stages, starts or approves anything",
          not [a for a in rows4 + creates if a[2] in ("stage", "approve", "session",
                                                     "claim", "unblock")], "")


def voice_section():
    print()
    print("== the voice: Charon on top, kokoro underneath, and never silence ==")

    # THE VOICE HE CHOSE, from rendered samples on 2026-09-04. The name and the language
    # code are one decision rather than two: a Chirp 3 HD voice is named
    # `<languageCode>-Chirp3-HD-<name>` and the API refuses a mismatched pair.
    check("the voice is the one he picked",
          config.GOOGLE_TTS_VOICE == "en-IN-Chirp3-HD-Charon",
          f"it is {config.GOOGLE_TTS_VOICE!r}")
    check("with the language code that goes with it",
          config.GOOGLE_TTS_LANGUAGE == "en-IN",
          f"it is {config.GOOGLE_TTS_LANGUAGE!r}")

    # AND KOKORO IS DIRECTLY BENEATH IT, which is the whole of degrade-never-mute. A
    # network failure, an expired key or a quota stop has to reach a LOCAL voice, and it
    # has to reach it next rather than eventually.
    chain = list(config.TTS_CHAIN)
    check("the hosted voice is at the top of the chain", chain[:1] == ["google"],
          str(chain))
    check("and kokoro is directly beneath it, not further down",
          chain[:2] == ["google", "kokoro"], str(chain))
    check("and the local floor is still under both",
          "say" in chain and "browser" in chain, str(chain))

    # DEGRADATION AT SPEAKING TIME, which is the property the old chain did not have.
    # Every failure it was designed for was an install-time one; a hosted voice fails
    # LATER, and under the old shape that raised inside Gateway.speak and the turn went
    # silent. Two engines, the top one refusing exactly the way a quota stop does.
    class Refuses:
        name = "refuses"
        ready = True

        def __init__(self):
            self.asked = []

        def synthesize(self, text, voice=""):
            self.asked.append(text)
            raise urllib.error.HTTPError("https://example.invalid", 429, "quota", {}, None)
            yield b""                       # pragma: no cover - never reached

    class Speaks:
        name = "speaks"
        ready = True

        def __init__(self):
            self.asked = []

        def synthesize(self, text, voice=""):
            self.asked.append(text)
            yield b"\x01\x00" * 100

    tts = speech.TTSChain(["browser"])
    bad, good = Refuses(), Speaks()
    # INJECTED AS ALREADY-BUILT, because the chain builds lazily now: kokoro is 787 MB
    # and 11.8 s to construct, measured, and building the fallback eagerly would have put
    # most of the 4.7 GB back that retiring the lookup tier removed.
    tts.order = ["refuses", "speaks"]
    tts.built = {"refuses": bad, "speaks": good}
    answer = "All quiet. One room is open. Nothing needs you."
    heard = list(tts.synthesize(answer))
    check("a hosted voice that refuses mid-answer does not mute the turn",
          len(heard) == 3, f"{len(heard)} chunks for three sentences")
    check("and every sentence is spoken exactly once, by the voice underneath",
          len(good.asked) == 3 and len(set(good.asked)) == 3, str(good.asked))
    check("the refused engine is asked once and then left alone",
          len(bad.asked) == 1,
          f"it was asked {len(bad.asked)} times; a demotion that does not stick pays "
          "the failing call on every sentence")
    check("the demotion is reported, with the reason and when it is next tried",
          tts.as_json()["demoted"].get("refuses", {}).get("why") == "HTTPError 429",
          str(tts.as_json()["demoted"]))
    check("and the voice the page is told about is the one actually speaking",
          tts.name == "speaks", tts.name)

    # A DEMOTION IS TEMPORARY. The code cannot tell a quota stop from a dropped packet,
    # and being wrong in the second direction means a local voice for the rest of the day
    # after one bad second.
    tts.demoted["refuses"]["until"] = time.time() - 1
    check("past the retry window the preferred voice is tried again",
          tts.name == "refuses", tts.name)

    # AND THE FLOOR CANNOT FAIL. `browser` makes no audio here at all: it tells the page
    # to speak, so the last link always says something.
    floor = speech.TTSChain(["browser"])
    floor.order = ["refuses", "browser"]
    floor.built = {"refuses": Refuses(), "browser": speech.BrowserTTS()}
    check("with everything above it refusing, the floor is the browser and not silence",
          list(floor.synthesize("Say this.")) == [] and floor.name == "browser",
          floor.name)

    # AND NOTHING BELOW THE PREFERRED VOICE IS HELD UNTIL IT IS NEEDED. Measured on this
    # machine: kokoro is 787 MB resident and 11.8 s to construct. Building it at startup
    # so that it is ready would put most of the 4.7 GB back that retiring the lookup
    # tier was meant to remove, for a voice that speaks only when the hosted one fails.
    # `say` is macOS's, and this check is about WHICH engines are built, not about what
    # `say` sounds like: `SayTTS` only asks whether the program is on PATH. So the box gets
    # a stand-in there for the length of the construction, and the same check runs on both
    # machines. Without it the chain fell to the floor on Linux and the check read as a
    # broken chain (2026-09-20, the first `make test` on the box).
    say_dir = Path(tempfile.mkdtemp())
    (say_dir / "say").write_text("#!/bin/sh\nexit 0\n")
    (say_dir / "say").chmod(0o755)
    path_before = os.environ.get("PATH", "")
    os.environ["PATH"] = os.pathsep.join([path_before, str(say_dir)])
    try:
        lazy = speech.TTSChain(["say", "kokoro", "browser"])
    finally:
        os.environ["PATH"] = path_before
        shutil.rmtree(say_dir, ignore_errors=True)
    started = lazy.as_json()["started"]
    check("only the preferred voice is built at startup", started == ["say"],
          f"it had started {started}")
    check("and the chain still answers with it", lazy.name == "say", lazy.name)
    source = (PKG / "harbor_voice" / "speech.py").read_text()
    check("a fallback that is slow to build starts in the background rather than stalling",
          "_build_soon" in source and "voice-tts-" in source,
          "11.8 s of silence on the sentence after a failure is the failure the chain "
          "exists to prevent, arriving through the fallback")
    check("while something already up speaks the sentence in hand",
          'in ("browser", "say")' in source,
          "`say` is local, offline and instant to construct")

    # THE TAIL OF AN ANSWER IS NEVER DROPPED IN SILENCE. When a sentence falls all the
    # way to the floor, the chain used to `return`, which ends the generator and discards
    # every REMAINING sentence, and Gateway.speak suppressed its browser message because
    # it had already heard samples from the earlier ones. A silent partial mute inside
    # the method whose rule is degrade-never-mute. Raised by review, 2026-09-04.
    partial = speech.TTSChain(["browser"])
    once = Speaks()

    class OnceThenFloor:
        """Speaks the first sentence and refuses every one after it."""

        name = "oncethenfloor"
        ready = True

        def __init__(self):
            self.n = 0

        def synthesize(self, text, voice=""):
            self.n += 1
            if self.n > 1:
                raise urllib.error.HTTPError("https://example.invalid", 429, "quota",
                                             {}, None)
            yield b"\x01\x00" * 100

    partial.order = ["oncethenfloor", "browser"]
    partial.built = {"oncethenfloor": OnceThenFloor(), "browser": speech.BrowserTTS()}
    answer = "All quiet. One room is open. Nothing needs you."
    report: dict = {}
    got = list(partial.synthesize(answer, report))
    check("a chain that reaches the floor mid-answer speaks what it could",
          len(got) == 1, f"{len(got)} chunks")
    check("and says what it could NOT, so the caller can hand it to the page",
          report.get("unspoken") == "One room is open. Nothing needs you.",
          repr(report))
    # PER CALL, NOT ON THE CHAIN. The chain is shared by every turn, so two overlapping
    # speak calls would have read each other's leftovers off `self`. Raised by review.
    check("and the leftover belongs to the call rather than to the chain",
          not hasattr(partial, "unspoken"),
          "one turn at a time by design is not a reason to put per-turn state where a "
          "second turn can reach it")

    # THE SAME HOLE ONE BRANCH OVER, which stayed open after the first fix: a walk that
    # runs off the END of the chain, rather than reaching the browser floor, exited the
    # inner loop with nothing said and nothing recorded, and simply moved on.
    ran_out = speech.TTSChain(["browser"])
    ran_out.order = ["oncethenfloor"]
    ran_out.built = {"oncethenfloor": OnceThenFloor()}
    report2: dict = {}
    got2 = list(ran_out.synthesize(answer, report2))
    check("a walk that runs off the end of the chain records the rest too",
          len(got2) == 1
          and report2.get("unspoken") == "One room is open. Nothing needs you.",
          f"{len(got2)} chunks, {report2!r}")
    server_src = (PKG / "harbor_voice" / "server.py").read_text()
    check("and the gateway hands the remainder over rather than only the whole answer",
          "unspoken" in server_src and "say = left if heard else text" in server_src,
          "the part he has NOT heard is the part that vanishes")

    # HEALTH ANSWERS EVEN WHEN THE CORPUS IS BROKEN, which is exactly when it is wanted.
    # load() refuses a malformed corpus rather than skipping rows, which is right, and
    # stats() is read by /voice/health, which must not stop answering because of it.
    broken = Path(tempfile.mkdtemp())
    (broken / "lines.json").write_text('[{"text": "x", "topic": "nope", "stage": "open"}]')
    try:
        corpus.load(broken / "lines.json")
        check("a malformed corpus is refused rather than quietly skipped", False,
              "a corpus that drops what it cannot parse has a size that is a lie")
    except Exception:
        check("a malformed corpus is refused rather than quietly skipped", True)
    before_path = corpus.LINES_PATH
    try:
        corpus.LINES_PATH = broken / "lines.json"
        stats = corpus.AudioCache(broken).stats()
        check("but /voice/health still answers, and says what is wrong",
              stats["lines"] == 0 and "error" in stats, str(stats))
    finally:
        corpus.LINES_PATH = before_path

    # AND THE GATEWAY BINDS BEFORE IT LOADS A MODEL. CorpusFiller is constructed inside
    # Dispatcher.__init__, inside Gateway.__init__, before the HTTP listener binds, and
    # the embedding picker's first load is a 123 MB download with no timeout of ours.
    # FORCED TO THE KEYWORD PICKER, and this file's opening promise is why. It says
    # "FAST AND OFFLINE, ALWAYS ... no network", and it runs on every promotion; the
    # first version of this check built through picker_from_config with the shipping
    # default of "embed", so on a machine with model2vec installed and the weights not
    # cached, the merge gate would have reached out to HuggingFace. Raised by review,
    # 2026-09-04. What is under test here is the LAZINESS, not which picker wins, and
    # finding 34 is where that was measured.
    before_picker = config.FILLER_PICKER
    try:
        config.FILLER_PICKER = "keyword"
        lazy_filler = corpus.CorpusFiller(
            lines=corpus.load(), cache=corpus.AudioCache(Path(tempfile.mkdtemp())))
        check("the filler does not build a picker until something is asked of it",
              lazy_filler._picker is None)
        check("and health can say so without building one",
              "not started" in lazy_filler.as_json()["picker"],
              lazy_filler.as_json()["picker"])
        # NEVER WAITS FOR ONE EITHER. The watch thread calls this inline and is the only
        # thing draining Harbor's say inbox, so a picker that is still building must be
        # answered around rather than waited on.
        started = time.time()
        first = lazy_filler.line("what have you got running")
        took = time.time() - started
        check("and the first line is answered without waiting for a build",
              bool(first.text) and took < 1.0, f"it took {took:.2f}s")
        for _ in range(60):
            if lazy_filler._picker is not None:
                break
            time.sleep(0.05)
        check("while the configured picker is built on a thread of its own",
              lazy_filler._picker is not None,
              "it is built in the background so a first install cannot stall a turn")
        # AND THE IN-FLIGHT GUARD IS ENTERED EXACTLY ONCE, however many callers arrive
        # while a build is running. This is the check that would have been red for the
        # blocking finding of review round 3: the guard cleared its own flag, so the
        # second caller during a build turned it off and the third started another one.
        # With `embed` as the default and the repeat filler firing six times a wait, a
        # first install fanned out three or more concurrent 123 MB builds.
        #
        # PINNING TO `keyword` FOR OFFLINE-NESS IS RIGHT AND IT IS WHY THE FIRST VERSION
        # OF THIS TEST COULD NOT SEE IT: keyword builds instantly, so `_picker` was set
        # before any second call and the flag path was never reached. A SLOW builder is
        # what exercises it, so one is injected.
        builds = []
        slow = corpus.CorpusFiller(
            lines=corpus.load(), cache=corpus.AudioCache(Path(tempfile.mkdtemp())))
        real = corpus.picker_from_config

        def slowly(name=None, lines=None):
            builds.append(time.time())
            time.sleep(0.6)
            return real("keyword", lines)

        try:
            corpus.picker_from_config = slowly
            readers = [threading.Thread(target=lambda: slow.picker) for _ in range(8)]
            for t in readers:
                t.start()
            for t in readers:
                t.join()
            check("eight callers during one build start exactly one build",
                  len(builds) == 1,
                  f"{len(builds)} builds were started; the guard is what bounds a "
                  "123 MB load to one")
            check("and health says a build is in flight rather than 'not started'",
                  "building" in slow.as_json()["picker"], slow.as_json()["picker"])
            for _ in range(40):
                if slow._picker is not None:
                    break
                time.sleep(0.05)
            check("and one of them lands", slow._picker is not None)
        finally:
            corpus.picker_from_config = real

        # A NAME NOTHING RECOGNISES SETTLES, AND SAYS SO. It used to raise inside the
        # build thread, be swallowed, and spawn another thread on the next filler line,
        # forever, with health reporting "<typo> (not started)" and nothing saying why.
        config.FILLER_PICKER = "embedd"
        typo = corpus.CorpusFiller(
            lines=corpus.load(), cache=corpus.AudioCache(Path(tempfile.mkdtemp())))
        check("a typo in the picker name still answers", bool(typo.line("hello").text))
        for _ in range(40):
            if typo._picker is not None:
                break
            time.sleep(0.05)
        check("and settles on the keyword picker rather than retrying forever",
              typo._picker is not None and typo._picker.name == "keyword",
              str(typo._picker))
        check("and /voice/health says the name is not a picker",
              "embedd" in typo.as_json()["picker"]
              and "ValueError" in typo.as_json()["picker"],
              typo.as_json()["picker"])
    finally:
        config.FILLER_PICKER = before_picker

    # THE METER. It counts what was SENT, only when the call came back, and it rolls over
    # by calendar month rather than by file age.
    tmp = Path(tempfile.mkdtemp())
    meter = speech.CharacterMeter(tmp / "tts-usage.json")
    meter.add(120, "google")
    meter.add(80, "google")
    rec = meter.as_json()
    check("the meter counts characters and calls", rec["characters"] == 200
          and rec["calls"] == 2, str(rec))
    check("and it says what is left of the free allowance, so nothing has to ask Google",
          rec["freeAllowance"] == 1000000 and rec["remaining"] == 999800, str(rec))
    (tmp / "tts-usage.json").write_text(json.dumps(
        {"month": "1999-01", "characters": 999999, "calls": 5}))
    check("a count from a previous month reads as zero rather than being added to",
          speech.CharacterMeter(tmp / "tts-usage.json").read()["characters"] == 0,
          "the allowance is monthly, so the meter has to be")

    # AND A REFUSED CALL IS NOT BILLED, so it must not be counted, or the meter drifts
    # up every time the network does.
    src = (PKG / "harbor_voice" / "speech.py").read_text()
    body = src.split("class GoogleTTS", 1)[1].split("\nclass ", 1)[0]
    request_at = body.index("audio = self._request")
    count_at = body.index("self.meter.add")
    record_at = body.index("_record_cloud_spend")
    check("the meter is only touched after a call that came back",
          request_at < count_at,
          "counting before the call would bill this machine for the network's failures")
    check("cloud-spend is only told about a call that came back, same rule",
          request_at < record_at,
          "counting before the call would tell cloud-spend about spend that never happened")

    # THE OTHER LEDGER (c-236). segments/cloud-spend read nothing, ever, because nothing
    # called record.py: the process-local meter above and cloud-spend's durable ledger
    # never met. GoogleTTS.synthesize now feeds both.
    check("_voice_tier reads the family out of Google's own naming convention",
          speech._voice_tier("en-IN-Chirp3-HD-Charon") == "chirp3-hd",
          speech._voice_tier("en-IN-Chirp3-HD-Charon"))
    for voice, want in (
            ("en-US-Standard-A", "standard"),
            ("en-US-Neural2-A", "neural2"),
            ("en-US-Wavenet-A", "wavenet"),
            ("en-US-Polyglot-1", "polyglot"),
            ("en-US-Studio-O", "studio"),
            ("en-US-Chirp-HD-D", "chirp-hd")):
        got = speech._voice_tier(voice)
        check(f"{voice!r} -> {want!r}, every tier allowances.json lists",
              got == want, got)

    captured = []

    def fake_record(**kw):
        captured.append(kw)
        return True

    real_lookup = speech._cloud_spend_record
    speech._cloud_spend_record = lambda: fake_record
    try:
        speech._record_cloud_spend(37, "en-IN-Chirp3-HD-Charon")
    finally:
        speech._cloud_spend_record = real_lookup
    check("a synthesis call is handed to cloud-spend's record() with the right shape",
          captured == [{"service": "texttospeech.googleapis.com", "unit": "characters",
                        "amount": 37, "tier": "chirp3-hd", "by": "harbor-voice"}],
          captured)

    # AND A MISSING OR BROKEN cloud-spend SEGMENT MUST NOT SILENCE VOICE, same promise
    # record.py itself makes for its own failures.
    speech._cloud_spend_record = lambda: (_ for _ in ()).throw(RuntimeError("no segment"))
    try:
        speech._record_cloud_spend(10, "en-IN-Chirp3-HD-Charon")
        raised = False
    except Exception:                                                    # noqa: BLE001
        raised = True
    finally:
        speech._cloud_spend_record = real_lookup
    check("a broken cloud-spend lookup is swallowed, not raised", not raised)

    # AND IT ACTUALLY RESOLVES THE REAL FILE, loaded the way every other cross-segment
    # import in this repo is (importlib.util.spec_from_file_location against config.SEGMENTS_DIR),
    # never a bare relative path that could pick up the wrong Harbor from a worktree.
    # The segment is one install's own since c-722 and is not in the code: where the tree read
    # has it, its record() loads; where it has none, the lookup is None, never a raise.
    real_record = speech._cloud_spend_record()
    present = (config.SEGMENTS_DIR / "cloud-spend" / "record.py").exists()
    check("the real cloud-spend record() loads and is callable, or is None with no such segment",
          callable(real_record) if present else real_record is None, real_record)


def corpus_section():
    print()
    print("== the filler is a written corpus now, and repeats are built ==")

    lines = corpus.load()
    check("the corpus is a few hundred lines rather than a handful",
          len(lines) >= 300, f"{len(lines)} lines")
    # THE NUMBER IS LOAD-BEARING IN THIS ONE FILE, because the safety argument is that a
    # person can read the whole set, and review found three comments quoting the DRAFTED
    # count as though it were the shipped one.
    src = (PKG / "harbor_voice" / "corpus.py").read_text()
    check("and corpus.py quotes the shipped count, not the drafted one",
          f"{len(lines)} written lines rendered once" in src
          or f"as {len(lines)} written lines" in src,
          f"the fixture holds {len(lines)}; the module docstring should say so")
    for stage in corpus.STAGES:
        for topic in corpus.TOPICS:
            n = sum(1 for ln in lines if ln.stage == stage and ln.topic == topic)
            check(f"{stage}/{topic} has lines of its own", n >= 15, f"{n} lines")

    # EVERY LINE PASSES THE SCREEN, and this is the whole safety argument: nothing is
    # generated, so nothing can escape, and the set is finite so it was read in full.
    refused = [(ln, corpus.check(ln.text, ln.stage)) for ln in lines]
    refused = [(ln, why) for ln, why in refused if why]
    check("every written line passes the corpus screen", not refused,
          str(refused[:3]))

    # AND THE SCREEN'S ONE EXEMPTION IS NARROW. `still` is allowed in a `hold` line
    # because that line is about the WAIT, which is the one thing a filler may speak
    # about, and its truth is guaranteed by its trigger. It is allowed ONLY when the line
    # passes every other rule with the word removed.
    check("'still on it' is allowed in a hold line",
          corpus.check("still on it.", "hold") == "", corpus.check("still on it.", "hold"))
    check("and refused in an opening one, where nothing has been said yet",
          corpus.check("still on it.", "open") != "")
    for probe, why in (
            ("still the same one from this morning.", "it compares two states"),
            ("still the one you asked about.", "it is not about looking"),
            ("still three of them waiting.", "it carries a count")):
        check(f"the exemption does not reach {probe!r} ({why})",
              corpus.check(probe, "hold") != "", corpus.check(probe, "hold"))

    # THE RULE THE GUARD DID NOT HAVE, FOUND BY READING THE SET. filler.guard passed all
    # 361 written lines; four of them promised an OUTCOME, which is the class that got the
    # model filler scrapped, and they were all "let me <verb>" where the guard's promise
    # rule matches "I'll <verb>".
    for promise in ("let me get that sorted for you.",
                    "right, let me get that handled.",
                    "let me take that in hand.",
                    "right, let me get that actioned for you."):
        check(f"a promise of an outcome is refused: {promise!r}",
              corpus.check(promise, "open") != "",
              "the turn goes to Harbor and Harbor decides, so nothing here can promise")
    check("and the guard alone would have passed every one of them",
          all(filler.guard(t, "", None) == "" for t in
              ("let me get that sorted for you.", "right, let me get that handled.")),
          "which is why the corpus has a screen of its own rather than reusing the guard")

    # PICKING. Never across stages, never the same line twice in one wait, and a topic
    # with a thin pool falls to `general` of the SAME stage rather than to an opener.
    picker = corpus.KeywordPicker(lines)
    for said, want in (("what have you got running", "lookup"),
                       ("should I merge that or not", "judgement"),
                       ("how does that actually work", "explain"),
                       ("what did I ask you yesterday", "recall")):
        check(f"{said!r} reads as {want}", picker.topic(said) == want,
              picker.topic(said))
    for stage in corpus.STAGES:
        picked = picker.pick("what have you got running", stage)
        check(f"a {stage} pick is a {stage} line", picked.stage == stage,
              repr(picked))
    said = "what have you got running"
    seen, avoid = [], set()
    for _ in range(6):
        got = picker.pick(said, "hold", avoid)
        seen.append(got.text)
        avoid.add(got.text)
    check("six lines into one wait, none of them repeats",
          len(set(seen)) == 6, str(seen))

    # THE HELD-OUT SET, kept as the regression guard. Scored on the keyword picker here
    # because this file is offline and instant by contract; the embedding comparison is
    # bin/keel-voice-corpus score, which loads a model.
    heldout = json.loads((PKG / "harbor_voice" / "fixtures"
                          / "picker_heldout.json").read_text())
    check("the held-out picker set is here and labelled", len(heldout) >= 100,
          f"{len(heldout)} rows")
    check("and none of it was written against the keyword list",
          all(r.get("topic") in corpus.TOPICS for r in heldout))
    right = sum(1 for r in heldout
                if corpus.topic_by_keyword(r["said"]) == r["topic"])
    check(f"the keyword picker still scores at least 60 of {len(heldout)} on it",
          right >= 60, f"it scored {right}; measured at 65 when this shipped")

    # THE RENDERED AUDIO IS A CACHE AND A MISS IS NOT AN ERROR. A fresh checkout has no
    # clips until `keel-voice-corpus render` runs, and the wait is still filled.
    tmp = Path(tempfile.mkdtemp())
    cache = corpus.AudioCache(tmp)
    check("an unrendered line reads as no audio rather than raising",
          cache.read("nothing has ever rendered this") == b"")
    cache.write("give me a moment.", b"\x01\x00" * 2400)
    check("a rendered line comes back as PCM", len(cache.read("give me a moment.")) == 4800)
    check("and a different voice does not play the old clip",
          cache.read("give me a moment.", voice="some-other-voice") == b"",
          "a rendered clip belongs to the voice that spoke it")

    # THE KEY NAMES THE ENGINE AS WELL AS THE VOICE, and that was a bug rather than a
    # nicety. The first corpus render went through the chain, Google refused part way
    # (355 calls back to back), the chain degraded to kokoro exactly as it is built to,
    # and 205 clips were written under a key naming Charon. They would have played back
    # in the wrong voice forever, because a cache hit asks no questions. Caught by
    # reading the character meter: 150 vendor calls for 355 rendered lines.
    check("the voice a clip belongs to names its engine",
          speech.preferred_voice_id().startswith("google:"),
          speech.preferred_voice_id())
    before_chain = config.TTS_CHAIN
    try:
        config.TTS_CHAIN = ["kokoro", "say"]
        check("and it changes when the preferred engine does",
              speech.preferred_voice_id() == f"kokoro:{config.TTS_VOICE}",
              speech.preferred_voice_id())
        check("so a clip rendered by another engine simply misses",
              cache.read("give me a moment.") == b"",
              "a miss costs one ordinary synthesis; a wrong hit costs the wrong voice")
    finally:
        config.TTS_CHAIN = before_chain

    # AND THE RENDER REFUSES TO DEGRADE, which is the opposite of what a spoken turn
    # must do. Degrading during a turn saves the answer; degrading during a render
    # writes a clip that is then played forever.
    render_src = (HERE / "keel-voice-corpus").read_text()
    check("the render drives one engine rather than the chain",
          "chain._build(want)" in render_src and "REFUSING" in render_src,
          "the chain answers with whatever is up, which is right for a turn and wrong "
          "here: a clip in the wrong voice is played forever")
    check("and it checks its own call count against the clip count afterwards",
          "calls_here != made" in render_src,
          "one call to the preferred engine per clip, or something else spoke")
    check("counting its own calls rather than reading the shared meter",
          "calls_here += 1" in render_src,
          "the meter is process-wide, so anything else speaking lands in its delta: "
          "a live test spoke during a render and the check cried degradation over noise")

    # THE BACKEND THE DISPATCHER HOLDS, and the one thing it must not do is hold a model.
    corpus_filler = corpus.CorpusFiller(picker=picker, lines=lines, cache=cache)
    result = corpus_filler.line("what have you got running")
    check("the corpus filler answers with a written line", bool(result.text), str(result))
    check("and says where it came from", result.source.startswith("corpus/"),
          result.source)
    check("and it holds no model", corpus_filler.resident is False)


def repeat_section():
    print()
    print("== the wait speaks again, on a constant that nothing used to read ==")

    # THE BUG THIS SECTION EXISTS FOR. config.FILLER_REPEAT_EVERY has been in this
    # package since the filler shipped, documented as the value that holds the decision,
    # and NOTHING READ IT: setting it did nothing, silently, which is worse than not
    # having it at all.
    source = (PKG / "harbor_voice" / "dispatcher.py").read_text()
    check("the dispatcher actually reads FILLER_REPEAT_EVERY",
          "FILLER_REPEAT_EVERY" in source,
          "it was documented for a day and never read, which is how a switch becomes a lie")

    class Counting:
        """A filler that answers instantly and records which stage it was asked for."""

        name = "counting"
        resident = False

        def __init__(self):
            self.asks = []

        def line(self, said, doc=None, stage="open", avoid=()):
            self.asks.append((stage, tuple(sorted(avoid))))
            return filler.Result(f"{stage} line {len(self.asks)}", "test", 0.0,
                                 "", "")

    doc = fixture()
    spoken, model = [], Counting()
    d = _dispatcher(doc, spoken, deliver=FakeDeliver(True, "delivered"),
                    filler_model=model)
    before = config.FILLER_REPEAT_EVERY
    try:
        config.FILLER_REPEAT_EVERY = 0.5
        d.answer("what do you make of all that")
        time.sleep(1.7)
    finally:
        config.FILLER_REPEAT_EVERY = before
        d.generation += 1               # end the watch thread

    stages = [stage for stage, _ in model.asks]
    check("the wait speaks more than once", len(stages) >= 2, str(stages))
    check("the first line is an opener", stages[:1] == ["open"], str(stages))
    check("and every one after it is a hold line, not another opener",
          set(stages[1:]) == {"hold"}, str(stages))
    check("and each one is told what has already been said, so it does not repeat",
          all(avoid for _stage, avoid in model.asks[1:]),
          str(model.asks))
    heard = [text for _gen, text, _s in spoken]
    check("all of them were actually spoken", len(heard) >= 2, str(heard))
    check("and no line was spoken twice", len(set(heard)) == len(heard), str(heard))

    # AND IT STOPS, TWICE OVER. The first version ran to TURN_MAX_SECONDS (600 s), so a
    # ten minute wait would have heard about seventy-four lines, and it talked straight
    # through the ninety second line that says "I'll answer in text instead". Raised by
    # review, 2026-09-04.
    spoken3, model3 = [], Counting()
    d3 = _dispatcher(doc, spoken3,
                     deliver=FakeDeliver(True, "delivered"), filler_model=model3)
    before_every = config.FILLER_REPEAT_EVERY
    before_limit = config.FILLER_REPEAT_LIMIT
    try:
        # THE WINDOW HAS TO OUTRUN THE LOOP, and the first version of this did not. The
        # watch loop sleeps 0.4 s a pass, so a 1.6 s window can only fire four times
        # whatever the limit is, and a test that cannot tell three from four does not
        # test the cap. Two over two and a half seconds is six possible fires against a
        # limit of two, which it can.
        config.FILLER_REPEAT_EVERY = 0.1
        config.FILLER_REPEAT_LIMIT = 2
        d3.answer("what do you make of all that")
        time.sleep(2.6)
        holds = [stage for stage, _ in model3.asks if stage == "hold"]
        check("the wait speaks again a bounded number of times",
              len(holds) == 2,
              f"it spoke {len(holds)} hold lines against a limit of 2 in a window with "
              "room for six; unbounded, a ten minute wait speaks about seventy-four")
    finally:
        config.FILLER_REPEAT_EVERY = before_every
        config.FILLER_REPEAT_LIMIT = before_limit
        d3.generation += 1

    spoken4, model4 = [], Counting()
    d4 = _dispatcher(doc, spoken4,
                     deliver=FakeDeliver(True, "delivered"), filler_model=model4)
    before_every = config.FILLER_REPEAT_EVERY
    before_giveup = config.NARRATE_GIVE_UP_AT
    try:
        config.FILLER_REPEAT_EVERY = 0.15
        config.NARRATE_GIVE_UP_AT = 0.3
        d4.answer("what do you make of all that")
        time.sleep(1.4)
        heard4 = [text for _gen, text, _s in spoken4]
        gave_up = dispatcher.NARRATION["giveup"]
        check("and it goes quiet once it has said it will answer in text instead",
              gave_up in heard4 and heard4[-1] == gave_up,
              f"after {gave_up!r} it said: {heard4[heard4.index(gave_up) + 1:]}"
              if gave_up in heard4 else str(heard4))
    finally:
        config.FILLER_REPEAT_EVERY = before_every
        config.NARRATE_GIVE_UP_AT = before_giveup
        d4.generation += 1

    # AND IT STOPS WHEN HE MOVES ON. A held turn is one he has already left; speaking
    # about its wait would be talking over the turn he is having now.
    spoken2, model2 = [], Counting()
    d2 = _dispatcher(doc, spoken2,
                     deliver=FakeDeliver(True, "delivered"), filler_model=model2)
    before = config.FILLER_REPEAT_EVERY
    try:
        config.FILLER_REPEAT_EVERY = 0.5
        d2.answer("what do you make of all that")
        d2.generation += 5              # he asked something else
        settled = len(model2.asks)
        time.sleep(1.4)
        check("a wait he has moved on from stops speaking",
              len(model2.asks) == settled, str(model2.asks))
    finally:
        config.FILLER_REPEAT_EVERY = before


def resident_section():
    print()
    print("== with the lookup tier gone, nothing loads a model ==")

    check("the filler ships as the written corpus",
          config.FILLER_BACKEND == "corpus", config.FILLER_BACKEND)
    check("the shipped filler holds nothing in memory",
          getattr(filler.from_config(), "resident", True) is False)

    # THE LOOKUP TIER IS NOT BEHIND A FLAG ANY MORE, it is gone, and that is what this
    # asserts: no module, no scorer, no fixtures, and no environment variable that would
    # bring any of them back.
    for gone in ("router.py", "args.py", "fixtures/heldout.json",
                 "fixtures/conversations_e.json", "fixtures/index_snapshot.json"):
        check(f"{gone} is deleted rather than switched off",
              not (PKG / "harbor_voice" / gone).exists(),
              "decision D4, 2026-09-18")
    for gone in ("keel-voice-router-score", "keel-voice-conversation-score"):
        check(f"bin/{gone} is deleted with the tier it scored",
              not (HERE / gone).exists(), "")
    cfg_src = (PKG / "harbor_voice" / "config.py").read_text()
    check("and no ROUTER_ setting is left for anything to read",
          not any(f"\n{key} =" in cfg_src for key in
                  ("ROUTER_BACKEND", "ROUTER_MODEL", "ROUTER_URL", "ROUTER_TIMEOUT",
                   "ROUTER_WARM_EVERY", "ROUTER_KEEP_ALIVE", "ROUTER_MAX_TOKENS",
                   "ROUTER_CONTEXT_TURNS", "ROUTER_CONTEXT_MODE", "CONTEXT_MEMORY")),
          "a switch nothing reads is worse than no switch")

    # AND THE STRUCTURAL ONE: with the shipped configuration, starting up and answering a
    # turn must not reach ollama at all. Not "must not use it", must not CALL it.
    import urllib.request as urlreq
    calls = []
    real = urlreq.urlopen

    def refuse(req, *a, **kw):
        calls.append(getattr(req, "full_url", str(req)))
        raise AssertionError("nothing may reach the network here")

    doc = fixture()
    spoken = []
    tmp = Path(tempfile.mkdtemp())
    try:
        urlreq.urlopen = refuse
        fil = filler.from_config()
        # ISOLATED INBOXES: left to their defaults, `inbox`, `progress_inbox` and
        # `open_inbox` are the real harbormsg.SAY_DIR/PROGRESS_DIR/OPENING_DIR under
        # state/voice. This selftest runs on every `make test`; it must not read or
        # delete a live gateway's pending lines.
        d = Dispatcher(_Snapshot(doc), busmod.Bus(),
                       lambda text, gen, spk=None: spoken.append(text),
                       SayInbox(tmp / "say"), tmp / "transcript.jsonl",
                       deliver=FakeDeliver(True, "delivered"), filler_model=fil,
                       progress_inbox=SayInbox(tmp / "progress"),
                       open_inbox=SayInbox(tmp / "opening"))
        turn = d.answer("what have you got running")
        d.generation += 1
    finally:
        urlreq.urlopen = real
    check("a whole turn makes no network call at all", not calls, str(calls))
    check("and the turn still reached the model, which is where it belongs",
          turn.tier == "harbor", turn.tier)

    # THE GATEWAY SAYS SO ON /voice/health, so it can be read rather than inferred
    # from `top`.
    source = (PKG / "harbor_voice" / "server.py").read_text()
    check("the gateway reports what it is holding resident", '"resident"' in source)
    check("and it does not start a warm loop when nothing wants warming",
          "if self.resident():" in source,
          "a warm loop that runs anyway is what would pull 4.7 GB back in after boot")


class _Snapshot:
    """The document, already healthy. The real one polls a server."""

    def __init__(self, doc):
        self.doc = doc
        self.healthy = True
        self.age = 0.0
        self.error = ""


def authority_section():
    print()
    print("== voice reads state, and acts once: his answer to one of Bosun's asks ==")
    package = PKG / "harbor_voice"
    sources = {p.name: p.read_text() for p in package.glob("*.py")}
    sources["keel-voice"] = (HERE / "keel-voice").read_text()
    sources["keel-voice-gateway"] = (HERE / "keel-voice-gateway").read_text()
    sources["app.js"] = page_js(HERE.parent)

    def code_only(text: str, js: bool) -> str:
        """Comments stripped, so a line SAYING it never calls /api/action is not read as
        a call to it. Crude, and crude is right: a stricter parser here would be a
        dependency in a guard whose whole job is to be simple enough to trust."""
        blob = text
        # Block comments first, because a line in the MIDDLE of one does not start with
        # any marker at all, which is exactly how this guard first went red on its own
        # docstring.
        for open_, close_ in (('"""', '"""'), ("/*", "*/")):
            while open_ in blob:
                i = blob.index(open_)
                j = blob.find(close_, i + len(open_))
                if j < 0:
                    blob = blob[:i]
                    break
                blob = blob[:i] + blob[j + len(close_):]
        keep = []
        for line in blob.splitlines():
            stripped = line.strip()
            if stripped.startswith("#") or stripped.startswith("//"):
                continue
            keep.append(line.split("  # ")[0].split("  // ")[0])
        return "\n".join(keep)

    def action_offenders(texts: dict) -> list:
        """Every source that CALLS /api/action, except the one call site the design allows
        (c-523): the page's `ANSWER_SITE`, one call, posting the Console's answer body with
        `voice: true`. Anything else, a second call anywhere or that one changed into
        another verb, is an offender."""
        out = []
        for name, text in texts.items():
            code = code_only(text, name.endswith(".js"))
            calls = code.count("/api/action")
            if not calls:
                continue
            if name == "app.js" and calls == 1 and answer_site_ok(code):
                continue
            out.append(name)
        return out

    def answer_site_ok(code: str) -> bool:
        start = code.find(ANSWER_SITE)
        if start < 0:
            return False
        end = code.find("\n  }", start)
        body = code[start:end if end > 0 else len(code)]
        return ("/api/action" in body and 'sub: "answer"' in body
                and "voice: true" in body and 'verb: "console"' in body)

    offenders = action_offenders(sources)
    check("the voice front end CALLS /api/action only at the page's answer to Bosun",
          not offenders, f"a call outside {ANSWER_SITE} (or a changed one) in {offenders}")
    # AND THE GUARD STILL BITES: a second call site, or the allowed one turned into another
    # verb, goes red. Proved on copies, so this run's real sources are never touched.
    second = dict(sources, **{"app.js": sources["app.js"]
                              + '\nfetch("/api/action", { method: "POST" });\n'})
    other = dict(sources, **{"app.js": sources["app.js"].replace(
        'sub: "answer"', 'sub: "raise"')})
    check("and a second call site, or the allowed one changed, still goes red",
          action_offenders(second) == ["app.js"] and action_offenders(other) == ["app.js"],
          "the narrowed guard let one through")

    # THE POINT OF THIS ONE. It is grep-able on purpose: the authority table says voice
    # READS the board and never acts on it, and a rule that can only be checked by
    # reading is a rule that drifts. The reading used to be an HTTP endpoint; it is now
    # `kb`, which is the board's own read tool, and `kb`'s writing verbs are not here.
    check("and the way it reads the board is `kb`, named in one place",
          "KB = KEEL_HOME" in sources["config.py"]
          and 'ASKED_HOME = Path(os.environ.get("KEEL_HOME"' in sources["config.py"]
          and "KEEL_HOME = CHECKOUT if BORROWED_HOME else ASKED_HOME" in sources["config.py"],
          "the home is read from the environment in one place, and the guard that may "
          "refuse it sits on the same line as the answer")
    snap = code_only(sources["snapshot.py"], False)
    check("and it only ever asks `kb` to LIST, never to change anything",
          '_kb("list")' in snap and '_kb("needs-you")' in snap
          and not any(f'_kb("{verb}' in snap for verb in
                      ("new", "add", "move", "stage", "approve", "block", "note",
                       "archive", "delete")),
          "voice reads the board and never changes it through kb")
    check("and the old HTTP route to a dashboard is gone rather than left dangling",
          "/api/state" not in sources["config.py"]
          and "urllib" not in code_only(sources["snapshot.py"], False),
          "nothing in this package opens a socket to read the board any more")

    for forbidden, why in (("harbor-promote", "promoting is never voice's"),
                           ("--approved", "that word is the human's"),
                           ("harbor-spawn", "voice never starts a session itself"),
                           ("git ", "voice has no repository")):
        offenders = [n for n, t in sources.items() if forbidden in t and n != "verbs.py"]
        check(f"nothing in the voice front end reaches for {forbidden!r} ({why})",
              not offenders, f"found in {offenders}")

    # THIS CHECK USED TO READ "there is no paid model anywhere in this package" and it
    # was still passing on 2026-09-04, by accident, after the voice became a hosted one.
    # The header Google wants is `X-Goog-Api-Key`, which is none of the four strings it
    # looked for, so a check whose stated meaning was "the code cannot reach a vendor"
    # went green over a package that now reaches one on every spoken turn. A green check
    # whose sentence is untrue is worse than no check, so it is split into the two things
    # that ARE true and are worth defending.
    #
    # ONE: NO MODEL IS PAID FOR, ANYWHERE. Nothing here sends a prompt to a vendor.
    # Routing and the filler are local or they do not happen, which is the custody line
    # findings 11 to 15 drew and it has not moved.
    for name, text in sources.items():
        if not name.endswith(".py"):
            continue
        body = code_only(text, False).lower()
        offenders = [w for w in ("anthropic", "openai", "api.groq", "generativelanguage")
                     if w in body]
        check(f"{name} sends no prompt to a vendor", not offenders,
              f"found {offenders}: findings 11 to 15 rejected hosted routing")

    # TWO: THE ONE VENDOR CALL IS THE VOICE, AND ITS KEY IS NEVER IN A URL. A urllib
    # exception carries the URL it failed on, and a URL is where an API key gets leaked
    # by accident, so the key travels in a header and this asserts that it still does.
    speech_src = sources["speech.py"]
    check("the hosted voice is the only thing in this package that calls a vendor",
          speech_src.count("texttospeech.googleapis.com") == 1
          and "texttospeech" not in "".join(t for n, t in sources.items()
                                            if n != "speech.py"),
          "if a second vendor call appears, the custody decision needs re-taking")
    check("and its key travels in a header, never in a URL",
          "X-Goog-Api-Key" in speech_src and "?key=" not in speech_src,
          "a urllib exception carries the URL, which is how a key leaks by accident")
    check("the key is read from the keychain or the systemd credential, and from nowhere else",
          "find-generic-password" in speech_src
          and "GOOGLE_TTS_KEYCHAIN" in sources["config.py"]
          and 'os.environ.pop("CREDENTIALS_DIRECTORY"' in sources["config.py"]
          and "CREDENTIALS_DIRECTORY" not in speech_src.replace("config.CREDENTIALS_DIRECTORY", ""),
          "never an environment variable, never a file of its own, never a fixture")
    # `self.key` MEANS EXACTLY ONE THING IN THIS PACKAGE and it is a credential, so
    # the check is that it never appears outside a class that holds one. A second
    # meaning for the word would be a second place somebody has to look before believing
    # the key is where it is said to be; corpus.Line's cache key is called `audio_key`
    # for that reason and no other.
    #
    # THERE ARE TWO KEYS SINCE c-313: the Google TTS key in speech.py and the judges' Jev
    # key in jev.py. The second one widens this rule rather than being excused from it,
    # because the custody claim is about the package and not about one file.
    key_holders = {"speech.py": ("GoogleTTS", "ElevenLabsTTS"), "jev.py": ("Jev",)}
    for name, classes in key_holders.items():
        source = sources[name]
        inside = "".join(class_body(source, cls) for cls in classes)
        check(f"{name}: the credential attribute appears only inside the classes that hold one",
              source.count("self.key") == inside.count("self.key"),
              "a second use of the word is a second place somebody has to look")
    for name, text in sources.items():
        if name in key_holders:
            continue
        check(f"{name} never touches a key at all", "self.key" not in text,
              "a key is held in memory by one object and read by one method")

    # THE JUDGES' KEY, BY THE SAME RULE AS THE GOOGLE ONE (c-313). It is the same custody
    # question asked of the second vendor: one place per machine, a header rather than a
    # URL, and nothing in the package that could print it.
    jev_src = sources["jev.py"]
    check("the Jev key is read from the keychain or the systemd credential, and nowhere else",
          "find-generic-password" in jev_src
          and "JEV_KEYCHAIN" in sources["config.py"]
          and "JEV_CREDENTIAL" in sources["config.py"]
          and "os.environ.get" not in jev_src,
          "never an environment variable, never a file of its own, never a fixture")
    check("and it travels in an Authorization header, never in a URL",
          "Authorization" in jev_src and "?key=" not in jev_src and "key=" not in jev_src,
          "a urllib exception carries the URL, which is how a key leaks by accident")
    check("no module but jev.py names the judges' credential",
          all("JEV_CREDENTIAL" not in text for name, text in sources.items()
              if name not in ("jev.py", "config.py")),
          "one reader, one constant, one place to look")


