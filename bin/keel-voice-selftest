gw.talk = servermod.Conversation()
gw.snapshot = type("Snap", (), {"doc": {"cards": [
    {"id": "c-901", "title": "Run the long route", "space": "personal", "stage": "building"},
    {"id": "c-902", "title": "Somebody else's title", "space": "work", "stage": "building"},
    {"id": "c-903", "title": "Finished thing", "space": "personal", "stage": "done"}]}})()
menu = drive(gateway=gw)
asked = menu["sent"][0]["questions"] if menu["sent"] else {}
