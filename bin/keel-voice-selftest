failures = []


# THE ONE PLACE THE VOICE FRONT END MAY CALL /api/action (c-523, BO-5): the page's own
# post of his answer to one of Bosun's asks, `voice: true`, which the deck refuses on any
# other body (`keel/actions.py` voice_answer). Named here and nowhere else.
ANSWER_SITE = "function recordAnswer(msg) {"


def page_js(home: Path) -> str:
    """The voice page's scripts as one text, in the order index.html loads them (VP-6).

    The page is several files sharing `window.Voice` since the rebuild, so a text check
    about the page reads all of them, as `tests/voicepage.py` does for the stdlib suite."""
    app = home / "segments" / "voice" / "app"
    names = re.findall(r'<script src="([^"/][^"]*)"', (app / "index.html").read_text())
    return "\n".join((app / name).read_text() for name in names)


def check(name, ok, detail=""):
    print(f"  {'ok  ' if ok else 'FAIL'}  {name}"
          + (f"\n          {detail}" if detail and not ok else ""))
    if not ok:
        failures.append(name)


def never_says(name, sentence, forbidden):
    check(name, forbidden.lower() not in sentence.lower(),
          f"it said: {sentence!r}")


# --------------------------------------------------------------------------- #
# The deck's state document, as a fixture and as a real loopback server.
#
# THE DIGEST IS OF THE DECK SINCE 2026-09-18 (decision V16), so the thing to defend is no
# longer "the board document has the right keys": it is that what the deck SHOWS and what
# a Harbor may SAY are the same set of facts. The failure that caused this was exactly
# that gap, and it was silent: the deck was serving `providers.work.reviews` while the
# digest hard-coded an empty list, so a question about the PR Review screen came back
# "that is on the work side and I cannot reach it".
#
# A REAL SERVER ON A REAL LOOPBACK PORT, not a monkeypatched fetch, for the same reason
# the board section shells out to a stub `kb` rather than patching `subprocess`: the
# boundary being crossed is the thing worth defending, and it is offline either way.
# --------------------------------------------------------------------------- #

def deck_state() -> dict:
    """A document shaped like `GET /api/state`, with bodies in it that must not survive.

    No employer vocabulary: `make test` greps every tracked file outside `packs/work/`
    against `packs/work/drift-terms`, so the repos and keys here are invented.
    """
    def card(cid, space, stage, title, updated, needs_you=False, archived=False, blocked=""):
        return {"id": cid, "space": space, "stage": stage, "title": title, "topic": "",
                "repo": None, "updated_at": updated, "blocked_reason": blocked,
                "brief": "a card body nobody should ever hear read out loud",
                "derived": {"archived": archived, "needs_you": needs_you, "backlog": False,
                            "plan_gate": needs_you, "outcome_gate": False}}

    # A REVIEW CARD (lane RC) is what the deck's Reviews list shows since 2026-09-24: one
    # card per colleague's pull request, its repo on the card, `derived.review` the one
    # word it stands at, and its findings as the outcome. The findings and the pull
    # request's description are bodies, so both are here to prove they never survive.
    def review(cid, stage, word, title, repo, number, updated):
        row = card(cid, "work", stage, f"Review: {title}", updated)
        row["repo"] = repo
        row["brief"] = "a pull request description nobody should ever hear read out loud"
        row["outcome"] = "a review body nobody should ever hear read out loud"
        row["options"] = {"review_key": f"{repo}:{number}",
                          "review_pr": {"description": "another body"}}
        row["derived"]["review"] = word
        return row

    # A WORK CARD WHOSE PULL REQUEST IS OPEN (lane SHIP) is how a work pull request reaches
    # a Harbor since the PRs page went (lane RETIRE, RT-1): the watcher's facts ride on the
    # card's own row. A waiting comment is a body, so one is here to prove it never survives.
    def shipping(cid, title, updated):
        row = card(cid, "work", "shipping", title, updated)
        row["repo"] = "engine"
        row["options"] = {"pr": 41, "shipping": {
            "pending": [{"kind": "comment", "handle": "c9",
                         "text": "a reviewer comment nobody should ever hear read out loud"}],
            "facts": {"state": "open", "comments": 3, "approvals": 1, "ci": "passed",
                      "behind": 2, "waiting": 1}}}
        return row
    return {
        "now": "2026-09-18T02:30:00+05:30",
        "cards": [
            card("c-101", "personal", "inbox", "rewire the porch light", "2026-09-18T01:00:00+05:30"),
            card("c-102", "personal", "building", "the deck redesign", "2026-09-17T09:00:00+05:30"),
            card("c-103", "work", "review", "the export button does nothing", "2026-09-18T02:00:00+05:30"),
            card("c-104", "work", "planning", "a gate nobody answered", "2026-09-18T02:10:00+05:30",
                 needs_you=True),
            card("c-105", "personal", "done", "an archived one", "2026-09-01T00:00:00+05:30",
                 archived=True),
            review("c-106", "inbox", "waiting", "widget list drops its second page", "widgets", 101,
                   "2026-09-18T01:50:00+05:30"),
            review("c-107", "assigned", "reviewing", "retries never back off", "engine", 102,
                   "2026-09-18T01:40:00+05:30"),
            shipping("c-108", "back off on the third retry", "2026-09-18T00:30:00+05:30"),
        ],
        "needs_you": ["c-104"],
        "houses": ["c-102"],
        "running": ["c-102"],
        "backlog": [],
        "drain": {"host": "here", "text": "drain: houses=1 reviews=0 started=1", "alive": True},
        "segments": [{"name": "daybook",
                      "summary": {"tiles": [{"label": "New since last look", "value": "4"}]}}],
        "spaces": {
            "personal": {"name": "personal", "topics": ["deck", "keel"],
                         "counts": {"cards": 3, "needs_you": 0, "backlog": 0}},
            "work": {"name": "work", "topics": ["widgets"],
                     "counts": {"cards": 4, "needs_you": 1, "backlog": 0}},
        },
        "providers": {"work": {
            # THE OLD SCANNER'S ROUTE, which the adapter still serves: since lane RC the
            # review cards above are the Reviews list, so none of this may reach a Harbor.
            "reviews": {"route": "reviews", "columns": ["detected", "inbox"], "hidden": 9,
                        "items": [
                            {"key": "review:a-901", "title": "a stale scanner row",
                             "repo": "widgets", "kanbanState": "inbox",
                             "findings": "a scanner body nobody should ever hear"}]},
            # THE RETIRED PULL REQUEST WATCH'S ROUTE (lane RETIRE), as an older deck or a
            # stale push could still carry it: none of it may reach a Harbor either.
            "prs": {"route": "prs", "columns": ["open", "behind"], "hidden": 1,
                    "items": [
                        {"pr": 42, "story": "t-22", "title": "a stale watcher row",
                         "repo": "widgets", "kanbanState": "behind"}]},
        }},
        "config": {"houses_max": 3},
    }


def serve_state(state: dict):
    """A loopback HTTP server answering `/api/state` with `state`. Returns (port, stop)."""
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    body = json.dumps(state).encode()

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):                                               # noqa: N802
            if self.path.split("?")[0] != "/api/state":
                self.send_response(404)
                self.end_headers()
                return
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):                                   # the live log stays clean
            pass

    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()

    def stop():
        server.shutdown()
        server.server_close()

    return server.server_address[1], stop


# --------------------------------------------------------------------------- #
# A document shaped like the real one, carrying the exact traps that were fallen into.
# --------------------------------------------------------------------------- #

def fixture() -> dict:
    now = time.strftime("%Y-%m-%dT%H:%M:%S+05:30")
    return {
        "harbor": {"running": True, "session": "harbor", "remote": "https://example/x"},
        "counts": {"running": 2, "rooms": 1, "work": 8, "notices": 2,
                   "now": 2, "alert": {"now": True, "rooms": False, "running": False}},
        "generatedAt": now,
        # THE TRAP FROM FINDING 5. Every pending entry here is `kind: notice`, and two of
        # them plainly need a person: one is marked by_hand and one says an approval
        # could not be resolved. A renderer that reads `kind` as "does this need him"
        # says "nothing needs a decision" against this document.
        "queue": [
            {"index": 1, "status": "pending", "kind": "notice", "folded": False,
             "what": "The desktop room view is drawn, and it wants four answers",
             "summary": "Four questions, each with a recommendation, on the surface.",
             "by_hand": "answer on the surface", "at": now},
            {"index": 2, "status": "pending", "kind": "notice", "folded": False,
             "what": "could not approve entry room-view-desktop-mock",
             "summary": "The approval was staged but nothing resolved it.", "at": now},
            {"index": 3, "status": "pending", "kind": "notice", "folded": True,
             "what": "an old notice nobody has read", "summary": "", "at": now},
            # `what` is stored already cut at about 64 characters, which is how the probe
            # came to read "...ends a dispatch's room membership too, s" out loud.
            # `by_hand` is REALISTIC here, not incidental: `harbor-queue add` has always
            # required a non-notice entry to carry on_approve, by_hand or choices (the
            # "must actuate, or say it cannot" gate), so a bare `kind: approval` with
            # none of those could never actually exist on a real queue. Without it,
            # c-118's payload-derived qsection correctly read this entry as carrying
            # nothing at all and folded it in with the notices, which is what the fixture
            # itself was wrong about, not the fold.
            {"index": 4, "status": "pending", "kind": "approval", "folded": False,
             "what": "merge: harbor-close ends a dispatch's room membership too, s",
             "summary": "The graph stops claiming a member is live after its dispatch "
                        "was closed.", "by_hand": "needing your own hands to merge it",
             "at": now},
            {"index": 5, "status": "resolved", "kind": "approval", "what": "gone", "at": now},
        ],
        "running": [
            {"id": "aaaa1111" * 4, "name": "voice front end: the build", "state": "working",
             "space": "personal", "room": "voice-front-end", "member": "build", "at": now},
            {"id": "bbbb2222" * 4, "name": "voice front end: the mockup", "state": "idle",
             "space": "personal", "room": "voice-front-end", "member": "mock", "at": now},
        ],
        "rooms": [
            {"key": "voice-front-end", "retired": False,
             "members": [{"name": "build", "state": "running"},
                         {"name": "plan", "state": "done", "ended": True}]},
            # A finished room with nobody live. The probe counted this as open and said
            # five rooms were open when one was.
            {"key": "room-view-desktop", "retired": True,
             "members": [{"name": "mock", "state": "done", "ended": True}]},
            {"key": "contract-drift", "retired": False,
             "members": [{"name": "auditor", "state": "done", "ended": True}]},
        ],
        "reviews": [{"key": "abc", "title": "voice ui", "agent": "listening"}],
        # The list is CAPPED by the view at 8, and the board had 30 that morning. The
        # probe read the capped length and spoke it as the size of the board.
        "work": {"connected": True, "adapter": "acme",
                 "items": [{"title": f"item {i}", "why": "parked at review"}
                           for i in range(8)]},
        "usage": {"available": True, "today": {"date": "2026-09-03", "cost": 22.27,
                                               "tokens": 1, "msgs": 40, "sessions": 3},
                  "week": {"cost": 100.5}},
        # The briefing opens with Harbor's own standing instructions, by construction,
        # so any "first N lines" rule reads them out as if they were news.
        "briefing": "# Briefing, Tuesday 01 September 2026, 07:12 IST\n\n"
                    "Standing context. Read it, hold it, do not summarise it back.\n\n"
                    "## Running now (0)\n\nNothing is running.\n\n"
                    "## Waiting on you (2)\n\n- a thing\n\n## Segments\n",
        "segments": [{"name": "daybook", "tiles": [{"label": "New", "value": "10"}]}],
    }


