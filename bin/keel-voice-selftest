out["c552_menu"] = sorted((asked.get("card") or {}).get("criteria") or {})
out["c552_facts"] = menu["log"][0].get("facts") if menu["log"] else {}
out["c552_questions"] = menu["log"][0].get("questions") if menu["log"] else None
out["c552_rule"] = menu["log"][0].get("rule") if menu["log"] else {}
# the cut is taken through the real `barged_in`, as the socket's `start` and `cut` do
gw.bus = type("Bus", (), {"state": "speaking"})()
gw.dispatcher.turn = type("Turn", (), {"id": "t-cut"})()
config.JUDGES_LOG.unlink(missing_ok=True)
