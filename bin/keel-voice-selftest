#!/usr/bin/env python3
"""keel-voice-selftest - what the voice front end promises, exercised.

FAST AND OFFLINE, ALWAYS. No ollama, no speech model, no board, no network. That is not
modesty about scope, it is what makes this runnable on every `make test` inside a
throwaway worktree. The one thing it cannot check that way is the filler model under
attack, and that has its own command (bin/keel-voice-filler-score) because hundreds of
sequential model calls take minutes and a three-minute gate is a gate people learn to
skip.

WHAT IT GUARDS, and every one of these is a bug that was actually made:

  THE ONE CODE-RENDERED ANSWER, AND THE SENTENCE IT MUST NEVER SPEAK. An early probe
  ran the renderer against the real document and it said "Nothing needs a decision" while
  two entries needed one, because every pending entry carried kind "notice" and the CODE
  turned that field into a judgement it does not carry. Code-rendering stops the model
  inventing a fact; it does not stop the code inventing one. The repair has a test here,
  written as the sentence that must never come back, and so does the phrase table that
  decides whether that answer is even reached.

  THE FAILURE DIRECTION. A board read that refuses, a fold that raises, a sentence that
  renders empty: every one has to reach Harbor. A single path from any of those to a
  guessed answer is the whole design failing, quietly, in the direction that costs
  trust.

  THE GENERATION COUNTER. A turn he interrupted must not be able to speak over the one he
  is having now. Without it the dead turn's stop signal races in and kills the new answer,
  which is the prior art's hardest-won bug.

  THE BUS CONTRACT. A waveform younger than 0.6 s overrides the state word to speaking,
  and level is mean(|samples|)/3000 capped at 1. Those two are what let any face built
  against ai-visualizer run against this unmodified, so they are asserted as arithmetic
  rather than trusted as a comment.

  THE WEBSOCKET'S THREE LENGTH ENCODINGS. A reader that only handles the inline one works
  perfectly on every control message and then corrupts the first real utterance, because
  audio frames are always in the other two.
"""
from __future__ import annotations

import array
import datetime
import json
import os
import re
import shutil
import socket
import sqlite3
import struct
import subprocess
import urllib.error
import sys
import tempfile
import threading
import time
import tomllib
from datetime import datetime, timedelta, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
HOME = HERE.parent                 # the Keel checkout
PKG = HOME / "voice"               # where the harbor_voice package lives
sys.path.insert(0, str(PKG))


def closed_port() -> int:
    """A loopback port nothing is listening on: bound, read, released.

    Used where something has to be proved to fall back. It is not "a port that is
    probably free": it is one the kernel just handed out and we let go of, which is as
    close to certain as an offline test can be.
    """
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()
    return port


# --------------------------------------------------------------------------- #
# THE FENCE, and it runs before `harbor_voice` is imported.
#
# WHY IT EXISTS. This file's capture checks speak two phrases, "a thought" and "remember
# the bearing export", and what they prove is that a card comes back. A house runs this
# file to prove its work, many times per card, and a house's environment carries
# `KEEL_HOME=<the live checkout>` beside `KEEL_HOST` and `KEEL_CARD`. `harbor_voice.config`
# reads `KEEL_HOME` at import and derives `KB = $KEEL_HOME/bin/kb` from it, so those two
# captures were filed on his real board: 84 fake cards on 2026-09-20, 69 of them from one
# card's runs in a single 43 minutes. Nothing in the output said which board it had.
#
# WHY IT IS UNCONDITIONAL AND FIRST, the way `tests/fence.py` is for the stdlib suite. The
# guards in `keel/config.py` and `harbor_voice/config.py` now catch this shape too, but a
# guard that has to be reasoned about is one a new section can walk around: two sections
# here already built a throwaway `KEEL_HOME` with a stub `kb`, and the two that file
# through the real dispatcher had none, which is exactly the kind of gap nobody notices
# while writing the check they came for. So the run owns a scratch world instead: every
# `KEEL_*` and `HARBOR_VOICE_*` the caller had is dropped, `HOME` and `TMPDIR` move inside
# it, a recording `kb` stand-in sits both first on `PATH` and at the path `config.KB` will
# resolve to, and `fence_section()` says at the end that nothing got out. Nothing about
# what the selftest PROVES changes: the fixtures that build their own `KEEL_HOME` and their
# own stub `kb` are read after this and still win.
# --------------------------------------------------------------------------- #

# What the stand-in answers with. `capture.file` reads the id out of the JSON, and every
# other verb the package has is a read that wants a list.
KB_CARD = {"id": "c-901", "space": "personal", "stage": "inbox", "topic": "voice"}
KB_STAND_IN = '''#!{python}
"""Records what it was asked for, and answers the way `kb` would. Written by the fence in
bin/keel-voice-selftest; see that file for why."""
import json
import os
import sys

with open({log!r}, "a", encoding="utf-8") as handle:
    handle.write(json.dumps({{"argv": sys.argv[1:], "cwd": os.getcwd()}}) + "\\n")

print(json.dumps({card!r}) if "create" in sys.argv else "[]")
'''

SCRATCH_TOML = """\
# The selftest's own keel.toml, so the one file the package reads (the judges switch,
# config.KEEL_TOML) is this run's and not the checkout's. It names no board on another
# machine: a scratch board reached over HTTP is the live board under a quieter name.
[keel]
state_dir = "state"
segments_dir = "segments"
[voice]
port = 4390
[voice.judges]
[voice.judge_floors]
"""

KB_LOG = "kb-calls.jsonl"
RUN_NONCE = "selftest-" + os.urandom(8).hex()
REAL_HOME = Path(os.environ.get("HOME") or Path("~").expanduser()).resolve()
WITNESSED: dict[str, str] = {}      # taken by `fence`, read back by `fence_section`


def witness(path: Path) -> str:
    """A fingerprint of one path: enough to notice a write, cheap enough to take twice.

    A DIRECTORY IS ITS NAME LIST, NOT ITS mtime AND NOT ITS CONTENTS' (c-316, and the
    first version of this could not pass on the box at all). Two things write into the
    live tree on their own clock while any selftest runs, and neither is the selftest:

    - the voice gateway mirrors its state to `state/voice/.voice_state` and its
      neighbours by writing `._X` and renaming it over `X`, twice a second, and a rename
      bumps the DIRECTORY's mtime while leaving its contents identical. Measured: two
      readings twelve seconds apart, nothing of the selftest's running, differing in the
      directory mtime alone;
    - the drain appends to `state/logs/drain.log` every half minute. Measured the same
      way, twenty seconds apart.

    So a before-and-after comparison of a shared directory cannot answer "did THIS run
    write here" on a machine where Keel is running, and the honest thing is to ask the
    question it can answer: did anything APPEAR or VANISH. A stray write from a section
    creates something (a card directory, an inbox message, a rendered clip, a log), and
    that is what the name list catches. The case it cannot catch, a section appending to a
    live log, is covered better and earlier by the two checks above it: every path the
    package can write to is inside the scratch, and `harbormsg.LOG` is one of them.

    AND THE NAME LIST LEAVES OUT DOT ENTRIES, for the same reason one layer down. The
    mirror's `._X` exists only between the write and the rename, so the list itself
    flickers: one run in two failed on a `._.voice_state` that was there for one reading
    and not the other. Nothing a stray write would create is dot-prefixed (a card
    directory, an inbox message, a rendered clip, a log), and the one thing that is, the
    bus mirror, is the live gateway's own heartbeat.

    A FILE is still its mtime and its size, because nothing living writes the two files
    witnessed that way (`board.db`, `voice-session.json`), and there a write IS the signal.
    """
    try:
        stat = path.stat()
    except OSError:
        return "missing"
    if path.is_dir():
        names = sorted(entry.name for entry in path.iterdir()
                       if not entry.name.startswith("."))
        return f"dir {len(names)} {','.join(names[:50])}"
    return f"file {stat.st_mtime_ns} {stat.st_size}"


def live_roots() -> list[Path]:
    """The live checkout and this checkout: the two boards a launch from a worktree reaches."""
    return list(dict.fromkeys([HOME.resolve(), (REAL_HOME / "keel").resolve()]))


def witness_paths() -> list[Path]:
    """The real places this run must leave exactly as it found them.

    Each root's `state/voice`, and the one directory the package writes to outside
    `state/`: `segments/cloud-spend/data`, which `speech._record_cloud_spend` appends the
    TTS spend ledger to.

    NOT THE BOARD, ITS CARD DIRECTORIES OR ITS LOGS (c-417). Those changed under every run
    on a machine where Keel was running: `board.db` by its mtime whenever the drain, a hook
    or the hourly backup wrote (WAL), `state/cards` whenever anything filed a card, and
    `state/logs` whenever a house started. So a run that wrote nothing failed on somebody
    else's activity. What this run could put on a board is a card, and every card it files
    carries RUN_NONCE (`--option run_nonce=`, `snapshot._kb`), so `board_leaks` asks the
    live boards, read-only, for that value instead: a question only this run can make true.
    `voice-session.json` went with them for the same reason (the gateway writes it on every
    turn he takes), and the writable-paths check already proves the package's copy of that
    path is inside the scratch.
    """
    found = [root / "state" / "voice" for root in live_roots()]
    return found + [HOME / "segments" / "cloud-spend" / "data"]


def board_leaks(db: Path, nonce: str) -> list[str]:
    """The ids of cards on `db` that carry `nonce` in their options, title or brief, or that
    an event carrying it points at. Opened read-only, the way the doctor opens it; a board
    that is not there, or not a board, has none."""
    if not db.is_file():
        return []
    pattern = f"%{nonce}%"
    try:
        conn = sqlite3.connect(f"{db.as_uri()}?mode=ro", uri=True)
        try:
            cards = conn.execute("SELECT id FROM cards WHERE options LIKE ? OR title LIKE ? "
                                 "OR brief LIKE ?", (pattern,) * 3).fetchall()
            events = conn.execute("SELECT card FROM events WHERE text LIKE ? OR data LIKE ?",
                                  (pattern,) * 2).fetchall()
        finally:
            conn.close()
    except sqlite3.Error:
        return []
    return sorted({row[0] for row in cards + events})


def fence() -> Path:
    """Build the scratch world this run lives in, and point every name at it.

    Returns its root. Everything `harbor_voice.config` reads is decided here, because it
    reads it at import time and this is the last moment before that import.
    """
    root = Path(tempfile.mkdtemp(prefix="keel-voice-selftest-")).resolve()
    (root / "bin").mkdir()
    (root / "state" / "voice").mkdir(parents=True)
    (root / "segments").mkdir()
    (root / "home" / ".config").mkdir(parents=True)
    (root / "tmp").mkdir()
    (root / "keel.toml").write_text(SCRATCH_TOML)
    kb = root / "bin" / "kb"
    kb.write_text(KB_STAND_IN.format(python=sys.executable, log=str(root / KB_LOG),
                                     card=KB_CARD))
    kb.chmod(0o755)

    for key in [key for key in os.environ
                if key.startswith("KEEL_") or key.startswith("HARBOR_VOICE_")]:
        os.environ.pop(key)
    os.environ.update(
        # This run's mark on everything it files (c-417); `board_leaks` looks for it.
        HARBOR_VOICE_RUN_NONCE=RUN_NONCE,
        # The four `harbor_voice.config` reads for a path. The segments and adapters trees
        # are THIS CHECKOUT'S OWN and are read rather than written: the package loads
        # `segments/cloud-spend/record.py` by path (`speech._cloud_spend_record`) and merges
        # each adapter's `hearing.json`, and both have to be the real files for the checks
        # on them to mean anything. `witness_paths` watches the one of the two that a
        # mistake here would write into.
        KEEL_HOME=str(root),
        KEEL_CONFIG=str(root / "keel.toml"),
        KEEL_SEGMENTS_DIR=str(HOME / "segments"),
        KEEL_ADAPTERS_DIR=str(HOME / "adapters"),
        # The deck this machine really is running answers on 8790, and a section that
        # forgot to point somewhere else would read his board through it.
        KEEL_SERVE_PORT=str(closed_port()),
        # a config may say `state_dir = "~/keel/state"`, so a child that falls back to the
        # toml lands on the live state however well the `KEEL_*` names were handled.
        HOME=str(root / "home"),
        XDG_CONFIG_HOME=str(root / "home" / ".config"),
        # THE ONE CACHE THIS RUN READS FROM THE REAL HOME, because it is the machine's and
        # not Keel's: `corpus.EmbeddingPicker` loads potion-base-8M through
        # huggingface_hub, which caches under `$HOME/.cache/huggingface`. With `HOME` moved
        # and nothing said, that cache misses and the run DOWNLOADS the weights, which is
        # the opposite of this file's opening promise. Offline as well as pointed at the
        # cache, so it can only ever be a read: a machine without the weights gets the
        # keyword picker, which `corpus.build` already falls back to, and never a download
        # on a merge gate.
        HF_HOME=str(REAL_HOME / ".cache" / "huggingface"),
        HF_HUB_OFFLINE="1",
        # Every `tempfile.mkdtemp()` in this file lands inside the scratch as well, so the
        # run leaves one directory behind rather than forty, and it is removed at the end.
        TMPDIR=str(root / "tmp"),
        PATH=os.pathsep.join([str(root / "bin"), os.environ.get("PATH", "")]),
    )
    tempfile.tempdir = str(root / "tmp")
    WITNESSED.update({str(path): witness(path) for path in witness_paths()})
    return root


def kb_calls() -> list:
    """Every call the stand-in `kb` recorded, oldest first."""
    path = SCRATCH / KB_LOG
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


def fence_report() -> int:
    """`--fence-report`: the fence, one capture through it, and what it decided, as JSON.

    It stops before this file's own imports, so it runs under the stdlib interpreter rather
    than `.venv-voice`, which is what lets `tests/test_live_state.py` run the whole path the
    leak went down (`capture.file` shelling out to `config.KB`) under a house's environment
    and assert that the live checkout saw none of it.
    """
    from harbor_voice import capture, config
    card = capture.file("a thought", "personal", [])
    print(json.dumps({"scratch": str(SCRATCH), "home": os.environ["HOME"],
                      "keel_home": str(config.KEEL_HOME), "kb": str(config.KB),
                      "state": str(config.STATE), "data": str(config.DATA),
                      "card": card, "kb_calls": kb_calls(),
                      "keel_env": {key: value for key, value in os.environ.items()
                                   if key.startswith("KEEL_")}}))
    return 0


SCRATCH = fence()

if "--fence-report" in sys.argv:
    sys.exit(fence_report())

