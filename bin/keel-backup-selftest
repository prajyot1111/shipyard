check "$(has "$ROOT/restored-helm/segments")" "no" "and no part of Harbor's tree comes with it"
check "$(has "$ROOT/restored-helm/ledger")" "no" "including the ledger"
check "$(has "$ROOT/restored/pr-reviews")" "no" "and a Harbor restore delivers no Helm state"

