import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
db.execute("insert into cards values ('c-003', 'a third card')")
db.commit(); db.close()
PY
before_keel="$(count "$KSNAP")"
out="$(HOST_UNDER_TEST=selftest-box SETS_UNDER_TEST=keel run snapshot)"; rc=$?
check "$([ "$rc" -ne 0 ] && echo yes || echo no)" "yes" "a second host writing a set the first still owns is refused"
check "$(echo "$out" | grep -c 'One set has one writer')" "1" "and it says why, and what to do"
check "$(count "$KSNAP")" "$before_keel" "and nothing reached the store"
out="$(HOST_UNDER_TEST=selftest-box SETS_UNDER_TEST=keel run snapshot --take-over)"
check "$(latest_of keel host)" "selftest-box" "--take-over moves the set, and latest.json says so"
check "$(count "$KSNAP")" "$((before_keel + 1))" \
      "the new owner adds to the set's history rather than replacing it"
python3 - "$KEEL/state/board.db" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
db.execute("insert into cards values ('c-004', 'a fourth card')")
db.commit(); db.close()
PY
out="$(SETS_UNDER_TEST=keel run snapshot)"
check "$(echo "$out" | grep -c 'One set has one writer')" "1" "and now the first host is the one refused"
out="$(SETS_UNDER_TEST=keel run snapshot --take-over)"
check "$(latest_of keel host)" "$HOST_A" "until it takes the set back"
out="$(SETS_UNDER_TEST=keel run snapshot --set helm)"
check "$(echo "$out" | grep -c 'does not write the helm set')" "1" "a host may not write a set its config does not give it"

# --- 10. the nightly pull --------------------------------------------------------------
notices_reset
out="$(run pull)"; rc=$?
check "$rc" "0" "a pull succeeds"
MIR="$BH/mirror/sets"
# Per set, the newest snapshot of each of the MIRROR_DAYS (3) most recent days the store holds.
want=0
for s in "$SD"/sets/*/snapshots; do
  n="$(find "$s" -name '*.tar.gz.gpg' -exec basename {} \; | cut -c1-8 | sort -u | wc -l | tr -d ' ')"
  want=$((want + (n < 3 ? n : 3)))
done
check "$(count "$MIR")" "$want" "the mirror holds the newest snapshot of each set's three most recent days"
check "$(echo "$out" | grep -c 'proven: .*keel')" "1" "and proves the newest keel snapshot by restoring it"
check "$(echo "$out" | grep -c 'proven: .*helm')" "1" "and the helm set's, with the helm key"
# The store keeps its full history; the mirror only the recent end, and it must not fetch
# what it then drops, or every pull would download the history and delete it again.
for id in 20250101T010000Z 20250102T010000Z; do mk "$id"; done
run pull >/dev/null
out="$(run pull)"
check "$(echo "$out" | grep -c 'pull ok: 0 new object')" "1" \
      "a second pull fetches nothing, with older history still in the store"
check "$(count "$MIR/harbor/snapshots/2025/01")" "0" "and the mirror holds none of that older history"
# The store losing its newest snapshot: a writer gone wrong, a hand in the Drive web page.
# The mirror keeps it, because its keep set is computed on its own ids as well.
gone="$(find "$HASNAP" -name '*.tar.gz.gpg' | LC_ALL=C sort | tail -1)"
rm -f "$gone"
run pull >/dev/null
check "$(has "$BH/mirror/${gone#"$SD"/}")" "yes" \
      "a snapshot the store lost is NOT deleted from the mirror"
cp -p "$BH/mirror/${gone#"$SD"/}" "$gone"   # put it back from the mirror: what the mirror is for
out="$(run verify --local)"; rc=$?
check "$rc" "0" "a local verify reads the mirror"
state_put last_verify "2020-01-01T00:00:00Z"
run verify --local >/dev/null 2>&1
check "$(state_of last_verify)" "2020-01-01T00:00:00Z" "and, proving less than a store verify, moves no clock"
run verify >/dev/null 2>&1

# An unreadable newest snapshot is raised by the pull on the first night.
cp "$(newest "$KSNAP")" "$ROOT/good-keel"
echo 'not a gpg file' > "$(newest "$KSNAP")"
run pull >/dev/null 2>&1
check "$(notice open backup-pull-stale)" "yes" "a pulled snapshot that does not read back is raised at once"
cp "$ROOT/good-keel" "$(newest "$KSNAP")"
run pull >/dev/null 2>&1
check "$(notice done backup-pull-stale)" "yes" "and the next good pull retires it"

# A pull job that never runs is caught by the hourly snapshot, which certainly does.
notices_reset
state_put last_pull "2020-01-01T00:00:00Z"
run snapshot >/dev/null 2>&1
check "$(notice open backup-pull-stale)" "yes" "the hourly job raises a pull that is two nights late"
run pull >/dev/null 2>&1
check "$(notice done backup-pull-stale)" "yes" "and a pull retires it"

# --- 10b. the box publishes while the pull runs (c-440) --------------------------------
# The pull lists the store once, and the box rewrites each set's latest.json every hour. A
# pull on a laptop that dozes between DarkWakes runs for hours, so the listing's md5 for
# latest.json was stale by the time it was fetched, and the pull failed on the one file
# that is the commit point, two nights running. A stand-in box rewrites keel's latest.json
# (same snapshot, a new counter) as fast as it can for the length of the pull.
notices_reset
KLATEST="$SD/sets/keel/latest.json"
cp "$KLATEST" "$ROOT/latest-keel.json"
rm -f "$ROOT/rewriter.stop"
python3 - "$KLATEST" "$ROOT/rewriter.stop" <<'PY' &
import json, os, sys, time
path, stop = sys.argv[1], sys.argv[2]
base, n = json.load(open(path)), 0
while not os.path.exists(stop):
    n += 1
    # `.put-` is the name an interrupted put has, which the file store's listing skips,
    # so the temporary is never listed as an object: the box's own store_put does this.
    tmp = os.path.join(os.path.dirname(path), f".put-rewriter-{n}")
    with open(tmp, "w") as handle:
        json.dump(dict(base, rewritten=n), handle)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    time.sleep(0.005)
PY
rewriter=$!
out="$(run pull)"; rc=$?
touch "$ROOT/rewriter.stop"; wait "$rewriter" 2>/dev/null
check "$rc" "0" "a pull survives the box rewriting latest.json while it runs"
[ "$rc" = 0 ] || printf '%s\n' "$out" | tail -3
named="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["snapshot"])' "$BH/mirror/sets/keel/latest.json" 2>/dev/null)"
check "$(find "$BH/mirror/sets/keel/snapshots" -name "$named.tar.gz.gpg" | wc -l | tr -d ' ')" "1" \
      "and the mirror's latest.json names a snapshot the mirror holds"
cp "$ROOT/latest-keel.json" "$KLATEST"
# A latest.json naming a snapshot nobody holds is not a commit point to accept, whatever
# its md5: the pull re-lists once, finds nothing new, and fails rather than write it.
python3 - "$KLATEST" <<'PY'
import json, sys
d = json.load(open(sys.argv[1])); d["snapshot"] = "20991231T235959Z"
json.dump(d, open(sys.argv[1], "w"))
PY
cp "$BH/mirror/sets/keel/latest.json" "$ROOT/mirror-latest-keel.json"
out="$(run pull 2>&1)"; rc=$?
check "$([ "$rc" -ne 0 ] && echo yes || echo no)" "yes" "a latest.json naming a snapshot the mirror cannot hold fails the pull"
check "$(cmp -s "$BH/mirror/sets/keel/latest.json" "$ROOT/mirror-latest-keel.json" && echo kept || echo moved)" "kept" \
      "and the mirror keeps the commit point it had"
cp "$ROOT/latest-keel.json" "$KLATEST"
run pull >/dev/null 2>&1

# THE NOTICE POINTS AT THE LOG THE ERROR IS IN, AND SAYS THE SAME THING EVERY HOUR. The
# hourly job re-states an open pull notice with --replace, and a brief that carried a
# relative age ("49h ago", then "50h ago") was a new `kb set` event on the card every hour.
notices_reset
state_put last_pull "2020-01-01T00:00:00Z"
state_put last_pull_error "could not copy sets/keel/latest.json at 2020-01-01T03:00:00Z"
run snapshot >/dev/null 2>&1
brief1="$(python3 -c 'import json,sys; print([c["brief"] for c in json.load(open(sys.argv[1])) if c["options"]["notice_key"] == "backup-pull-stale"][0])' "$NOTICES")"
run snapshot >/dev/null 2>&1
brief2="$(python3 -c 'import json,sys; print([c["brief"] for c in json.load(open(sys.argv[1])) if c["options"]["notice_key"] == "backup-pull-stale"][0])' "$NOTICES")"
check "$(echo "$brief1" | grep -c 'pull.err')" "1" "the pull notice names pull.err, where the error is"
check "$(echo "$brief1" | grep -c 'could not copy sets/keel/latest.json')" "1" "and carries the last error itself"
check "$([ "$brief1" = "$brief2" ] && echo same || echo changed)" "same" "and an hour later it says exactly the same thing"
run pull >/dev/null 2>&1

# --- 11. is any of it shared? ----------------------------------------------------------
notices_reset
chmod o+r "$(newest "$KSNAP")"
out="$(run verify)"; rc=$?
check "$([ "$rc" -ne 0 ] && echo yes || echo no)" "yes" "a store with a shared object fails the weekly verify"
check "$(notice open backup-public)" "yes" "and raises backup-public"
chmod o-r "$(newest "$KSNAP")"
run verify >/dev/null 2>&1
check "$(notice done backup-public)" "yes" "which only a verify that saw nothing shared retires"

# --- 12. the move off GitHub ------------------------------------------------------------
# The old layout, as the GitHub clone holds it: harbor at the root, keel and helm under
# sets/, every blob under the ONE shared key. Migrated into a fresh store by a fresh
# machine that holds only the shared key.
OLD="$ROOT/old-clone"; BH2="$ROOT/backup2"; SD2="$ROOT/store2"
mkdir -p "$BH2" "$SD2" "$OLD"
cp "$BH/backup.key" "$BH2/backup.key"
enc_old() {             # $1 = set dir in the clone, $2 = id, $3 = source root, $4.. = paths
  local dir="$1" id="$2" src="$3"; shift 3
  mkdir -p "$dir/snapshots/${id:0:4}/${id:4:2}"
  ( cd "$src" && tar -cf - "$@" ) | gzip -9nc | gpg --batch --yes --quiet --no-tty --pinentry-mode loopback \
    --symmetric --cipher-algo AES256 --passphrase-file "$BH/backup.key" \
    -o "$dir/snapshots/${id:0:4}/${id:4:2}/$id.tar.gz.gpg"
  printf '{"manifest": "old-%s", "snapshot": "%s"}\n' "$id" "$id" > "$dir/latest.json"
}
mkdir -p "$ROOT/oldkeel/state"
python3 - "$ROOT/oldkeel/state/board.db" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1]); db.execute("create table cards (id text)")
db.execute("insert into cards values ('c-001')"); db.commit(); db.close()
PY
enc_old "$OLD" 20260910T010000Z "$FAKE" segments/fathom/data/index.json
enc_old "$OLD" 20260911T010000Z "$FAKE" segments/fathom/data/index.json
enc_old "$OLD/sets/keel" 20260911T020000Z "$ROOT/oldkeel" state/board.db
enc_old "$OLD/sets/helm" 20260911T030000Z "$HELM" pr-reviews/state.json
git -C "$OLD" init --quiet -b main && git -C "$OLD" add -A \
  && git -C "$OLD" -c user.name=t -c user.email=t@t commit --quiet -m old
mig() { KEEL_HOME="$KEEL" KEEL_HARBOR_HOME="$FAKE" KEEL_HELM_HOME="$HELM" KEEL_BACKUP_HOME="$BH2" \
        KEEL_BACKUP_STORE="file:$SD2" KEEL_BACKUP_SETS="keel harbor helm" KEEL_BACKUP_HOST="$HOST_A" \
        NOTICES_PATH="$NOTICES" "$BACKUP" migrate-from-git --clone "$OLD" 2>&1; }
notices_reset
out="$(mig)"; rc=$?
check "$rc" "0" "the migration runs to the end"
check "$(count "$SD2/sets/harbor/snapshots")" "2" "every Harbor snapshot is in the store, now under sets/harbor/"
check "$(count "$SD2/sets/keel/snapshots")" "1" "and Keel's"
check "$(count "$SD2/sets/helm/snapshots")" "1" "and Helm's"
check "$(echo "$out" | grep -c 'verify ok')" "1" "and the ordinary store verify then reads every set back"
hblob="$(newest "$SD2/sets/helm/snapshots")"
check "$(decrypts_with "$BH2/backup-helm.key" "$hblob")" "yes" "the helm snapshots are re-encrypted under the helm key"
check "$(decrypts_with "$BH2/backup.key" "$hblob")" "no" "and no longer open with the shared one"
check "$(notice open backup-passphrase-helm)" "yes" "whose new passphrase goes to the password manager"
check "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["host"])' "$SD2/sets/keel/latest.json")" "$HOST_A" \
      "latest.json names the host that owns each set from now on"
out="$(mig)"
check "$(echo "$out" | grep -c '0 snapshot(s) copied')" "3" "run again, it copies nothing: a run cut short is finished by rerunning it"
python3 - "$SD2/sets/keel/latest.json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1])); d.update(snapshot="29990101T000000Z", host="selftest-box")
json.dump(d, open(sys.argv[1], "w"))
PY
out="$(mig)"
check "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["host"])' "$SD2/sets/keel/latest.json")" "selftest-box" \
      "a rerun after the store moved on does not rewind latest.json or its owner"

# --- 12b. the code set ------------------------------------------------------------------
# The checkout's own history, as one git bundle (c-288): the repo has no remote, so without
# it a restore brings back a board with no code to run it. Staged like the board, rebuilt
# only when a ref moves, and floored at six hours like Helm.
CSNAP="$SD/sets/code/snapshots"
gitc() { git -C "$KEEL" -c user.name=selftest -c user.email=selftest@example.invalid "$@"; }
echo 'print("keel")' > "$KEEL/bin/keel"
gitc init --quiet -b main && gitc add bin/keel && gitc commit --quiet -m one
export SETS_UNDER_TEST="keel code harbor helm"
out="$(run snapshot --set code)"; rc=$?
check "$rc" "0" "the code set snapshots a checkout"
check "$(count "$CSNAP")" "1" "into sets/code/, one object"
check "$(git -C "$KEEL" status --porcelain --ignored | grep -c bundle)" "0" \
      "and writes nothing into the checkout it bundles"
out="$(run snapshot --set code)"
check "$(echo "$out" | grep -c '\[code\] unchanged since')" "1" "an unchanged repo is an unchanged set: the bundle is reused byte for byte"
mkdir -p "$ROOT/restored-code"
run restore --set code --into "$ROOT/restored-code" >/dev/null
check "$(git bundle list-heads "$ROOT/restored-code/code/keel.bundle" 2>/dev/null | grep -c ' refs/heads/main$')" "1" \
      "restore --set code brings back a bundle holding main"
git clone --quiet -b main "$ROOT/restored-code/code/keel.bundle" "$ROOT/cloned" 2>/dev/null
check "$(cat "$ROOT/cloned/bin/keel" 2>/dev/null)" 'print("keel")' "and a checkout cloned from it holds the committed code"
echo 'print("keel 2")' > "$KEEL/bin/keel"; gitc commit --quiet -am two
out="$(run snapshot --set code)"
check "$(echo "$out" | grep -c '\[code\] changed, but the last snapshot is only')" "1" \
      "a new commit inside the six-hour floor waits"
out="$(run snapshot --set code --force)"
check "$(count "$CSNAP")" "2" "and --force takes it"
out="$(run verify --set code)"; rc=$?
check "$rc" "0" "the store verify reads the code set back through its canary"
check "$(grep -c '^| code |' "$SD/README.md")" "1" "and the README names the code set"
check "$(grep -c "a card's \`scratch/\` folder" "$SD/README.md")" "1" "and says a card's scratch folder is in no keel snapshot"
unset SETS_UNDER_TEST

# --- 12c. the install's own board (c-622) ------------------------------------------------
# The scheduled jobs run from the checkout, while an install's board is its config's
# state_dir (~/shipyard/state). `keel backup env` hands it over as KEEL_BACKUP_STATE_DIR,
# and the keel set is then the install's home: its state/, config.toml and segment data.
INST="$ROOT/install"
mkdir -p "$INST/state/cards/c-900" "$INST/segments/daybook/data"
python3 - "$INST/state/board.db" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
db.execute("pragma journal_mode=wal")
db.execute("create table cards (id text primary key, title text)")
db.execute("insert into cards values ('c-900', 'the install board')")
db.commit(); db.close()
PY
echo 'the install plan' > "$INST/state/cards/c-900/plan.md"
echo '[machine]'         > "$INST/config.toml"
out="$(KEEL_BACKUP_STATE_DIR="$INST/state" SETS_UNDER_TEST=keel run snapshot --set keel --force)"; rc=$?
check "$rc" "0" "the keel set snapshots the install's state dir, wherever the checkout is"
mkdir -p "$ROOT/restored-install"
KEEL_BACKUP_STATE_DIR="$INST/state" SETS_UNDER_TEST=keel run restore --into "$ROOT/restored-install" >/dev/null
check "$(python3 -c 'import sqlite3,sys
db = sqlite3.connect(sys.argv[1])
print(db.execute("select id from cards").fetchone()[0])' "$ROOT/restored-install/state/board.db" 2>/dev/null)" "c-900" \
      "and the board it brings back is the install's, not the checkout's"
check "$(has "$ROOT/restored-install/state/cards/c-900/plan.md")" "yes" "with the install's card directories"
check "$(has "$ROOT/restored-install/config.toml")" "yes" "and the install's own config"
out="$(KEEL_BACKUP_STATE_DIR="$INST/state" SETS_UNDER_TEST=keel run restore --into "$INST/state/x")"
check "$(echo "$out" | grep -c 'refusing to restore into')" "1" "a restore into the install's home is refused"
out="$(KEEL_BACKUP_STATE_DIR="$INST/board" SETS_UNDER_TEST=keel run snapshot --set keel)"; rc=$?
check "$([ "$rc" -ne 0 ] && echo yes || echo no)" "yes" "a state dir not named state is refused, not guessed"
before_keel="$(count "$KSNAP")"
mkdir -p "$ROOT/boardless/state"
out="$(KEEL_BACKUP_STATE_DIR="$ROOT/boardless/state" SETS_UNDER_TEST=keel run snapshot --set keel --force)"; rc=$?
check "$([ "$rc" -ne 0 ] && echo yes || echo no)" "yes" "a state dir with no board, on a set with history, is refused"
check "$(count "$KSNAP")" "$before_keel" "and no board-less snapshot reaches the store"
SETS_UNDER_TEST=keel run snapshot --set keel --force >/dev/null 2>&1    # the checkout's board newest again

echo
if [ "$fail" -eq 0 ]; then echo "all $pass checks passed (file store)"; else echo "$fail of $((pass+fail)) checks FAILED (file store)"; fi

# --- 13. the same code through rclone ---------------------------------------------------
# rclone's own `local` backend, so the rclone half of the store layer (lsjson listings with
# md5, copyto, deletefile, the exit-3 "no such directory") is exercised for real, offline.
# The Drive-only parts (the permissions metadata, OAuth) cannot be, and say so: the privacy
# check answers "unknown" here and must leave backup-public standing.
if command -v rclone >/dev/null 2>&1; then
  echo
  echo "keel-backup-selftest (store: rclone, local backend)"
  RCONF="$ROOT/rclone.conf"; printf '[selftest]\ntype = local\n' > "$RCONF"
  STORE="rclone:selftest:$ROOT/rstore"
  BH="$ROOT/backup3"; mkdir -p "$BH"; cp "$ROOT/backup/backup.key" "$ROOT/backup/backup-helm.key" "$BH/"
  SD="$ROOT/rstore"; KSNAP="$SD/sets/keel/snapshots"
  notices_reset
  out="$(run snapshot)"
  check "$(echo "$out" | grep -c 'snapshot .* published')" "3" "rclone: the first run publishes every set"
  check "$(echo "$out" | grep -c 'proven by md5')" "3" "rclone: each proven by the md5 rclone lists"
  out="$(run snapshot)"
  check "$(echo "$out" | grep -c 'nothing to publish')" "3" "rclone: an unchanged run publishes nothing"
  mkdir -p "$ROOT/r-restored"
  run restore --into "$ROOT/r-restored" >/dev/null
  check "$(has "$ROOT/r-restored/state/board.db")" "yes" "rclone: a restore from the store brings the board back"
  notices_reset
  out="$(run verify)"; rc=$?
  check "$rc" "0" "rclone: the store verify passes"
  check "$(echo "$out" | grep -c 'LEFT STANDING')" "1" \
        "rclone: a store that cannot answer the sharing question is not called private"
  out="$(run pull)"; rc=$?
  check "$rc" "0" "rclone: the pull copies and proves the store"

  # A refused token, through a stub rclone that answers everything but listremotes the way
  # rclone answers when Google has revoked the grant.
  mkdir -p "$ROOT/stub"
  cat > "$ROOT/stub/rclone" <<STUB
#!/usr/bin/env bash
for a in "\$@"; do [ "\$a" = listremotes ] && exec "$(command -v rclone)" "\$@"; done
echo 'Failed to create file system: couldn'"'"'t fetch token: oauth2: "invalid_grant" "Token has been expired or revoked."' >&2
exit 1
STUB
  chmod +x "$ROOT/stub/rclone"
  notices_reset
  echo '{"n":"r"}' > "$FAKE/segments/fathom/data/state.json"
  out="$(PATH="$ROOT/stub:$PATH" run snapshot)"; rc=$?
  check "$([ "$rc" -ne 0 ] && echo yes || echo no)" "yes" "rclone: a refused token fails the run"
  check "$(notice open backup-auth)" "yes" "and raises backup-auth on the FIRST failure, not after hours of staleness"
  run snapshot >/dev/null
  check "$(notice done backup-auth)" "yes" "and the next run that reaches the store retires it"
  echo
  if [ "$fail" -eq 0 ]; then echo "all $pass checks passed (both stores)"; else echo "$fail of $((pass+fail)) checks FAILED"; fi
else
  echo "(rclone is not installed here, so the rclone pass is skipped)"
fi
exit $(( fail > 0 ))
