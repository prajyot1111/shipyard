check "$(has "$ROOT/restored-helm/pr-watch/context/_assets/cloud__empty")"   "yes" "empty directories survive the round trip"
check "$(has "$ROOT/restored-helm/pr-reviews/orientation/cloud-1.md")"       "yes" "the review scanner's history survives whole"
# The retired watcher's own caches: nothing reads them, so nothing copies them (RETIRE).
check "$(has "$ROOT/restored-helm/pr-watch/status")"      "no" "the retired watcher's status cache is not in scope"
check "$(has "$ROOT/restored-helm/pr-watch/watch")"       "no" "nor its watchlist"
check "$(has "$ROOT/restored-helm/pr-watch/model.json")"  "no" "nor its model choice"

# The floor on how often the Helm set is snapshotted: a changed set inside it waits. The
# change is a finding now; the watcher's status timestamps that used to churn it are out.
echo '{"checked_at":"t2"}' > "$HELM/pr-watch/status/cloud-1.json"
out="$(run snapshot)"
check "$(echo "$out" | grep -c '\[helm\] changed')" "0" \
      "a retired cache moving is not a change to the set"
echo '# a finding, edited' > "$HELM/pr-reviews/findings/cloud-1.md"
out="$(run snapshot)"
check "$(echo "$out" | grep -c '\[helm\] changed, but the last snapshot is only')" "1" \
      "a changed Helm set inside its floor is not snapshotted again"
check "$(count "$HSNAP")" "1" "so it still holds exactly one snapshot"
harbor_before="$(count "$HASNAP")"
out="$(run snapshot --set helm --force)"
check "$(echo "$out" | grep -c '\[helm\] snapshot .* published')" "1" \
      "--force is the door through the floor, and --set takes only the set named"
check "$(count "$HASNAP")" "$harbor_before" "and Harbor's set was left alone by that run"

# Retention is per set: three fabricated helm ids past its 2-day hourly tier, a pair on
# one day and one two days older. Pinned to fixed hours so the pair is one UTC day whatever
# time this runs.
python3 - "$ROOT/hids" <<'PY'
import datetime, sys
now = datetime.datetime.now(datetime.timezone.utc)
rows = [(3, 12), (3, 6), (5, 12)]
open(sys.argv[1], "w").write("\n".join(
    (now - datetime.timedelta(days=d)).replace(hour=h, minute=0, second=0,
                                               microsecond=0).strftime("%Y%m%dT%H%M%SZ")
    for d, h in rows) + "\n")
PY
hpath() { printf '%s/%s/%s/%s.tar.gz.gpg' "$HSNAP" "${1:0:4}" "${1:4:2}" "$1"; }
h1="$(sed -n 1p "$ROOT/hids")"; h2="$(sed -n 2p "$ROOT/hids")"; h3="$(sed -n 3p "$ROOT/hids")"
for id in "$h1" "$h2" "$h3"; do mkdir -p "$(dirname "$(hpath "$id")")"; echo x > "$(hpath "$id")"; chmod 600 "$(hpath "$id")"; done
echo '{"prs":{"cloud-2":{}}}' > "$HELM/pr-reviews/state.json"
run snapshot --set helm --force >/dev/null
check "$(has "$(hpath "$h1")")" "yes" "the newest snapshot of a day survives Helm's daily tier"
check "$(has "$(hpath "$h2")")" "no"  "the older one of the same day is pruned by Helm's daily tier"
check "$(has "$(hpath "$h3")")" "yes" "and one per day survives out to Helm's 30-day boundary"

# The sets' alarms must not be the same alarm either.
notices_reset
echo 'not a gpg file' > "$(newest "$HSNAP")"
run verify >/dev/null 2>&1
check "$(notice open backup-unreadable-helm)" "yes" "an unreadable Helm set raises an alarm under its OWN key"
check "$(notice open backup-unreadable)" "no" "and leaves Harbor's key untouched"
check "$(notice open backup-unreadable-keel)" "no" "and Keel's"
check "$(notice open backup-stale)" "no" "and the staleness key is not involved at all"
echo '{"prs":{"cloud-3":{}}}' > "$HELM/pr-reviews/state.json"
run snapshot --set helm --force >/dev/null
out="$(run verify --set helm)"
check "$(notice done backup-unreadable-helm)" "yes" "a narrowed verify that reads the set back retires that set's card"

# A set's root gone. Never written: skipped, not fatal (a machine that never ran Helm).
# Written before: the data this machine promised to back up is gone, and that is loud.
without_helm() { KEEL_HOME="$KEEL" KEEL_HARBOR_HOME="$FAKE" KEEL_HELM_HOME="$ROOT/no-such-claude" \
       KEEL_BACKUP_HOME="$BH" KEEL_BACKUP_STORE="$1" KEEL_BACKUP_SETS="keel harbor helm" \
       KEEL_BACKUP_HOST="$HOST_A" NOTICES_PATH="$NOTICES" "$BACKUP" snapshot 2>&1; }
notices_reset
out="$(without_helm "$STORE")"; rc=$?
check "$([ "$rc" -ne 0 ] && echo yes || echo no)" "yes" "a set whose root is gone, with snapshots in the store, fails the run"
check "$(echo "$out" | grep -c 'is gone, but the store holds')" "1" "and says so rather than counting it a quiet hour"
check "$(notice open backup-stale)" "yes" "and the board hears it"
mkdir -p "$ROOT/fresh-store"
out="$(KEEL_BACKUP_HOME="$ROOT/fresh-bh" without_helm "file:$ROOT/fresh-store")"; rc=$?
check "$rc" "0" "a machine that never had Helm's directories still completes a snapshot run"
check "$(echo "$out" | grep -c 'is not on this machine')" "1" \
      "and says which set it skipped rather than failing silently"
run snapshot >/dev/null

# The settings cannot be read (a config typo): the hourly job must not turn into a
# silent "nothing to do". A bin/keel that fails stands in for it.
notices_reset
printf '#!/bin/sh\necho "ConfigError: [hosts.mac] has no key backup_set" >&2\nexit 1\n' > "$KEEL/bin/keel"
chmod +x "$KEEL/bin/keel"
out="$(KEEL_HOME="$KEEL" KEEL_BACKUP_HOME="$BH" NOTICES_PATH="$NOTICES" "$BACKUP" snapshot 2>&1)"; rc=$?
rm -f "$KEEL/bin/keel"
check "$([ "$rc" -ne 0 ] && echo yes || echo no)" "yes" "a failed keel backup env fails the scheduled run"
check "$(echo "$out" | grep -c 'could not read the backup settings.*ConfigError')" "1" "and names why"
check "$(notice open backup-stale)" "yes" "and raises backup-stale rather than going quiet"
run snapshot >/dev/null

# A run narrowed by --set may not speak for the sets it never opened.
state_put last_success "2020-01-01T00:00:00Z"
state_put last_verify "2020-01-01T00:00:00Z"
notices_reset
run snapshot --set helm >/dev/null 2>&1
check "$(state_of last_success)" "2020-01-01T00:00:00Z" "a narrowed snapshot run does not move the run-wide freshness figure"
check "$(notice open backup-stale)" "yes" "so a genuinely stale backup is still announced after one"
run verify --set helm >/dev/null 2>&1
check "$(state_of last_verify)" "2020-01-01T00:00:00Z" "and a narrowed verify does not move the verify clock"
run snapshot >/dev/null 2>&1

