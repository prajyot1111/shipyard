#!/usr/bin/env bash
# keel-backup-selftest - prove the parts of keel-backup that a real run cannot show you.
#
# Most of keel-backup can be checked by running it: a snapshot either reaches the store or
# it does not. Some of its promises cannot be checked that way, and they are the ones that
# matter:
#
#   RETENTION only does anything to snapshots older than each set's hourly window (read
#   from keel-backup itself, not hardcoded here), so the first real evidence that the
#   policy works would otherwise arrive days after anyone stopped watching. Here it is
#   exercised in a second, against fabricated ids spanning a year.
#
#   PUBLISHING IS PROVEN, NOT ASSUMED. A snapshot that could not reach the store waits in
#   pending/ and goes first next run; latest.json is only ever written after the store's
#   own md5 of the blob matches. A real run cannot show you the failure half of that.
#
#   THE REFUSALS are the paths that only run when something has already gone wrong: a
#   restore aimed inside a live checkout, a missing key beside an existing history, a
#   second machine writing a set the first one still owns. All are guards against damage,
#   so "it looked fine" is not evidence about any of them.
#
#   THE ALARMS, raised and retired by exactly the runs that may raise and retire them,
#   including the store verify's clearing rules, which the git version could only prove
#   by hand against the real remote. A `file:` store is a real store, not a test double:
#   the same code path the Drive store takes, minus rclone.
#
#   THE BOARD IS TAKEN THROUGH SQLITE'S BACKUP API rather than read off the live tree, so
#   a snapshot taken mid-write is not a torn file.
#
#   THE HELM SET HAS ITS OWN KEY, and the move off GitHub re-encrypts it: asserted by
#   trying the other key and watching it fail.
#
# It touches nothing real: a temporary KEEL_HOME with invented data, a directory standing
# in for the store, and a stub `kb` holding a JSON file of notices instead of the real
# board. Nothing here needs the network and nothing here can write to the live backup. When
# rclone is installed, a second pass runs the core of it through rclone's own `local`
# backend, so the rclone code path (and the refused-token alarm, through a stub rclone that
# says invalid_grant) is exercised too. The box has no rclone, and skips that pass.
#
#   keel-backup-selftest          run everything, print a line per check

set -uo pipefail

BACKUP="$(cd "$(dirname "$0")" && pwd)/keel-backup"
[ -x "$BACKUP" ] || { echo "no keel-backup beside $0" >&2; exit 2; }

ROOT="$(mktemp -d "${TMPDIR:-/tmp}/keel-backup-selftest.XXXXXX")"
trap 'chmod -R u+rwx "$ROOT" 2>/dev/null; rm -rf "$ROOT"' EXIT
KEEL="$ROOT/keel"
FAKE="$ROOT/harbor"
HELM="$ROOT/claude"
BH="$ROOT/backup"
SD="$ROOT/store"
NOTICES="$ROOT/notices.json"
STORE="file:$SD"
HOST_A="selftest-mac"
KSNAP="$SD/sets/keel/snapshots"
HASNAP="$SD/sets/harbor/snapshots"
HSNAP="$SD/sets/helm/snapshots"

pass=0; fail=0
ok()   { printf '  ok    %s\n' "$*"; pass=$((pass+1)); }
bad()  { printf '  FAIL  %s\n' "$*"; fail=$((fail+1)); }
check(){ if [ "$1" = "$2" ]; then ok "$3"; else bad "$3 (expected '$2', got '$1')"; fi; }
has()  { if [ -e "$1" ]; then echo yes; else echo no; fi; }
count(){ find "$1" -name '*.tar.gz.gpg' 2>/dev/null | wc -l | tr -d ' '; }
newest(){ find "$1" -name '*.tar.gz.gpg' 2>/dev/null | LC_ALL=C sort | tail -1; }

# Every run names its whole configuration, so nothing falls through to `keel backup env`.
run() { KEEL_HOME="$KEEL" KEEL_HARBOR_HOME="$FAKE" KEEL_HELM_HOME="$HELM" KEEL_BACKUP_HOME="$BH" \
        KEEL_BACKUP_STORE="$STORE" KEEL_BACKUP_SETS="${SETS_UNDER_TEST:-keel harbor helm}" \
        KEEL_BACKUP_EXTRA="${EXTRA_UNDER_TEST-harbor helm}" \
        KEEL_BACKUP_HOST="${HOST_UNDER_TEST:-$HOST_A}" KEEL_BACKUP_PULL=1 \
        KEEL_BACKUP_RCLONE_CONFIG="${RCONF:-$ROOT/none.conf}" \
        NOTICES_PATH="$NOTICES" "$BACKUP" "$@" 2>&1; }
jq_status() {           # $1 = python expression over the parsed status json
  run status --json | python3 -c "import json,sys; d=json.load(sys.stdin); print($1)"
}
latest_of() {           # $1 = set, $2 = field of the store's latest.json
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' \
    "$SD/sets/$1/latest.json" "$2" 2>/dev/null
}
decrypts_with() {       # $1 = keyfile, $2 = blob; yes when gpg can open it
  if gpg --batch --quiet --no-tty --pinentry-mode loopback --passphrase-file "$1" \
       --decrypt "$2" >/dev/null 2>&1; then echo yes; else echo no; fi
}
# The stub board's state, read the way an assertion wants it: is there an OPEN notice under
# this key, and is the one under this key done? A keyed notice is the whole alarm contract,
# so both directions are asked directly rather than by grepping a log of argv.
notice() {              # $1 = open|done|title, $2 = key
  python3 -c 'import json,sys
try: cards = json.load(open(sys.argv[1]))
except Exception: cards = []
want, key = sys.argv[2], sys.argv[3]
hit = [c for c in cards if c["options"].get("notice_key") == key]
if want == "open": print("yes" if any(c["stage"] != "done" for c in hit) else "no")
elif want == "title": print(hit[-1]["title"] if hit else "")
else: print("yes" if hit and all(c["stage"] == "done" for c in hit) else "no")' "$NOTICES" "$1" "$2"
}
notices_reset() { rm -f "$NOTICES"; }
state_of() { python3 -c 'import json,sys
print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' "$BH/state.json" "$1"; }
state_put() { python3 - "$BH/state.json" "$1" "$2" <<'PY'
import json, sys
p = sys.argv[1]; d = json.load(open(p)); d[sys.argv[2]] = sys.argv[3]
json.dump(d, open(p, "w"))
PY
}

# --- a Keel-shaped home, the live set ------------------------------------------------
# state/ is the whole point of this set: the board is the only store, and a card directory
# holds the plan and the output a session wrote once and will never write again.
mkdir -p "$KEEL/bin" "$KEEL/state/cards/c-001" "$KEEL/state/voice/cache" \
         "$KEEL/state/logs" "$KEEL/state/worktrees/old-card" "$KEEL/state/fetch-locks" \
         "$KEEL/state/drafts/demo" "$KEEL/state/cards/c-001/scratch/node_modules/pkg" \
         "$KEEL/segments/daybook/data/inbox" "$KEEL/segments/fathom/data/asks"
python3 - "$KEEL/state/board.db" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
db.execute("pragma journal_mode=wal")
db.execute("create table cards (id text primary key, title text)")
db.execute("insert into cards values ('c-001', 'a card that exists nowhere else')")
db.commit(); db.close()
PY
echo 'the plan'          > "$KEEL/state/cards/c-001/plan.md"
echo '{"said":"hello"}'  > "$KEEL/state/voice/transcript.jsonl"
echo '{"items":[]}'      > "$KEEL/segments/daybook/data/items.json"
# What must NOT leave, and what must not be archived. The two keys are credentials, which
# never leave this machine encrypted or not. The pid names a process on THIS laptop. The
# cache is regenerable by saying the line again and is the biggest thing in the tree, which
# is exactly the shape of the scope bug that took the old repo to 2.5GB. The logs and the
# worktrees are a record of how the state got here and a checkout of a repo that has its
# own history, neither of which is state.
echo 'a-secret-token'    > "$KEEL/state/human.token"
echo 'a-secret-key'      > "$KEEL/state/artifact.key"
echo '4242'              > "$KEEL/state/talker.pid"
echo 'fake wav'          > "$KEEL/state/voice/cache/0a1b2c3d.wav"
echo 'keel up'           > "$KEEL/state/logs/keel.out.log"
echo 'a worktree file'   > "$KEEL/state/worktrees/old-card/README"
echo 'pid'               > "$KEEL/state/fetch-locks/.fetch-daybook.lock"
# Scratch media and a dependency tree: on 2026-09-28 these took a snapshot from 26MB to 173MB.
echo 'fake mp4'          > "$KEEL/state/drafts/demo/film.mp4"
echo 'module.exports=1'  > "$KEEL/state/cards/c-001/scratch/node_modules/pkg/index.js"
echo 'scratch notes'     > "$KEEL/state/cards/c-001/scratch/notes.md"
mkdir -p "$KEEL/state/cards/c-001/out"
echo 'fake film'         > "$KEEL/state/cards/c-001/out/demo.MP4"
echo 'fake stem'         > "$KEEL/state/cards/c-001/out/voice.wav"
echo 'the outcome'       > "$KEEL/state/cards/c-001/out/summary.md"
# A landing's whole test output, about 0.9MB a card on the real board (c-671). It is named
# exactly: another log in a card directory may be the card's evidence, and stays.
echo 'Ran 4000 tests'    > "$KEEL/state/cards/c-001/merged-tests.log"
echo 'what the run said' > "$KEEL/state/cards/c-001/evidence.log"
echo 'Ran 4000 tests'    > "$KEEL/state/cards/c-001/out/merged-tests.log"
# The install's own things, which left the code in c-722: each a root of this set, each with
# its own git repo whose .git stays out (the files are what is archived).
for d in memory/bosun memory/talker identity packs/work history/docs; do mkdir -p "$KEEL/$d"; done
echo 'bosun index'       > "$KEEL/memory/bosun/MEMORY.md"
echo 'talker rules'      > "$KEEL/memory/talker/CLAUDE.md"
git -C "$KEEL/memory" init -q -b main
git -C "$KEEL/memory" -c user.name=t -c user.email=t@example.invalid commit -q --allow-empty -m 'the memory, committed'
mkdir -p "$KEEL/packs/.git"
echo 'ref: refs/heads/main' > "$KEEL/packs/.git/HEAD"        # a repo with no commit yet: no bundle
mkdir -p "$KEEL/spaces/personal" "$KEEL/claude/projects/-home-talker/memory"
echo 'my own rules'      > "$KEEL/spaces/personal/space-personal.md"
echo 'a lesson'          > "$KEEL/claude/projects/-home-talker/memory/MEMORY.md"
echo 'a transcript'      > "$KEEL/claude/projects/-home-talker/session.jsonl"
mkdir -p "$KEEL/state/cards/c-001/scratch/web/.git"
echo 'checked out'       > "$KEEL/state/cards/c-001/scratch/web/app.js"
echo 'ref: refs/heads/main' > "$KEEL/state/cards/c-001/scratch/web/.git/HEAD"
mkdir -p "$KEEL/state/cards/c-001/scratch/research/vendor/.git"
echo 'a vendored copy'   > "$KEEL/state/cards/c-001/scratch/research/vendor/lib.js"
# c-752: plain copies of a repo's source with no .git anywhere, which is what one done card
# held on 2026-10-11 (104MB of a 302MB snapshot). A card's scratch/ goes whole.
mkdir -p "$KEEL/state/cards/c-001/scratch/copy-1/src" "$KEEL/state/cards/c-001/out/node_modules/pkg"
echo 'a plain copy'      > "$KEEL/state/cards/c-001/scratch/copy-1/src/app.js"
echo 'module.exports=2'  > "$KEEL/state/cards/c-001/out/node_modules/pkg/index.js"
echo 'about the user'    > "$KEEL/identity/about-you.md"
echo 'name = "work"'     > "$KEEL/packs/work/pack.toml"
echo 'decided'           > "$KEEL/history/docs/decisions.md"
mkdir -p "$KEEL/state/cards/c-001/out/scratch"; echo "kept" > "$KEEL/state/cards/c-001/out/scratch/kept.md"

# A stub board: a JSON file of notices, with the three verbs keel-backup's queue() speaks.
# It is a simulator rather than an argv log because the alarm contract is about STATE (is
# there an open card under this key) and a log of calls cannot answer that.
cat > "$KEEL/bin/kb" <<'STUB'
#!/usr/bin/env python3
import json, os, sys
path = os.environ["NOTICES_PATH"]
try: cards = json.load(open(path))
except Exception: cards = []
argv = sys.argv[1:]
verb = argv[0] if argv else ""
def flag(name, default=""):
    return argv[argv.index(name) + 1] if name in argv else default
if verb == "list":
    print(json.dumps(cards))
elif verb == "create":
    key = flag("--option").split("=", 1)[-1]
    cards.append({"id": "n-%d" % (len(cards) + 1), "stage": "inbox",
                  "title": flag("--title"), "brief": flag("--brief"),
                  "options": {"notice_key": key}})
elif verb == "set":
    for card in cards:
        if card["id"] == argv[1]:
            for item in argv[2:]:
                name, _, value = item.partition("=")
                card[name] = value
elif verb == "stage":
    for card in cards:
        if card["id"] == argv[1]:
            card["stage"] = argv[2]
else:
    sys.exit(2)
json.dump(cards, open(path, "w"))
STUB
chmod +x "$KEEL/bin/kb"
export NOTICES_PATH="$NOTICES"

# --- a Harbor-shaped home, the set that froze at cutover -----------------------------
mkdir -p "$FAKE/bin" "$FAKE/secrets" "$FAKE/ledger/reviews" \
         "$FAKE/segments/fathom/data" "$FAKE/segments/daybook/data/inbox"
echo '{"asks":[]}'      > "$FAKE/segments/fathom/data/index.json"
echo '{"n":1}'          > "$FAKE/segments/fathom/data/state.json"
echo '{"items":[]}'     > "$FAKE/segments/daybook/data/items.json"
echo '{"drop":1}'       > "$FAKE/segments/daybook/data/inbox/one.json"
# EMPTY, and it has to survive the round trip. segments/README.md makes data/asks/ the
# place a fetcher writes an ask and data/inbox/ the single door an answer comes back
# through, so a restore that quietly drops them leaves the worker with nowhere to write.
# The first restore of the live data did exactly that, because a tar built from a list of
# files records no directory at all.
mkdir -p "$FAKE/segments/fathom/data/asks" "$FAKE/segments/fathom/data/inbox"
echo '{"id":"a"}'       > "$FAKE/ledger/dispatches.jsonl"
echo '{"id":"q"}'       > "$FAKE/ledger/queue.jsonl"
echo 'finding'          > "$FAKE/ledger/reviews/branch-x.md"
# THE TWO THAT WERE PROTECTED BY NOTHING, plus the two that deliberately still are.
# returns and briefs are gitignored as runtime state AND used to sit outside every root
# in harbor_roots, so they fell through the gap between git and the backup and lived on
# one disk. settings and panes are gitignored too and are still out on purpose: a
# settings file is regenerated from the dispatch id and names absolute paths on the
# machine that wrote it, and a pane is a frame of a failed spawn with a lifetime of
# hours. Both directions are asserted at the restore below, so the judgement stays a
# judgement rather than quietly becoming whatever the glob happens to do next.
mkdir -p "$FAKE/ledger/returns" "$FAKE/ledger/briefs" \
         "$FAKE/ledger/settings" "$FAKE/ledger/panes"
echo '{"state":"done","note":"what came of it"}' > "$FAKE/ledger/returns/abc123.jsonl"
echo '# the brief this dispatch was given'       > "$FAKE/ledger/briefs/abc123.md"
echo '{"hooks":{}}'                              > "$FAKE/ledger/settings/abc123.json"
echo 'the pane a failed spawn was showing'       > "$FAKE/ledger/panes/abc123.txt"

# The residue the scope is supposed to skip. If any of it lands in a snapshot the file
# count assertions below go wrong, which is the point of putting it here.
mkdir -p "$FAKE/segments/fathom/data/__pycache__" "$FAKE/ledger/.fetch-fathom.lock"
echo 'junk' > "$FAKE/segments/fathom/data/__pycache__/x.pyc"
echo 'pid'  > "$FAKE/ledger/.fetch-fathom.lock/pid"
echo 'tmp'  > "$FAKE/ledger/queue.jsonl.lock"
# filler-audio (card c-092): a regenerable TTS cache, same class as __pycache__ above, and
# the one that actually caused the size incident this card fixed. A fake "clip" here proves
# the exclusion, not just documents it.
mkdir -p "$FAKE/segments/voice/data/filler-audio"
echo 'fake wav' > "$FAKE/segments/voice/data/filler-audio/0a1b2c3d.wav"
# .tmp-* (card c-092 review round 2): harbor-live-status and harbor_voice/bus.py both
# write these via tempfile.mkstemp(prefix=".tmp-") then os.replace() them away, so one
# sitting in a backed-up root is a real, ordinary thing to see mid-write, not residue from
# a crash. Left in place (unlike a real atomic write, which renames it away quickly) so it
# is still there when the archive is built, proving the exclusion rather than the race.
echo 'mid-write' > "$FAKE/segments/fathom/data/.tmp-abc123.json"

# --- a Helm-shaped ~/.claude, the second set ----------------------------------------
# The retired review scanner's and PR watch's directories, the two ~/.claude/.gitignore
# keeps out of the claude-config repo and so the only copies there are. Both tools are
# retired (Keel lane RETIRE, 2026-09-24) and the set now keeps their HISTORY, read-only:
# pr-reviews entire, and pr-watch's context notes with their screenshots, which old cards
# link into. The watcher's own caches (its watchlist, its status files, its model choice)
# are state nothing reads any more, and are left out.
mkdir -p "$HELM/pr-reviews/findings" "$HELM/pr-reviews/orientation" \
         "$HELM/pr-watch/status" "$HELM/pr-watch/watch" \
         "$HELM/pr-watch/context/_archived" "$HELM/pr-watch/context/_assets/cloud__feature-x"
echo '{"prs":{}}'          > "$HELM/pr-reviews/state.json"
echo '# a finding'         > "$HELM/pr-reviews/findings/cloud-1.md"
echo '# orientation'       > "$HELM/pr-reviews/orientation/cloud-1.md"
echo '{"checked_at":"t1"}' > "$HELM/pr-watch/status/cloud-1.json"
echo '{"pr":1}'            > "$HELM/pr-watch/watch/cloud-1.json"
echo '{"model":"opus"}'    > "$HELM/pr-watch/model.json"
echo 'pr context'          > "$HELM/pr-watch/context/cloud__feature-x.md"
echo 'archived context'    > "$HELM/pr-watch/context/_archived/cloud__old.md"
echo 'a screenshot'        > "$HELM/pr-watch/context/_assets/cloud__feature-x/shot.png"
# EMPTY, and it has to survive, for the same reason the Harbor set's drop directories do:
# a tar built from a list of files records no directory at all.
mkdir -p "$HELM/pr-watch/context/_assets/cloud__empty"

# THE THINGS THAT MUST NOT LEAVE, and the things that must not be archived. The .env is the
# one that matters most: the real file holds four live Slack webhook URLs, and credentials
# never leave this machine, encrypted or not. The rest would either restore as lies (a pid
# and a port naming a process on a dead laptop, a lock nothing will release) or would make
# the manifest change on every single run.
echo 'SLACK_WEBHOOK_URL=https://hooks.slack.com/services/NOT-A-REAL-ONE' > "$HELM/pr-reviews/.env"
echo 'scanning...'    > "$HELM/pr-reviews/helm.log"
echo 'scanning...'    > "$HELM/pr-watch/scan.log"
echo '4242'           > "$HELM/pr-reviews/helm.pid"
echo '8899'           > "$HELM/pr-reviews/helm.port"
echo 'held'           > "$HELM/pr-watch/.watcher.lock"
mkdir -p "$HELM/pr-reviews/__pycache__"; echo 'junk' > "$HELM/pr-reviews/__pycache__/x.pyc"

mkdir -p "$BH" "$SD"

echo "keel-backup-selftest (store: $STORE)"

# --- 1. first snapshot ---------------------------------------------------------------
out="$(run snapshot)"
check "$(echo "$out" | grep -c 'snapshot .* published')" "3" "first run publishes one snapshot per set"
check "$(count "$HASNAP")" "1" "one Harbor snapshot, under sets/harbor/ like the others"
check "$(count "$HSNAP")"  "1" "one Helm snapshot under its own prefix"
check "$(count "$KSNAP")"  "1" "one Keel snapshot under its own prefix"
check "$(latest_of keel host)" "$HOST_A" "latest.json names the host that wrote the set"
check "$(notice open backup-passphrase)" "yes" "a new key stages the passphrase for a password manager"
check "$(notice title backup-passphrase)" "Put the Shipyard backup passphrase in your password manager" \
  "and names it for the product (c-729)"
check "$(notice open backup-passphrase-helm)" "yes" "and the helm set's own key gets its own card"
check "$(decrypts_with "$BH/backup-helm.key" "$(newest "$HSNAP")")" "yes" "the helm snapshot opens with the helm key"
check "$(decrypts_with "$BH/backup.key" "$(newest "$HSNAP")")" "no" \
      "and NOT with the shared key, which is the one the box holds"
check "$(find "$SD" -type f -perm -004 | wc -l | tr -d ' ')" "0" "nothing in the store is readable by other users"
check "$(jq_status 'd["sets"]["keel"]["snapshots_kept"]')"   "1" "status agrees one Keel snapshot is retained"
check "$(jq_status 'd["sets"]["harbor"]["snapshots_kept"]')" "1" "status agrees one Harbor snapshot is retained"
check "$(jq_status 'd["snapshots_kept"]')" "3" "and the store-wide figure counts all three"

# --- 2. an unchanged run must not publish ---------------------------------------------
files_before="$(find "$SD" -type f | wc -l | tr -d ' ')"
out="$(run snapshot)"
check "$(echo "$out" | grep -c 'nothing to publish')" "3" "an unchanged run is skipped for EVERY set, not re-encrypted"
check "$(find "$SD" -type f | wc -l | tr -d ' ')" "$files_before" "and the store is untouched"

# --- 3. a changed run publishes one object --------------------------------------------
echo '{"n":2}' > "$FAKE/segments/fathom/data/state.json"
out="$(run snapshot)"
check "$(echo "$out" | grep -c '\[harbor\] snapshot .* published')" "1" "a changed file produces a new snapshot"
check "$(find "$SD" -type f | wc -l | tr -d ' ')" "$((files_before + 1))" \
      "and exactly one new object reaches the store, not the whole retained set"
check "$(latest_of harbor snapshot)" "$(basename "$(newest "$HASNAP")" .tar.gz.gpg)" \
      "latest.json names the newest blob"

# --- 3b. a snapshot that could not reach the store is not a quiet night ---------------
# The git version's hole: a failed push left latest.json matching the live data, so the
# next run skipped as unchanged and the snapshot stayed on the laptop forever. Here the
# store refuses the put (a directory it cannot write), the snapshot waits in pending/, and
# the next run publishes it before anything else, with no change needed to prompt it.
notices_reset
echo '{"n":"3b"}' > "$FAKE/segments/fathom/data/state.json"
month_dir="$(dirname "$(newest "$HASNAP")")"
chmod 500 "$month_dir"
out="$(run snapshot)"; rc=$?
chmod 700 "$month_dir"
check "$([ "$rc" -ne 0 ] && echo yes || echo no)" "yes" "a put the store refuses fails the run"
check "$(echo "$out" | grep -c 'is waiting in')" "1" "and says where the snapshot is waiting"
check "$(count "$BH/work/harbor/pending")" "1" "the proven blob waits in pending/"
check "$(notice open backup-stale)" "yes" "the failure reaches the board"
pending_id="$(basename "$(newest "$BH/work/harbor/pending")" .tar.gz.gpg)"
out="$(run snapshot)"
check "$(echo "$out" | grep -c '\[harbor\] published 1 snapshot')" "1" "the next run publishes the waiting snapshot first"
check "$(latest_of harbor snapshot)" "$pending_id" "and latest.json then names it"
check "$(echo "$out" | grep -c '\[harbor\] unchanged')" "1" "after which the live data is correctly unchanged"
check "$(has "$BH/work/harbor/pending")" "no" "pending/ is empty again"
# A run killed mid-gpg leaves half a blob under its .part name. It is never published.
mkdir -p "$BH/work/harbor/pending"; echo 'half a blob' > "$BH/work/harbor/pending/29990101T000000Z.tar.gz.gpg.part"
run snapshot >/dev/null
check "$(count "$HASNAP/2999")" "0" "a half-written blob from a killed run is never published"
check "$(has "$BH/work/harbor/pending/29990101T000000Z.tar.gz.gpg.part")" "no" "and it is cleared away"
# A blob under its final name with no latest.json beside it was never proven either (the
# meta write failed, or an older version of this tool was killed): discarded, not published.
mkdir -p "$BH/work/harbor/pending"; echo 'unproven' > "$BH/work/harbor/pending/29990102T000000Z.tar.gz.gpg"
out="$(run snapshot)"
check "$(count "$HASNAP/2999")" "0" "a blob with no proof beside it is never published"
check "$(echo "$out" | grep -c 'discarding 29990102T000000Z')" "1" "and the run says it discarded it"
check "$(notice done backup-stale)" "yes" "and the failure card is retired"

# --- 4. retention --------------------------------------------------------------------
# Fabricated ids across a year, straight into the store. Only the names matter: retention
# reads the timestamp out of the filename, which is why the format is fixed and UTC.
#
# THE HOURLY BOUNDARY IS READ FROM THE SCRIPT UNDER TEST, not hardcoded here, so this fails
# loudly if the two ever disagree instead of certifying whichever window is in the source.
HOURLY_DAYS="$(grep -oE 'harbor\) echo [0-9]+ ;;  helm\)' "$BACKUP" | grep -oE '[0-9]+')"
[ -n "$HOURLY_DAYS" ] || { echo "could not read harbor's hourly retention window out of $BACKUP" >&2; exit 2; }
mk() { local id="$1"; local d="$HASNAP/${id:0:4}/${id:4:2}"; mkdir -p "$d"; echo x > "$d/$id.tar.gz.gpg"; chmod 600 "$d/$id.tar.gz.gpg"; }
python3 - "$ROOT/ids" "$ROOT/expected_young" "$HOURLY_DAYS" <<'PY'
import datetime, sys
now = datetime.datetime.now(datetime.timezone.utc)
hourly_days = int(sys.argv[3])
ids = []
expected_young = 0
for h in range(1, 24 * 10, 3):            # every 3h back through 10 days
    ids.append((now - datetime.timedelta(hours=h)).strftime("%Y%m%dT%H%M%SZ"))
    if h <= hourly_days * 24:
        expected_young += 1
for d in (30, 30, 45, 45, 80):            # inside the daily tier, two pairs same-day
    ids.append((now - datetime.timedelta(days=d)).strftime("%Y%m%dT%H%M%SZ"))
    ids.append((now - datetime.timedelta(days=d, hours=5)).strftime("%Y%m%dT%H%M%SZ"))
for d in (100, 130, 200, 210, 300):       # beyond it, monthly
    ids.append((now - datetime.timedelta(days=d)).strftime("%Y%m%dT%H%M%SZ"))
open(sys.argv[1], "w").write("\n".join(sorted(set(ids))) + "\n")
open(sys.argv[2], "w").write(str(expected_young) + "\n")
PY
expected_young="$(cat "$ROOT/expected_young")"
while read -r id; do [ -n "$id" ] && mk "$id"; done < "$ROOT/ids"
before="$(count "$HASNAP")"
echo '{"n":3}' > "$FAKE/segments/fathom/data/state.json"
out="$(run snapshot)"
after="$(count "$HASNAP")"

python3 - "$HASNAP" "$HOURLY_DAYS" > "$ROOT/verdict" <<'PY'
import datetime, os, sys
now = datetime.datetime.now(datetime.timezone.utc)
hourly_days = int(sys.argv[2])
kept = []
for dp, _d, fs in os.walk(sys.argv[1]):
    for f in fs:
        if f.endswith(".tar.gz.gpg"):
            kept.append(f[: -len(".tar.gz.gpg")])
days, months, young = {}, {}, 0
for sid in kept:
    ts = datetime.datetime.strptime(sid, "%Y%m%dT%H%M%SZ").replace(tzinfo=datetime.timezone.utc)
    age = (now - ts).total_seconds() / 86400.0
    if age <= hourly_days:
        young += 1
    elif age <= 90:
        days.setdefault(sid[:8], []).append(sid)
    else:
        months.setdefault(sid[:6], []).append(sid)
print(young, max([len(v) for v in days.values()] or [0]), max([len(v) for v in months.values()] or [0]))
PY
read -r young maxday maxmonth < "$ROOT/verdict"
if [ "$after" -lt "$before" ]; then ok "retention pruned $((before - after)) of $before snapshots from the store"
else bad "retention deleted nothing (before $before, after $after)"; fi
if [ "$young" -ge "$expected_young" ]; then
  ok "everything inside the ${HOURLY_DAYS}-day hourly window survived ($young, at least $expected_young expected)"
else
  bad "the hourly tier lost snapshots (got $young, expected at least $expected_young)"
fi
check "$maxday" "1" "at most one snapshot per day survives in the daily tier"
check "$maxmonth" "1" "at most one snapshot per month survives beyond 90 days"
check "$(jq_status 'd["sets"]["harbor"]["snapshots_kept"]')" "$after" \
      "status counts the store's retained set, as of this run's listing"

# --- 4b. a truncated archive is refused, not silently published -----------------------
# tar hits a real read error on a file it cannot open (chmod 000) and exits non-zero.
# Without the check on the archive pipeline, this run would have published a snapshot
# missing whatever tar could not read. Root reads everything, so the check is skipped there.
if [ "$(id -u)" != 0 ]; then
  BADFILE="$FAKE/segments/fathom/data/unreadable.json"
  echo '{"secret":1}' > "$BADFILE"
  chmod 000 "$BADFILE"
  echo '{"n":99}' > "$FAKE/segments/fathom/data/state.json"   # force a real change too
  before_n="$(count "$HASNAP")"
  out="$(run snapshot)"; rc=$?
  chmod 644 "$BADFILE"; rm -f "$BADFILE"
  echo '{"n":3}' > "$FAKE/segments/fathom/data/state.json"    # back to what section 5 expects
  check "$([ "$rc" -ne 0 ] && echo yes || echo no)" "yes" "an unreadable file fails the run, not just a warning"
  check "$(echo "$out" | grep -c 'refusing to snapshot a possibly incomplete tree')" "1" \
        "and it says so, rather than publishing a truncated archive"
  check "$(count "$HASNAP")" "$before_n" "and nothing new reached the store"
fi
notices_reset

# --- 5. restore round trip, from the store -------------------------------------------
mkdir -p "$ROOT/restored"
run restore --set harbor --into "$ROOT/restored" >/dev/null
if diff -r "$FAKE/segments/fathom/data" "$ROOT/restored/segments/fathom/data" \
     --exclude __pycache__ --exclude '.tmp-*' >/dev/null 2>&1; then
  ok "a tree restored from the store matches the source byte for byte"
else
  bad "the restored tree differs from the source"
fi
check "$(has "$ROOT/restored/segments/fathom/data/__pycache__")" "no" "excluded residue is absent from the restored tree"
check "$(has "$ROOT/restored/segments/voice/data/filler-audio")" "no" "the filler-audio cache is not in scope (card c-092)"
check "$(has "$ROOT/restored/segments/fathom/data/.tmp-abc123.json")" "no" \
      "an atomic-write temp file is not in scope, so its own rename race cannot fail a snapshot"
check "$(has "$ROOT/restored/ledger/queue.jsonl.lock")" "no" "the queue lock file is not in scope"
check "$([ -d "$ROOT/restored/segments/fathom/data/asks" ] && echo yes || echo no)" "yes" \
      "empty drop directories survive the round trip"
check "$(has "$ROOT/restored/ledger/returns/abc123.jsonl")" "yes" "a dispatch return survives the round trip"
check "$(has "$ROOT/restored/ledger/briefs/abc123.md")" "yes" "and the brief that dispatch was given"
check "$(has "$ROOT/restored/ledger/settings")" "no" \
      "per-dispatch settings are NOT backed up, being regenerable and machine-local"
check "$(has "$ROOT/restored/ledger/panes")" "no" "nor a captured pane, which is residue rather than state"

# --- 6. the refusals -----------------------------------------------------------------
out="$(run restore --set harbor --into "$FAKE/segments")"
check "$(echo "$out" | grep -c 'refusing to restore')" "1" "a restore aimed inside the old checkout is refused"
out="$(run restore --set keel --into "$KEEL/state")"
check "$(echo "$out" | grep -c 'refusing to restore')" "1" \
      "and one aimed inside the LIVE checkout, which is the one the engine is running from"

mv "$BH/backup.key" "$ROOT/key.saved"
out="$(run snapshot)"
check "$(echo "$out" | grep -c 'Refusing to generate a new passphrase')" "1" \
      "a missing key beside an existing history refuses rather than orphaning it"
check "$(notice open backup-stale)" "yes" "and that failure reaches the board"
mv "$ROOT/key.saved" "$BH/backup.key"
mv "$BH/backup-helm.key" "$ROOT/hkey.saved"
out="$(run snapshot --set helm --force)"
check "$(echo "$out" | grep -c 'Refusing to generate a new passphrase')" "1" \
      "and the same refusal guards the helm set's own key"
mv "$ROOT/hkey.saved" "$BH/backup-helm.key"

echo '{"n":4}' > "$FAKE/segments/fathom/data/state.json"
run snapshot >/dev/null
check "$(notice done backup-stale)" "yes" "a later success retires the failure card"

# --- 7. the two alarms must not be the same alarm ------------------------------------
# The bug this catches shipped in the first version of this tool: verify used the
# snapshot's key, so a verify failing at 04:30 on Sunday was retired by the 05:00 snapshot.
notices_reset
cp "$(newest "$HASNAP")" "$ROOT/good-blob"
echo 'not a gpg file' > "$(newest "$HASNAP")"
run verify >/dev/null 2>&1
check "$(notice open backup-unreadable)" "yes" "an unreadable snapshot in the store raises its OWN alarm"
check "$(notice open backup-stale)" "no" "and leaves the staleness key alone"
echo '{"n":5}' > "$FAKE/segments/fathom/data/state.json"
run snapshot >/dev/null
check "$(notice done backup-unreadable)" "no" "a later successful SNAPSHOT does not retire the unreadable alarm"
# THE CLEARING HALF, which the git version could only prove by hand against GitHub: a
# store verify that reads the newest snapshot back retires the card. The newest harbor
# snapshot is now a good one again (the run above published it).
out="$(run verify)"; rc=$?
check "$rc" "0" "a store verify of every set passes once the newest snapshot is readable"
check "$(notice done backup-unreadable)" "yes" "and it retires the unreadable alarm"
check "$(echo "$out" | grep -c 'nothing shared')" "1" "and it confirms nothing in the store is shared"
check "$([ -n "$(state_of last_verify)" ] && echo yes || echo no)" "yes" "and stamps the verify clock"

# --- 8. the other sets ----------------------------------------------------------------
mkdir -p "$ROOT/restored-helm"
