{
  "scene": "10. End of day: his line 4, Harbor says nothing waits and three cards are shipping: the export card, the dark theme and the weekly digest",
  "seed": "evening",
  "start": "/segments/voice/app/",
  "mic": "line-4.wav",
  "harbor": [
    "Hey Harbor, anything left for today?"
  ],
  "viewport": {
    "width": 390,
    "height": 844
  },
  "scale": 2,
  "hero": "answered",
  "names": {
    "mic": "#mic",
    "said": ".v-turn.latest .v-said",
    "answer": ".v-turn.latest .v-answer",
    "export": ".row:has-text('Add CSV export'), tr:has-text('Add CSV export')"
  },
  "steps": [
    {
      "do": "wait",
      "target": "#mic",
      "label": "ready",
      "pause": 1500
    },
    {
      "do": "hold",
      "target": "#mic",
      "ms": 4500,
      "label": "speak",
      "pause": 0
    },
    {
      "do": "wait",
      "for": "(document.querySelector('.v-turn.latest .v-answer') || {}).textContent?.length > 20",
      "timeout": 180000,
      "label": "answered",
      "pause": 5000
    },
    {
      "do": "goto",
      "url": "/?view=attention",
      "label": "nothing waiting",
      "pause": 3500
    },
    {
      "do": "goto",
      "url": "/?view=cards",
      "label": "shipping",
      "pause": 4000
    }
  ]
}
